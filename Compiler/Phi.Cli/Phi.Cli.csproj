<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>phi</AssemblyName>
    <RootNamespace>Phi.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the checking heap, which phi fuzz objects puts beside each of its programs -->
    <EmbeddedResource Include="..\..\samples\own_heap\memory\*.phi" LogicalName="own_heap/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phi.Compiler\Phi.Compiler.csproj" />
  </ItemGroup>

</Project>
