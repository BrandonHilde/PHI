# The real-time clock (CMOS RTC), written in PHI. Works in 16-bit programs and
# 32-bit kernels.
#
#   use drivers.rtc;
#   call Rtc.Read;
#   log Rtc.hour ':' Rtc.minute ':' Rtc.second;
#   call Rtc.SetZone: 120;           # minutes from UTC: 120 is UTC+2
#   call Rtc.ReadLocal;              # Read, then moved into that time zone
#
# QEMU's clock is the host's time, in UTC. ReadLocal adds the zone's minutes, carrying
# into the day, month and year (leap years included); AddMinutes does the same for any
# date and time in the fields.

phi.Rtc:Library
{
	const u16 CMOS_INDEX: 0x70;
	const u16 CMOS_DATA: 0x71;

	int second: 0;
	int minute: 0;
	int hour: 0;
	int day: 0;
	int month: 0;
	int year: 0;
	int zone: 0;                    # minutes from UTC that ReadLocal adds (-720 to 840)

	[ReadRegister: u8 register: 0;]
		out CMOS_INDEX register;
	[end: in CMOS_DATA]

	# fill in the fields above with the current date and time
	[Read]
		# wait for any update in progress to finish, so the values belong together
		u8 status: 0x80;
		while status & 0x80
			call status is ReadRegister: 0x0A;
		;;

		call second is ReadRegister: 0x00;
		call minute is ReadRegister: 0x02;
		call hour is ReadRegister: 0x04;
		call day is ReadRegister: 0x07;
		call month is ReadRegister: 0x08;
		call year is ReadRegister: 0x09;

		u8 format: 0;
		call format is ReadRegister: 0x0B;
		bln pm: hour & 0x80;
		hour is hour & 0x7F;

		# usually the values are binary-coded decimal: 0x59 means 59
		if (format & 4) is 0
			second is (second & 0x0F) + (second >> 4) * 10;
			minute is (minute & 0x0F) + (minute >> 4) * 10;
			hour is (hour & 0x0F) + (hour >> 4) * 10;
			day is (day & 0x0F) + (day >> 4) * 10;
			month is (month & 0x0F) + (month >> 4) * 10;
			year is (year & 0x0F) + (year >> 4) * 10;
		;;

		# a 12-hour clock: 12 AM is 0, 1 PM is 13
		if (format & 2) is 0
			if hour is 12
				hour is 0;
			;;
			if pm
				hour++ 12;
			;;
		;;

		year++ 2000;
	[end]

	[SetZone: int minutes: 0;]
		zone is minutes;
	[end]

	# like Read, but in the time zone set with SetZone
	[ReadLocal]
		call Read;
		call AddMinutes: zone;
	[end]

	# move the fields by minutes (later, or earlier when negative), carrying into the hour,
	# day, month and year
	[AddMinutes: int minutes: 0;]
		int total: hour * 60 + minute + minutes;
		int days: 0;
		while total < 0
			total++ 1440;
			days--;
		;;
		while total >= 1440
			total-- 1440;
			days++;
		;;
		hour is total / 60;
		minute is total % 60;

		while days > 0
			day++;
			if day > (DaysIn: month year)
				day is 1;
				month++;
				if month > 12
					month is 1;
					year++;
				;;
			;;
			days--;
		;;
		while days < 0
			day--;
			if day < 1
				month--;
				if month < 1
					month is 12;
					year--;
				;;
				day is (DaysIn: month year);
			;;
			days++;
		;;
	[end]

	# the days in month m (1 to 12) of year y
	[DaysIn: int m: 1; int y: 2000;]
		if m is 2
			if y % 4 is 0 and (y % 100 is not 0 or y % 400 is 0) return 29;
			return 28;
		;;
		if m is 4 or m is 6 or m is 9 or m is 11 return 30;
	[end: 31]
}
