# Driver for the virtio-net network card that QEMU (and cloud machines) offer, through
# its legacy PCI interface (drivers.virtio). 32-bit kernels. The same calls as
# drivers.rtl8139, and drivers.nic uses whichever card the machine has.
#
#   use drivers.virtio_net;
#   bln ok: (VirtioNet.Start);                   # false if there's no card
#   call ok is VirtioNet.Send: frame length;     # a whole Ethernet frame
#   u32 length: (VirtioNet.Receive: buffer 1536);  # 0 if no frame is waiting
#
# The card and the driver share two queues: one of buffers for receiving and one for
# sending. Start gives the card a buffer for every place in the receive queue (256 on
# QEMU); the card fills them with frames and hands them back in the order they came.
# On the card's interrupt the driver copies those frames into a queue of up to
# FRAMES_WAITING, where they wait for Receive, and gives the buffers straight back: a
# card with no buffers stops taking frames, which would hold up the whole network, so
# a kernel busy elsewhere only loses frames once the queue is full (frames_dropped).
# Receive also empties the ring itself, so it works with interrupts off too. Each
# buffer starts with the card's 10-byte header, all zeros: no checksum or segmentation
# work is asked of the card.

use drivers.pci;
use drivers.virtio;
use data.queue;
use memory.mem;

# a frame waiting for Receive
struct.VirtioFrame
{
	u32 length;
	u8 data[1536];
}

phi.VirtioNet:Kernel
{
	const u32 PRODUCT: 0x1000;            # a network card, with the legacy interface
	const u32 REG_MAC: 0x14;              # Virtio.DEVICE: the card's address
	const u32 FEATURE_MAC: 0x20;          # the card tells us its address

	const u32 RECEIVE_QUEUE: 0;
	const u32 SEND_QUEUE: 1;
	const u32 HEADER: 10;
	const u32 BUFFER: 1536;               # the header and the largest frame, rounded up
	const u32 MAX_FRAME: 1514;
	const u32 FRAMES_WAITING: 256;

	u8 mac[6];
	bln started: false;
	u32 io: 0;
	u32 irq: 0;
	u32 frames_sent: 0;
	u32 frames_received: 0;
	u32 frames_dropped: 0;                # arrived with FRAMES_WAITING already waiting, or Send gave up
	u32 interrupts: 0;

	Virtqueue rx;
	ptr<u8> rx_buffers: 0;
	u32 rx_seen: 0;                       # how many buffers the card has handed back that we've read
	Virtqueue tx;
	ptr<u8> tx_buffers: 0;
	u32 tx_next: 0;                       # how many frames we've given the card to send
	ptr<QueueData> waiting: 0;
	VirtioFrame incoming;                 # a frame on its way from a buffer to the queue
	lock rx_lock;                          # the queue, between the interrupt (on any core) and Receive

	# find the card and turn it on; false if there isn't one
	[Start]
		if started return true;
		u32 card: (Pci.Find: Virtio.VENDOR PRODUCT);
		if card is Pci.NOT_FOUND return false;
		call Pci.EnableBusMaster: card;
		io is (Pci.Bar: card 0);
		irq is (Pci.Irq: card);
		waiting is (Queue.New: sizeof VirtioFrame FRAMES_WAITING);
		if waiting is 0 return false;

		call Virtio.Begin: io FEATURE_MAC;                      # nothing else
		while int i: 0; i < 6; i++;
			mac:i is in (io + REG_MAC + i);
		;;

		if not (Virtio.SetUpQueue: io RECEIVE_QUEUE addr rx) return false;
		if not (Virtio.SetUpQueue: io SEND_QUEUE addr tx) return false;
		rx_buffers is new u8[rx.size * BUFFER];
		tx_buffers is new u8[tx.size * BUFFER];
		if rx_buffers is 0 or tx_buffers is 0 return false;

		# every receive buffer goes to the card at once
		while u32 i: 0; i < rx.size; i++;
			rx.desc:i.address is rx_buffers + i * BUFFER;
			rx.desc:i.length is BUFFER;
			rx.desc:i.flags is Virtio.DESC_WRITE;
			rx.avail:(2 + i) is i;
		;;
		rx.avail:1 is rx.size;
		tx.avail:0 is Virtio.NO_INTERRUPT;                      # only receiving interrupts

		call OS.SetIrqHandler: irq addr Interrupt;
		call Virtio.Ready: io;
		call Virtio.Notify: io RECEIVE_QUEUE;
		started is true;
	[end: true]

	# send an Ethernet frame (destination, source, type, data; no checksum)
	[Send: ptr<u8> frame: 0; u32 length: 0;]
		if started is false or length > MAX_FRAME return false;

		# wait for a buffer the card has finished sending (it holds them back while the
		# network can't take more); after a second, this frame is dropped instead
		int start: (OS.GetTicks);
		while ((tx_next - (Virtio.Used: addr tx)) & 0xFFFF) >= tx.size
			if (OS.GetTicks) - start > 1000
				frames_dropped++;
				return false;
			;;
		;;

		u32 slot: tx_next % tx.size;
		ptr<u8> buffer: tx_buffers + slot * BUFFER;
		call Mem.Fill: buffer 0 HEADER;
		call Mem.Copy: buffer + HEADER frame length;
		tx.desc:slot.address is buffer;
		tx.desc:slot.length is HEADER + length;
		tx.desc:slot.flags is 0;
		tx.avail:(2 + slot) is slot;
		tx_next++;
		tx.avail:1 is tx_next & 0xFFFF;                         # the card may take it now
		call Virtio.Notify: io SEND_QUEUE;
		frames_sent++;
	[end: true]

	# copy the oldest received frame into a buffer; its length, or 0 if none is waiting
	[Receive: ptr<u8> to: 0; u32 max: 0;]
		u32 length: 0;
		if started
			locked rx_lock
				call TakeFrames;                                    # in case interrupts are off
				ptr<VirtioFrame> frame: (Queue.Front: waiting);
				if frame is not 0
					length is frame:0.length;
					if length > max
						length is max;
					;;
					call Mem.Copy: to frame:0.data length;
					call Queue.Drop: waiting;
				;;
			;;
		;;
	[end: length]

	# the card's interrupt: received frames into the queue
	[Interrupt]
		u8 cause: in (io + Virtio.REG_INTERRUPT);              # acknowledges it
		interrupts++;
		locked rx_lock
			call TakeFrames;
		;;
	[end]

	# every buffer the card has handed back: its frame into the queue (or dropped, when
	# the queue is full), and the buffer back to the card; holding rx_lock
	[TakeFrames]
		bln gave: false;
		while (Virtio.Used: addr rx) is not rx_seen
			u32 id: (Virtio.UsedId: addr rx rx_seen);
			u32 written: (Virtio.UsedLength: addr rx rx_seen);
			u32 length: 0;
			if written > HEADER
				length is written - HEADER;
			;;
			if waiting:0.count < waiting:0.capacity
				incoming.length is length;
				call Mem.Copy: incoming.data rx_buffers + id * BUFFER + HEADER length;
				call Queue.Push: waiting addr incoming;
				frames_received++;
			;;
			else
				frames_dropped++;
			;;
			rx_seen is (rx_seen + 1) & 0xFFFF;

			u32 next: rx.avail:1;
			rx.avail:(2 + next % rx.size) is id;
			rx.avail:1 is (next + 1) & 0xFFFF;
			gave is true;
		;;
		if gave
			call Virtio.Notify: io RECEIVE_QUEUE;
		;;
	[end]
}

