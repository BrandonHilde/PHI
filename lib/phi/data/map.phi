# Maps: a value for each key.
#
# Map<Key Value> is for any kind of key and value (32-bit kernels and programs):
#
#   use data.map;
#   new Map<str int> counts;                    # a key is a number, a chr, an enum, an i64 or text
#   call counts.Set: 'the' 1;                   # adds the key, or changes its value
#   call counts.Set: 'the' (counts.Get: 'the' 0) + 1;
#   int n: (counts.Get: 'phi' 0);               # 0, the second argument, if the key isn't there
#   bln here: (counts.Has: 'the');
#   call counts.Remove: 'the';                  # false if it wasn't there
#   log (counts.Count) '\n';
#
#   while each word in counts.keys              # every key, in the order they were added
#       log word ' ' (counts.Get: word 0) '\n'; # (Remove moves the last one into the gap)
#   ;;
#
#   new Map<u32 Player> players;                # a struct as the value: a copy is kept
#   call players.Set: 1042 ann;
#   new Player got: (players.Get: 1042 nobody); # a copy of it (or of nobody)
#   int i: (players.Find: 1042);                # where it is in players.values, or -1
#   if i >= 0
#       players.values:i.score++ 10;            # the one the map holds
#   ;;
#
# The keys and the values are two arrays, side by side: keys:i goes with values:i (and
# hashes:i is that key's hash, worked out once when it was added). places
# is a table whose size is a power of 2, holding 1 + where each key is (0 for a free place);
# a key's place comes from its hash (Hash.Of, in data.hash), and a taken place sends it to
# the next one along. The table doubles when it's three-quarters full, so Set, Get, Find,
# Has and Remove take about the same time however many keys there are. A Map is copied,
# compared and freed whole, as any struct with arrays that grow is. Get hands back a
# struct value as a copy; to change the one the map holds, use Find and values.
#
# The Map class below is the older way, for u32 keys and u32 values behind a pointer;
# Map<u32 u32> does the same with less to say.
#
# Maps from u32 keys to u32 values, such as an ID to an index, on the heap (32-bit kernels
# and programs). (A value is 32 bits in 64-bit code too, so keep a pointer's place in a
# table, not the pointer.)
#
#   use data.map;
#   ptr<MapData> players: (Map.New);
#   call Map.Set: players 1042 slot;            # adds the key, or changes its value
#   bln here: (Map.Has: players 1042);
#   u32 slot: (Map.Get: players 1042 NONE);     # NONE if the key isn't there (0 if left out)
#   call Map.Remove: players 1042;              # false if it wasn't there
#   log players:0.count;                        # how many keys
#   call Map.Delete: players;
#
#   # every key and value, in no particular order
#   int pos: (Map.Next: players);
#   while pos >= 0
#       log (Map.KeyAt: players pos) ' ' (Map.ValueAt: players pos) '\n';
#       pos is (Map.Next: players pos);
#   ;;
#
# Any u32 can be a key, 0 included, and any u32 a value. A negative number going in says
# `as u32` and coming out says `as int`, as a number that's kept as bits does anywhere. The keys are kept in a table whose size is a power
# of 2: a key's place comes from multiplying it by a large odd number (Fibonacci
# hashing), and a taken place sends it to the next one along. The table doubles when
# it's three-quarters full, so Set, Get, Has and Remove take about the same time
# however many keys there are. Changing the map while walking it with Next can skip
# keys or show them twice.

use memory.mem;
use data.hash;

struct.Map<Key Value>
{
	Key keys[];
	Value values[];
	u32 hashes[];               # each key's hash, kept: a key is hashed once, however the table grows
	u32 places[];               # 1 + where its key is in keys, or 0 while it's free
	u32 shift;                  # 32 minus the bits in places.len: a key's place is its hash >> shift

	# where key is in keys and values, or -1
	[Find: Key key;]
	[end: (FindHashed: key (Hash.Of: key))]

	# the same, for a key whose hash is known (a key with another hash isn't looked at)
	[FindHashed: Key key; u32 hash;]
		if places.len is 0 return -1;
		u32 mask: (places.len - 1) as u32;
		u32 pos: (hash * 0x9E3779B1) >> shift;
		# (a place is always inside the table, and what it holds inside the keys: no index
		# here needs its check)
		unsafe
			while places:pos is not 0
				int i: places:pos - 1;
				if hashes:i is hash and keys:i is key return i;
				pos is (pos + 1) & mask;
			;;
		;;
	[end: -1]

	[Has: Key key;]
	[end: (FindHashed: key (Hash.Of: key)) >= 0]

	# key's value is value now, whether or not key was there
	[Set: Key key; Value value;]
		u32 hash: (Hash.Of: key);
		int i: (FindHashed: key hash);
		if i >= 0
			values:i is value;
			return;
		;;
		if (keys.len + 1) * 4 > places.len * 3
			call Grow;
		;;
		keys++ key;
		values++ value;
		hashes++ hash;
		call Index: keys.len - 1;
	[end]

	# key's value, or otherwise if key isn't there
	[Get: Key key; Value otherwise;]
		int i: (FindHashed: key (Hash.Of: key));
		if i < 0 return otherwise;
	[end: values:i]

	# key and its value taken out; false if it wasn't there
	[Remove: Key key;]
		int i: (Find: key);
		if i < 0 return false;
		call Unplace: i;
		int last: keys.len - 1;
		if i is not last
			# the last one moves into the gap
			call Unplace: last;
			keys:i is keys:last;
			values:i is values:last;
			hashes:i is hashes:last;
			call Index: i;
		;;
		keys.len is last;
		values.len is last;
		hashes.len is last;
	[end: true]

	[Count]
	[end: keys.len]

	[Clear]
		keys.len is 0;
		values.len is 0;
		hashes.len is 0;
		places.len is 0;
	[end]

	# ---- the table

	# where a key with this hash starts looking: the hash, cut to the table's size
	[Place: u32 hash: 0;]
	[end: (hash * 0x9E3779B1) >> shift]

	[Index: int i: 0;]
		u32 mask: (places.len - 1) as u32;
		u32 pos: (Place: hashes:i);
		unsafe
			while places:pos is not 0
				pos is (pos + 1) & mask;
			;;
			places:pos is i + 1;
		;;
	[end]

	[Unplace: int i: 0;]
		u32 mask: places.len - 1;
		u32 pos: (Place: hashes:i);
		while places:pos is not i + 1
			pos is (pos + 1) & mask;
		;;
		u32 next: (pos + 1) & mask;
		while places:next is not 0
			int other: places:next - 1;
			u32 home: (Place: hashes:other);
			if ((next - home) & mask) >= ((next - pos) & mask)
				places:pos is places:next;
				pos is next;
			;;
			next is (next + 1) & mask;
		;;
		places:pos is 0;
	[end]

	[Grow]
		int size: places.len * 2;
		if size is 0
			size is 16;
			shift is 28;
		;;
		else
			shift--;
		;;
		places.len is 0;
		while places.len < size
			places++ 0;
		;;
		while int i: 0; i < keys.len; i++;
			call Index: i;
		;;
	[end]
}


struct.MapData
{
	ptr<u32> keys;
	ptr<u32> values;
	ptr<u8> states;             # EMPTY, USED or REMOVED for each place
	u32 count;                  # keys in the map
	u32 capacity;               # places: a power of 2
	u32 removed;                # places left REMOVED (they slow a search until the table is remade)
	u32 shift;                  # 32 minus the bits in capacity: a key's place is its hash >> shift
}

phi.Map:Library
{
	const u32 FIRST_CAPACITY: 16;
	const u32 FIRST_SHIFT: 28;
	const u32 HASH: 0x9E3779B1;           # 2^32 divided by the golden ratio, made odd
	const u8 EMPTY: 0;
	const u8 USED: 1;
	const u8 REMOVED: 2;

	# an empty map; 0 if the heap is full
	[New]
		ptr<MapData> map: new MapData;
		if map is 0 return 0;
		if (Allocate: map FIRST_CAPACITY FIRST_SHIFT) is false
			free map;
			return 0;
		;;
	[end: map]

	# key's value set to value, adding key if it isn't there; false if the heap is full
	[Set: ptr<MapData> map: 0; u32 key: 0; u32 value: 0;]
		int pos: (Find: map key);
		if pos >= 0
			map:0.values:pos is value;
			return true;
		;;
		# keep a quarter of the places free (counting removed ones), so searches stay short
		if (map:0.count + map:0.removed + 1) * 4 > map:0.capacity * 3
			if (Rebuild: map) is false return false;
		;;
		u32 place: (Place: map key);
		while map:0.states:place is USED
			place is (place + 1) & (map:0.capacity - 1);
		;;
		if map:0.states:place is REMOVED
			map:0.removed--;
		;;
		map:0.states:place is USED;
		map:0.keys:place is key;
		map:0.values:place is value;
		map:0.count++;
	[end: true]

	# key's value, or otherwise if key isn't in the map
	[Get: ptr<MapData> map: 0; u32 key: 0; u32 otherwise: 0;]
		int pos: (Find: map key);
		if pos < 0 return otherwise;
	[end: map:0.values:pos]

	[Has: ptr<MapData> map: 0; u32 key: 0;]
	[end: (Find: map key) >= 0]

	# take key out of the map; false if it wasn't there
	[Remove: ptr<MapData> map: 0; u32 key: 0;]
		int pos: (Find: map key);
		if pos < 0 return false;
		map:0.states:pos is REMOVED;
		map:0.count--;
		map:0.removed++;
	[end: true]

	# the place of the first key after the place after (leave it out to start), or -1 after the last
	[Next: ptr<MapData> map: 0; int after: -1;]
		u32 place: after + 1;
		while place < map:0.capacity
			if map:0.states:place is USED return place;
			place++;
		;;
	[end: -1]

	# the key and the value at a place from Next
	[KeyAt: ptr<MapData> map: 0; int pos: 0;]
	[end: map:0.keys:pos]

	[ValueAt: ptr<MapData> map: 0; int pos: 0;]
	[end: map:0.values:pos]

	# every key out, keeping the table's size
	[Clear: ptr<MapData> map: 0;]
		call Mem.Fill: map:0.states EMPTY map:0.capacity;
		map:0.count is 0;
		map:0.removed is 0;
	[end]

	[Delete: ptr<MapData> map: 0;]
		if map is 0 return;
		free map:0.keys;
		free map:0.values;
		free map:0.states;
		free map;
	[end]

	# ---- inside the table

	# where key's search starts
	[Place: ptr<MapData> map: 0; u32 key: 0;]
	[end: (key * HASH) >> map:0.shift]

	# the place holding key, or -1
	[Find: ptr<MapData> map: 0; u32 key: 0;]
		u32 place: (Place: map key);
		while map:0.states:place is not EMPTY
			if map:0.states:place is USED and map:0.keys:place is key return place;
			place is (place + 1) & (map:0.capacity - 1);
		;;
	[end: -1]

	# new, empty tables of capacity places; false if the heap is full
	[Allocate: ptr<MapData> map: 0; u32 capacity: 0; u32 shift: 0;]
		ptr<u32> keys: new u32[capacity];
		ptr<u32> values: new u32[capacity];
		ptr<u8> states: new u8[capacity];
		if keys is 0 or values is 0 or states is 0
			free keys;
			free values;
			free states;
			return false;
		;;
		map:0.keys is keys;
		map:0.values is values;
		map:0.states is states;
		map:0.capacity is capacity;
		map:0.shift is shift;
		map:0.count is 0;
		map:0.removed is 0;
	[end: true]

	# the keys moved into a new table: twice as big if they fill half of it, else the
	# same size (which clears out the removed places); false if the heap is full
	[Rebuild: ptr<MapData> map: 0;]
		u32 capacity: map:0.capacity;
		u32 shift: map:0.shift;
		if map:0.count * 2 >= capacity
			capacity is capacity * 2;
			shift--;
		;;
		ptr<u32> old_keys: map:0.keys;
		ptr<u32> old_values: map:0.values;
		ptr<u8> old_states: map:0.states;
		u32 old_capacity: map:0.capacity;
		if (Allocate: map capacity shift) is false return false;   # the map is unchanged
		while u32 i: 0; i < old_capacity; i++;
			if old_states:i is USED
				u32 place: (Place: map old_keys:i);
				while map:0.states:place is USED
					place is (place + 1) & (map:0.capacity - 1);
				;;
				map:0.states:place is USED;
				map:0.keys:place is old_keys:i;
				map:0.values:place is old_values:i;
				map:0.count++;
			;;
		;;
		free old_keys;
		free old_values;
		free old_states;
	[end: true]
}
