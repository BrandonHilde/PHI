# Queues: first in, first out.
#
# Queue<Item> is for items of any type, as many as are added (32-bit kernels and programs):
#
#   use data.queue;
#   new Queue<int> waiting;                     # numbers, text, structs
#   call waiting.Add: 7;                        # a copy is kept, after the newest
#   call waiting.Add: 12;
#   while (waiting.Count) > 0
#       int next: (waiting.Take);               # the oldest, which leaves the queue
#   ;;
#   int soon: (waiting.Front);                  # the oldest, which stays
#   call waiting.Clear;
#
#   new Queue<Request> requests;                # a struct: Add keeps a copy, text and all
#   Request r;
#   r is (requests.Take);
#
# Taking from an empty queue (or its Front) is an error, as an index past an array's end
# is: ask Count first. The items are the array items, the oldest at items:first, and
# taking doesn't move the others along: first steps past the one taken, and the room in
# front is used again once the queue has emptied, or has more room in front than items.
# A Queue is copied, compared and freed whole, as any struct with an array that grows is.
#
# The Queue class below is the older way: records of one size behind a pointer, in a block
# that never grows, so Push says when it's full. That's what a driver wants for packets
# (what doesn't fit is dropped, and nothing is asked of the heap while one arrives), and
# what the network modules use.
#
# Queues of records of one size, taken out in the order they were put in, such as
# packets or events waiting for the next tick (32-bit kernels and programs).
#
#   use data.queue;
#   ptr<QueueData> inbox: (Queue.New: sizeof Packet 64);  # room for 64
#   bln ok: (Queue.Push: inbox addr packet);             # a copy goes in; false when full
#   while (Queue.Pop: inbox addr packet)                 # the oldest is copied out
#       call Handle: packet;
#   ;;
#   log inbox:0.count;
#   call Queue.Delete: inbox;
#
# The records sit in one block from the heap, used as a ring: the oldest is at head,
# and the next one goes count places after it, wrapping round at the end. Nothing is
# moved when a record is taken out. Front gives the oldest record where it is, and
# Drop takes it out without copying it. A queue isn't safe to use from an interrupt
# handler and the rest of the program at the same time.

use memory.mem;

struct.Queue<Item>
{
	Item items[];
	int first;                  # where the oldest is in items

	[Add: Item item;]
		if first > 0 and first is items.len
			items.len is 0;
			first is 0;
		;;
		elif first >= 32 and first * 2 > items.len
			int count: items.len - first;
			while int i: 0; i < count; i++;
				items:i is items:(first + i);
			;;
			items.len is count;
			first is 0;
		;;
		items++ item;
	[end]

	[Count]
	[end: items.len - first]

	# the oldest, which leaves the queue
	[Take]
		first++;
	[end: items:(first - 1)]

	# the oldest, which stays
	[Front]
	[end: items:first]

	[Clear]
		items.len is 0;
		first is 0;
	[end]
}

struct.QueueData
{
	ptr<u8> records;
	u32 size;                   # bytes in a record
	u32 capacity;               # records it holds
	u32 head;                   # where the oldest record is
	u32 count;                  # records in it
}

phi.Queue:Library
{
	# an empty queue of up to capacity records of size bytes; 0 if the heap is full
	[New: u32 size: 0; u32 capacity: 0;]
		ptr<QueueData> queue: new QueueData;
		if queue is 0 return 0;
		queue:0.records is new u8[size * capacity];
		if queue:0.records is 0
			free queue;
			return 0;
		;;
		queue:0.size is size;
		queue:0.capacity is capacity;
	[end: queue]

	# a copy of size bytes at record, added after the newest; false when it's full
	[Push: ptr<QueueData> queue: 0; ptr<u8> record: 0;]
		if queue:0.count is queue:0.capacity return false;
		u32 place: (queue:0.head + queue:0.count) % queue:0.capacity;
		call Mem.Copy: queue:0.records + place * queue:0.size record queue:0.size;
		queue:0.count++;
	[end: true]

	# the oldest record copied to into, and taken out; false when it's empty
	[Pop: ptr<QueueData> queue: 0; ptr<u8> target: 0;]
		if queue:0.count is 0 return false;
		call Mem.Copy: target queue:0.records + queue:0.head * queue:0.size queue:0.size;
		call Drop: queue;
	[end: true]

	# the oldest record, where it is in the queue (a ptr<u8>, which a ptr<Packet> takes); 0
	# when it's empty
	[Front: ptr<QueueData> queue: 0;]
		if queue:0.count is 0 return 0;
		ptr<u8> front: queue:0.records + queue:0.head * queue:0.size;
	[end: front]

	# take the oldest record out, without copying it anywhere
	[Drop: ptr<QueueData> queue: 0;]
		if queue:0.count is 0 return;
		queue:0.head is (queue:0.head + 1) % queue:0.capacity;
		queue:0.count--;
	[end]

	[Clear: ptr<QueueData> queue: 0;]
		queue:0.head is 0;
		queue:0.count is 0;
	[end]

	[Delete: ptr<QueueData> queue: 0;]
		if queue is 0 return;
		free queue:0.records;
		free queue;
	[end]
}
