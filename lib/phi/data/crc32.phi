# CRC-32, the checksum zip files and Ethernet use, for finding data that was cut short
# or damaged (it isn't proof against someone changing it on purpose: use crypto.hmac
# for that). Any 32-bit program.
#
#   use data.crc32;
#   u32 check: (Crc32.Of: data length);
#   u32 more: (Crc32.Add: check rest rest_length);    # the same as one Of over both
#
# A table of 256 values, made the first time it's needed, lets it take a byte at a time.

phi.Crc32:Library
{
	u32 crc_table[256];
	bln crc_ready: false;

	[Of: ptr<u8> data: 0; u32 length: 0;]
	[end: (Add: 0 data length)]

	# the CRC of what crc was the CRC of, followed by length more bytes
	[Add: u32 crc: 0; ptr<u8> data: 0; u32 length: 0;]
		if crc_ready is false
			call MakeTable;
		;;
		u32 c: crc ^ 0xFFFFFFFF;
		while u32 i: 0; i < length; i++;
			c is crc_table:((c ^ data:i) & 0xFF) ^ (c >> 8);
		;;
	[end: c ^ 0xFFFFFFFF]

	[MakeTable]
		while u32 n: 0; n < 256; n++;
			u32 c: n;
			while int k: 0; k < 8; k++;
				if (c & 1) is 1
					c is 0xEDB88320 ^ (c >> 1);
				;;
				else
					c is c >> 1;
				;;
			;;
			crc_table:n is c;
		;;
		crc_ready is true;
	[end]
}
