# Widgets for windows: buttons, check boxes, text fields, text areas and lists, drawn with
# gfx.draw. 32-bit kernels and user programs (with gui.app).
#
#   use gui.widgets;
#   Button ok;
#   TextField name;
#   call ok.Place: 10 60 80 24 'OK';
#   call name.Place: 10 20 200;
#   ...
#   call App.WaitEvent;
#   if App.event.kind is Events.MOUSE
#       if (ok.Mouse: App.event) ...           # true: it was clicked
#       call name.Mouse: App.event;            # a click on it puts the caret there
#   ;;
#   if App.event.kind is Events.KEY
#       int done: (name.Key: App.event.value); # 2 when Enter was pressed
#   ;;
#   call Draw.Clear: Widgets.FACE;
#   call ok.Paint;
#   call name.Paint;
#   call App.Present;
#
# Each widget keeps its own place and state; Mouse and Key say what happened, and the
# program draws everything again after an event (Paint) and Presents it. Widgets draw
# relative to Draw's view, so they work inside a part of a window too.

use gfx.draw;
use gui.events;
use user.text;
use user.math;

# a button: Mouse gives true when it's clicked (pressed, and let go on it)
struct.Button
{
	int x;
	int y;
	int w;
	int h;
	str label: [31];
	bln down;                   # pressed, and not let go yet

	[Place: int bx: 0; int by: 0; int bw: 0; int bh: 0; ptr<u8> text: 0;]
		x is bx;
		y is by;
		w is bw;
		h is bh;
		label is text;
	[end]

	[Paint]
		u32 face: Widgets.BUTTON;
		if down
			face is Widgets.BUTTON_DOWN;
		;;
		call Draw.FillRect: x y w h face;
		call Draw.Rect: x y w h Widgets.EDGE;
		call Draw.Centered: x y + (h - 16) / 2 w label Widgets.TEXT;
	[end]

	[Mouse: GuiEvent e;]
		bln on: (Widgets.Inside: e.x e.y x y w h);
		bln clicked: false;
		if e.clicks > 0
			down is on;
		;;
		elif down and (e.value & 1) is 0
			clicked is on;
			down is false;
		;;
	[end: clicked]
}

# a box to tick: Mouse gives true when a click changed it
struct.CheckBox
{
	int x;
	int y;
	str label: [31];
	bln on;

	[Place: int cx: 0; int cy: 0; ptr<u8> text: 0;]
		x is cx;
		y is cy;
		label is text;
	[end]

	[Paint]
		call Draw.FillRect: x y + 1 14 14 Widgets.FIELD;
		call Draw.Rect: x y + 1 14 14 Widgets.EDGE;
		if on
			call Draw.Line: x + 3 y + 8 x + 6 y + 11 Widgets.ACCENT;
			call Draw.Line: x + 6 y + 11 x + 11 y + 4 Widgets.ACCENT;
			call Draw.Line: x + 3 y + 7 x + 6 y + 10 Widgets.ACCENT;
			call Draw.Line: x + 6 y + 10 x + 11 y + 3 Widgets.ACCENT;
		;;
		call Draw.Text: x + 20 y label Widgets.TEXT;
	[end]

	[Mouse: GuiEvent e;]
		int wide: 20 + 8 * (Text.Length: label);
		if e.clicks > 0 and (Widgets.Inside: e.x e.y x y wide 16)
			on is (on is false);
			return true;
		;;
	[end: false]
}

# a line of text to type into, with a caret that moves (arrows, Home, End) and keys that
# take characters back (Backspace, Delete). Shift with those keys, Ctrl+A, a drag or a
# double click selects text, and typing replaces what's selected.
struct.TextField
{
	int x;
	int y;
	int w;
	str text: [127];
	int len;
	int cursor;                 # where the next character goes, 0 to len
	int anchor;                 # the other end of the selection: the same as cursor when none is
	int most;                   # how many characters it takes (at most 127)
	bln focused;                # it gets the keys
	bln secret;                 # shown as dots: a password
	bln dragging;               # the left button went down on it and is still held

	[Place: int fx: 0; int fy: 0; int fw: 0;]
		x is fx;
		y is fy;
		w is fw;
		most is 127;
	[end]

	[Set: ptr<u8> value: 0;]
		len is (Text.Copy: text value sizeof text);
		cursor is len;
		anchor is len;
	[end]

	# select all the text, so typing replaces it
	[SelectAll]
		anchor is 0;
		cursor is len;
	[end]

	# where the selection starts and ends (the same when nothing is selected)
	[SelectionStart]
	[end: (Math.Min: anchor cursor)]

	[SelectionEnd]
	[end: (Math.Max: anchor cursor)]

	# the selected text into buffer (size bytes, with the zero), for a clipboard; its length
	[CopySelection: ptr<u8> buffer: 0; int size: 0;]
		int from: (SelectionStart);
		int n: (Math.Min: (SelectionEnd) - from size - 1);
		while int i: 0; i < n; i++;
			buffer:i is text:(from + i);
		;;
		buffer:n is 0;
	[end: n]

	# a key: 0 if it wasn't for the field, 1 if it changed the text, the caret or the
	# selection, 2 for Enter, 3 for Esc
	[Key: int key: 0;]
		int k: key & Events.KEY_MASK;
		bln shift: (key & Events.MOD_SHIFT) is not 0;
		if (key & Events.MOD_CTRL) is not 0 and (k is 'a' or k is 'A')
			call SelectAll;
			return 1;
		;;
		when k
			is Events.KEY_ENTER
				return 2;
			;;
			is Events.KEY_ESCAPE
				return 3;
			;;
			is Events.KEY_LEFT
				if anchor is not cursor and shift is false
					call MoveTo: (SelectionStart) false;
				;;
				else
					call MoveTo: cursor - 1 shift;
				;;
				return 1;
			;;
			is Events.KEY_RIGHT
				if anchor is not cursor and shift is false
					call MoveTo: (SelectionEnd) false;
				;;
				else
					call MoveTo: cursor + 1 shift;
				;;
				return 1;
			;;
			is Events.KEY_HOME
				call MoveTo: 0 shift;
				return 1;
			;;
			is Events.KEY_END
				call MoveTo: len shift;
				return 1;
			;;
			is Events.KEY_BACKSPACE
				if (DeleteSelection) is false and cursor > 0
					cursor--;
					call Remove: cursor;
				;;
				anchor is cursor;
				return 1;
			;;
			is Events.KEY_DELETE
				if (DeleteSelection) is false and cursor < len
					call Remove: cursor;
				;;
				anchor is cursor;
				return 1;
			;;
		;;
		if (key & (Events.MOD_CTRL | Events.MOD_ALT)) is not 0 return 0;
		if k >= 32 and k < 127
			call DeleteSelection;
			if len >= most or len >= 127 return 1;
			int i: len;
			while i > cursor
				text:i is text:(i - 1);
				i--;
			;;
			text:cursor is k;
			len++;
			cursor++;
			anchor is cursor;
			text:len is 0;
			return 1;
		;;
	[end: 0]

	# the caret to pos (kept inside the text); extend keeps the selection's other end
	[MoveTo: int pos: 0; bln extend: false;]
		cursor is (Math.Clamp: pos 0 len);
		if extend is false
			anchor is cursor;
		;;
	[end]

	# the character at pos taken out
	[Remove: int pos: 0;]
		while int i: pos; i < len; i++;
			text:i is text:(i + 1);
		;;
		len--;
	[end]

	# the selected text taken out; false when nothing was selected
	[DeleteSelection]
		int from: (SelectionStart);
		int gone: (SelectionEnd) - from;
		if gone is 0 return false;
		while int i: from; i + gone <= len; i++;
			text:i is text:(i + gone);
		;;
		len-- gone;
		cursor is from;
		anchor is from;
	[end: true]

	# a click on it gives it the keys and puts the caret there (a double click selects
	# everything, and moving with the button held selects up to the mouse); a click
	# elsewhere takes the keys away; true when that changed anything
	[Mouse: GuiEvent e;]
		if e.clicks is 0
			if dragging and (e.value & 1) is not 0
				int to: (Spot: e.x);
				if to is cursor return false;
				cursor is to;
				return true;
			;;
			dragging is false;
			return false;
		;;
		bln on: (Widgets.Inside: e.x e.y x y w 24);
		bln was: focused;
		focused is on;
		dragging is on;
		if on
			call MoveTo: (Spot: e.x) false;
			if e.clicks is 2
				call SelectAll;
			;;
			return true;
		;;
	[end: was]

	# the place in the text nearest to the mouse at px
	[Spot: int px: 0;]
	[end: (Math.Clamp: (px - x - 6 + 4) / 8 + (First) 0 len)]

	# the first character shown: the caret always stays in sight
	[First]
		int room: (w - 14) / 8;
		int first: 0;
		if cursor > room
			first is cursor - room;
		;;
	[end: first]

	[Paint]
		u32 edge: Widgets.EDGE;
		if focused
			edge is Widgets.ACCENT;
		;;
		call Draw.FillRect: x y w 24 Widgets.FIELD;
		call Draw.Rect: x y w 24 edge;
		call Draw.PushClip: x + 4 y w - 8 24;
		int first: (First);
		int from: (Math.Max: (SelectionStart) first);
		int to: (SelectionEnd);
		if to > from
			call Draw.FillRect: x + 6 + (from - first) * 8 y + 4 (to - from) * 8 16 Widgets.SELECT;
		;;
		int cx: x + 6;
		if secret
			while int i: first; i < len; i++;
				call Draw.FillCircle: cx + 3 y + 12 3 Widgets.TEXT;
				cx++ 8;
			;;
		;;
		else
			call Draw.TextN: cx y + 4 addr text:first len - first Widgets.TEXT;
		;;
		call Caret: x + 6 + (cursor - first) * 8;
		call Draw.PopClip;
	[end]

	[Caret: int cx: 0;]
		if focused
			call Draw.FillRect: cx y + 4 2 16 Widgets.ACCENT;
		;;
	[end]
}

# Tab and Shift+Tab move the keys from one text field to the next, in the order they
# were added; the field that gets them has its text selected, so typing replaces it.
#
#   FocusChain tabs;
#   call tabs.Add: addr name;
#   call tabs.Add: addr password;
#   int done: (tabs.Key: App.event.value);    # Tab moves on; other keys go to the field
#   call tabs.Mouse: App.event;               # a click picks the field
struct.FocusChain
{
	ptr<TextField> fields[16];
	int count;

	[Add: ptr<TextField> field: 0;]
		if count < 16
			fields:count is field;
			count++;
		;;
	[end]

	# the field that has the keys, or -1
	[Current]
		while int i: 0; i < count; i++;
			ptr<TextField> f: fields:i;
			if f:0.focused return i;
		;;
	[end: -1]

	# give field n the keys, with its text selected
	[Focus: int n: 0;]
		while int i: 0; i < count; i++;
			ptr<TextField> f: fields:i;
			f:0.focused is (i is n);
			f:0.dragging is false;
			if i is n
				f:0.anchor is 0;
				f:0.cursor is f:0.len;
			;;
		;;
	[end]

	# a key: Tab and Shift+Tab move to the next or the one before (1); other keys go to
	# the field with the keys, and this gives what its Key gives (0 if none has them)
	[Key: int key: 0;]
		if count is 0 return 0;
		int now: (Current);
		if (key & Events.KEY_MASK) is Events.KEY_TAB
			int to: now + 1;
			if (key & Events.MOD_SHIFT) is not 0
				to is now - 1;
				if now < 0
					to is count - 1;
				;;
			;;
			call Focus: (to + count) % count;
			return 1;
		;;
		if now < 0 return 0;
		ptr<TextField> f: fields:now;
	[end: (f:0.Key: key)]

	# a mouse event, to every field (a click gives the keys to the one it's on); true
	# when that changed any of them
	[Mouse: GuiEvent e;]
		bln changed: false;
		while int i: 0; i < count; i++;
			ptr<TextField> f: fields:i;
			if (f:0.Mouse: e)
				changed is true;
			;;
		;;
	[end: changed]

	[Paint]
		while int i: 0; i < count; i++;
			ptr<TextField> f: fields:i;
			call f:0.Paint;
		;;
	[end]
}

# a list to pick from, with a scroll bar when it doesn't all fit: the wheel and the
# arrow keys move through it
struct.ListBox
{
	int x;
	int y;
	int w;
	int h;
	ptr<ptr<u8>> items;         # the text of each row (a str array, say)
	int count;
	int selected;               # -1: none
	int first;                  # the row at the top

	[Place: int lx: 0; int ly: 0; int lw: 0; int lh: 0;]
		x is lx;
		y is ly;
		w is lw;
		h is lh;
		selected is -1;
	[end]

	[SetItems: ptr<ptr<u8>> list: 0; int n: 0;]
		items is list;
		count is n;
		selected is (Math.Min: selected n - 1);
		first is (Math.Clamp: first 0 (Math.Max: n - (Rows) 0));
	[end]

	# the rows of a str array (one filled as it goes, say); call it again after adding to it
	[SetList: str list[];]
		call SetItems: list list.len;
	[end]

	[Rows]
	[end: (Math.Max: h / Widgets.ROW 1)]

	# a mouse event: 0 if nothing changed, 1 if it picked a row or scrolled, 2 when a row
	# was double-clicked
	[Mouse: GuiEvent e;]
		if (Widgets.Inside: e.x e.y x y w h) is false return 0;
		int rows: (Rows);
		if e.wheel is not 0
			first is (Math.Clamp: first + e.wheel * 3 0 (Math.Max: count - rows 0));
			return 1;
		;;
		if e.clicks is 0 return 0;
		if count > rows and e.x >= x + w - Widgets.BAR
			# the scroll bar: a page up or down
			if e.y < y + h / 2
				first is (Math.Max: first - rows 0);
			;;
			else
				first is (Math.Min: first + rows count - rows);
			;;
			return 1;
		;;
		int row: first + (e.y - y) / Widgets.ROW;
		if row >= count return 0;
		selected is row;
		if e.clicks is 2 return 2;
	[end: 1]

	# Up, Down, Page Up, Page Down, Home and End move the selection; 2 for Enter
	[Key: int key: 0;]
		int k: key & Events.KEY_MASK;
		if count is 0 return 0;
		int rows: (Rows);
		int to: selected;
		when k
			is Events.KEY_UP
				to--;
			;;
			is Events.KEY_DOWN
				to++;
			;;
			is Events.KEY_PAGEUP
				to-- rows;
			;;
			is Events.KEY_PAGEDOWN
				to++ rows;
			;;
			is Events.KEY_HOME
				to is 0;
			;;
			is Events.KEY_END
				to is count - 1;
			;;
			is Events.KEY_ENTER
				return 2;
			;;
			else
				return 0;
			;;
		;;
		selected is (Math.Clamp: to 0 count - 1);
		if selected < first
			first is selected;
		;;
		if selected >= first + rows
			first is selected - rows + 1;
		;;
	[end: 1]

	[Paint]
		call Draw.FillRect: x y w h Widgets.FIELD;
		call Draw.PushClip: x y w h;
		int rows: (Rows);
		int text_w: w - 8;
		if count > rows
			text_w is w - Widgets.BAR - 8;
		;;
		while int r: 0; r <= rows and first + r < count; r++;
			int i: first + r;
			int ry: y + r * Widgets.ROW;
			if i is selected
				call Draw.FillRect: x ry w Widgets.ROW Widgets.SELECT;
			;;
			call Draw.TextFitted: x + 4 ry + 1 text_w items:i Widgets.TEXT;
		;;
		if count > rows
			# the thumb's size and place show how much is in sight, and where
			int bx: x + w - Widgets.BAR;
			call Draw.FillRect: bx y Widgets.BAR h Widgets.BUTTON;
			int thumb: (Math.Max: h * rows / count 12);
			int ty: y + (h - thumb) * first / (Math.Max: count - rows 1);
			call Draw.FillRect: bx + 1 ty Widgets.BAR - 2 thumb Widgets.EDGE;
		;;
		call Draw.PopClip;
		call Draw.Rect: x y w h Widgets.EDGE;
	[end]
}

# many lines of text to type into and scroll through: the caret moves by character, line and
# page, Shift with those keys, Ctrl+A, a drag or a double click selects, typing replaces what's
# selected, and the wheel scrolls. It grows as it's typed into, up to most bytes, and doesn't
# wrap: a long line scrolls sideways as the caret goes along it. Lines end with a \n.
#
#   TextArea notes;
#   call notes.Place: 10 10 300 200;
#   call notes.Set: 'first line\nsecond line';
#   int done: (notes.Key: App.event.value);    # 3 for Esc (Enter is a new line here)
#   call notes.Mouse: App.event;
#   call notes.Paint;
#   log notes.text;                            # all of it, with a zero after it
#   call notes.Insert: 'pasted' 6;             # in place of what's selected
#   int n: (notes.CopySelection: buffer 1024); # the selected text, for a clipboard
#   call notes.Free;                           # its text goes back to the heap
struct.TextArea
{
	int x;
	int y;
	int w;
	int h;
	ptr<u8> text;               # all of it, with a zero after it
	int len;
	int room;                   # the bytes text has
	int most;                   # how many characters it takes (1 MB unless it's changed)
	int cursor;                 # where the next character goes, 0 to len
	int anchor;                 # the other end of the selection: the same as cursor when none is
	int top;                    # the first line shown
	int left;                   # how many characters of each line are off to the left
	int column;                 # where Up and Down aim for, as lines are shorter or longer
	bln focused;                # it gets the keys
	bln dragging;               # the left button went down on it and is still held

	[Place: int ax: 0; int ay: 0; int aw: 0; int ah: 0;]
		x is ax;
		y is ay;
		w is aw;
		h is ah;
		most is 1048576;
		call Reserve: 0;
	[end]

	# everything in it replaced
	[Set: ptr<u8> value: 0;]
		len is 0;
		cursor is 0;
		anchor is 0;
		top is 0;
		left is 0;
		column is 0;
		call Reserve: 0;
		text:0 is 0;
		call Insert: value (Text.Length: value);
		call MoveTo: 0 false;
	[end]

	# its text goes back to the heap
	[Free]
		if text is not 0
			free text;
		;;
		text is 0;
		room is 0;
		len is 0;
		cursor is 0;
		anchor is 0;
	[end]

	[SelectAll]
		anchor is 0;
		cursor is len;
	[end]

	[SelectionStart]
	[end: (Math.Min: anchor cursor)]

	[SelectionEnd]
	[end: (Math.Max: anchor cursor)]

	# the selected text into buffer (size bytes, with the zero), for a clipboard; its length
	[CopySelection: ptr<u8> buffer: 0; int size: 0;]
		int from: (SelectionStart);
		int n: (Math.Min: (SelectionEnd) - from size - 1);
		while int i: 0; i < n; i++;
			buffer:i is text:(from + i);
		;;
		buffer:n is 0;
	[end: n]

	# count characters of value in place of what's selected, as many as most leaves room for
	[Insert: ptr<u8> value: 0; int count: 0;]
		call DeleteSelection;
		int n: (Math.Min: count most - len);
		if n <= 0 return;
		call Reserve: len + n;
		int i: len;
		while i > cursor
			i--;
			text:(i + n) is text:i;
		;;
		while int k: 0; k < n; k++;
			text:(cursor + k) is value:k;
		;;
		len++ n;
		text:len is 0;
		cursor++ n;
		anchor is cursor;
		call Settled;
	[end]

	# a key: 0 if it wasn't for it, 1 if it changed the text, the caret or the selection, 3 for Esc
	[Key: int key: 0;]
		int k: key & Events.KEY_MASK;
		bln shift: (key & Events.MOD_SHIFT) is not 0;
		bln ctrl: (key & Events.MOD_CTRL) is not 0;
		if ctrl and (k is 'a' or k is 'A')
			call SelectAll;
			return 1;
		;;
		when k
			is Events.KEY_ESCAPE
				return 3;
			;;
			is Events.KEY_ENTER
				u8 line: 10;
				call Insert: addr line 1;
				return 1;
			;;
			is Events.KEY_TAB
				# spaces to the next multiple of 4, as the font has no tab
				u8 spaces[4];
				int fill: 4 - (cursor - (LineStart: cursor)) % 4;
				while int i: 0; i < fill; i++;
					spaces:i is ' ';
				;;
				call Insert: addr spaces fill;
				return 1;
			;;
			is Events.KEY_LEFT
				if anchor is not cursor and shift is false
					call MoveTo: (SelectionStart) false;
				;;
				else
					call MoveTo: cursor - 1 shift;
				;;
				return 1;
			;;
			is Events.KEY_RIGHT
				if anchor is not cursor and shift is false
					call MoveTo: (SelectionEnd) false;
				;;
				else
					call MoveTo: cursor + 1 shift;
				;;
				return 1;
			;;
			is Events.KEY_UP
				call MoveLines: (-1) shift;
				return 1;
			;;
			is Events.KEY_DOWN
				call MoveLines: 1 shift;
				return 1;
			;;
			is Events.KEY_PAGEUP
				call MoveLines: 0 - (Rows) shift;
				return 1;
			;;
			is Events.KEY_PAGEDOWN
				call MoveLines: (Rows) shift;
				return 1;
			;;
			is Events.KEY_HOME
				if ctrl
					call MoveTo: 0 shift;
				;;
				else
					call MoveTo: (LineStart: cursor) shift;
				;;
				return 1;
			;;
			is Events.KEY_END
				if ctrl
					call MoveTo: len shift;
				;;
				else
					call MoveTo: (LineEnd: cursor) shift;
				;;
				return 1;
			;;
			is Events.KEY_BACKSPACE
				if (DeleteSelection) is false and cursor > 0
					cursor--;
					call Remove: cursor;
				;;
				anchor is cursor;
				call Settled;
				return 1;
			;;
			is Events.KEY_DELETE
				if (DeleteSelection) is false and cursor < len
					call Remove: cursor;
				;;
				anchor is cursor;
				call Settled;
				return 1;
			;;
		;;
		if (key & (Events.MOD_CTRL | Events.MOD_ALT)) is not 0 return 0;
		if k >= 32 and k < 127
			u8 typed: k as u8;
			call Insert: addr typed 1;
			return 1;
		;;
	[end: 0]

	# a click on it gives it the keys and puts the caret there (a double click selects the word,
	# and moving with the button held selects up to the mouse); a click elsewhere takes the keys
	# away; the wheel scrolls it when it's over it; true when that changed anything
	[Mouse: GuiEvent e;]
		bln on: (Widgets.Inside: e.x e.y x y w h);
		if e.wheel is not 0
			if on is false return false;
			int was_top: top;
			top is (Math.Clamp: top + e.wheel * 3 0 (Math.Max: (Lines) - (Rows) 0));
			return top is not was_top;
		;;
		if e.clicks is 0
			if dragging and (e.value & 1) is not 0
				int to: (Spot: e.x e.y);
				if to is cursor return false;
				cursor is to;
				call Settled;
				return true;
			;;
			dragging is false;
			return false;
		;;
		bln was: focused;
		focused is on;
		dragging is on;
		if on
			call MoveTo: (Spot: e.x e.y) false;
			if e.clicks is 2
				call SelectWord;
			;;
			return true;
		;;
	[end: was]

	[Paint]
		u32 edge: Widgets.EDGE;
		if focused
			edge is Widgets.ACCENT;
		;;
		call Draw.FillRect: x y w h Widgets.FIELD;
		call Draw.Rect: x y w h edge;
		call Draw.PushClip: x + 4 y + 2 w - 8 - Widgets.BAR h - 4;
		int rows: (Rows);
		int start: (StartOfLine: top);
		int from: (SelectionStart);
		int to: (SelectionEnd);
		int caret_line: (LineOf: cursor);
		while int row: 0; row <= rows and start <= len; row++;
			int stop: (LineEnd: start);
			int py: y + 4 + row * 16;
			# what's selected on this line, and the end of the line if the selection goes on past it
			int a: (Math.Max: from start);
			int b: (Math.Min: to stop);
			if b > a or (to > stop and from <= stop)
				int wide: b - a;
				if to > stop
					wide++;
				;;
				call Draw.FillRect: x + 6 + (a - start - left) * 8 py wide * 8 16 Widgets.SELECT;
			;;
			if stop - start > left
				call Draw.TextN: x + 6 py text + start + left stop - start - left Widgets.TEXT;
			;;
			if focused and top + row is caret_line
				call Draw.FillRect: x + 6 + (cursor - start - left) * 8 py 2 16 Widgets.ACCENT;
			;;
			start is stop + 1;
		;;
		call Draw.PopClip;
		# the scroll bar, when it doesn't all fit
		int lines: (Lines);
		if lines > rows
			int track: h - 4;
			int thumb: (Math.Max: track * rows / lines 8);
			int place: (track - thumb) * top / (Math.Max: lines - rows 1);
			call Draw.FillRect: x + w - Widgets.BAR - 1 y + 2 + place Widgets.BAR thumb Widgets.EDGE;
		;;
	[end]

	# ---- how it's laid out

	# how many whole lines fit
	[Rows]
	[end: (Math.Max: (h - 8) / 16 1)]

	# how many characters fit across
	[Columns]
	[end: (Math.Max: (w - 12 - Widgets.BAR) / 8 1)]

	# how many lines there are: one more than the \n in it
	[Lines]
	[end: (LineOf: len) + 1]

	# which line pos is on, from 0
	[LineOf: int pos: 0;]
		int line: 0;
		while int i: 0; i < pos; i++;
			if text:i is 10
				line++;
			;;
		;;
	[end: line]

	# where a line starts (the end of the text past the last line)
	[StartOfLine: int line: 0;]
		int i: 0;
		while line > 0 and i < len
			if text:i is 10
				line--;
			;;
			i++;
		;;
	[end: i]

	[LineStart: int pos: 0;]
		while pos > 0 and text:(pos - 1) is not 10
			pos--;
		;;
	[end: pos]

	[LineEnd: int pos: 0;]
		while pos < len and text:pos is not 10
			pos++;
		;;
	[end: pos]

	# the place in the text nearest to the mouse
	[Spot: int px: 0; int py: 0;]
		int line: (Math.Clamp: top + (py - y - 4) / 16 0 (Lines) - 1);
		int start: (StartOfLine: line);
		int along: (Math.Max: (px - x - 6 + 4) / 8 + left 0);
	[end: (Math.Min: start + along (LineEnd: start))]

	# ---- changing it

	# there's room for wanted characters and a zero (it doubles, so typing isn't slow)
	[Reserve: int wanted: 0;]
		if wanted + 1 <= room return;
		int bigger: (Math.Max: room * 2 256);
		while bigger < wanted + 1
			bigger is bigger * 2;
		;;
		ptr<u8> grown: new u8[bigger];
		while int i: 0; i < len; i++;
			grown:i is text:i;
		;;
		grown:len is 0;
		if text is not 0
			free text;
		;;
		text is grown;
		room is bigger;
	[end]

	# the caret to pos (kept inside the text); extend keeps the selection's other end
	[MoveTo: int pos: 0; bln extend: false;]
		cursor is (Math.Clamp: pos 0 len);
		if extend is false
			anchor is cursor;
		;;
		call Settled;
	[end]

	# the caret by count lines (up if it's negative), aiming for the column it was last moved to
	[MoveLines: int count: 0; bln extend: false;]
		int line: (Math.Clamp: (LineOf: cursor) + count 0 (Lines) - 1);
		int start: (StartOfLine: line);
		cursor is (Math.Min: start + column (LineEnd: start));
		if extend is false
			anchor is cursor;
		;;
		call InSight;
	[end]

	# the word the caret is on, selected: letters, digits and _, or else the one character
	[SelectWord]
		int from: cursor;
		int to: cursor;
		while from > 0 and (Widgets.WordCharacter: text:(from - 1))
			from--;
		;;
		while to < len and (Widgets.WordCharacter: text:to)
			to++;
		;;
		if from is to and to < len
			to++;
		;;
		anchor is from;
		cursor is to;
		call Settled;
	[end]

	# the character at pos taken out
	[Remove: int pos: 0;]
		while int i: pos; i < len; i++;
			text:i is text:(i + 1);
		;;
		len--;
	[end]

	# the selected text taken out; false when nothing was selected
	[DeleteSelection]
		int from: (SelectionStart);
		int gone: (SelectionEnd) - from;
		if gone is 0 return false;
		while int i: from; i + gone <= len; i++;
			text:i is text:(i + gone);
		;;
		len-- gone;
		cursor is from;
		anchor is from;
		call Settled;
	[end: true]

	# the caret has moved along: Up and Down aim for here from now on
	[Settled]
		column is cursor - (LineStart: cursor);
		call InSight;
	[end]

	# the caret kept in sight
	[InSight]
		int line: (LineOf: cursor);
		int rows: (Rows);
		if line < top
			top is line;
		;;
		elif line >= top + rows
			top is line - rows + 1;
		;;
		int along: cursor - (LineStart: cursor);
		int columns: (Columns);
		if along < left
			left is along;
		;;
		elif along >= left + columns
			left is along - columns + 1;
		;;
	[end]
}

phi.Widgets:Library
{
	# the colors
	const u32 TEXT: 0x1D2330;
	const u32 TEXT_DIM: 0x6B7385;
	const u32 FACE: 0xF2F4F8;   # a window's inside
	const u32 FIELD: 0xFFFFFF;
	const u32 EDGE: 0xB4BAC6;
	const u32 BUTTON: 0xE3E7EE;
	const u32 BUTTON_DOWN: 0xBFC8D8;
	const u32 ACCENT: 0x2F6FE4;
	const u32 SELECT: 0xCFE0FF;

	const int ROW: 18;          # a list's rows
	const int BAR: 10;          # a scroll bar's width

	# is (px, py) inside the w x h rectangle at (x, y)
	[Inside: int px: 0; int py: 0; int x: 0; int y: 0; int w: 0; int h: 0;]
	[end: px >= x and py >= y and px < x + w and py < y + h]

	# a letter, a digit or _: part of a word, for a double click
	[WordCharacter: u8 c: 0;]
	[end: (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c is '_']

	# text in the dimmer color, for labels next to fields
	[Label: int x: 0; int y: 0; ptr<u8> text: 0;]
		call Draw.Text: x y text TEXT_DIM;
	[end]
}
