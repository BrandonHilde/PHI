# A window for a user program: draw with gfx.draw, show it, and take events. The
# kernel puts it on the screen (gui.surfaces).
#
#   use gui.app;
#   phi.Hello:Program
#   {
#       if (App.Open: 200 100) is false
#           exit 1;
#       ;;
#       call Draw.Clear: Draw.WHITE;
#       call Draw.Text: 10 10 'Hello' Draw.BLACK;
#       call App.Present;
#       while true
#           call App.WaitEvent;
#           if App.event.kind is Events.CLOSE
#               exit 0;
#           ;;
#           if App.event.kind is Events.KEY ...      # App.event.value is the key
#           if App.event.kind is Events.MOUSE ...    # .x .y .value (buttons) .clicks .wheel
#           if App.event.kind is Events.RESIZE       # .x by .y: call App.Resize, then draw again
#       ;;
#   }
#
# Open makes the program's pixels (on its heap), points Draw at them and copies the
# kernel's font, so Draw's text works. Nothing shows until Present. A crash ends only
# this program: the kernel and the other windows carry on.
#
#   call App.SetTitle: 'Notes - TODO.TXT';             # what the window is called
#   int pid: (App.OpenWindow: 'VIEWER.BIN' 'TODO.TXT'); # another program, in its own window
#   if (App.Focused) ...                                # is this window in front?
#   call App.SetResizable: false;                       # it can't redraw at another size

use gfx.draw;
use gui.events;

phi.App:Program
{
	ptr<u32> pixels: 0;
	int width: 0;
	int height: 0;
	GuiEvent event;             # the event NextEvent or WaitEvent took

	# a window of w x h pixels, drawn on with Draw; false if the kernel can't make one
	[Open: int w: 0; int h: 0;]
		if (OS.SurfaceOpen: w h) is 0 return false;
		if pixels is not 0
			free pixels;
		;;
		pixels is new u32[w * h];
		if pixels is 0 return false;
		width is w;
		height is h;
		if (OS.CopyFont: addr Font.glyphs) is 1
			Font.loaded is true;
		;;
		call Draw.Target: pixels w h;
	[end: true]

	# a new size (after Events.RESIZE: App.event.x by App.event.y); what was drawn is
	# gone, so draw again; false if the kernel can't make one that size
	[Resize: int w: 0; int h: 0;]
	[end: (Open: w h)]

	# show what's been drawn
	[Present]
		call OS.SurfacePresent: pixels;
	[end]

	# the next event into App.event; false when there's none yet
	[NextEvent]
	[end: (OS.NextEvent: addr event) is 1]

	# name the window (the window manager cuts it to fit its title bar)
	[SetTitle: ptr<u8> title: 0;]
		call OS.SetWindowTitle: title;
	[end]

	# start the program at path from the disk, with a command line, in a window of its
	# own; its process number, or -1 if it couldn't start
	[OpenWindow: ptr<u8> path: 0; ptr<u8> arguments: 0;]
	[end: (OS.OpenWindow: path arguments)]

	# whether the window can be resized (it can, unless this says otherwise): a program
	# that doesn't handle Events.RESIZE says false, and the window manager keeps its size
	[SetResizable: bln yes: true;]
		call OS.SetResizable: yes;
	[end]

	# is this program's window in front (getting the keys)?
	[Focused]
	[end: (OS.WindowFocused) is 1]

	# wait for the next event, sleeping a little between looks
	[WaitEvent]
		while (NextEvent) is false
			call OS.Sleep: 10;
		;;
	[end]
}
