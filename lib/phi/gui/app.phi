# A window for a user program: draw with gfx.draw, show it, and take events. The
# kernel puts it on the screen (gui.surfaces).
#
#   use gui.app;
#   phi.Hello:Program
#   {
#       if (App.Open: 200 100) is false
#           exit 1;
#       ;;
#       call Draw.Clear: Draw.WHITE;
#       call Draw.Text: 10 10 'Hello' Draw.BLACK;
#       call App.Present;
#       while true
#           call App.WaitEvent;
#           if App.event.kind is Events.CLOSE
#               exit 0;
#           ;;
#           if App.event.kind is Events.KEY ...      # App.event.value is the key
#           if App.event.kind is Events.MOUSE ...    # .x .y .value (buttons) .clicks .wheel
#           if App.event.kind is Events.RESIZE       # .x by .y: call App.Resize, then draw again
#       ;;
#   }
#
# Open makes the program's pixels (on its heap), points Draw at them and copies the
# kernel's font, so Draw's text works. Nothing shows until Present. A crash ends only
# this program: the kernel and the other windows carry on.
#
#   call App.SetTitle: 'Notes - TODO.TXT';             # what the window is called
#   int pid: (App.OpenWindow: 'VIEWER.BIN' 'TODO.TXT'); # another program, in its own window
#   if (App.Focused) ...                                # is this window in front?
#   call App.SetResizable: false;                       # it can't redraw at another size
#
# A program can open more windows, each with a number of its own; App's window is 0. An event says
# which it's for (App.event.window), and Draw draws on whichever Windows.Use last said:
#
#   int tools: (Windows.Open: 200 300);                 # another window; -1 if it can't
#   call Windows.SetTitle: tools 'Tools';
#   call Windows.Use: tools;
#   call Draw.Clear: Draw.WHITE;
#   call Windows.Present: tools;
#   call Windows.Use: 0;                                # and back to App's
#   if App.event.kind is Events.CLOSE and App.event.window is tools
#       call Windows.Close: tools;                      # only that one goes
#   ;;
#   if App.event.kind is Events.RESIZE
#       call Windows.Resize: App.event.window App.event.x App.event.y;
#   ;;

use gfx.draw;
use gui.events;

phi.App:Program
{
	ptr<u32> pixels: 0;
	int width: 0;
	int height: 0;
	GuiEvent event;             # the event NextEvent or WaitEvent took
	GuiEvent back_events[8];    # what's been put back, for NextEvent to give again (see PutBack)
	int back_count: 0;

	# a window of w x h pixels, drawn on with Draw; false if the kernel can't make one
	[Open: int w: 0; int h: 0;]
		if (OS.SurfaceOpen: w h) is 0 return false;
		if pixels is not 0
			free pixels;
		;;
		pixels is new u32[w * h];
		if pixels is 0 return false;
		width is w;
		height is h;
		if (OS.CopyFont: addr Font.glyphs) is 1
			Font.loaded is true;
		;;
		call Draw.Target: pixels w h;
	[end: true]

	# a new size (after Events.RESIZE: App.event.x by App.event.y); what was drawn is
	# gone, so draw again; false if the kernel can't make one that size
	[Resize: int w: 0; int h: 0;]
	[end: (Open: w h)]

	# show what's been drawn
	[Present]
		call OS.SurfacePresent: pixels;
	[end]

	# the next event into App.event; false when there's none yet
	[NextEvent]
		if back_count > 0
			back_count--;
			event is back_events:back_count;
			return true;
		;;
	[end: (OS.NextEvent: addr event) is 1]

	# an event for NextEvent to give next, for something that waits for events of its own (a
	# dialog) to leave one for the program's loop. The last one put back comes first; one of
	# each kind is kept for each window.
	[PutBack: GuiEvent back;]
		int same: -1;
		while int i: 0; i < back_count; i++;
			if back_events:i.kind is back.kind and back_events:i.window is back.window
				same is i;
			;;
		;;
		if same >= 0
			back_events:same is back;
			return;
		;;
		if back_count >= 8 return;
		back_events:back_count is back;
		back_count++;
	[end]

	# name the window (the window manager cuts it to fit its title bar)
	[SetTitle: ptr<u8> title: 0;]
		call OS.SetWindowTitle: title;
	[end]

	# start the program at path from the disk, with a command line, in a window of its
	# own; its process number, or -1 if it couldn't start
	[OpenWindow: ptr<u8> path: 0; ptr<u8> arguments: 0;]
	[end: (OS.OpenWindow: path arguments)]

	# whether the window can be resized (it can, unless this says otherwise): a program
	# that doesn't handle Events.RESIZE says false, and the window manager keeps its size
	[SetResizable: bln yes: true;]
		call OS.SetResizable: yes;
	[end]

	# is this program's window in front (getting the keys)?
	[Focused]
	[end: (OS.WindowFocused) is 1]

	# wait for the next event, sleeping a little between looks
	[WaitEvent]
		while (NextEvent) is false
			call OS.Sleep: 10;
		;;
	[end]
}

# a program's windows by number, 0 being App's: the calls for one say which, and the system's own
# are left acting on App's, so App's calls never need to know about these
phi.Windows:Program
{
	const int MOST: 8;

	ptr<u32> pixels[8];
	int widths[8];
	int heights[8];

	# another window of w x h pixels: its number, or -1 if there's no making one
	[Open: int w: 0; int h: 0;]
		int n: (OS.WindowNew);
		if n < 0 return -1;
		if n >= MOST or not (Make: n w h)
			int closed: (OS.WindowClose: n);
			return -1;
		;;
	[end: n]

	# Draw draws on this window from now on
	[Use: int n: 0;]
		if n is 0
			call Draw.Target: App.pixels App.width App.height;
			return;
		;;
		if not (Valid: n) return;
		call Draw.Target: pixels:n widths:n heights:n;
	[end]

	# show what's been drawn on it
	[Present: int n: 0;]
		if n is 0
			call App.Present;
			return;
		;;
		if not (Valid: n) return;
		int selected: (OS.WindowSelect: n);
		call OS.SurfacePresent: pixels:n;
		selected is (OS.WindowSelect: 0);
	[end]

	# a new size (after Events.RESIZE for it): what was drawn is gone, so draw again, and Use it
	# again if it was the one being drawn on; false if there's no making it that size
	[Resize: int n: 0; int w: 0; int h: 0;]
		if n is 0 return (App.Resize: w h);
		if not (Valid: n) return false;
	[end: (Make: n w h)]

	[Width: int n: 0;]
		if n is 0 return App.width;
		if not (Valid: n) return 0;
	[end: widths:n]

	[Height: int n: 0;]
		if n is 0 return App.height;
		if not (Valid: n) return 0;
	[end: heights:n]

	[SetTitle: int n: 0; ptr<u8> title: 0;]
		if n is 0
			call App.SetTitle: title;
			return;
		;;
		if not (Valid: n) return;
		int selected: (OS.WindowSelect: n);
		call OS.SetWindowTitle: title;
		selected is (OS.WindowSelect: 0);
	[end]

	[SetResizable: int n: 0; bln yes: true;]
		if n is 0
			call App.SetResizable: yes;
			return;
		;;
		if not (Valid: n) return;
		int selected: (OS.WindowSelect: n);
		call OS.SetResizable: yes;
		selected is (OS.WindowSelect: 0);
	[end]

	# is it in front, getting the keys?
	[Focused: int n: 0;]
		if n is 0 return (App.Focused);
		if not (Valid: n) return false;
		int selected: (OS.WindowSelect: n);
		bln focused: (OS.WindowFocused) is 1;
		selected is (OS.WindowSelect: 0);
	[end: focused]

	# it's gone, and App's is drawn on if it was being; false if there's no such window (App's
	# goes when the program ends)
	[Close: int n: 0;]
		if n is 0 or not (Valid: n) return false;
		if Draw.pixels is pixels:n
			call Use: 0;
		;;
		int closed: (OS.WindowClose: n);
		free pixels:n;
		pixels:n is 0;
	[end: closed is 1]

	# its surface at this size, and pixels for it
	[Make: int n: 0; int w: 0; int h: 0;]
		int selected: (OS.WindowSelect: n);
		int made: (OS.SurfaceOpen: w h);
		selected is (OS.WindowSelect: 0);
		if made is 0 return false;
		if pixels:n is not 0
			if Draw.pixels is pixels:n
				call Use: 0;
			;;
			free pixels:n;
		;;
		pixels:n is new u32[w * h];
		widths:n is w;
		heights:n is h;
		if not Font.loaded and (OS.CopyFont: addr Font.glyphs) is 1
			Font.loaded is true;
		;;
	[end: true]

	[Valid: int n: 0;]
		if n <= 0 or n >= MOST return false;
	[end: pixels:n is not 0]
}
