# A desktop for GUI programs: each program (with gui.app) gets a window with a title
# bar and a close box. 32-bit kernels.
#
#   use gui.desktop;
#   bln ok: (Screen.Start: 800 600);
#   call Desktop.Start;                                  # takes the keyboard and mouse
#   int pid: (Desktop.Run: 'PAINT.BIN' 'Paint' 40 40);   # a program, in a window at (40, 40)
#   while Desktop.windows.len > 0
#       call Desktop.Step;                               # input, events and drawing
#       call OS.Yield;                                   # and the programs run
#   ;;
#
# Step moves the mouse pointer, brings a window to the front when it's clicked, drags
# windows by their title bars, sends keys to the front window and mouse events to the
# window they happen in (from its inside's top left: a button pressed or let go, the
# wheel turned, or the mouse moved over it), and asks a program to close when
# its close box is clicked. The grip at a window's bottom right corner resizes it: the
# program is told its new size (Events.RESIZE) when the button is let go. A program
# that ends, or crashes, loses its window. The screen is drawn again only when
# something changed.

use gui.surfaces;
use drivers.vbe;
use drivers.input;
use user.text;
use user.math;

struct.DesktopWindow
{
	int pid;
	int x;                      # the frame's top left
	int y;
	int w;                      # its inside's size (0 until the program opens its surface)
	int h;
	u8 title[32];
}

phi.Desktop:Kernel
{
	const int TITLE_H: 20;
	const int BORDER: 2;
	const int CLOSE_SIZE: 16;
	const int GRIP: 12;         # the corner that resizes a window
	const int SMALLEST_W: 80;
	const int SMALLEST_H: 40;
	const u32 FACE: 0xF2F4F8;   # a window's inside, where its program hasn't drawn
	const int EMPTY_W: 160;     # a window's size until its program opens its surface
	const int EMPTY_H: 40;
	const u32 BACKGROUND: 0x2B4A6F;
	const u32 FRAME: 0xC0C0C0;
	const u32 TITLE_FRONT: 0x2F6FE4;
	const u32 TITLE_BACK: 0x808080;

	DesktopWindow windows[atmost 16];   # back to front: the last is in front
	bln dirty: true;
	int dragging: -1;           # the process whose window is being dragged
	int drag_dx: 0;
	int drag_dy: 0;
	int resizing: -1;           # the process whose window is being resized
	int pointer_x: -1;
	int pointer_y: -1;

	[Start]
		call Input.Start;
		call Input.SetArea: Screen.width Screen.height;
		dirty is true;
	[end]

	# start a program from the disk in a window with its top left at (x, y); its process
	# number, or -1 if it couldn't start
	[Run: ptr<u8> path: 0; ptr<u8> title: 0; int x: 0; int y: 0;]
		int pid: (Process.Spawn: path);
		if pid >= 0
			call Add: pid title x y;
		;;
	[end: pid]

	# a window for a program that's already running; false if there are too many
	[Add: int pid: 0; ptr<u8> title: 0; int x: 0; int y: 0;]
		if windows.len is windows.max return false;
		windows++;
		int i: windows.len - 1;
		windows:i.pid is pid;
		windows:i.x is x;
		windows:i.y is y;
		call Text.Copy: windows:i.title title sizeof windows:i.title;
		dirty is true;
	[end: true]

	# one round: programs that ended, then keys and the mouse, then the screen if it changed
	[Step]
		call Watch;
		call Keys;
		call Mouse;
		if dirty
			call Redraw;
			dirty is false;
		;;
	[end]

	# ------------------------------------------------------------ the windows

	[Width: int i: 0;]
		int w: windows:i.w;
		if w is 0
			w is EMPTY_W;
		;;
	[end: w + 2 * BORDER]

	[Height: int i: 0;]
		int h: windows:i.h;
		if h is 0
			h is EMPTY_H;
		;;
	[end: TITLE_H + h + BORDER]

	# the window (an index) at (x, y), from the front; -1 for the desktop
	[At: int x: 0; int y: 0;]
		int i: windows.len - 1;
		while i >= 0
			int wx: windows:i.x;
			int wy: windows:i.y;
			if x >= wx and y >= wy and x < wx + (Width: i) and y < wy + (Height: i)
				return i;
			;;
			i--;
		;;
	[end: -1]

	# move window i to the front; its new index
	[ToFront: int i: 0;]
		int last: windows.len - 1;
		if i is last return i;
		DesktopWindow moving;
		moving is windows:i;
		while int k: i; k < last; k++;
			windows:k is windows:(k + 1);
		;;
		windows:last is moving;
		dirty is true;
	[end: last]

	[Remove: int i: 0;]
		while int k: i; k < windows.len - 1; k++;
			windows:k is windows:(k + 1);
		;;
		windows.len--;
		dirty is true;
	[end]

	# programs that ended lose their windows (and their memory goes back); a new picture
	# from one means drawing again
	[Watch]
		int i: windows.len - 1;
		while i >= 0
			int pid: windows:i.pid;
			u32 state: (OS.TaskState: pid);
			if state is Process.TASK_FREE or state >= Process.TASK_EXITED
				if dragging is pid
					dragging is -1;
				;;
				call Remove: i;
				call Process.Wait: pid;
			;;
			elif (Surfaces.TakeChanged: pid)
				dirty is true;
				# the window takes the size of what the program drew, unless it's being resized
				if resizing is not pid
					windows:i.w is Surfaces.width:pid;
					windows:i.h is Surfaces.height:pid;
				;;
			;;
			i--;
		;;
	[end]

	# ------------------------------------------------------------ input

	# keys go to the front window
	[Keys]
		int key: (Input.NextKey);
		while key is not 0
			if windows.len > 0
				call Surfaces.PostKey: windows:(windows.len - 1).pid key;
			;;
			key is (Input.NextKey);
		;;
	[end]

	[Mouse]
		while (Input.NextMouse)
			call MouseEvent: Input.event_x Input.event_y Input.event_buttons Input.event_clicks Input.event_wheel;
		;;

		# a window being resized follows the mouse with its corner
		if resizing >= 0
			int r: (Find: resizing);
			if r >= 0
				int w: (Math.Max: Input.mouse_x - windows:r.x - 2 * BORDER SMALLEST_W);
				int h: (Math.Max: Input.mouse_y - windows:r.y - TITLE_H - BORDER SMALLEST_H);
				if w is not windows:r.w or h is not windows:r.h
					windows:r.w is w;
					windows:r.h is h;
					dirty is true;
				;;
			;;
		;;

		# a window being dragged follows the mouse
		if dragging >= 0
			int d: (Find: dragging);
			if d >= 0 and (windows:d.x is not Input.mouse_x - drag_dx or windows:d.y is not Input.mouse_y - drag_dy)
				windows:d.x is Input.mouse_x - drag_dx;
				windows:d.y is Input.mouse_y - drag_dy;
				dirty is true;
			;;
		;;

		if Input.mouse_x is not pointer_x or Input.mouse_y is not pointer_y
			pointer_x is Input.mouse_x;
			pointer_y is Input.mouse_y;
			call Screen.MoveCursor: pointer_x pointer_y;
			if dragging < 0
				call Moved: pointer_x pointer_y;
			;;
		;;
	[end]

	# the mouse moved: the window under it is told where it is now (clicks 0)
	[Moved: int x: 0; int y: 0;]
		int i: (At: x y);
		if i < 0 return;
		int inside_x: x - windows:i.x - BORDER;
		int inside_y: y - windows:i.y - TITLE_H;
		if inside_y < 0 return;
		call Surfaces.PostMouse: windows:i.pid inside_x inside_y Input.buttons 0 0;
	[end]

	[MouseEvent: int x: 0; int y: 0; int buttons: 0; int clicks: 0; int wheel: 0;]
		if (buttons & 1) is 0
			dragging is -1;
			if resizing >= 0
				# let go: the program draws itself that size
				int r: (Find: resizing);
				if r >= 0
					call Surfaces.PostResize: resizing windows:r.w windows:r.h;
				;;
				resizing is -1;
			;;
		;;
		int i: (At: x y);
		if i < 0 return;
		if clicks > 0
			i is (ToFront: i);
		;;
		int wx: windows:i.x;
		int wy: windows:i.y;
		int pid: windows:i.pid;

		if y < wy + TITLE_H
			if clicks is 0 return;
			# the close box, at the right of the title bar
			int box: wx + (Width: i) - BORDER - CLOSE_SIZE - 2;
			if x >= box and x < box + CLOSE_SIZE
				call Surfaces.PostClose: pid;
				return;
			;;
			dragging is pid;
			drag_dx is x - wx;
			drag_dy is y - wy;
			return;
		;;
		# the grip at the bottom right corner
		if clicks > 0 and x >= wx + (Width: i) - GRIP and y >= wy + (Height: i) - GRIP
			resizing is pid;
			return;
		;;
		call Surfaces.PostMouse: pid x - wx - BORDER y - wy - TITLE_H buttons clicks wheel;
	[end]

	# the index of the process's window, or -1
	[Find: int pid: 0;]
		while int i: 0; i < windows.len; i++;
			if windows:i.pid is pid return i;
		;;
	[end: -1]

	# ------------------------------------------------------------ drawing

	[Redraw]
		call Draw.ResetView;
		call Draw.Clear: BACKGROUND;
		while int i: 0; i < windows.len; i++;
			call DrawWindow: i (i is windows.len - 1);
		;;
		call Screen.PresentAll;
	[end]

	[DrawWindow: int i: 0; bln front: false;]
		int x: windows:i.x;
		int y: windows:i.y;
		int w: (Width: i);
		int h: (Height: i);
		u32 title: TITLE_BACK;
		if front
			title is TITLE_FRONT;
		;;
		call Draw.BlendRect: x + 4 y + 4 w h Draw.BLACK 64;      # a shadow
		call Draw.FillRect: x y w h FRAME;
		call Draw.FillRect: x y w TITLE_H title;
		int box: x + w - BORDER - CLOSE_SIZE - 2;
		call Draw.TextFitted: x + 6 y + 2 box - x - 10 addr windows:i.title Draw.WHITE;
		call Draw.FillRect: box y + 2 CLOSE_SIZE CLOSE_SIZE FRAME;
		call Draw.Line: box + 4 y + 6 box + 11 y + 13 Draw.BLACK;
		call Draw.Line: box + 11 y + 6 box + 4 y + 13 Draw.BLACK;
		# its inside, cut to the window's size (it may be being resized)
		call Draw.FillRect: x + BORDER y + TITLE_H w - 2 * BORDER h - TITLE_H - BORDER FACE;
		call Draw.PushClip: x + BORDER y + TITLE_H w - 2 * BORDER h - TITLE_H - BORDER;
		call Surfaces.DrawAt: windows:i.pid x + BORDER y + TITLE_H;
		call Draw.PopClip;

		# the grip: three short lines in the corner
		int gx: x + w - 3;
		int gy: y + h - 3;
		while int k: 1; k <= 3; k++;
			call Draw.Line: gx - 3 * k gy gx gy - 3 * k Draw.GRAY;
		;;
	[end]
}
