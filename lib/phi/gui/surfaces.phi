# Windows for user programs, on the kernel's side. 32-bit kernels with proc.process.
#
#   use gui.surfaces;
#   int pid: (Process.Spawn: 'PAINT.BIN');
#   ...
#   if (Surfaces.TakeChanged: pid)              # it showed a new picture
#       call Surfaces.DrawAt: pid 100 80;       # draw it (with Draw, so cut to the view)
#   ;;
#   call Surfaces.PostKey: pid key;             # tell it about a key ...
#   call Surfaces.PostMouse: pid x y buttons clicks wheel;   # ... the mouse (x, y inside it)
#   call Surfaces.PostResize: pid w h;          # ... that its window is a new size
#   call Surfaces.PostClose: pid;               # ... or that it should close
#
# A program (with gui.app) opens one surface: a block of w x h pixels the kernel keeps
# for it. It draws on its own pixels and Presents them, which copies them here, and
# takes the events posted to it, oldest first (32 are kept; Post gives false when its
# queue is full). The kernel decides where a surface goes on the screen and which
# program gets the keys: that's the window manager's work, and this leaves it to the
# kernel. A program that crashes loses its surface; the kernel carries on.
#
# A program's first surface is known by its process number, as a program's only one always was.
# Others it opens (Windows.Open in gui.app) have numbers of their own from MAX_PROCESSES up, and
# the window manager treats each as a window; their events go to the same program's queue, each
# saying which of its windows it's for.
#
# A program can also name its window (App.SetTitle), start another program in a window
# of its own (App.OpenWindow), ask whether its window is in front (App.Focused) and say
# it can't be resized (App.SetResizable). Those are requests the window manager picks
# up: TakeTitle, TakeNewWindow, Resizable, and front, which it keeps set to the process
# whose window is in front.
#
# The system calls (64 to 74) are OS.SurfaceOpen, OS.SurfacePresent, OS.NextEvent, OS.CopyFont,
# OS.SetWindowTitle, OS.OpenWindow, OS.WindowFocused, OS.SetResizable, OS.WindowNew, OS.WindowSelect
# and OS.WindowClose;
# Surfaces answers them through Process.more_calls.

use proc.process;
use memory.mem;
use gfx.draw;
use gui.events;

phi.Surfaces:Kernel
{
	const u32 SYS_SURFACE_OPEN: 64;
	const u32 SYS_SURFACE_PRESENT: 65;
	const u32 SYS_NEXT_EVENT: 66;
	const u32 SYS_COPY_FONT: 67;
	const u32 SYS_SET_TITLE: 68;
	const u32 SYS_OPEN_WINDOW: 69;
	const u32 SYS_FOCUSED: 70;
	const u32 SYS_RESIZABLE: 71;
	const u32 SYS_WINDOW_NEW: 72;
	const u32 SYS_WINDOW_SELECT: 73;
	const u32 SYS_WINDOW_CLOSE: 74;
	const int TITLE_SIZE: 32;
	const int MAX_PROCESSES: 64;
	const int MAX_SURFACES: 128;        # a process's first, by its number, and others above those
	const int QUEUE: 32;
	const int MOST_SIDE: 4096;
	const int MOST_PIXELS: 1920 * 1200;

	ptr<u32> pixels[128];       # each surface (0: none)
	int width[128];
	int height[128];
	int presents[128];          # how many pictures it has shown
	bln changed[128];           # a new one since TakeChanged last looked
	int owners[128];            # the process each from MAX_PROCESSES up is for (0: it's free)
	int numbers[128];           # and which window of that process's it is, from 1
	int selected[64];           # the surface each process's calls act on (0: its first)
	GuiEvent queue[2048];       # QUEUE events for each process
	int head[64];
	int tail[64];
	u8 titles[4096];            # TITLE_SIZE for each surface: what it asked to be called
	bln title_changed[128];     # a title TakeTitle hasn't taken yet
	bln new_window[128];        # wanting a window, waiting for TakeNewWindow
	bln fixed_size[128];        # said it can't handle Events.RESIZE (App.SetResizable: false)
	int front: 0;               # the surface whose window is in front (the window manager sets it)
	int buttons_held[128];      # the mouse buttons in the last MOUSE event each surface was sent

	# what had the system calls and the release before us (net.calls, say): we pass
	# theirs on
	method<u32 u32 u32 u32 u32: int> other_calls: Process.more_calls;
	method<int> other_release: Process.on_release;
	Process.more_calls is addr Calls;
	Process.on_release is addr Release;

	# a system call from a program
	[Calls: u32 number: 0; u32 a: 0; u32 b: 0; u32 c: 0; u32 d: 0;]
		if number < SYS_SURFACE_OPEN or number > SYS_WINDOW_CLOSE
			int passed: -1;
			if other_calls is not 0
				call passed is other_calls: number a b c d;
			;;
			return passed;
		;;
		int pid: (OS.CurrentProcess);
		if pid <= 0 or pid >= MAX_PROCESSES return -1;
		int surface: pid;
		if selected:pid is not 0
			surface is selected:pid;
		;;
		if number is SYS_SURFACE_OPEN return (Open: surface a as int b as int);
		if number is SYS_SURFACE_PRESENT return (Present: surface a);
		if number is SYS_NEXT_EVENT return (Next: pid a);
		if number is SYS_COPY_FONT return (CopyFont: a);
		if number is SYS_SET_TITLE return (SetTitle: surface a);
		if number is SYS_OPEN_WINDOW return (OpenWindow: a b);
		if number is SYS_RESIZABLE
			fixed_size:surface is (a is 0);
			return 1;
		;;
		if number is SYS_FOCUSED
			if surface is front return 1;
			return 0;
		;;
		# (the number of a window comes from the program, and is refused if it isn't its own)
		if number is SYS_WINDOW_NEW return (NewWindow: pid);
		if number is SYS_WINDOW_SELECT return (SelectWindow: pid a as int);
		if number is SYS_WINDOW_CLOSE return (CloseWindow: pid a as int);
	[end: -1]

	# another window for the process, wanting a window from the window manager once it has a
	# surface: its number, or -1 if there's no room for one
	[NewWindow: int pid: 0;]
		int free_one: -1;
		while int s: MAX_PROCESSES; s < MAX_SURFACES and free_one < 0; s++;
			if owners:s is 0
				free_one is s;
			;;
		;;
		if free_one < 0 return -1;
		# (the lowest number this process isn't using)
		int number: 1;
		while (SurfaceOf: pid number) >= 0
			number++;
		;;
		owners:free_one is pid;
		numbers:free_one is number;
		new_window:free_one is true;
	[end: number]

	# the surface of one of the process's windows; -1 if it hasn't got that one
	[SurfaceOf: int pid: 0; int number: 0;]
		if number is 0 return pid;
		while int s: MAX_PROCESSES; s < MAX_SURFACES; s++;
			if owners:s is pid and numbers:s is number return s;
		;;
	[end: -1]

	[SelectWindow: int pid: 0; int number: 0;]
		int s: (SurfaceOf: pid number);
		if s < 0 return 0;
		selected:pid is 0;
		if number is not 0
			selected:pid is s;
		;;
	[end: 1]

	[CloseWindow: int pid: 0; int number: 0;]
		if number is 0 return 0;
		int s: (SurfaceOf: pid number);
		if s < 0 return 0;
		if selected:pid is s
			selected:pid is 0;
		;;
		call Forget: s;
		owners:s is 0;
		numbers:s is 0;
	[end: 1]

	# a surface of w x h pixels for the process (any it had goes); 1, or 0 if it can't
	[Open: int pid: 0; int w: 0; int h: 0;]
		if w <= 0 or h <= 0 or w > MOST_SIDE or h > MOST_SIDE return 0;
		if w * h > MOST_PIXELS return 0;
		if pixels:pid is not 0
			free pixels:pid;            # a new size: the events waiting for it stay
			pixels:pid is 0;
		;;
		ptr<u32> p: new u32[w * h];
		if p is 0 return 0;
		pixels:pid is p;
		width:pid is w;
		height:pid is h;
	[end: 1]

	# the program's picture, at from in its memory, copied into its surface
	[Present: int pid: 0; u32 from: 0;]
		if pixels:pid is 0 return 0;
		u32 bytes: width:pid * height:pid * 4;
		if (Process.UserRange: from bytes) is false return 0;
		call Mem.Copy: pixels:pid from bytes;
		presents:pid++;
		changed:pid is true;
	[end: 1]

	# the oldest event posted to the program, into the GuiEvent at to; 1, or 0 if none
	[Next: int pid: 0; u32 to: 0;]
		if (Process.UserRange: to sizeof GuiEvent) is false return 0;
		if head:pid is tail:pid return 0;
		ptr<GuiEvent> event: to;
		event:0 is queue:(pid * QUEUE + tail:pid);
		tail:pid is (tail:pid + 1) % QUEUE;
	[end: 1]

	# the font (gfx.font), so the program's text looks like the kernel's
	[CopyFont: u32 to: 0;]
		if Font.loaded is false return 0;
		if (Process.UserRange: to sizeof Font.glyphs) is false return 0;
		call Mem.Copy: to Font.glyphs sizeof Font.glyphs;
	[end: 1]

	# the title at from in the program's memory, cut to fit, for TakeTitle
	[SetTitle: int pid: 0; u32 from: 0;]
		u8 text[32];
		int i: 0;
		while i < TITLE_SIZE - 1 and (Process.UserRange: from + i 1)
			ptr<u8> byte: from + i;
			if byte:0 is 0 break;
			text:i is byte:0;
			i++;
		;;
		text:i is 0;
		call StoreTitle: pid addr text;
	[end: 1]

	# a title from the kernel's memory
	[StoreTitle: int pid: 0; ptr<u8> text: 0;]
		int i: 0;
		while i < TITLE_SIZE - 1 and text:i is not 0
			titles:(pid * TITLE_SIZE + i) is text:i;
			i++;
		;;
		titles:(pid * TITLE_SIZE + i) is 0;
		title_changed:pid is true;
	[end]

	# start the program at path (text in the caller's memory, like its command line) and
	# ask for a window for it, named after its file; its process number, or -1
	[OpenWindow: u32 path_from: 0; u32 arguments_from: 0;]
		u8 path[64];
		u8 arguments[256];
		if (Process.CopyFromUser: path_from addr path sizeof path) is false return -1;
		if arguments_from is not 0
			if (Process.CopyFromUser: arguments_from addr arguments sizeof arguments) is false return -1;
		;;
		int pid: (Process.Spawn: addr path addr arguments);
		if pid > 0 and pid < MAX_PROCESSES
			new_window:pid is true;
			call StoreTitle: pid addr path;
		;;
	[end: pid]

	# the process a surface is for
	[Owner: int surface: 0;]
		if surface < MAX_PROCESSES return surface;
	[end: owners:surface]

	# is this surface still one? (a program can close one it opened itself, and go on)
	[Alive: int surface: 0;]
		if surface < MAX_PROCESSES return true;
		if surface >= MAX_SURFACES return false;
	[end: owners:surface is not 0]

	# ------------------------------------------------------------ for the window manager

	# can the process's window be resized? (it takes Events.RESIZE, unless it said it can't)
	[Resizable: int pid: 0;]
		if pid <= 0 or pid >= MAX_SURFACES return true;
	[end: fixed_size:pid is false]

	# a process App.OpenWindow started, or a window a program opened, which wants a window on the
	# screen; 0 when there's none
	[TakeNewWindow]
		while int pid: 1; pid < MAX_SURFACES; pid++;
			if new_window:pid
				new_window:pid is false;
				return pid;
			;;
		;;
	[end: 0]

	# the title the process asked for, into `into` (size bytes, ending with a zero), if
	# it asked for one since the last time; false if it didn't
	[TakeTitle: int pid: 0; ptr<u8> target: 0; int size: 0;]
		if pid <= 0 or pid >= MAX_SURFACES or size <= 0 return false;
		if title_changed:pid is false return false;
		title_changed:pid is false;
		int i: 0;
		while i < size - 1 and i < TITLE_SIZE - 1 and titles:(pid * TITLE_SIZE + i) is not 0
			target:i is titles:(pid * TITLE_SIZE + i);
			i++;
		;;
		target:i is 0;
	[end: true]

	# put an event in the queue of the process a surface is for, saying which window it's for;
	# false if it has no surface or its queue is full
	[Post: int surface: 0; int kind: 0; int x: 0; int y: 0; int value: 0; int clicks: 0; int wheel: 0;]
		if surface <= 0 or surface >= MAX_SURFACES return false;
		if pixels:surface is 0 return false;
		int pid: (Owner: surface);
		if pid <= 0 return false;
		int next: (head:pid + 1) % QUEUE;
		if next is tail:pid return false;
		int slot: pid * QUEUE + head:pid;
		queue:slot.window is numbers:surface;
		queue:slot.kind is kind;
		queue:slot.x is x;
		queue:slot.y is y;
		queue:slot.value is value;
		queue:slot.clicks is clicks;
		queue:slot.wheel is wheel;
		queue:slot.pressed is 0;
		if kind is Events.MOUSE
			# a button that wasn't held in the last event went down: a right click is a press too
			queue:slot.pressed is value & ~buttons_held:surface;
			buttons_held:surface is value;
		;;
		head:pid is next;
	[end: true]

	[PostKey: int pid: 0; int key: 0;]
	[end: (Post: pid Events.KEY 0 0 key 0 0)]

	# x and y from the surface's top left
	[PostMouse: int pid: 0; int x: 0; int y: 0; int buttons: 0; int clicks: 0; int wheel: 0;]
	[end: (Post: pid Events.MOUSE x y buttons clicks wheel)]

	[PostClose: int pid: 0;]
	[end: (Post: pid Events.CLOSE 0 0 0 0 0)]

	# the window was made w x h: the program opens a surface that size and draws again
	[PostResize: int pid: 0; int w: 0; int h: 0;]
	[end: (Post: pid Events.RESIZE w h 0 0 0)]

	# did the process show a new picture since the last time this was asked?
	[TakeChanged: int pid: 0;]
		if pid <= 0 or pid >= MAX_SURFACES return false;
		bln was: changed:pid;
		changed:pid is false;
	[end: was]

	# draw the process's surface with its top left at (x, y)
	[DrawAt: int pid: 0; int x: 0; int y: 0;]
		if pid > 0 and pid < MAX_SURFACES and pixels:pid is not 0
			call Draw.Blit: x y width:pid height:pid pixels:pid width:pid;
		;;
	[end]

	# the process ended (or opens another surface): its surface and events go
	[Release: int pid: 0;]
		if other_release is not 0
			call other_release: pid;
		;;
		if pid <= 0 or pid >= MAX_PROCESSES return;
		call Forget: pid;
		head:pid is 0;
		tail:pid is 0;
		selected:pid is 0;
		# and any others it opened
		while int s: MAX_PROCESSES; s < MAX_SURFACES; s++;
			if owners:s is pid
				call Forget: s;
				owners:s is 0;
				numbers:s is 0;
			;;
		;;
	[end]

	# a surface as if it had never been
	[Forget: int surface: 0;]
		if pixels:surface is not 0
			free pixels:surface;
		;;
		pixels:surface is 0;
		width:surface is 0;
		height:surface is 0;
		presents:surface is 0;
		changed:surface is false;
		title_changed:surface is false;
		new_window:surface is false;
		fixed_size:surface is false;
		buttons_held:surface is 0;
	[end]
}
