# FAT16 file system, written in PHI (32-bit kernels).
#
#   use fs.fat16;
#   ptr<u8> buffer: new u8[4096];
#   int size: 0;
#   call size is Fat.ReadFile: 'README.TXT' buffer 4096;     # -1 if it isn't there
#   call size is Fat.ReadAt: 'SONG.WAV' 8192 buffer 4096;    # from 8192 bytes in
#   call ok is Fat.WriteFile: 'DOCS/NOTES.TXT' text length;  # creates or replaces
#   call ok is Fat.Append: 'GAME.LOG' text length;           # adds to the end (or creates)
#   call ok is Fat.Delete: 'OLD.TXT';
#   call count is Fat.List: '';                              # prints a directory
#
#   FileInfo entries[64];
#   int count: (Fat.Entries: 'DOCS' addr entries:0 entries.len);   # a folder's entries
#   log entries:0.name ' ' entries:0.size ' ' entries:0.folder;
#   call ok is Fat.MakeFolder: 'DOCS/OLD';
#   call ok is Fat.Rename: 'DOCS/NOTES.TXT' 'DOCS/OLD/NOTES1.TXT';   # can move, too
#   call ok is Fat.DeleteFolder: 'DOCS/OLD';                 # only when it's empty
#
# Paths use / between folders and 8.3 names (README.TXT, DOCS/NOTES.TXT); case
# doesn't matter. Long file names aren't read. New files can go in any existing
# folder that has a free entry (folders don't grow yet). Files and folders get the
# date and time from the clock when they're written. `phi build` fills the disk from
# the program's NAME.rootfs/ (or rootfs/) folder.
#
# The whole FAT is kept in memory and written back after every change.

use drivers.disk;
use drivers.rtc;
use memory.heap;
use fs.fileinfo;                # FileInfo, which programs use too (OS.ListFolder)

# the start of the partition's first sector: the BIOS Parameter Block
struct.FatBootSector
{
	u8 jump[3];
	u8 oem[8];
	u16 bytes_per_sector;
	u8 sectors_per_cluster;
	u16 reserved_sectors;
	u8 fat_count;
	u16 root_entries;
	u16 total_sectors16;
	u8 media;
	u16 sectors_per_fat;
	u16 sectors_per_track;
	u16 heads;
	u32 hidden_sectors;
	u32 total_sectors32;
}

# one 32-byte directory entry
struct.DirEntry
{
	u8 name[11];            # 8 + 3, padded with spaces
	u8 attributes;
	u8 reserved;
	u8 create_tenths;
	u16 create_time;
	u16 create_date;
	u16 access_date;
	u16 cluster_high;       # always 0 on FAT16
	u16 write_time;
	u16 write_date;
	u16 cluster;            # first cluster of the data (0 for an empty file)
	u32 size;
}

phi.Fat:Kernel
{
	const u8 ATTR_VOLUME: 0x08;
	const u8 ATTR_DIRECTORY: 0x10;
	const u8 ATTR_ARCHIVE: 0x20;
	const u8 ATTR_LONG_NAME: 0x0F;
	const u8 ENTRY_DELETED: 0xE5;
	const u16 CHAIN_END: 0xFFF8;        # this and above: the last cluster of a file
	const u16 CHAIN_LAST: 0xFFFF;

	bln mounted: false;
	u32 sectors_per_cluster: 0;
	u32 cluster_bytes: 0;
	u32 fat_start: 0;
	u32 fat_sectors: 0;
	u32 fat_count: 0;
	u32 root_start: 0;
	u32 root_sectors: 0;
	u32 data_start: 0;
	u32 cluster_count: 0;

	ptr<u16> fat_table: 0;
	ptr<u8> sector_buffer: 0;
	ptr<u8> cluster_buffer: 0;

	# what the last Resolve found
	u8 wanted_name[11];
	DirEntry found;
	u32 found_sector: 0;
	u32 found_index: 0;
	bln parent_found: false;            # every folder in the path exists
	u32 parent_directory: 0;            # the folder the last name is (or would be) in; 0 = root

	str display_name: [12];

	call Mount;

	[Mount]
		if Disk.partition_found
			sector_buffer is new u8[512];
			bln ok: false;
			call ok is Disk.Read: 0 1 sector_buffer;
			ptr<FatBootSector> boot: sector_buffer;
			if ok and boot:0.bytes_per_sector is 512 and sector_buffer:510 is 0x55
				sectors_per_cluster is boot:0.sectors_per_cluster;
				cluster_bytes is sectors_per_cluster * 512;
				fat_start is boot:0.reserved_sectors;
				fat_sectors is boot:0.sectors_per_fat;
				fat_count is boot:0.fat_count;
				root_start is fat_start + fat_count * fat_sectors;
				root_sectors is (boot:0.root_entries * 32 + 511) / 512;
				data_start is root_start + root_sectors;

				u32 total: boot:0.total_sectors16;
				if total is 0
					total is boot:0.total_sectors32;
				;;
				cluster_count is (total - data_start) / sectors_per_cluster;

				fat_table is new u16[fat_sectors * 256];
				cluster_buffer is new u8[cluster_bytes];
				mounted is true;
				while u32 s: 0; s < fat_sectors and mounted; s++;
					call mounted is Disk.Read: fat_start + s 1 fat_table + s * 512;
				;;
			;;
		;;
	[end]

	# ------------------------------------------------------------ reading

	# bytes copied into buffer (at most max), or -1 if the file isn't there
	[ReadFile: ptr<u8> path: 0; ptr<u8> buffer: 0; u32 max: 0;]
		int copied: 0;
		call copied is ReadAt: path 0 buffer max;
	[end: copied]

	# the same, starting offset bytes into the file (0 bytes at or past its end)
	[ReadAt: ptr<u8> path: 0; u32 offset: 0; ptr<u8> buffer: 0; u32 max: 0;]
		int copied: -1;
		bln exists: false;
		call exists is Resolve: path;
		if exists and (found.attributes & ATTR_DIRECTORY) is 0
			copied is 0;
			u32 wanted: 0;
			if offset < found.size
				wanted is found.size - offset;
			;;
			if wanted > max
				wanted is max;
			;;

			# follow the chain to the cluster the offset is in
			u32 cluster: found.cluster;
			u32 skip: offset / cluster_bytes;
			while skip > 0 and cluster >= 2 and cluster < CHAIN_END
				cluster is fat_table:cluster;
				skip--;
			;;
			u32 within: offset % cluster_bytes;

			while cluster >= 2 and cluster < CHAIN_END and copied < wanted
				bln ok: false;
				call ok is ReadCluster: cluster;
				u32 chunk: cluster_bytes - within;
				if chunk > wanted - copied
					chunk is wanted - copied;
				;;
				while u32 k: 0; k < chunk; k++;
					buffer:(copied + k) is cluster_buffer:(within + k);
				;;
				copied++ chunk;
				within is 0;
				cluster is fat_table:cluster;
			;;
		;;
	[end: copied]

	# the file's size in bytes, or -1 if it isn't there
	[FileSize: ptr<u8> path: 0;]
		int size: -1;
		bln exists: false;
		call exists is Resolve: path;
		if exists
			size is found.size;
		;;
	[end: size]

	[Exists: ptr<u8> path: 0;]
		bln exists: false;
		call exists is Resolve: path;
	[end: exists]

	# print a folder ('' is the root); returns how many entries it has, or -1 if
	# there's no such folder
	[List: ptr<u8> path: 0;]
		int count: 0;
		u32 directory: 0;
		bln ok: true;
		if path:0 is not 0
			call ok is Resolve: path;
			ok is ok and (found.attributes & ATTR_DIRECTORY) is not 0;
			directory is found.cluster;
		;;
		if ok is false
			count is -1;
		;;

		bln more: ok;
		while u32 n: 0; more; n++;
			u32 sector: 0;
			call sector is DirectorySector: directory n;
			if sector is 0
				more is false;
			;;
			else
				call ok is Disk.Read: sector 1 sector_buffer;
				while u32 i: 0; i < 16 and more; i++;
					ptr<DirEntry> e: sector_buffer + i * 32;
					if e:0.name:0 is 0
						more is false;            # nothing after this entry is in use
					;;
					elif e:0.name:0 is not ENTRY_DELETED and e:0.name:0 is not '.' and (e:0.attributes & ATTR_VOLUME) is 0
						call DisplayName: e;
						if (e:0.attributes & ATTR_DIRECTORY) is not 0
							log '  ' display_name '/\n';
						;;
						else
							log '  ' display_name '  ' e:0.size '\n';
						;;
						count++;
					;;
				;;
			;;
		;;
	[end: count]

	# ------------------------------------------------------------ writing

	# create or replace a file; false if a folder in the path is missing,
	# the folder has no free entry, or the disk is full
	[WriteFile: ptr<u8> path: 0; ptr<u8> data: 0; u32 length: 0;]
		bln ok: false;
		bln exists: false;
		call exists is Resolve: path;
		u32 slotSector: 0;
		u32 slotIndex: 0;

		if exists and (found.attributes & ATTR_DIRECTORY) is 0
			call FreeChain: found.cluster;
			slotSector is found_sector;
			slotIndex is found_index;
			ok is true;
		;;
		elif exists is false and parent_found
			call ok is FindFreeSlot: parent_directory;
			slotSector is found_sector;
			slotIndex is found_index;
		;;

		# the data, a cluster at a time
		u32 first: 0;
		u32 previous: 0;
		u32 written: 0;
		while ok and written < length
			u32 cluster: 0;
			call cluster is FindFreeCluster;
			if cluster is 0
				ok is false;                  # the disk is full
			;;
			else
				fat_table:cluster is CHAIN_LAST;
				if previous is 0
					first is cluster;
				;;
				else
					fat_table:previous is cluster;
				;;
				previous is cluster;

				u32 chunk: cluster_bytes;
				if chunk > length - written
					chunk is length - written;
				;;
				while u32 k: 0; k < cluster_bytes; k++;
					cluster_buffer:k is 0;
				;;
				while u32 m: 0; m < chunk; m++;
					cluster_buffer:m is data:(written + m);
				;;
				u32 target: 0;
				call target is ClusterSector: cluster;
				call ok is Disk.Write: target sectors_per_cluster cluster_buffer;
				written++ chunk;
			;;
		;;

		# the directory entry
		if ok
			call ok is Disk.Read: slotSector 1 sector_buffer;
			ptr<DirEntry> e: sector_buffer + slotIndex * 32;
			if exists is false
				while u32 b: 0; b < 32; b++;
					sector_buffer:(slotIndex * 32 + b) is 0;
				;;
				while u32 c: 0; c < 11; c++;
					e:0.name:c is wanted_name:c;
				;;
				e:0.attributes is ATTR_ARCHIVE;
				call Stamp: e true;
			;;
			e:0.cluster is first;
			e:0.size is length;
			call Stamp: e false;
			call ok is Disk.Write: slotSector 1 sector_buffer;
		;;

		bln saved: false;
		call saved is SaveFat;
		ok is ok and saved;
	[end: ok]

	# add length bytes to the end of a file, creating it if it isn't there; false if a
	# folder in the path is missing, the folder has no free entry, or the disk is full.
	# The data goes to the disk first, then the FAT (only if the file needed another
	# cluster), then the new size: if the machine stops part way, the file is as it was.
	[Append: ptr<u8> path: 0; ptr<u8> data: 0; u32 length: 0;]
		if (Resolve: path) is false return (WriteFile: path data length);
		if (found.attributes & ATTR_DIRECTORY) is not 0 return false;
		if length is 0 return true;
		u32 size: found.size;
		u32 first: found.cluster;
		u32 slotSector: found_sector;
		u32 slotIndex: found_index;

		# the cluster the file ends in (0 if it has none), and how much of it is used
		u32 last: 0;
		u32 used: 0;
		if size > 0 and first >= 2
			last is first;
			u32 skip: (size - 1) / cluster_bytes;
			while skip > 0 and last >= 2 and last < CHAIN_END
				last is fat_table:last;
				skip--;
			;;
			used is size - (size - 1) / cluster_bytes * cluster_bytes;
		;;
		bln fat_changed: false;
		if last >= 2 and fat_table:last < CHAIN_END
			# clusters past the end, from a stop part way through an earlier Append
			call FreeChain: fat_table:last;
			fat_table:last is CHAIN_LAST;
			fat_changed is true;
		;;

		# first the room left in the last cluster
		bln ok: true;
		u32 written: 0;
		if last >= 2 and used < cluster_bytes
			call ok is ReadCluster: last;
			u32 room: cluster_bytes - used;
			if room > length
				room is length;
			;;
			while u32 m: 0; m < room; m++;
				cluster_buffer:(used + m) is data:m;
			;;
			if ok
				call ok is Disk.Write: (ClusterSector: last) sectors_per_cluster cluster_buffer;
			;;
			written is room;
		;;

		# then new clusters for the rest
		u32 previous: last;
		u32 first_new: 0;
		while ok and written < length
			u32 cluster: (FindFreeCluster);
			if cluster is 0
				ok is false;                  # the disk is full
			;;
			else
				fat_table:cluster is CHAIN_LAST;
				if previous is 0
					first is cluster;
				;;
				else
					fat_table:previous is cluster;
				;;
				if first_new is 0
					first_new is cluster;
				;;
				previous is cluster;
				fat_changed is true;

				u32 chunk: cluster_bytes;
				if chunk > length - written
					chunk is length - written;
				;;
				while u32 k: 0; k < cluster_bytes; k++;
					cluster_buffer:k is 0;
				;;
				while u32 m: 0; m < chunk; m++;
					cluster_buffer:m is data:(written + m);
				;;
				call ok is Disk.Write: (ClusterSector: cluster) sectors_per_cluster cluster_buffer;
				written++ chunk;
			;;
		;;

		if ok is false
			# give back the clusters this took; the file keeps its old size
			if first_new is not 0
				call FreeChain: first_new;
				if last >= 2
					fat_table:last is CHAIN_LAST;
				;;
			;;
			return false;
		;;
		if fat_changed and (SaveFat) is false return false;

		# last, the size: until this is written, the file is as it was
		call ok is Disk.Read: slotSector 1 sector_buffer;
		ptr<DirEntry> e: sector_buffer + slotIndex * 32;
		e:0.cluster is first;
		e:0.size is size + length;
		call Stamp: e false;
		if ok
			call ok is Disk.Write: slotSector 1 sector_buffer;
		;;
	[end: ok]

	[Delete: ptr<u8> path: 0;]
		bln ok: false;
		call ok is Resolve: path;
		ok is ok and (found.attributes & ATTR_DIRECTORY) is 0;
		if ok
			call FreeChain: found.cluster;
			call ok is Disk.Read: found_sector 1 sector_buffer;
			sector_buffer:(found_index * 32) is ENTRY_DELETED;
			call ok is Disk.Write: found_sector 1 sector_buffer;
			bln saved: false;
			call saved is SaveFat;
			ok is ok and saved;
		;;
	[end: ok]

	# ------------------------------------------------------------ folders

	# the entries of a folder ('' is the root) copied into `into`, at most max of them;
	# returns how many, or -1 if there's no such folder
	[Entries: ptr<u8> path: 0; ptr<FileInfo> into: 0; int max: 0;]
		u32 directory: (FolderCluster: path);
		if directory is NO_FOLDER
			return -1;
		;;

		int count: 0;
		while u32 n: 0; count < max; n++;
			u32 sector: (DirectorySector: directory n);
			if sector is 0 or not (Disk.Read: sector 1 sector_buffer)
				break;
			;;
			while u32 i: 0; i < 16 and count < max; i++;
				ptr<DirEntry> e: sector_buffer + i * 32;
				u8 first: e:0.name:0;
				if first is 0
					return count;                 # nothing after this entry is in use
				;;
				if first is not ENTRY_DELETED and first is not '.' and (e:0.attributes & ATTR_VOLUME) is 0
					call DisplayName: e;
					ptr<FileInfo> info: into + count * sizeof FileInfo;
					info:0.name is display_name;
					info:0.folder is (e:0.attributes & ATTR_DIRECTORY) is not 0;
					info:0.size is e:0.size;
					u16 date: e:0.write_date;
					u16 time: e:0.write_time;
					info:0.year is 0;
					if date is not 0
						info:0.year is 1980 + (date >> 9);
					;;
					info:0.month is (date >> 5) & 15;
					info:0.day is date & 31;
					info:0.hour is time >> 11;
					info:0.minute is (time >> 5) & 63;
					count++;
				;;
			;;
		;;
	[end: count]

	# make a folder; false if it's there already, its parent isn't, or there's no room
	[MakeFolder: ptr<u8> path: 0;]
		if (Resolve: path) or not parent_found
			return false;
		;;
		u32 parent: parent_directory;
		if not (FindFreeSlot: parent)
			return false;
		;;
		u32 slot_sector: found_sector;
		u32 slot_index: found_index;

		u32 cluster: (FindFreeCluster);
		if cluster is 0
			return false;                     # the disk is full
		;;
		fat_table:cluster is CHAIN_LAST;

		# the new folder's first cluster: '.' (itself) and '..' (its parent), then nothing
		while u32 k: 0; k < cluster_bytes; k++;
			cluster_buffer:k is 0;
		;;
		ptr<DirEntry> dot: cluster_buffer;
		call FillEntry: dot '.          ' ATTR_DIRECTORY cluster;
		ptr<DirEntry> dotdot: cluster_buffer + 32;
		call FillEntry: dotdot '..         ' ATTR_DIRECTORY parent;
		if not (Disk.Write: (ClusterSector: cluster) sectors_per_cluster cluster_buffer)
			return false;
		;;

		# its entry in the parent
		if not (Disk.Read: slot_sector 1 sector_buffer)
			return false;
		;;
		ptr<DirEntry> e: sector_buffer + slot_index * 32;
		call FillEntry: e addr wanted_name ATTR_DIRECTORY cluster;
	[end: (Disk.Write: slot_sector 1 sector_buffer) and (SaveFat)]

	# delete a folder, which must be empty
	[DeleteFolder: ptr<u8> path: 0;]
		if not (Resolve: path) or (found.attributes & ATTR_DIRECTORY) is 0
			return false;
		;;
		u32 entry_sector: found_sector;
		u32 entry_index: found_index;
		u32 cluster: found.cluster;

		FileInfo any[1];
		if (Entries: path addr any:0 1) is not 0
			return false;                     # not empty
		;;

		call FreeChain: cluster;
		if not (Disk.Read: entry_sector 1 sector_buffer)
			return false;
		;;
		sector_buffer:(entry_index * 32) is ENTRY_DELETED;
	[end: (Disk.Write: entry_sector 1 sector_buffer) and (SaveFat)]

	# rename a file or folder, or move it to another folder; false if `from` isn't there,
	# `to` is, or the folder for `to` doesn't exist or has no room
	[Rename: ptr<u8> from: 0; ptr<u8> to: 0;]
		if not (Resolve: from)
			return false;
		;;
		DirEntry moving;
		ptr<u8> source: addr found;
		ptr<u8> copy: addr moving;
		while int b: 0; b < sizeof DirEntry; b++;
			copy:b is source:b;
		;;
		u32 old_sector: found_sector;
		u32 old_index: found_index;
		u32 old_parent: parent_directory;

		if (Resolve: to) or not parent_found
			return false;
		;;
		u32 new_parent: parent_directory;
		u8 new_name[11];
		while int c: 0; c < 11; c++;
			new_name:c is wanted_name:c;
		;;

		if new_parent is old_parent
			# the same folder: just the name changes
			if not (Disk.Read: old_sector 1 sector_buffer)
				return false;
			;;
			ptr<DirEntry> e: sector_buffer + old_index * 32;
			while int d: 0; d < 11; d++;
				e:0.name:d is new_name:d;
			;;
			return (Disk.Write: old_sector 1 sector_buffer);
		;;

		# another folder: a new entry there, then the old one goes
		if not (FindFreeSlot: new_parent) or not (Disk.Read: found_sector 1 sector_buffer)
			return false;
		;;
		ptr<u8> slot: sector_buffer + found_index * 32;
		while int m: 0; m < sizeof DirEntry; m++;
			slot:m is copy:m;
		;;
		while int n: 0; n < 11; n++;
			slot:n is new_name:n;
		;;
		if not (Disk.Write: found_sector 1 sector_buffer) or not (Disk.Read: old_sector 1 sector_buffer)
			return false;
		;;
		sector_buffer:(old_index * 32) is ENTRY_DELETED;
		if not (Disk.Write: old_sector 1 sector_buffer)
			return false;
		;;

		# a folder that moved has a new parent for its '..'
		if (moving.attributes & ATTR_DIRECTORY) is not 0 and (ReadCluster: moving.cluster)
			ptr<DirEntry> dotdot: cluster_buffer + 32;
			dotdot:0.cluster is new_parent;
			return (Disk.Write: (ClusterSector: moving.cluster) sectors_per_cluster cluster_buffer);
		;;
	[end: true]

	[FreeClusters]
		u32 count: 0;
		while u32 c: 2; c < cluster_count + 2; c++;
			if fat_table:c is 0
				count++;
			;;
		;;
	[end: count]

	# ------------------------------------------------------------ inside the file system

	const u32 NO_FOLDER: 0xFFFFFFFF;

	# the first cluster of a folder ('' is the root, 0), or NO_FOLDER
	[FolderCluster: ptr<u8> path: 0;]
		while path:0 is '/'
			path++;
		;;
		if path:0 is 0
			return 0;
		;;
		if not (Resolve: path) or (found.attributes & ATTR_DIRECTORY) is 0
			return NO_FOLDER;
		;;
	[end: found.cluster]

	# a fresh directory entry: an 11-character name, attributes and first cluster
	[FillEntry: ptr<DirEntry> e: 0; ptr<u8> name: 0; u8 attributes: 0; u32 cluster: 0;]
		ptr<u8> bytes: e;
		while int b: 0; b < sizeof DirEntry; b++;
			bytes:b is 0;
		;;
		while int c: 0; c < 11; c++;
			e:0.name:c is name:c;
		;;
		e:0.attributes is attributes;
		e:0.cluster is cluster;
		call Stamp: e true;
	[end]

	# the date and time from the clock, as FAT keeps them; `created` sets the creation time too
	[Stamp: ptr<DirEntry> e: 0; bln created: false;]
		call Rtc.Read;
		u16 date: ((Rtc.year - 1980) << 9) | (Rtc.month << 5) | Rtc.day;
		u16 time: (Rtc.hour << 11) | (Rtc.minute << 5) | (Rtc.second / 2);
		e:0.write_date is date;
		e:0.write_time is time;
		e:0.access_date is date;
		if created
			e:0.create_date is date;
			e:0.create_time is time;
		;;
	[end]

	# find a path; true if it exists (found, found_sector, found_index describe it)
	[Resolve: ptr<u8> path: 0;]
		bln ok: mounted;
		u32 directory: 0;
		parent_found is false;

		while path:0 is '/'
			path++;
		;;
		if path:0 is 0
			ok is false;                      # the root itself has no entry
		;;

		while ok and path:0 is not 0
			u32 used: 0;
			call used is SetName: path;
			path++ used;
			while path:0 is '/'
				path++;
			;;
			bln last: path:0 is 0;

			parent_directory is directory;
			parent_found is used > 0;
			call ok is FindInDirectory: directory;
			ok is ok and used > 0;

			if ok and last is false
				# a folder in the middle of the path
				if (found.attributes & ATTR_DIRECTORY) is 0
					ok is false;
				;;
				directory is found.cluster;
			;;
			if ok is false and last is false
				parent_found is false;
			;;
		;;
	[end: ok]

	# the next path part (up to / or the end) as a padded 8.3 name in wanted_name;
	# returns how many characters it used, or 0 if it isn't a valid 8.3 name
	[SetName: ptr<u8> part: 0;]
		while u32 i: 0; i < 11; i++;
			wanted_name:i is ' ';
		;;
		u32 length: 0;
		u32 nameLength: 0;
		u32 extensionLength: 0;
		bln inExtension: false;
		bln valid: true;
		while part:length is not 0 and part:length is not '/'
			u8 c: part:length;
			if c >= 'a' and c <= 'z'
				c is c - 32;                     # names are stored in capitals
			;;
			if c is '.'
				if inExtension or nameLength is 0
					valid is false;
				;;
				inExtension is true;
			;;
			elif inExtension
				if extensionLength < 3
					wanted_name:(8 + extensionLength) is c;
					extensionLength++;
				;;
				else
					valid is false;
				;;
			;;
			else
				if nameLength < 8
					wanted_name:nameLength is c;
					nameLength++;
				;;
				else
					valid is false;
				;;
			;;
			length++;
		;;
		if valid is false or nameLength is 0
			length is 0;
		;;
	[end: length]

	# look for wanted_name in a folder (0 = root)
	[FindInDirectory: u32 directory: 0;]
		bln found_it: false;
		bln more: true;
		while u32 n: 0; more and found_it is false; n++;
			u32 sector: 0;
			call sector is DirectorySector: directory n;
			if sector is 0
				more is false;
			;;
			else
				bln ok: false;
				call ok is Disk.Read: sector 1 sector_buffer;
				while u32 i: 0; i < 16 and more and found_it is false; i++;
					u32 pos: i * 32;
					if sector_buffer:pos is 0
						more is false;
					;;
					elif sector_buffer:pos is not ENTRY_DELETED and sector_buffer:(pos + 11) is not ATTR_LONG_NAME
						bln same: true;
						while u32 k: 0; k < 11; k++;
							if sector_buffer:(pos + k) is not wanted_name:k
								same is false;
							;;
						;;
						if same
							found_it is true;
							found_sector is sector;
							found_index is i;
							ptr<u8> copy: addr found;
							while u32 b: 0; b < 32; b++;
								copy:b is sector_buffer:(pos + b);
							;;
						;;
					;;
				;;
			;;
		;;
	[end: found_it]

	# an unused entry in a folder: sets found_sector and found_index
	[FindFreeSlot: u32 directory: 0;]
		bln found_it: false;
		bln more: true;
		while u32 n: 0; more and found_it is false; n++;
			u32 sector: 0;
			call sector is DirectorySector: directory n;
			if sector is 0
				more is false;
			;;
			else
				bln ok: false;
				call ok is Disk.Read: sector 1 sector_buffer;
				while u32 i: 0; i < 16 and found_it is false; i++;
					u8 first: sector_buffer:(i * 32);
					if first is 0 or first is ENTRY_DELETED
						found_it is true;
						found_sector is sector;
						found_index is i;
					;;
				;;
			;;
		;;
	[end: found_it]

	# the partition sector holding sector n of a folder, or 0 past its end
	[DirectorySector: u32 directory: 0; u32 n: 0;]
		u32 sector: 0;
		if directory is 0
			if n < root_sectors
				sector is root_start + n;
			;;
		;;
		else
			u32 cluster: directory;
			u32 hops: n / sectors_per_cluster;
			while hops > 0 and cluster >= 2 and cluster < CHAIN_END
				cluster is fat_table:cluster;
				hops--;
			;;
			if cluster >= 2 and cluster < CHAIN_END
				call sector is ClusterSector: cluster;
				sector++ n % sectors_per_cluster;
			;;
		;;
	[end: sector]

	[ClusterSector: u32 cluster: 0;]
	[end: data_start + (cluster - 2) * sectors_per_cluster]

	[ReadCluster: u32 cluster: 0;]
		u32 sector: 0;
		call sector is ClusterSector: cluster;
		bln ok: false;
		call ok is Disk.Read: sector sectors_per_cluster cluster_buffer;
	[end: ok]

	[FindFreeCluster]
		u32 result: 0;
		while u32 c: 2; c < cluster_count + 2 and result is 0; c++;
			if fat_table:c is 0
				result is c;
			;;
		;;
	[end: result]

	[FreeChain: u32 cluster: 0;]
		while cluster >= 2 and cluster < CHAIN_END
			u32 next: fat_table:cluster;
			fat_table:cluster is 0;
			cluster is next;
		;;
	[end]

	# write the in-memory FAT to every copy on disk
	[SaveFat]
		bln ok: true;
		while u32 copy: 0; copy < fat_count; copy++;
			while u32 s: 0; s < fat_sectors and ok; s++;
				call ok is Disk.Write: fat_start + copy * fat_sectors + s 1 fat_table + s * 512;
			;;
		;;
	[end: ok]

	# NAME.EXT from a directory entry, into display_name
	[DisplayName: ptr<DirEntry> e: 0;]
		u32 length: 0;
		while u32 i: 0; i < 8; i++;
			if e:0.name:i is not ' '
				display_name:length is e:0.name:i;
				length++;
			;;
		;;
		if e:0.name:8 is not ' '
			display_name:length is '.';
			length++;
			while u32 j: 8; j < 11; j++;
				if e:0.name:j is not ' '
					display_name:length is e:0.name:j;
					length++;
				;;
			;;
		;;
		display_name:length is 0;
	[end]
}
