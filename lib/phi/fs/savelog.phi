# Save logs: records of one size added to the end of a file whenever something
# changes, each with a CRC-32, and read back in order when the kernel starts again
# (32-bit kernels).
#
#   use fs.savelog;
#   PlayerSave p;
#   call ok is SaveLog.Add: 'SAVES.LOG' addr p sizeof PlayerSave;          # false if the disk is full
#   call ok is SaveLog.AddMany: 'SAVES.LOG' addr list sizeof PlayerSave n;  # n records, in one write
#   int count: (SaveLog.Read: 'SAVES.LOG' sizeof PlayerSave addr Restore);  # -1 if there's no log
#   call SaveLog.Clear: 'SAVES.LOG';
#
#   [Restore: ptr<u8> record: 0;]          # called for each record, oldest first
#       ...
#   [end]
#
# Add writes a record and its CRC to the end of the file in one Fat.Append, which
# writes the new size last: a machine that stops part way through leaves the file as
# it was, or (if the disk itself was half way through) a record cut short. Read stops
# at the first record that's cut short or whose CRC doesn't match, and sets torn. A log
# only grows: to keep it small, read it, Clear it, and add back the latest of each
# thing (samples/mmo/server.rootfs/world.phi does, with user.savelog).

use fs.fat16;
use data.crc32;

phi.SaveLog:Kernel
{
	const u32 MAX_RECORD: 1024;

	u8 log_record[MAX_RECORD + 4];       # a record and its CRC, on its way to or from the disk
	u8 log_batch[16384];                 # records and their CRCs, for AddMany
	bln torn: false;                     # the last Read stopped at a damaged record

	# add a record of size bytes to the end of the log at path; false if it couldn't be written
	[Add: ptr<u8> path: 0; ptr<u8> record: 0; u32 size: 0;]
		if size is 0 or size > MAX_RECORD return false;
		while u32 i: 0; i < size; i++;
			log_record:i is record:i;
		;;
		u32 crc: (Crc32.Of: record size);
		log_record:size is crc;
		log_record:(size + 1) is crc >> 8;
		log_record:(size + 2) is crc >> 16;
		log_record:(size + 3) is crc >> 24;
	[end: (Fat.Append: path addr log_record size + 4)]

	# add count records of size bytes each, one after another at records, to the end of
	# the log at path, in as few writes as fit; false if any couldn't be written
	[AddMany: ptr<u8> path: 0; ptr<u8> records: 0; u32 size: 0; u32 count: 0;]
		if size is 0 or size > MAX_RECORD return false;
		u32 used: 0;
		while u32 r: 0; r < count; r++;
			if used + size + 4 > sizeof log_batch
				if (Fat.Append: path addr log_batch used) is false return false;
				used is 0;
			;;
			ptr<u8> record: records + r * size;
			while u32 i: 0; i < size; i++;
				log_batch:(used + i) is record:i;
			;;
			u32 crc: (Crc32.Of: record size);
			log_batch:(used + size) is crc;
			log_batch:(used + size + 1) is crc >> 8;
			log_batch:(used + size + 2) is crc >> 16;
			log_batch:(used + size + 3) is crc >> 24;
			used++ size + 4;
		;;
		if used is 0 return true;
	[end: (Fat.Append: path addr log_batch used)]

	# call every with each whole record in the log, oldest first; how many there were,
	# or -1 if there's no log at path
	[Read: ptr<u8> path: 0; u32 size: 0; method<ptr<u8>> every: 0;]
		torn is false;
		if size is 0 or size > MAX_RECORD return -1;
		int length: (Fat.FileSize: path);
		if length < 0 return -1;
		int count: 0;
		u32 offset: 0;
		while offset < length
			int got: (Fat.ReadAt: path offset addr log_record size + 4);
			if got < 0 or got < size + 4      # (an int and a u32 compare unsigned: -1 first)
				torn is true;
				break;
			;;
			u32 crc: log_record:size | (log_record:(size + 1) << 8) | (log_record:(size + 2) << 16) | (log_record:(size + 3) << 24);
			if crc is not (Crc32.Of: addr log_record size)
				torn is true;
				break;
			;;
			call every: addr log_record;
			count++;
			offset++ size + 4;
		;;
	[end: count]

	# empty the log (it's created if it isn't there); false if it couldn't be written
	[Clear: ptr<u8> path: 0;]
	[end: (Fat.WriteFile: path addr log_record 0)]
}
