# The kernel heap: memory for `new` and `free` (32-bit kernels).
#
#   ptr<Task> t: new Task;        # zeroed; 0 if the heap is full
#   ptr<u8> buffer: new u8[512];
#   free t;
#
# A kernel that uses new or free gets this file automatically. It takes a
# contiguous range of frames at startup: a quarter of free memory, at least 8 MB
# (31 MB on QEMU's default 128 MB machine), but never more than half. Blocks are
# kept in address order, each with a header, so Free can merge a block with free
# neighbors. Free blocks are also on one of BINS lists by size (8-15 bytes, 16-31,
# 32-63, and so on, doubling), so Alloc only looks at free blocks that could fit:
# the first one big enough on its size's own list, otherwise the first on the next
# list that has one. It splits off what it doesn't need.
# Both work holding heap_lock, so the cores (proc.cores) can share the heap, and with
# their core's interrupts off, so an interrupt handler can use it too (a method's objects
# are freed when it ends, even in a handler).

use memory.frames;
use memory.paging;

struct.HeapBlock
{
	u32 magic;                  # HEAP_MAGIC while this is a block of the heap
	u32 size;                   # bytes after the header
	u32 used;                   # 1 while handed out
	ptr<HeapBlock> next;        # the block after this one in memory
	ptr<HeapBlock> previous;
	u32 bin;                    # while free: which size list it's on (and the header stays 24 bytes)
}

# the first bytes of a free block: its neighbors on its size's list
struct.HeapFreeLinks
{
	ptr<HeapBlock> next;
	ptr<HeapBlock> previous;
}

phi.Heap:Kernel
{
	const u32 HEAP_MAGIC: 0x48454150;        # 'HEAP'
	const u32 HEADER: 24;
	const u32 HEAP_MIN_FRAMES: 2048;         # 8 MB
	const u32 BINS: 28;                      # the last takes every block of 1 GB and more

	ptr<HeapBlock> heap_first: 0;
	u32 heap_start: 0;
	u32 heap_size: 0;
	u32 used_bytes: 0;          # handed out right now (not counting headers)
	u32 used_blocks: 0;
	lock heap_lock;             # one core at a time in Alloc, Free and LargestFree
	ptr<HeapBlock> heap_bins[BINS];
	u32 heap_zero_at: 0;        # for HeapZero
	u32 heap_zero_words: 0;
	u32 heap_bin_size: 0;       # for HeapBinOf
	u32 heap_bin: 0;

	call Init;

	[Init]
		u32 frames: Frames.free_frames / 4;
		if frames < HEAP_MIN_FRAMES
			frames is HEAP_MIN_FRAMES;
		;;
		if frames > Frames.free_frames / 2
			frames is Frames.free_frames / 2;
		;;
		call heap_start is Frames.AllocContiguous: frames;
		if heap_start is not 0
			heap_size is frames * Frames.FRAME_SIZE;
			heap_first is heap_start;
			heap_first:0.magic is HEAP_MAGIC;
			heap_first:0.size is heap_size - HEADER;
			call AddFree: heap_first;
		;;
	[end]

	# size bytes of zeroed memory, or 0 if no free block is big enough
	[Alloc: u32 size: 0;]
		u32 result: 0;
		u32 wanted: (size + 7) & ~7;
		if wanted is 0
			wanted is 8;
		;;
		locked heap_lock
			ptr<HeapBlock> b: (FindFree: wanted);
			if b is not 0
				call RemoveFree: b;
				# split off the rest when it's big enough to be a block of its own
				if b:0.size >= wanted + HEADER + 8
					ptr<HeapBlock> rest: b + HEADER + wanted;
					rest:0.magic is HEAP_MAGIC;
					rest:0.size is b:0.size - wanted - HEADER;
					rest:0.used is 0;
					rest:0.next is b:0.next;
					rest:0.previous is b;
					if b:0.next is not 0
						ptr<HeapBlock> after: b:0.next;
						after:0.previous is rest;
					;;
					b:0.next is rest;
					b:0.size is wanted;
					call AddFree: rest;
				;;

				b:0.used is 1;
				used_bytes++ b:0.size;
				used_blocks++;
				result is b + HEADER;
				heap_zero_at is result;
				heap_zero_words is b:0.size / 4;
				call asm.HeapZero;
			;;
		;;
	[end: result]

	# give back memory from Alloc; freeing 0 does nothing
	[Free: u32 address: 0;]
		locked heap_lock
			if address is not 0
				ptr<HeapBlock> b: address - HEADER;
				bln valid: address >= heap_start + HEADER and address < heap_start + heap_size;
				if valid
					valid is b:0.magic is HEAP_MAGIC and b:0.used is 1;
				;;

				if valid is false
					log '\nPHI: free of memory that new did not hand out (or freed twice): ' address '\n';
					call HeapHalt;
				;;

				b:0.used is 0;
				used_bytes-- b:0.size;
				used_blocks--;

				# merge with the next block, then the previous one, if they are free
				ptr<HeapBlock> next: b:0.next;
				if next is not 0 and next:0.used is 0
					call RemoveFree: next;
					b:0.size++ HEADER + next:0.size;
					b:0.next is next:0.next;
					next:0.magic is 0;
					if b:0.next is not 0
						ptr<HeapBlock> after: b:0.next;
						after:0.previous is b;
					;;
				;;
				ptr<HeapBlock> merged: b;
				ptr<HeapBlock> previous: b:0.previous;
				if previous is not 0 and previous:0.used is 0
					call RemoveFree: previous;
					previous:0.size++ HEADER + b:0.size;
					previous:0.next is b:0.next;
					b:0.magic is 0;
					if previous:0.next is not 0
						ptr<HeapBlock> later: previous:0.next;
						later:0.previous is previous;
					;;
					merged is previous;
				;;
				call AddFree: merged;
			;;
		;;
	[end]

	# the largest block Alloc could hand out right now
	[LargestFree]
		u32 largest: 0;
		locked heap_lock
			ptr<HeapBlock> b: heap_first;
			while b is not 0
				if b:0.used is 0 and b:0.size > largest
					largest is b:0.size;
				;;
				b is b:0.next;
			;;
		;;
	[end: largest]

	# ---- the lists of free blocks by size

	# which list a free block of size bytes (8 or more) goes on: 0 for 8-15, 1 for 16-31, ...
	[BinOf: u32 size: 0;]
		heap_bin_size is size;
		call asm.HeapBinOf;
		if heap_bin >= BINS
			heap_bin is BINS - 1;
		;;
	[end: heap_bin]

	# a free block of at least wanted bytes: the first that fits on wanted's own list
	# (where some are smaller), else the first on a list of bigger ones; 0 if none
	[FindFree: u32 wanted: 0;]
		u32 bin: (BinOf: wanted);
		ptr<HeapBlock> found: 0;
		ptr<HeapBlock> b: heap_bins:bin;
		while b is not 0 and found is 0
			if b:0.size >= wanted
				found is b;
			;;
			ptr<HeapFreeLinks> links: b + HEADER;
			b is links:0.next;
		;;
		bin++;
		while found is 0 and bin < BINS
			found is heap_bins:bin;
			bin++;
		;;
	[end: found]

	# put a free block at the front of its size's list
	[AddFree: ptr<HeapBlock> b: 0;]
		u32 bin: (BinOf: b:0.size);
		b:0.bin is bin;
		ptr<HeapFreeLinks> links: b + HEADER;
		links:0.next is heap_bins:bin;
		links:0.previous is 0;
		if heap_bins:bin is not 0
			ptr<HeapFreeLinks> first: heap_bins:bin + HEADER;
			first:0.previous is b;
		;;
		heap_bins:bin is b;
	[end]

	# take a free block off its size's list (before it's used, merged or resized)
	[RemoveFree: ptr<HeapBlock> b: 0;]
		ptr<HeapFreeLinks> links: b + HEADER;
		if links:0.previous is not 0
			ptr<HeapFreeLinks> before: links:0.previous + HEADER;
			before:0.next is links:0.next;
		;;
		else
			heap_bins:(b:0.bin) is links:0.next;
		;;
		if links:0.next is not 0
			ptr<HeapFreeLinks> after: links:0.next + HEADER;
			after:0.previous is links:0.previous;
		;;
	[end]
}

asm.HeapHalt
{
	cli
.halt:
	hlt
	jmp .halt
}

# heap_zero_words 32-bit words at heap_zero_at set to 0
asm.HeapZero
{
	mov edi, [{heap_zero_at}]
	mov ecx, [{heap_zero_words}]
	xor eax, eax
	rep stosd
	ret
}

# heap_bin = the number of the highest bit set in heap_bin_size / 8
asm.HeapBinOf
{
	mov eax, [{heap_bin_size}]
	shr eax, 3
	bsr eax, eax
	mov [{heap_bin}], eax
	ret
}
