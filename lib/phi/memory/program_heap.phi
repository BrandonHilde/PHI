# The heap for user programs: memory for `new` and `free` (and objects).
#
#   ptr<u8> buffer: new u8[100000];    # zeroed; 0 if there's no memory for it
#   free buffer;
#
# A program that uses new or free gets this file automatically. The heap starts
# empty, right above the program's stack (0x40400000), and grows when nothing in
# it fits: it asks the kernel for more with OS.Grow, at least 64 KB at a time, up
# to most_bytes (below), and up to what the system has: 124 MB on PHI OS. Blocks are
# kept in address order, each with a header, so Free can
# merge a block with free neighbors; free blocks are also on lists by size, and
# Alloc takes the first that fits from them and splits it, as the kernel's heap
# (memory.heap) does. A program's threads (user.threads) share it, so Alloc, Free and
# LargestFree take a lock: one thread at a time in them.
#
# Most of what a program asks for is small and soon given back: a str's text, a list's
# node. So a freed block of up to 512 bytes isn't merged and filed, which costs a search
# and two lists' worth of pointers each way: it waits on a list of blocks of exactly its
# size (heap_kept), and the next Alloc of that size takes it straight back. A block
# waiting there still counts as free. When nothing else fits, every block that's waiting
# is given back properly first (GiveBackKept), merged with its neighbors, so the heap
# never grows for want of memory that's only waiting.

struct.HeapBlock
{
	u32 magic;                  # HEAP_MAGIC while this is a block of the heap
	u32 size;                   # bytes after the header
	u32 used;                   # 1 while handed out
	ptr<HeapBlock> next;        # the block after this one in memory
	ptr<HeapBlock> previous;
	u32 bin;                    # while free: which size list it's on
}

# the first bytes of a free block: its neighbors on its size's list
struct.HeapFreeLinks
{
	ptr<HeapBlock> next;
	ptr<HeapBlock> previous;
}

phi.Heap:Program
{
	const u32 HEAP_MAGIC: 0x48454150;        # 'HEAP'
	const u32 HEADER: sizeof HeapBlock;      # (24 bytes, or 32 in 64-bit code)
	const u32 SMALLEST: sizeof HeapFreeLinks; # a free block keeps its list's links in it
	const u32 GROW_MIN: 65536;               # asked of the kernel at a time, at least
	const u32 PAGE_SIZE: 4096;
	const u32 BINS: 28;                      # 8-15 bytes, 16-31, ... doubling; the last takes the rest
	const u32 MOST_32: 134217728;            # 128 MB: a 32-bit program's heap, unless it says otherwise
	const u32 KEPT_MOST: 512;                # a freed block of up to this many bytes waits by its size
	const u32 KEPT_SIZES: 65;                # one list for each size, in steps of 8 bytes
	const u32 FREE: 0;                       # what a block's `used` says: free, and on a list by size
	const u32 USED: 1;                       # handed out
	const u32 KEPT: 2;                       # freed, and waiting on heap_kept for the next of its size

	# The most the heap grows to, which the program decides: `Heap.most_bytes is 600000000;`
	# lets it have 600 MB, and a smaller number holds it to less. 0 is the default: 128 MB in a
	# 32-bit program, which leaves the rest of its 4 GB of addresses to everything else, and no
	# limit but the system's in a 64-bit one. The system can always give less than this.
	u64 most_bytes: 0;

	ptr<HeapBlock> heap_first: 0;
	ptr<HeapBlock> heap_last: 0;
	ptr<u8> heap_start: 0;
	ptr<u8> heap_end: 0;
	u32 used_bytes: 0;          # handed out right now (not counting headers)
	u32 used_blocks: 0;
	ptr<HeapBlock> heap_bins[BINS];
	ptr<HeapBlock> heap_kept[KEPT_SIZES];    # freed blocks of size / 8 * 8 bytes exactly, the last freed first
	u32 kept_blocks: 0;                      # how many are waiting there
	ptr<u8> heap_zero_at: 0;    # for HeapZero
	u32 heap_zero_words: 0;
	u32 heap_bin_size: 0;       # for HeapBinOf
	u32 heap_bin: 0;
	lock heap_lock;             # one thread at a time in Alloc, Free and LargestFree

	# size bytes of zeroed memory, or 0 if the kernel has no more to give
	[Alloc: u32 size: 0;]
		u32 wanted: (size + 7) & ~7;
		if wanted < SMALLEST
			wanted is SMALLEST;
		;;
		ptr<u8> result: 0;
		locked heap_lock
			# a block of just this size, freed a moment ago: it's taken straight back
			# (wanted is at most 512 where its list is asked for, so the index needs no check)
			u32 kind: wanted >> 3;
			ptr<HeapBlock> b: 0;
			if wanted <= KEPT_MOST
				unsafe
					b is heap_kept:kind;
				;;
			;;
			if b is not 0
				ptr<HeapFreeLinks> links: b + HEADER;
				unsafe
					heap_kept:kind is links:0.next;
				;;
				kept_blocks--;
				b:0.used is USED;
				used_bytes++ wanted;
				used_blocks++;
				result is b + HEADER;
				heap_zero_at is result;
				heap_zero_words is wanted / 4;
				call asm.HeapZero;
			;;
			else
				result is (Take: wanted);
				# nothing fits: what's waiting by size goes back first, then the kernel is asked
				if result is 0 and (GiveBackKept)
					result is (Take: wanted);
				;;
				if result is 0 and (More: wanted)
					result is (Take: wanted);
				;;
			;;
		;;
	[end: result]

	# a free block that fits, split if it's much bigger; 0 if none does
	[Take: u32 wanted: 0;]
		ptr<HeapBlock> b: (FindFree: wanted);
		if b is 0 return 0;
		call RemoveFree: b;

		# split off the rest when it's big enough to be a block of its own
		if b:0.size >= wanted + HEADER + SMALLEST
			ptr<HeapBlock> rest: b + HEADER + wanted;
			rest:0.magic is HEAP_MAGIC;
			rest:0.size is b:0.size - wanted - HEADER;
			rest:0.used is FREE;
			rest:0.next is b:0.next;
			rest:0.previous is b;
			if b:0.next is not 0
				ptr<HeapBlock> after: b:0.next;
				after:0.previous is rest;
			;;
			if heap_last is b
				heap_last is rest;
			;;
			b:0.next is rest;
			b:0.size is wanted;
			call AddFree: rest;
		;;

		b:0.used is USED;
		used_bytes++ b:0.size;
		used_blocks++;
		ptr<u8> result: b + HEADER;
		heap_zero_at is result;
		heap_zero_words is b:0.size / 4;
		call asm.HeapZero;
	[end: result]

	# room for a block of wanted bytes, from the kernel, at the end of the heap
	[More: u32 wanted: 0;]
		u32 bytes: wanted + HEADER;
		if bytes < GROW_MIN
			bytes is GROW_MIN;
		;;
		u64 most: most_bytes;
		if most is 0 and sizeof ptr<u8> is 4
			most is MOST_32;
		;;
		if most is not 0
			u64 size: 0;
			if heap_start is not 0
				size is (heap_end - heap_start) as u64;
			;;
			if size + bytes > most return false;
		;;
		ptr<u8> start: (OS.Grow: bytes);
		if start is 0 return false;
		bytes is (bytes + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);   # it maps whole pages
		if heap_start is 0
			heap_start is start;
		;;
		heap_end is start + bytes;

		# the new memory follows the last block: a free one just gets bigger
		if heap_last is not 0 and heap_last:0.used is FREE
			call RemoveFree: heap_last;
			heap_last:0.size++ bytes;
			call AddFree: heap_last;
			return true;
		;;
		ptr<HeapBlock> b: start;
		b:0.magic is HEAP_MAGIC;
		b:0.size is bytes - HEADER;
		b:0.previous is heap_last;
		if heap_last is not 0
			heap_last:0.next is b;
		;;
		else
			heap_first is b;
		;;
		heap_last is b;
		call AddFree: b;
	[end: true]

	# give back memory from Alloc; freeing 0 does nothing
	[Free: ptr<u8> address: 0;]
		if address is 0 return;
		locked heap_lock
			ptr<HeapBlock> b: address - HEADER;
			bln valid: address >= heap_start + HEADER and address < heap_end;
			if valid
				valid is b:0.magic is HEAP_MAGIC and b:0.used is USED;
			;;
			if valid is false
				log '\nPHI: free of memory that new did not hand out (or freed twice): ' (address as u32) '\n';
				exit -1;
			;;

			used_bytes-- b:0.size;
			used_blocks--;
			if b:0.size <= KEPT_MOST and (b:0.size & 7) is 0
				# small: it waits for the next Alloc of its size
				b:0.used is KEPT;
				u32 kind: b:0.size >> 3;
				ptr<HeapFreeLinks> links: b + HEADER;
				unsafe
					links:0.next is heap_kept:kind;
					heap_kept:kind is b;
				;;
				kept_blocks++;
			;;
			else
				call GiveBack: b;
			;;
		;;
	[end]

	# a block that's no longer used or waiting, made free: merged with the next block and the
	# previous one, if they are free, and put on its size's list
	[GiveBack: ptr<HeapBlock> b: 0;]
		b:0.used is FREE;
		ptr<HeapBlock> next: b:0.next;
		if next is not 0 and next:0.used is FREE
			call RemoveFree: next;
			b:0.size++ HEADER + next:0.size;
			b:0.next is next:0.next;
			next:0.magic is 0;
			if b:0.next is not 0
				ptr<HeapBlock> after: b:0.next;
				after:0.previous is b;
			;;
			if heap_last is next
				heap_last is b;
			;;
		;;
		ptr<HeapBlock> merged: b;
		ptr<HeapBlock> previous: b:0.previous;
		if previous is not 0 and previous:0.used is FREE
			call RemoveFree: previous;
			previous:0.size++ HEADER + b:0.size;
			previous:0.next is b:0.next;
			b:0.magic is 0;
			if previous:0.next is not 0
				ptr<HeapBlock> later: previous:0.next;
				later:0.previous is previous;
			;;
			if heap_last is b
				heap_last is previous;
			;;
			merged is previous;
		;;
		call AddFree: merged;
	[end]

	# every block that's waiting by its size, given back; false if none was
	[GiveBackKept]
		if kept_blocks is 0 return false;
		while u32 size: 1; size < KEPT_SIZES; size++;
			while heap_kept:size is not 0
				ptr<HeapBlock> b: heap_kept:size;
				ptr<HeapFreeLinks> links: b + HEADER;
				heap_kept:size is links:0.next;
				call GiveBack: b;
			;;
		;;
		kept_blocks is 0;
	[end: true]

	# the largest block Alloc could hand out without asking the kernel for more
	[LargestFree]
		u32 largest: 0;
		locked heap_lock
			bln given: (GiveBackKept);       # (what's waiting by size is free too, once it's merged)
			ptr<HeapBlock> b: heap_first;
			while b is not 0
				if b:0.used is FREE and b:0.size > largest
					largest is b:0.size;
				;;
				b is b:0.next;
			;;
		;;
	[end: largest]

	# ---- the lists of free blocks by size

	# which list a free block of size bytes (8 or more) goes on: 0 for 8-15, 1 for 16-31, ...
	[BinOf: u32 size: 0;]
		heap_bin_size is size;
		call asm.HeapBinOf;
		if heap_bin >= BINS
			heap_bin is BINS - 1;
		;;
	[end: heap_bin]

	# a free block of at least wanted bytes: the first that fits on wanted's own list
	# (where some are smaller), else the first on a list of bigger ones; 0 if none
	[FindFree: u32 wanted: 0;]
		u32 bin: (BinOf: wanted);
		ptr<HeapBlock> found: 0;
		ptr<HeapBlock> b: heap_bins:bin;
		while b is not 0 and found is 0
			if b:0.size >= wanted
				found is b;
			;;
			ptr<HeapFreeLinks> links: b + HEADER;
			b is links:0.next;
		;;
		bin++;
		while found is 0 and bin < BINS
			found is heap_bins:bin;
			bin++;
		;;
	[end: found]

	# put a free block at the front of its size's list
	[AddFree: ptr<HeapBlock> b: 0;]
		u32 bin: (BinOf: b:0.size);
		b:0.bin is bin;
		ptr<HeapFreeLinks> links: b + HEADER;
		links:0.next is heap_bins:bin;
		links:0.previous is 0;
		if heap_bins:bin is not 0
			ptr<HeapFreeLinks> first: heap_bins:bin + HEADER;
			first:0.previous is b;
		;;
		heap_bins:bin is b;
	[end]

	# take a free block off its size's list (before it's used, merged or resized)
	[RemoveFree: ptr<HeapBlock> b: 0;]
		ptr<HeapFreeLinks> links: b + HEADER;
		if links:0.previous is not 0
			ptr<HeapFreeLinks> before: links:0.previous + HEADER;
			before:0.next is links:0.next;
		;;
		else
			heap_bins:(b:0.bin) is links:0.next;
		;;
		if links:0.next is not 0
			ptr<HeapFreeLinks> after: links:0.next + HEADER;
			after:0.previous is links:0.previous;
		;;
	[end]
}

# heap_zero_words 32-bit words at heap_zero_at set to 0
# (a word at a time for a small block: rep stosd takes longer to get going than 16 stores take)
asm.HeapZero
{
	mov edi, [{heap_zero_at}]
	mov ecx, [{heap_zero_words}]
	xor eax, eax
	cmp ecx, 16
	ja .many
	test ecx, ecx
	jz .done
.next:
	mov [edi], eax
	add edi, 4
	dec ecx
	jnz .next
.done:
	ret
.many:
	rep stosd
	ret
}

# heap_bin = the number of the highest bit set in heap_bin_size / 8
asm.HeapBinOf
{
	mov eax, [{heap_bin_size}]
	shr eax, 3
	bsr eax, eax
	mov [{heap_bin}], eax
	ret
}

# the same two, for 64-bit code: the address in all of rdi
x64.HeapZero
{
	mov rdi, [rel {heap_zero_at}]
	mov ecx, [rel {heap_zero_words}]
	xor eax, eax
	cmp ecx, 16
	ja .many
	test ecx, ecx
	jz .done
.next:
	mov [rdi], eax
	add rdi, 4
	dec ecx
	jnz .next
.done:
	ret
.many:
	rep stosd
	ret
}

x64.HeapBinOf
{
	mov eax, [rel {heap_bin_size}]
	shr eax, 3
	bsr eax, eax
	mov [rel {heap_bin}], eax
	ret
}
