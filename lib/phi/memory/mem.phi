# Copying and filling memory with the CPU's string instructions (rep movs, rep stos).
# 32-bit kernels and programs, and 64-bit programs.
#
#   use memory.mem;
#   call Mem.Copy: to from 4096;              # the areas must not overlap
#   call Mem.Move: text + 1 text length;      # they may overlap (here, shift right by one)
#   call Mem.Fill: buffer 0 512;              # 512 zero bytes
#   call Mem.Fill32: pixels 0xFFFFFF 640;     # 640 white pixels
#
# Each method's asm block reads the method's own arguments from its stack frame (the last
# one at [ebp + 8], the one before it at [ebp + 12], and so on; in 64-bit code [rbp + 16],
# [rbp + 24] and so on: see LayOutFrame in the code generator), so nothing is shared
# between calls, and an interrupt handler (a network card's, say) can copy while the code
# it interrupted is in the middle of a copy too.
#
# A count of 2 billion or more to Copy, Move, Fill or Fill32 is a negative number or a subtraction
# below 0, and is an error (ErrorKind.COUNT). The compiler checks it where each is called
# (EmitMemCountCheck), so the error names that line rather than one in this file.

phi.Mem:Library
{
	# count bytes from from to to; the two areas must not overlap
	[Copy: ptr<u8> to: 0; ptr<u8> from: 0; u32 count: 0;]
		call MemCopyForward;
	[end]

	# count bytes from from to to, where the two areas may overlap
	[Move: ptr<u8> to: 0; ptr<u8> from: 0; u32 count: 0;]
		call MemMove;
	[end]

	# count bytes set to value
	[Fill: ptr<u8> to: 0; u8 value: 0; u32 count: 0;]
		call MemFillBytes;
	[end]

	# count 32-bit values (like pixels) set to value
	[Fill32: ptr<u32> to: 0; u32 value: 0; u32 count: 0;]
		call MemFillWords;
	[end]

	# true when the first count bytes at a and b are the same
	[Equal: ptr<u8> a: 0; ptr<u8> b: 0; u32 count: 0;]
		u32 i: 0;
		while i < count
			if a:i is not b:i
				return false;
			;;
			i++;
		;;
	[end: true]
}

# Copy's arguments: to at [ebp + 16], from at [ebp + 12], count at [ebp + 8]
asm.MemCopyForward
{
	mov edi, [ebp + 16]
	mov esi, [ebp + 12]
	mov ecx, [ebp + 8]
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}

# Move's arguments, as Copy's: forward unless to is inside the source, then from the end
# so no byte is overwritten before it's read
asm.MemMove
{
	mov edi, [ebp + 16]
	mov esi, [ebp + 12]
	mov ecx, [ebp + 8]
	cmp edi, esi
	jbe .forward
	lea eax, [esi + ecx]
	cmp edi, eax
	jae .forward
	lea esi, [esi + ecx - 1]
	lea edi, [edi + ecx - 1]
	std
	rep movsb
	cld
	ret
.forward:
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}

# Fill's arguments: to at [ebp + 16], value at [ebp + 12] (its low byte), count at [ebp + 8]
asm.MemFillBytes
{
	mov edi, [ebp + 16]
	mov ecx, [ebp + 8]
	movzx eax, byte [ebp + 12]
	imul eax, eax, 0x01010101
	mov edx, ecx
	shr ecx, 2
	rep stosd
	mov ecx, edx
	and ecx, 3
	rep stosb
	ret
}

# Fill32's arguments: to at [ebp + 16], value at [ebp + 12], count at [ebp + 8]
asm.MemFillWords
{
	mov edi, [ebp + 16]
	mov ecx, [ebp + 8]
	mov eax, [ebp + 12]
	rep stosd
	ret
}

# 64-bit code: the same, with the arguments 8 bytes apart (the last at [rbp + 16]) and the
# addresses in all of rdi and rsi
x64.MemCopyForward
{
	mov rdi, [rbp + 32]
	mov rsi, [rbp + 24]
	mov ecx, [rbp + 16]
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}
x64.MemMove
{
	mov rdi, [rbp + 32]
	mov rsi, [rbp + 24]
	mov ecx, [rbp + 16]
	cmp rdi, rsi
	jbe .forward
	lea rax, [rsi + rcx]
	cmp rdi, rax
	jae .forward
	lea rsi, [rsi + rcx - 1]
	lea rdi, [rdi + rcx - 1]
	std
	rep movsb
	cld
	ret
.forward:
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}
x64.MemFillBytes
{
	mov rdi, [rbp + 32]
	mov ecx, [rbp + 16]
	movzx eax, byte [rbp + 24]
	imul eax, eax, 0x01010101
	mov edx, ecx
	shr ecx, 2
	rep stosd
	mov ecx, edx
	and ecx, 3
	rep stosb
	ret
}
x64.MemFillWords
{
	mov rdi, [rbp + 32]
	mov ecx, [rbp + 16]
	mov eax, [rbp + 24]
	rep stosd
	ret
}

# ARM (a macOS program): the arguments as x64.'s, at x29 + 16 up
arm.MemCopyForward
{
	ldr x0, [x29, #32]
	ldr x1, [x29, #24]
	ldr w2, [x29, #16]
	sub x9, x0, x1
	cmp x9, #8
	b.lo 2f					; (closer than 8 ahead: a byte at a time, as a forward copy repeats)
1:	cmp x2, #8
	b.lo 2f
	ldr x10, [x1], #8
	str x10, [x0], #8
	sub x2, x2, #8
	b 1b
2:	cbz x2, 3f
	ldrb w10, [x1], #1
	strb w10, [x0], #1
	sub x2, x2, #1
	b 2b
3:	ret
}
arm.MemMove
{
	ldr x0, [x29, #32]
	ldr x1, [x29, #24]
	ldr w2, [x29, #16]
	sub x9, x0, x1
	cmp x9, x2
	b.hs 1f					; not into the bytes ahead of it: forward
	add x0, x0, x2
	add x1, x1, x2
4:	cbz x2, 3f				; backward, the last first
	ldrb w10, [x1, #-1]!
	strb w10, [x0, #-1]!
	sub x2, x2, #1
	b 4b
1:	cmp x2, #8
	b.lo 2f
	ldr x10, [x1], #8
	str x10, [x0], #8
	sub x2, x2, #8
	b 1b
2:	cbz x2, 3f
	ldrb w10, [x1], #1
	strb w10, [x0], #1
	sub x2, x2, #1
	b 2b
3:	ret
}
arm.MemFillBytes
{
	ldr x0, [x29, #32]
	ldrb w1, [x29, #24]
	ldr w2, [x29, #16]
	mov x9, #0x0101010101010101
	mul x1, x1, x9
1:	cmp x2, #8
	b.lo 2f
	str x1, [x0], #8
	sub x2, x2, #8
	b 1b
2:	cbz x2, 3f
	strb w1, [x0], #1
	sub x2, x2, #1
	b 2b
3:	ret
}
arm.MemFillWords
{
	ldr x0, [x29, #32]
	ldr w1, [x29, #24]
	ldr w2, [x29, #16]
1:	cbz x2, 2f
	str w1, [x0], #4
	sub x2, x2, #1
	b 1b
2:	ret
}
