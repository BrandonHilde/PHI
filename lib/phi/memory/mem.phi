# Copying and filling memory with the CPU's string instructions (rep movs, rep stos).
# 32-bit kernels and programs.
#
#   use memory.mem;
#   call Mem.Copy: to from 4096;              # the areas must not overlap
#   call Mem.Move: text + 1 text length;      # they may overlap (here, shift right by one)
#   call Mem.Fill: buffer 0 512;              # 512 zero bytes
#   call Mem.Fill32: pixels 0xFFFFFF 640;     # 640 white pixels
#
# Each method's asm block reads the method's own arguments from its stack frame (the last
# one at [ebp + 8], the one before it at [ebp + 12], and so on: see LayOutFrame in the code
# generator), so nothing is shared between calls, and an interrupt handler (a network
# card's, say) can copy while the code it interrupted is in the middle of a copy too.

phi.Mem:Library
{
	# count bytes from from to to; the two areas must not overlap
	[Copy: ptr<u8> to: 0; ptr<u8> from: 0; u32 count: 0;]
		call MemCopyForward;
	[end]

	# count bytes from from to to, where the two areas may overlap
	[Move: ptr<u8> to: 0; ptr<u8> from: 0; u32 count: 0;]
		call MemMove;
	[end]

	# count bytes set to value
	[Fill: ptr<u8> to: 0; u8 value: 0; u32 count: 0;]
		call MemFillBytes;
	[end]

	# count 32-bit values (like pixels) set to value
	[Fill32: ptr<u32> to: 0; u32 value: 0; u32 count: 0;]
		call MemFillWords;
	[end]

	# true when the first count bytes at a and b are the same
	[Equal: ptr<u8> a: 0; ptr<u8> b: 0; u32 count: 0;]
		u32 i: 0;
		while i < count
			if a:i is not b:i
				return false;
			;;
			i++;
		;;
	[end: true]
}

# Copy's arguments: to at [ebp + 16], from at [ebp + 12], count at [ebp + 8]
asm.MemCopyForward
{
	mov edi, [ebp + 16]
	mov esi, [ebp + 12]
	mov ecx, [ebp + 8]
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}

# Move's arguments, as Copy's: forward unless to is inside the source, then from the end
# so no byte is overwritten before it's read
asm.MemMove
{
	mov edi, [ebp + 16]
	mov esi, [ebp + 12]
	mov ecx, [ebp + 8]
	cmp edi, esi
	jbe .forward
	lea eax, [esi + ecx]
	cmp edi, eax
	jae .forward
	lea esi, [esi + ecx - 1]
	lea edi, [edi + ecx - 1]
	std
	rep movsb
	cld
	ret
.forward:
	mov edx, ecx
	shr ecx, 2
	rep movsd
	mov ecx, edx
	and ecx, 3
	rep movsb
	ret
}

# Fill's arguments: to at [ebp + 16], value at [ebp + 12] (its low byte), count at [ebp + 8]
asm.MemFillBytes
{
	mov edi, [ebp + 16]
	mov ecx, [ebp + 8]
	movzx eax, byte [ebp + 12]
	imul eax, eax, 0x01010101
	mov edx, ecx
	shr ecx, 2
	rep stosd
	mov ecx, edx
	and ecx, 3
	rep stosb
	ret
}

# Fill32's arguments: to at [ebp + 16], value at [ebp + 12], count at [ebp + 8]
asm.MemFillWords
{
	mov edi, [ebp + 16]
	mov ecx, [ebp + 8]
	mov eax, [ebp + 12]
	rep stosd
	ret
}
