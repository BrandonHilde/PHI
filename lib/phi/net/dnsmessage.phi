# DNS's messages: a question for a name's address, and reading the answer (RFC 1035). What a
# kernel's net.dns and a program's Dns (net.sockets) share; each sends them its own way, and each
# has the Net whose Get16, Put16 and Get32 this uses.
#
# It also keeps the last 16 answers, each for as long as the server said it holds (its TTL), up to
# 5 minutes, so a name just asked isn't asked again: Kept and Keep, which both kinds of Dns use.
# DnsMessage.keeping is false; turns that off, and DnsMessage.Forget drops what's kept.

phi.DnsMessage:Library
{
	const u32 HEADER: 12;
	const u32 TYPE_A: 1;                  # an IPv4 address
	const u32 CLASS_INTERNET: 1;
	const u32 MOST_NAME: 253;             # DNS's limit, written out
	const u32 KEPT: 16;                   # answers kept
	const u32 KEPT_NAME: 64;              # ...for names shorter than this
	const u32 LONGEST: 300;               # seconds one is kept, however long it holds

	bln keeping: true;
	u8 dns_names[1024];                   # each kept name, in small letters, a zero after
	u32 dns_addresses[16];                # 0: nothing kept here
	u32 dns_servers[16];                  # who said so, and on which port
	u32 dns_ports[16];
	int dns_until[16];                    # OS.GetTicks when it stops holding
	u32 dns_next: 0;
	lock dns_kept;

	# a question for name's address, in query (room bytes): its length, or 0 if the name can't be one
	[Question: ptr<u8> query: 0; u32 room: 0; u32 id: 0; ptr<u8> name: 0;]
		call Net.Put16: query id;
		call Net.Put16: query + 2 0x0100;      # please ask other servers if need be
		call Net.Put16: query + 4 1;           # one question
		call Net.Put16: query + 6 0;
		call Net.Put16: query + 8 0;
		call Net.Put16: query + 10 0;

		# 'www.example.com' is written 3 www 7 example 3 com 0
		u32 pos: HEADER;
		u32 label: pos;                        # where the current part's length goes
		pos++;
		u32 i: 0;
		while name:i is not 0
			if pos + 6 >= room or i >= MOST_NAME return 0;
			if name:i is '.'
				if pos - label - 1 is 0 return 0;   # an empty part: a..b, or .a
				if name:(i + 1) is not 0
					query:label is pos - label - 1;
					label is pos;
					pos++;
				;;
			;;
			else
				query:pos is name:i;
				pos++;
				if pos - label - 1 > 63 return 0;   # a part has at most 63 characters
			;;
			i++;
		;;
		if pos - label - 1 is 0 return 0;      # no name at all
		query:label is pos - label - 1;
		query:pos is 0;
		pos++;
		call Net.Put16: query + pos TYPE_A;
		call Net.Put16: query + pos + 2 CLASS_INTERNET;
	[end: pos + 4]

	# the first address in the answer to question id, of length bytes at r; 0 if it's not there.
	# lasts, if it's given, gets how many seconds the answer holds: the least of the address's TTL
	# and those of the other names (CNAMEs) on the way to it.
	[Answer: ptr<u8> r: 0; u32 length: 0; u32 id: 0; ptr<u32> lasts: 0;]
		if length < HEADER return 0;
		u32 flags: (Net.Get16: r + 2) as u32;
		u32 questions: (Net.Get16: r + 4) as u32;
		u32 answers: (Net.Get16: r + 6) as u32;

		# an answer (the top bit), to our question, without an error (the low 4 bits)
		if ((Net.Get16: r) as u32) is not id or (flags & 0x8000) is 0 or (flags & 0x000F) is not 0 return 0;

		u32 address: 0;
		u32 holds: 0xFFFFFFFF;
		u32 pos: HEADER;
		while u32 q: 0; q < questions and pos < length; q++;
			pos is (SkipName: r pos length) + 4;  # and its type and class
		;;
		while u32 a: 0; a < answers and address is 0; a++;
			pos is (SkipName: r pos length);
			if pos + 10 > length return 0;
			u32 type: (Net.Get16: r + pos) as u32;
			u32 class: (Net.Get16: r + pos + 2) as u32;
			u32 size: (Net.Get16: r + pos + 8) as u32;
			u32 ttl: (Net.Get32: r + pos + 4);
			if ttl < holds
				holds is ttl;
			;;
			pos++ 10;
			# other answers (like a CNAME, another name for the same host) are passed over
			if type is TYPE_A and class is CLASS_INTERNET and size is 4 and pos + 4 <= length
				address is (Net.Get32: r + pos);
			;;
			pos++ size;
		;;
		if lasts is not 0
			lasts:0 is holds;
		;;
	[end: address]

	# ---- answers kept

	# the address kept for name, as the server at that address and port gave it; 0 if none is, or
	# it no longer holds
	[Kept: ptr<u8> name: 0; u32 server: 0; u32 port: 0;]
		if not keeping return 0 as u32;
		u32 address: 0;
		int ticks: (OS.GetTicks);
		locked dns_kept
			while u32 i: 0; i < KEPT and address is 0; i++;
				if dns_addresses:i is not 0 and dns_servers:i is server and dns_ports:i is port and (SameName: addr dns_names:(i * KEPT_NAME) name)
					if dns_until:i - ticks > 0
						address is dns_addresses:i;
					;;
					else
						dns_addresses:i is 0;
					;;
				;;
			;;
		;;
	[end: address]

	# keep name's address for seconds (LONGEST at most), in place of the oldest kept once there
	# are KEPT; a name too long to keep, or an answer that holds for no time, isn't kept
	[Keep: ptr<u8> name: 0; u32 server: 0; u32 port: 0; u32 address: 0; u32 seconds: 0;]
		if not keeping or address is 0 or seconds is 0 return;
		u32 length: 0;
		while name:length is not 0 and length < KEPT_NAME
			length++;
		;;
		if length >= KEPT_NAME return;
		if seconds > LONGEST
			seconds is LONGEST;
		;;
		locked dns_kept
			u32 place: dns_next;
			bln found: false;
			while u32 i: 0; i < KEPT and not found; i++;
				if dns_addresses:i is 0
					place is i;
					found is true;
				;;
			;;
			if not found
				dns_next is (dns_next + 1) % KEPT;
			;;
			while u32 k: 0; k <= length; k++;
				dns_names:(place * KEPT_NAME + k) is (Lower: name:k);
			;;
			dns_addresses:place is address;
			dns_servers:place is server;
			dns_ports:place is port;
			dns_until:place is (OS.GetTicks) + (seconds * 1000) as int;
		;;
	[end]

	# drop every answer kept
	[Forget]
		locked dns_kept
			while u32 i: 0; i < KEPT; i++;
				dns_addresses:i is 0;
			;;
		;;
	[end]

	# whether name is the kept one (which is in small letters), whatever its case
	[SameName: ptr<u8> kept_name: 0; ptr<u8> name: 0;]
		u32 i: 0;
		while kept_name:i is not 0 and kept_name:i is (Lower: name:i)
			i++;
		;;
	[end: kept_name:i is 0 and name:i is 0]

	[Lower: u32 c: 0;]
		if c >= 'A' and c <= 'Z' return c + 32;
	[end: c]

	# where the name at pos ends: names are parts, each with its length first, ending with 0 or
	# with a 2-byte pointer to the rest of the name elsewhere in the message
	[SkipName: ptr<u8> r: 0; u32 pos: 0; u32 length: 0;]
		while pos < length
			u32 b: r:pos;
			if b is 0 return pos + 1;
			if (b & 0xC0) is 0xC0 return pos + 2;
			pos++ b + 1;
		;;
	[end: pos]
}
