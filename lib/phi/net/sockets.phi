# The network for user programs: UDP sockets and TCP connections, through the kernel
# (which needs use net.calls, and starts the network itself).
#
#   use net.sockets;
#   int s: (Udp.Open: 4000);                    # a socket on port 4000, or -1
#   UdpDatagram d;
#   while (Udp.Receive: s addr d)               # true for each one waiting; never waits
#       call Udp.SendTo: s d.from d.from_port d.data d.length;
#   ;;
#   int c: (Tcp.Connect: (Net.ParseIp: '10.0.2.2') 80);   # waits for the other side
#   int got: (Tcp.Read: c addr buffer 1000);    # waits up to Tcp.timeout ms
#
# These are the kernel's Udp, Tcp and Net (net.udp, net.tcp, net.net), with the same
# methods, so code moves between a kernel and a program by changing its use line. What
# differs: a program doesn't start the network (Net.Address says whether the kernel has),
# and while it waits it sleeps, so the kernel and the other programs carry on.
#
# A program's sockets, connections and listeners are its own: they're closed when it
# ends, even if it crashes.

use net.datagram;
use net.dnsmessage;

phi.Net:Program
{
	# this machine's address, or 0 if the kernel hasn't started the network
	[Address:]
	[end: (OS.NetAddress) as u32]

	# (the same as the kernel's Net, for the numbers in packets and addresses)
	# numbers in packets are big-endian: the most significant byte first
	[Get16: ptr<u8> p: 0;]
	[end: (p:0 << 8) | p:1]

	[Get32: ptr<u8> p: 0;]
		u32 value: ((p:0 << 24) | (p:1 << 16) | (p:2 << 8) | p:3) as u32;
	[end: value]

	[Put16: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 8;
		p:1 is value;
	[end]

	[Put32: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 24;
		p:1 is value >> 16;
		p:2 is value >> 8;
		p:3 is value;
	[end]

	# 'a.b.c.d' as an address; 0 if the text isn't one
	[ParseIp: ptr<u8> text: 0;]
		u32 address: 0;
		u32 part: 0;
		u32 digits: 0;
		u32 parts: 0;
		bln ok: true;
		u32 i: 0;
		while ok and text:i is not 0
			u8 c: text:i;
			if c >= '0' and c <= '9'
				part is part * 10 + (c - '0');
				digits++;
				ok is part <= 255 and digits <= 3;
			;;
			elif c is '.' and digits > 0 and parts < 3
				address is (address << 8) | part;
				parts++;
				part is 0;
				digits is 0;
			;;
			else
				ok is false;
			;;
			i++;
		;;
		if ok and parts is 3 and digits > 0
			address is (address << 8) | part;
		;;
		else
			address is 0;
		;;
	[end: address]

	[PrintIp: u32 address: 0;]
		log (address >> 24) '.' ((address >> 16) & 0xFF) '.' ((address >> 8) & 0xFF) '.' (address & 0xFF);
	[end]

	# (the kernel's Start and Wait, so code that calls them moves between the two by its
	# use line.) A program doesn't start the network: the kernel or system has; true if it
	# has, and address, mask and router are its choice, not the program's
	[Start: u32 address: 0; u32 mask: 0xFFFFFF00; u32 router: 0;]
	[end: (OS.NetAddress) is not 0]

	# a moment for what's on its way to arrive: the program sleeps a millisecond, so the
	# kernel (or system) and the other programs carry on
	[Wait]
		call OS.Sleep: 1;
	[end]
}

# The address of a name like 'example.com', the same call as a kernel's net.dns:
#
#   u32 address: (Dns.Resolve: 'example.com');   # 0 if it can't be found
#
# Text that already is an address comes back as one without asking, localhost is 127.0.0.1, and
# the system's hosts file comes next if it has one. Otherwise the system's name server is asked,
# over UDP, unless it gave the answer a little while ago (net.dnsmessage keeps the last answers for
# as long as they hold). Only IPv4 addresses. Threads may each ask at once.
phi.Dns:Program
{
	const u32 SERVER_PORT: 53;
	const int MOST_HOSTS: 16384;          # what's read of a hosts file

	u32 server: 0;                        # who's asked; 0 for the system's name server
	u32 server_port: 53;
	int tries: 3;
	int wait: 2000;                       # ms per try
	u32 next_id: 0;

	[Resolve: ptr<u8> name: 0;]
		if name:0 is 0 return 0 as u32;
		u32 address: (Net.ParseIp: name);
		if address is not 0 return address;
		if (Same: name 'localhost') return (Net.ParseIp: '127.0.0.1');
		# (one is the path on Linux, and the other on Windows; PHI OS's disk has neither)
		address is (FromHostsFile: '/etc/hosts' name);
		if address is 0
			address is (FromHostsFile: 'C:/Windows/System32/drivers/etc/hosts' name);
		;;
		if address is not 0 return address;

		u32 asked: server;
		if asked is 0
			asked is (OS.NetNameServer) as u32;
		;;
		if asked is 0 return 0 as u32;
		address is (DnsMessage.Kept: name asked server_port);
		if address is not 0 return address;
		u8 query[300];
		atomic next_id++;
		u32 id: ((OS.GetTicks) as u32 + next_id * 40503) & 0xFFFF;
		u32 length: (DnsMessage.Question: addr query 300 id name);
		if length is 0 return 0 as u32;

		int s: (Udp.Open: 0 8);
		if s < 0 return 0 as u32;
		UdpDatagram d;
		int tried: 0;
		while address is 0 and tried < tries
			if (Udp.SendTo: s asked server_port addr query length) and (Udp.Wait: s addr d wait) and d.from is asked
				u32 lasts: 0;
				address is (DnsMessage.Answer: addr d.data d.length id addr lasts);
				call DnsMessage.Keep: name asked server_port address lasts;
			;;
			tried++;
		;;
		call Udp.Close: s;
	[end: address]

	# name's address in a hosts file: lines of an address and the names it has; 0 if it's not there
	[FromHostsFile: ptr<u8> path: 0; ptr<u8> name: 0;]
		ptr<u8> text: new u8[MOST_HOSTS];
		int size: (OS.ReadFile: path text MOST_HOSTS - 1);
		u32 found: 0;
		int pos: 0;
		while pos < size and found is 0
			# a line's words: the first an address, the others names, up to any #
			u32 here: 0;
			int word: 0;
			while pos < size and text:pos is not 10 and text:pos is not '#'
				while pos < size and (text:pos is ' ' or text:pos is 9 or text:pos is 13)
					pos++;
				;;
				int start: pos;
				while pos < size and text:pos is not ' ' and text:pos is not 9 and text:pos is not 13 and text:pos is not 10 and text:pos is not '#'
					pos++;
				;;
				if pos > start
					u8 ended: text:pos;
					text:pos is 0;
					if word is 0
						here is (Net.ParseIp: text + start);
					;;
					elif here is not 0 and (Same: text + start name) and found is 0
						found is here;
					;;
					text:pos is ended;
					word++;
				;;
			;;
			while pos < size and text:pos is not 10
				pos++;
			;;
			pos++;
		;;
		free text;
	[end: found]

	# the same name, whatever the case
	[Same: ptr<u8> a: 0; ptr<u8> b: 0;]
		int i: 0;
		while a:i is not 0 and b:i is not 0
			if (Lower: a:i) is not (Lower: b:i) return false;
			i++;
		;;
	[end: a:i is b:i]

	[Lower: int c: 0;]
		if c >= 'A' and c <= 'Z' return c + 32;
	[end: c]
}

phi.Udp:Program
{
	const u32 MAX_DATA: 1472;

	# a socket for datagrams sent to port (0: any free port), keeping up to queue of
	# them (at most 256); -1 if the port is taken or every socket is open
	[Open: u32 port: 0; u32 queue: 64;]
	[end: (OS.UdpOpen: port queue)]

	[Close: int s: -1;]
		call OS.UdpClose: s;
	[end]

	# the oldest datagram for the socket, into target; false if none is waiting (it
	# never waits)
	[Receive: int s: -1; ptr<UdpDatagram> target: 0;]
	[end: (OS.UdpReceive: s target) is 1]

	# like Receive, but waits up to timeout ms for a datagram to arrive
	[Wait: int s: -1; ptr<UdpDatagram> target: 0; int timeout: 1000;]
		int start: (OS.GetTicks);
		while true
			if (Receive: s target) return true;
			if (OS.GetTicks) - start >= timeout return false;
			call OS.Sleep: 1;
		;;
	[end: false]

	# send length bytes of data to port at an address, from the socket's port; false
	# if it couldn't be sent
	[SendTo: int s: -1; u32 to: 0; u32 port: 0; ptr<u8> data: 0; u32 length: 0;]
		if s < 0 or port > 0xFFFF or length > MAX_DATA return false;
	[end: (OS.UdpSend: s | (port << 16) to data length) is 1]
}

phi.Tcp:Program
{
	const int CLOSED_AND_READ: -2;        # what the kernel's Take gives once all is read

	int timeout: 10000;                   # how long Read and Write wait, in ms

	# connect to a port; a connection number, or -1 if nobody answered (or refused)
	[Connect: u32 to: 0; u32 port: 0;]
		int handle: (OS.TcpBegin: to port);
		if handle < 0 return -1;
		while (OS.TcpState: handle) is 0
			call OS.Sleep: 1;
		;;
		if (OS.TcpState: handle) < 0
			call OS.TcpClose: handle;
			return -1;
		;;
	[end: handle]

	# send data, waiting while the send buffer is full; the bytes sent, or -1 if the
	# connection broke (or nothing could be sent for timeout ms)
	[Write: int handle: 0; ptr<u8> data: 0; u32 length: 0;]
		u32 done: 0;
		int idle: (OS.GetTicks);
		while done < length
			int taken: (OS.TcpSend: handle data + done length - done);
			if taken < 0 return -1;
			if taken > 0
				done++ taken;
				idle is (OS.GetTicks);
			;;
			elif (OS.GetTicks) - idle > timeout
				return -1;
			;;
			if done < length
				call OS.Sleep: 1;
			;;
		;;
	[end: done as int]

	# what has arrived, up to max bytes (waiting up to timeout ms if nothing has): the
	# bytes, 0 once the other side has closed and everything is read, -1 on a timeout or
	# a reset
	[Read: int handle: 0; ptr<u8> to: 0; u32 max: 0;]
		int start: (OS.GetTicks);
		while true
			int got: (OS.TcpTake: handle to max);
			if got > 0 return got;
			if got is CLOSED_AND_READ return 0;
			if got < 0 or (OS.GetTicks) - start >= timeout return -1;
			call OS.Sleep: 1;
		;;
	[end: -1]

	# finish the connection: what's still in its send buffer goes, then a FIN. (wait is
	# for net.tcp's sake, which has the same calls: here the kernel finishes the close,
	# even after the program has stopped.)
	[Close: int handle: 0; int wait: 0;]
		call OS.TcpClose: handle;
	[end]

	# ---- for servers: nothing here waits

	# take connections to port (up to backlog waiting, at most 256); a listener, or -1
	[Listen: u32 port: 0; u32 backlog: 64;]
	[end: (OS.TcpListen: port backlog)]

	# a connection that has come in on a listener, or -1 if none is waiting
	[Accept: int listener: 0;]
	[end: (OS.TcpAccept: listener)]

	# stop taking connections; the ones waiting for Accept are closed
	[StopListening: int listener: 0;]
		call OS.TcpStopListening: listener;
	[end]

	# how much can be read now; -1 once the connection is closed (and everything is
	# read) or reset
	[Waiting: int handle: 0;]
	[end: (OS.TcpWaiting: handle)]

	# put up to length bytes in the send buffer; how many it took (0 when it's full), or
	# -1 if the connection is broken or closing
	[Send: int handle: 0; ptr<u8> data: 0; u32 length: 0;]
	[end: (OS.TcpSend: handle data length)]

	# the address of the other end of a connection (0 if there's no such connection)
	[Address: int handle: 0;]
	[end: (OS.TcpAddress: handle) as u32]
}
