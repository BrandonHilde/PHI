# DNS: the address of a name like 'example.com', asked of Net.dns. 32-bit kernels.
#
#   use net.dns;
#   u32 address: 0;
#   call address is Dns.Resolve: 'example.com';   # 0 if it can't be found
#
# Text that already is an address ('10.0.2.2') comes back as one without asking, and so does a
# name asked a little while ago (net.dnsmessage keeps the last answers for as long as they hold).

use net.net;
use net.dnsmessage;

phi.Dns:Kernel
{
	const u32 SERVER_PORT: 53;
	const int TRIES: 3;
	const int WAIT: 2000;                 # ms per try

	u8 query[300];
	u32 query_id: 0x1234;

	[Resolve: ptr<u8> name: 0;]
		u32 address: 0;
		call address is Net.ParseIp: name;

		if address is 0 and name:0 is not 0
			address is (DnsMessage.Kept: name Net.dns SERVER_PORT);
		;;
		u32 length: 0;
		if address is 0 and name:0 is not 0
			query_id++;
			length is (DnsMessage.Question: addr query query.len query_id name);
		;;

		if length > 0
			u32 ticks: 0;
			call ticks is OS.GetTicks;
			u32 port: 50000 + (ticks % 10000);
			int tries: 0;
			while address is 0 and tries < TRIES
				call Net.Listen: port;
				bln sent: false;
				call sent is Net.SendUdp: Net.dns port SERVER_PORT addr query length;
				int got: 0;
				call got is Net.WaitUdp: WAIT;
				if got > 0
					u32 lasts: 0;
					address is (DnsMessage.Answer: addr Net.udp_data got query_id addr lasts);
					call DnsMessage.Keep: name Net.dns SERVER_PORT address lasts;
				;;
				tries++;
			;;
			call Net.Listen: 0;
		;;
	[end: address]
}
