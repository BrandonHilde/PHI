# TLS 1.3 over a TCP connection, driven without ever waiting: what a server needs, with
# many connections at once (a kernel's, or a program's). Use net.tcp (a kernel) or
# net.sockets (a program) as well: their Tcp is what this sends and receives through.
#
#   use net.sockets;
#   use net.tlslink;
#   TlsLink link;
#   int c: (Tcp.Accept: listener);
#   bln ok: (Secure.Accept: addr link c addr identity);  # a server's side of c (a TlsIdentity)
#   # then, each time round the server's loop:
#   if not (Secure.Pump: addr link)                      # sends what it can, takes what came
#       call Secure.Close: addr link;                    # it closed, broke, or failed (link.session.error)
#   ;;
#   int got: (Secure.Read: addr link buffer max);        # data that has come: 0 if none yet
#   int taken: (Secure.Write: addr link data length);    # sent as Pump gets the chance
#
# Secure.Connect: link c host is a client's side, the same way. The protocol is net.tls13's:
# link.session is the TlsSession (link.session.connected once the handshake is done).

use net.tls13;

# a TCP connection with TLS on it
struct.TlsLink
{
	int connection;
	TlsSession session;
}

phi.Secure:Library
{
	# link = the server's side of TLS on connection c, showing identity; false if there's no memory for it
	[Accept: ptr<TlsLink> link: 0; int c: -1; ptr<TlsIdentity> identity: 0;]
		link.connection is c;
	[end: (Tls13.Server: addr link.session identity)]

	# link = a client's side of TLS on connection c, to host (what its certificate must be
	# for); false if there's no memory for it
	[Connect: ptr<TlsLink> link: 0; int c: -1; ptr<u8> host: 0;]
		link.connection is c;
	[end: (Tls13.Client: addr link.session host)]

	# send what the session has (as much as TCP takes now), and give it what has come;
	# false once it can't go on (TCP closed or broke, or the session failed)
	[Pump: ptr<TlsLink> link: 0;]
		ptr<TlsSession> s: addr link.session;
		while (Tls13.Pending: s) > 0
			int taken: (Tcp.Send: link.connection (Tls13.Outgoing: s) (Tls13.Pending: s));
			if taken < 0 return false;
			if taken is 0 break;
			call Tls13.Sent: s taken;
		;;
		int ready: (Tcp.Waiting: link.connection);
		while ready > 0 and s.room > 0 and not s.failed
			u32 n: ready;
			if n > s.room
				n is s.room;
			;;
			int got: (Tcp.Read: link.connection (Tls13.Room: s) n);
			if got <= 0 break;
			call Tls13.Received: s got;
			ready is (Tcp.Waiting: link.connection);
		;;
		# (what the session made of it, such as the rest of its handshake, goes next time)
		if s.failed
			# the alert that says why, if TCP takes it
			int taken: (Tcp.Send: link.connection (Tls13.Outgoing: s) (Tls13.Pending: s));
			return false;
		;;
		if ready < 0 and s.app_left is 0 return false;
	[end: true]

	# data that has come (up to max bytes): how many; 0 if none yet, -1 once it's closed
	[Read: ptr<TlsLink> link: 0; ptr<u8> buffer: 0; u32 max: 0;]
	[end: (Tls13.Read: addr link.session buffer max)]

	# data to send: how much was taken (it goes as Pump gets the chance); -1 if the
	# handshake isn't done
	[Write: ptr<TlsLink> link: 0; ptr<u8> data: 0; u32 length: 0;]
	[end: (Tls13.Write: addr link.session data length)]

	# close_notify, sent if TCP takes it now, then the connection closed and the session freed
	[Close: ptr<TlsLink> link: 0;]
		call Tls13.Close: addr link.session;
		ptr<TlsSession> s: addr link.session;
		if (Tls13.Pending: s) > 0 and link.connection >= 0
			int taken: (Tcp.Send: link.connection (Tls13.Outgoing: s) (Tls13.Pending: s));
		;;
		if link.connection >= 0
			call Tcp.Close: link.connection;
		;;
		link.connection is -1;
		call Tls13.Free: s;
	[end]
}
