# TLS 1.3 over a 32-bit kernel's TCP, the client side: an encrypted connection to a
# server, which is what https:// is. Http.Get uses it for https:// URLs.
#
#   use net.tls;
#   bln ok: false;
#   call ok is Tls.Connect: address 443 'example.com';    # false: Tls.error says why
#   int sent: 0;
#   call sent is Tls.Write: request length;
#   int got: 0;
#   call got is Tls.Read: buffer max;    # bytes; 0 once the server has closed; -1 on an error
#   call Tls.Close;
#
# One connection at a time, which waits for the server as it goes (as net.tcp's Connect,
# Write and Read do). The protocol itself is net.tls13's: this gives it what TCP brings
# and sends what it makes. The server's certificate is checked there: it must be for
# host, go back to a root the program trusts (X509.Trust, or Roots.TrustAll from
# crypto.roots, before connecting), and have signed the handshake; if any of that fails,
# so does Connect, and Tls.verified says it checked out.

use net.tcp;
use net.tls13;

phi.Tls:Kernel
{
	str error: [100];                     # why Connect, Read or Write failed
	u32 alert: 0;                         # the alert the server sent, if it sent one
	u32 suite: 0;                         # the cipher suite the server chose
	bln verified: false;                  # the server's certificate was checked, and is good
	u32 offer: 3;                         # suites to offer: 1 AES-128-GCM, 2 ChaCha20-Poly1305, 3 both

	int tls_connection: -1;
	bln tls_open: false;                  # tls_session has its buffers
	TlsSession tls_session;

	# connect and do the handshake; host is the server's name, or its address written out
	# (what its certificate must be for)
	[Connect: u32 address: 0; u32 port: 0; ptr<u8> host: 0;]
		call Close;
		error is '';
		alert is 0;
		suite is 0;
		verified is false;
		tls_session.offer is offer;
		tls_open is true;
		if not (Tls13.Client: addr tls_session host) return (Tls.Failed);
		tls_connection is (Tcp.Connect: address port);
		if tls_connection < 0
			error is 'could not connect';
			call Close;
			return false;
		;;
		while not tls_session.connected and not tls_session.failed
			if not (Tls.Flush) return (Tls.Failed);
			if not (Tls.Fill) return (Tls.Failed);
		;;
		# (our Finished, or the alert that says why not)
		bln flushed: (Tls.Flush);
		if tls_session.failed or not flushed return (Tls.Failed);
		suite is tls_session.suite;
		verified is tls_session.verified;
	[end: true]

	# send data; length, or -1 if the connection failed
	[Write: ptr<u8> data: 0; u32 length: 0;]
		if not tls_open or not tls_session.connected return -1;
		u32 done: 0;
		while done < length
			int taken: (Tls13.Write: addr tls_session data + done length - done);
			if taken < 0 return -1;
			done++ taken;
			if not (Tls.Flush) return -1;
		;;
	[end: length]

	# read what the server sent: the number of bytes, 0 once it has closed the
	# connection, or -1 on an error (error says what) or a timeout
	[Read: ptr<u8> buffer: 0; u32 max: 0;]
		if not tls_open return -1;
		while true
			int got: (Tls13.Read: addr tls_session buffer max);
			if got > 0 return got;
			if got < 0
				if tls_session.closed and not tls_session.failed return 0;
				error is tls_session.error;
				alert is tls_session.alert;
				return -1;
			;;
			# nothing yet: what we owe the server (a KeyUpdate's answer), then wait for more
			if not (Tls.Flush) return -1;
			if not (Tls.Fill)
				if tls_session.closed return 0;
				return -1;
			;;
		;;
	[end: -1]

	# say goodbye (close_notify) and close the TCP connection
	[Close]
		if tls_open
			if tls_connection >= 0
				call Tls13.Close: addr tls_session;
				bln flushed: (Tls.Flush);
			;;
			call Tls13.Free: addr tls_session;
			tls_open is false;
		;;
		if tls_connection >= 0
			call Tcp.Close: tls_connection;
			tls_connection is -1;
		;;
	[end]

	# send what the session has for the server; false if TCP couldn't take it
	[Flush]
		while (Tls13.Pending: addr tls_session) > 0
			int sent: (Tcp.Write: tls_connection (Tls13.Outgoing: addr tls_session) (Tls13.Pending: addr tls_session));
			if sent <= 0
				error is 'the connection broke';
				return false;
			;;
			call Tls13.Sent: addr tls_session sent;
		;;
	[end: true]

	# wait for what the server sends next, and give it to the session; false if it closed,
	# stopped answering, or what came didn't check out
	[Fill]
		int got: (Tcp.Read: tls_connection (Tls13.Room: addr tls_session) tls_session.room);
		if got <= 0
			if got is 0
				tls_session.closed is true;
				error is 'the server closed the connection';
			;;
			else
				error is 'the server stopped answering';
			;;
			return false;
		;;
		if not (Tls13.Received: addr tls_session got)
			error is tls_session.error;
			alert is tls_session.alert;
			return false;
		;;
	[end: true]

	# the handshake failed: error says why (the session's reason, if it has one); the
	# connection is closed (after the alert that tells the server, if there's one to send)
	[Failed]
		if tls_session.error.len > 0
			error is tls_session.error;
		;;
		alert is tls_session.alert;
		if tls_connection >= 0
			bln flushed: (Tls.Flush);
		;;
		call Tls13.Free: addr tls_session;
		tls_open is false;
		if tls_connection >= 0
			call Tcp.Close: tls_connection;
			tls_connection is -1;
		;;
	[end: false]
}
