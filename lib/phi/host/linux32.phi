# 32-bit Linux's own, for the host modules that are Linux's (time_linux32.phi,
# files_linux.phi, net_linux.phi): its system calls' numbers (i386's, through int 0x80), and the little
# that differs from 64-bit Linux beyond them. linux64.phi is the same for x86-64.

phi.LinuxLayout:Linux32
{
	const int LARGE_FILE: 0x8000;         # O_LARGEFILE: a file of 2 GB or more can be opened

	# an open file's size, into size; false if it isn't a regular file
	[SizeOf: int fd: 0; ptr<u64> size: 0;]
		u32 info[24];
		if (sys.FStat64: fd addr info) is not 0 return false;
		if (info:4 & 0xF000) is not 0x8000 return false;
		u64 whole: info:12;
		size:0 is (whole << 32) | info:11;
	[end: true]

	# what's at path: its mode, or -1 if there's nothing; its size and when it was last written
	# (seconds since 1970) into what's given
	[StatOf: ptr<u8> path: 0; ptr<u64> size: 0; ptr<u32> seconds: 0;]
		u32 info[24];
		if (sys.Stat: path addr info) is not 0 return -1;
		u64 whole: info:12;
		size:0 is (whole << 32) | info:11;
		seconds:0 is info:18;
	[end: info:4 as int]

	# reading goes on from position; false if Linux says no (_llseek takes its two halves)
	[SeekTo: int fd: 0; u64 position: 0;]
		u64 got: 0;
		if (sys.LLSeek: fd (position >> 32) as u32 position as u32 addr got 0) is not 0 return false;
	[end: got is position]

	# a file's size, or -1 if it isn't a file, and an error from 2 GB up, which an int can't
	# hold (Linux's stat64: the mode at byte 16, the size at 44)
	[FileSize: ptr<u8> path: 0;]
		u32 info[24];
		if (sys.Stat: path addr info) is not 0 return -1;
		if (info:4 & 0xF000) is not 0x8000 return -1;   # not a regular file
		if info:12 is not 0 or info:11 >= 0x80000000
			throw 'a file of 2 GB or more is more than OS.FileSize can say: ' path;
		;;
	[end: info:11 as int]
}

sys.Read: 3  int fd  ptr<u8> buffer  u32 count;
sys.MemoryProtect: 125  ptr<u8> start  u32 length  int how;
sys.Write: 4  int fd  ptr<u8> data  u32 count;
sys.Open: 5  ptr<u8> path  int flags  int mode;
sys.Close: 6  int fd;
sys.Unlink: 10  ptr<u8> path;
sys.Time: 13  ptr<u32> seconds: u32;
sys.LSeek: 19  int fd  int offset  int whence;
sys.Rename: 38  ptr<u8> from  ptr<u8> to;
sys.MakeDir: 39  ptr<u8> path  int mode;
sys.RemoveDir: 40  ptr<u8> path;
sys.SchedYield: 158;
sys.GetUserId: 199;
sys.GetProcessId: 20;
sys.NanoSleep: 162  ptr<int> wanted  ptr<int> left;
sys.Stat: 195  ptr<u8> path  ptr<u32> info;
sys.FStat64: 197  int fd  ptr<u32> info;
sys.GetDents: 220  int fd  ptr<u8> buffer  u32 count;
sys.LLSeek: 140  int fd  u32 high  u32 low  ptr<u64> result  int whence;
sys.ClockGetTime: 265  int clock  ptr<int> now;

# the sockets (Linux 4.3 and later has a call for each, not one socketcall)
sys.Ioctl: 54  int fd  int request  ptr<int> value;
sys.Socket: 359  int family  int type  int protocol;
sys.Bind: 361  int fd  ptr<u8> address  int length;
sys.Connect: 362  int fd  ptr<u8> address  int length;
sys.Listen: 363  int fd  int backlog;
sys.Accept4: 364  int fd  ptr<u8> address  ptr<int> length  int flags;
sys.GetSockOpt: 365  int fd  int level  int name  ptr<int> value  ptr<int> length;
sys.SetSockOpt: 366  int fd  int level  int name  ptr<int> value  int length;
sys.GetSockName: 367  int fd  ptr<u8> address  ptr<int> length;
sys.GetPeerName: 368  int fd  ptr<u8> address  ptr<int> length;
sys.SendTo: 369  int fd  ptr<u8> data  u32 length  int flags  ptr<u8> to  int tolength;
sys.RecvFrom: 371  int fd  ptr<u8> buffer  u32 length  int flags  ptr<u8> from  ptr<int> fromlength;
