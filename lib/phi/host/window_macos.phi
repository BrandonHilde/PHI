ObjC.sel_registerName: ptr<u8> name: ptr<u8>;
ObjC.objc_autoreleasePoolPush: : ptr<u8>;
ObjC.objc_autoreleasePoolPop: ptr<u8> pool;
ObjC.Send = 'objc_msgSend': ptr<u8> object ptr<u8> selector: ptr<u8>;
ObjC.Send1 = 'objc_msgSend': ptr<u8> object ptr<u8> selector ptr<u8> value: ptr<u8>;
ObjC.SendInt = 'objc_msgSend': ptr<u8> object ptr<u8> selector i64 value;
ObjC.SendBool = 'objc_msgSend': ptr<u8> object ptr<u8> selector: u8;
ObjC.SendU16 = 'objc_msgSend': ptr<u8> object ptr<u8> selector: u16;
ObjC.SendF64 = 'objc_msgSend': ptr<u8> object ptr<u8> selector: f64;
ObjC.SendSize = 'objc_msgSend': ptr<u8> object ptr<u8> selector f64 width f64 height;
ObjC.InitWindow = 'objc_msgSend': ptr<u8> object ptr<u8> selector f64 x f64 y f64 width f64 height i64 style i64 backing i64 defer: ptr<u8>;
ObjC.NextEvent = 'objc_msgSend': ptr<u8> object ptr<u8> selector u64 mask ptr<u8> until ptr<u8> mode i64 dequeue: ptr<u8>;
