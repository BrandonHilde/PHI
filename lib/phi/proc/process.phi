# Processes for 32-bit kernels: run programs from the disk in user mode.
#
#   use proc.process;
#   int pid: 0;
#   call pid is Process.Spawn: 'HELLO.BIN';   # -1 if it can't start
#   call pid is Process.Spawn: 'ECHO.BIN' 'hello there';   # with a command line
#   int code: 0;
#   call code is Process.Wait: pid;            # its exit code; -1 if it crashed
#
# A program (classes that inherit Program; `phi build` compiles any .phi file in
# a kernel's rootfs into NAME.BIN) runs in ring 3 with its own address space:
# its code and data at 0x40000000, a 64 KB stack ending at 0x40400000, a heap
# that grows up from there (OS.Grow, which memory.heap uses for new), and the
# kernel's memory mapped but out of reach. It talks to the kernel through
# system calls (lib/x86_32/tasks.asm); the ones numbered 16 and up (programs,
# files, process information, the screen, sound) are handled here. Libraries add
# their own from 64 up (gui.surfaces does) by setting more_calls, and on_release
# hears when a program's memory is about to go back.
#
# The timer shares the CPU between programs. The kernel's own code runs until it
# waits (Wait, WaitAll, OS.Yield) or its main code ends.

use memory.heap;
use fs.fat16;
use drivers.ac97;

# the registers saved when a program made a system call
struct.SyscallFrame
{
	u32 gs;
	u32 fs;
	u32 es;
	u32 ds;
	u32 edi;
	u32 esi;
	u32 ebp;
	u32 esp;
	u32 ebx;
	u32 edx;
	u32 ecx;
	u32 eax;
	u32 vector;
	u32 error;
	u32 eip;
	u32 cs;
	u32 eflags;
	u32 user_esp;
	u32 user_ss;
}

phi.Process:Kernel
{
	const u32 USER_BASE: 0x40000000;
	const u32 USER_TOP: 0x40400000;
	const u32 PAGE_SIZE: 4096;
	const u32 STACK_PAGES: 16;              # 64 KB
	const u32 PAGE_USER: 7;                 # present, writable, user mode may use it
	const u32 KERNEL_STACK_SIZE: 8192;
	const int MAX_PROCESSES: 16;

	const u32 TASK_FREE: 0;
	const u32 TASK_EXITED: 5;
	const u32 TASK_COLLECTED: 6;
	const u32 ARGUMENTS_SIZE: 256;          # a program's command line, at the bottom of its stack area
	const u32 NAME_SIZE: 16;

	const u32 SYS_SPAWN: 16;
	const u32 SYS_READ_FILE: 17;
	const u32 SYS_WRITE_FILE: 18;
	const u32 SYS_DELETE_FILE: 19;
	const u32 SYS_LIST_FILES: 20;
	const u32 SYS_FILE_SIZE: 21;
	const u32 SYS_TASK_STATE: 22;
	const u32 SYS_TASK_NAME: 23;
	const u32 SYS_KILL: 24;
	const u32 SYS_FREE_MEMORY: 25;
	const u32 SYS_TOTAL_MEMORY: 26;
	const u32 SYS_REBOOT: 27;
	const u32 SYS_CLEAR: 28;
	const u32 SYS_PUT_CELL: 29;
	const u32 SYS_KEY_DOWN: 30;
	const u32 SYS_READ_FILE_AT: 31;
	const u32 SYS_SOUND_WRITE: 32;
	const u32 SYS_SOUND_RATE: 33;
	const u32 SYS_SOUND_QUEUED: 34;
	const u32 SYS_SOUND_STOP: 35;
	const u32 SYS_SOUND_VOLUME: 36;
	const u32 SYS_GROW: 37;
	const u32 SYS_LIST_FOLDER: 38;
	const u32 SYS_MAKE_FOLDER: 39;
	const u32 SYS_RENAME: 40;
	const u32 SYS_DELETE_FOLDER: 41;
	const u32 SYS_MORE: 64;                 # from here on, more_calls handles them

	const u32 HEAP_LIMIT: 0x48000000;       # a program's heap is at most 124 MB (from USER_TOP)
	const u32 GROW_SPARE: 256;              # frames left for the kernel when a program grows

	u32 process_directory[16];              # 0: no process with this number
	u32 process_kernel_stack[16];
	u32 process_image_end[16];
	u32 process_heap_end[16];               # its heap is USER_TOP up to this
	u8 process_names[256];                  # 16 bytes for each process
	u32 started: 0;
	u8 call_path[64];                       # copies of a system call's text arguments
	u8 call_arguments[256];
	u8 call_path_to[64];                    # where Rename moves call_path to

	# system calls 64 and up: their number and four arguments, and the result to give back
	method<u32 u32 u32 u32 u32: int> more_calls: 0;
	# told a process's number before its memory goes back
	method<int> on_release: 0;
	# answers OS.IsKeyDown for programs (1 if the key is held) when the kernel has its own
	# keyboard driver, as gui.desktop does with drivers.input; 0 uses the built-in one
	method<u32: int> key_down: 0;

	call OS.StartMultitasking;
	call OS.SetSyscallHandler: addr HandleSyscall;

	# load a program from the disk and start it, with a command line it can read
	# with OS.Arguments; its process number, or -1
	[Spawn: ptr<u8> path: 0; ptr<u8> arguments: 0;]
		int pid: -1;
		int size: 0;
		call size is Fat.FileSize: path;
		u32 pages: (size + PAGE_SIZE - 1) / PAGE_SIZE;

		if size > 0 and pages + STACK_PAGES <= 1024
			ptr<u8> image: new u8[size];
			int got: 0;
			call got is Fat.ReadFile: path image size;

			ptr<u32> directory: 0;
			ptr<u32> table: 0;
			u32 kernelStack: 0;
			call directory is Frames.Alloc;
			call table is Frames.Alloc;
			call kernelStack is Frames.AllocContiguous: 2;

			if got is size and directory is not 0 and table is not 0 and kernelStack is not 0
				# the kernel's mappings (out of reach in user mode), then the program's 4 MB
				while u32 i: 0; i < 1024; i++;
					directory:i is Paging.page_directory:i;
					table:i is 0;
				;;
				directory:(USER_BASE >> 22) is table | PAGE_USER;

				# its code and data
				while u32 p: 0; p < pages; p++;
					ptr<u8> frame: 0;
					call frame is NewPage;
					u32 offset: p * PAGE_SIZE;
					u32 chunk: PAGE_SIZE;
					if chunk > size - offset
						chunk is size - offset;
					;;
					while u32 b: 0; b < chunk; b++;
						frame:b is image:(offset + b);
					;;
					table:p is frame | PAGE_USER;
				;;

				# its stack, at the top of the 4 MB; the command line goes at the bottom of it
				while u32 s: 0; s < STACK_PAGES; s++;
					ptr<u8> stackFrame: 0;
					call stackFrame is NewPage;
					table:(1024 - STACK_PAGES + s) is stackFrame | PAGE_USER;
					if s is 0 and arguments is not 0
						u32 a: 0;
						while a < ARGUMENTS_SIZE - 1 and arguments:a is not 0
							stackFrame:a is arguments:a;
							a++;
						;;
					;;
				;;

				u32 imageEnd: USER_BASE + pages * PAGE_SIZE;
				u32 stackBottom: USER_TOP - STACK_PAGES * PAGE_SIZE;
				call pid is OS.CreateUserTask: directory USER_BASE USER_TOP kernelStack + KERNEL_STACK_SIZE imageEnd stackBottom;
				if pid > 0
					process_directory:pid is directory;
					process_kernel_stack:pid is kernelStack;
					process_image_end:pid is imageEnd;
					process_heap_end:pid is USER_TOP;
					started++;
					# its name: the file name, without any folders
					u32 nameStart: 0;
					u32 n: 0;
					while path:n is not 0
						if path:n is '/'
							nameStart is n + 1;
						;;
						n++;
					;;
					while u32 k: 0; k < NAME_SIZE; k++;
						process_names:(pid * NAME_SIZE + k) is 0;
					;;
					u32 copied: 0;
					while copied < NAME_SIZE - 1 and path:(nameStart + copied) is not 0
						u8 c: path:(nameStart + copied);
						if c >= 'a' and c <= 'z'
							c is c - 32;                  # file names are capitals on FAT16
						;;
						process_names:(pid * NAME_SIZE + copied) is c;
						copied++;
					;;
				;;
			;;
			free image;
		;;
	[end: pid]

	# wait for a program the kernel started; its exit code (-1 if it crashed)
	[Wait: int pid: 0;]
		int code: -1;
		if pid > 0 and pid < MAX_PROCESSES
			if process_directory:pid is not 0
				u32 state: 1;
				call state is OS.TaskState: pid;
				while state is not TASK_EXITED and state is not TASK_COLLECTED
					call OS.Yield;
					call CollectFinished;
					call state is OS.TaskState: pid;
				;;
				call code is OS.TaskExitCode: pid;
				call Release: pid;
			;;
		;;
	[end: code]

	# wait until every program has finished
	[WaitAll]
		bln running: true;
		while running
			call CollectFinished;
			running is false;
			while int pid: 1; pid < MAX_PROCESSES; pid++;
				if process_directory:pid is not 0
					u32 state: 0;
					u32 parent: 0;
					call state is OS.TaskState: pid;
					call parent is OS.TaskParent: pid;
					if state is TASK_EXITED and parent is 0
						call Release: pid;
					;;
					else
						running is true;
					;;
				;;
			;;
			if running
				call OS.Yield;
			;;
		;;
	[end]

	# free programs whose parent program has read their exit code, and finished
	# programs whose parent is gone
	[CollectFinished]
		while int pid: 1; pid < MAX_PROCESSES; pid++;
			if process_directory:pid is not 0
				u32 state: 0;
				u32 parent: 0;
				u32 parentState: 0;
				call state is OS.TaskState: pid;
				call parent is OS.TaskParent: pid;
				call parentState is OS.TaskState: parent;
				bln orphan: parent is not 0 and (parentState is TASK_FREE or parentState >= TASK_EXITED);
				if state is TASK_COLLECTED or (state is TASK_EXITED and orphan)
					call Release: pid;
				;;
			;;
		;;
	[end]

	# copy a process's name (up to 15 characters, then a zero) into buffer, which
	# holds 16; true if it has one. OS.TaskName in a kernel comes here.
	[TaskName: u32 process: 0; ptr<u8> buffer: 0;]
		buffer:0 is 0;
		if process >= MAX_PROCESSES
			return false;
		;;
		while u32 k: 0; k < NAME_SIZE; k++;
			buffer:k is process_names:(process * NAME_SIZE + k);
		;;
		buffer:(NAME_SIZE - 1) is 0;
	[end: (buffer:0 is not 0)]

	# give a finished program's memory back
	[Release: int pid: 0;]
		if on_release is not 0
			call on_release: pid;
		;;
		ptr<u32> directory: process_directory:pid;
		# its 4 MB of code, data and stack, then each 4 MB its heap grew into
		while u32 d: USER_BASE >> 22; d <= (process_heap_end:pid - 1) >> 22; d++;
			if (directory:d & 1) is not 0
				call ReleaseTable: directory:d & 0xFFFFF000;
			;;
		;;
		call Frames.Free: directory;
		call Frames.Free: process_kernel_stack:pid;
		call Frames.Free: process_kernel_stack:pid + PAGE_SIZE;
		process_directory:pid is 0;
		call OS.FreeTask: pid;
	[end]

	# give back a page table and every page it maps
	[ReleaseTable: ptr<u32> table: 0;]
		while u32 i: 0; i < 1024; i++;
			if (table:i & 1) is not 0
				call Frames.Free: table:i & 0xFFFFF000;
			;;
		;;
		call Frames.Free: table;
	[end]

	# map bytes more (whole pages, zeroed) at the end of the calling program's heap;
	# where the new memory starts, or 0 if there's no room
	[Grow: u32 bytes: 0;]
		int pid: (OS.CurrentTask);
		u32 start: process_heap_end:pid;
		u32 pages: (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
		if pid <= 0 or pid >= MAX_PROCESSES or start is 0 or pages is 0 return 0;
		if pages > (HEAP_LIMIT - start) / PAGE_SIZE return 0;
		# each page, and a page table for each 4 MB it starts, plus some for the kernel
		if Frames.free_frames < pages + pages / 1024 + 2 + GROW_SPARE return 0;

		ptr<u32> directory: process_directory:pid;
		while u32 p: 0; p < pages; p++;
			u32 address: start + p * PAGE_SIZE;
			u32 d: address >> 22;
			if (directory:d & 1) is 0
				ptr<u32> fresh: (NewPage);
				directory:d is fresh | PAGE_USER;
			;;
			elif directory:d is Paging.page_directory:d
				return 0;           # the kernel's (a device's memory): not for a heap
			;;
			ptr<u32> table: directory:d & 0xFFFFF000;
			ptr<u32> page: (NewPage);
			table:((address >> 12) & 1023) is page | PAGE_USER;
		;;

		process_heap_end:pid is start + pages * PAGE_SIZE;
		call OS.SetTaskHeapEnd: pid process_heap_end:pid;
	[end: start]

	# a zeroed frame
	[NewPage]
		ptr<u32> page: 0;
		call page is Frames.Alloc;
		if page is not 0
			while u32 w: 0; w < 1024; w++;
				page:w is 0;
			;;
		;;
	[end: page]

	# is [address, address + length) memory the calling program owns?
	[UserRange: u32 address: 0; u32 length: 0;]
		u32 caller: 0;
		call caller is OS.CurrentTask;
		u32 last: address + length;
		bln inImage: address >= USER_BASE and last >= address and last <= process_image_end:caller;
		bln inStack: address >= USER_TOP - STACK_PAGES * PAGE_SIZE and last >= address and last <= USER_TOP;
		bln inHeap: address >= USER_TOP and last >= address and last <= process_heap_end:caller;
	[end: inImage or inStack or inHeap]

	# copy a zero-terminated string out of the calling program's memory, checking
	# every byte is inside it; false if it isn't (or doesn't end within max bytes)
	[CopyFromUser: u32 from: 0; ptr<u8> to: 0; u32 max: 0;]
		bln ok: true;
		bln ended: false;
		u32 length: 0;
		while ok and ended is false and length < max
			bln inside: false;
			call inside is UserRange: from + length 1;
			if inside
				ptr<u8> byte: from + length;
				to:length is byte:0;
				ended is (byte:0 is 0);
				length++;
			;;
			else
				ok is false;
			;;
		;;
	[end: ok and ended]

	# system calls numbered 16 and up, from programs: the number is in the saved
	# eax, arguments in ebx, ecx and edx, and the result goes back in eax
	[HandleSyscall]
		ptr<SyscallFrame> frame: 0;
		call frame is OS.SyscallFrame;
		u32 number: frame:0.eax;
		u32 first: frame:0.ebx;
		u32 second: frame:0.ecx;
		u32 third: frame:0.edx;
		u32 fourth: frame:0.esi;
		int result: -1;
		bln ok: false;

		# most calls start with a path
		bln pathOk: false;
		bln named: (number >= SYS_SPAWN and number <= SYS_FILE_SIZE) or number is SYS_READ_FILE_AT;
		if named or (number >= SYS_LIST_FOLDER and number <= SYS_DELETE_FOLDER)
			call pathOk is CopyFromUser: first addr call_path 64;
		;;

		# the sound calls find the card the first time
		bln sound: false;
		if number >= SYS_SOUND_WRITE and number <= SYS_SOUND_VOLUME
			call sound is Ac97.Start;
		;;

		if number is SYS_SPAWN
			bln argumentsOk: true;
			call_arguments:0 is 0;
			if second is not 0
				call argumentsOk is CopyFromUser: second addr call_arguments 256;
			;;
			if pathOk and argumentsOk
				call result is Spawn: addr call_path addr call_arguments;
			;;
		;;
		elif number is SYS_READ_FILE
			call ok is UserRange: second third;
			if pathOk and ok
				call result is Fat.ReadFile: addr call_path second third;
			;;
		;;
		elif number is SYS_WRITE_FILE
			call ok is UserRange: second third;
			if pathOk and ok
				call ok is Fat.WriteFile: addr call_path second third;
				result is ok;
			;;
		;;
		elif number is SYS_DELETE_FILE
			if pathOk
				call ok is Fat.Delete: addr call_path;
				result is ok;
			;;
		;;
		elif number is SYS_LIST_FILES
			if pathOk
				call result is Fat.List: addr call_path;
			;;
		;;
		elif number is SYS_FILE_SIZE
			if pathOk
				call result is Fat.FileSize: addr call_path;
			;;
		;;
		elif number is SYS_TASK_STATE
			result is 0;
			if first < MAX_PROCESSES
				call result is OS.TaskState: first;
			;;
		;;
		elif number is SYS_TASK_NAME
			result is 0;
			call ok is UserRange: second NAME_SIZE;
			if ok
				call result is TaskName: first second;
			;;
		;;
		elif number is SYS_KILL
			call result is OS.KillTask: first;
		;;
		elif number is SYS_FREE_MEMORY
			result is Frames.free_frames * 4;
		;;
		elif number is SYS_TOTAL_MEMORY
			result is Frames.total_frames * 4;
		;;
		elif number is SYS_REBOOT
			call OS.Reboot;
		;;
		elif number is SYS_CLEAR
			call OS.ClearScreen;
			result is 0;
		;;
		elif number is SYS_PUT_CELL
			call OS.PutCell: first second third;
			result is 0;
		;;
		elif number is SYS_KEY_DOWN
			if key_down is not 0
				call result is key_down: first;
			;;
			else
				call OS.SetupKeyboardInterupt;
				call result is OS.IsKeyDown: first;
			;;
		;;
		elif number is SYS_READ_FILE_AT
			call ok is UserRange: third fourth;
			if pathOk and ok
				call result is Fat.ReadAt: addr call_path second third fourth;
			;;
		;;
		elif number is SYS_GROW
			call result is Grow: first;
		;;
		elif number is SYS_LIST_FOLDER
			call ok is UserRange: second third * sizeof FileInfo;
			if pathOk and ok and third < 0x10000
				call result is Fat.Entries: addr call_path second third;
			;;
		;;
		elif number is SYS_MAKE_FOLDER
			if pathOk
				call ok is Fat.MakeFolder: addr call_path;
				result is ok;
			;;
		;;
		elif number is SYS_RENAME
			call ok is CopyFromUser: second addr call_path_to 64;
			if pathOk and ok
				call ok is Fat.Rename: addr call_path addr call_path_to;
				result is ok;
			;;
		;;
		elif number is SYS_DELETE_FOLDER
			if pathOk
				call ok is Fat.DeleteFolder: addr call_path;
				result is ok;
			;;
		;;
		elif number >= SYS_MORE
			if more_calls is not 0
				call result is more_calls: number first second third fourth;
			;;
		;;
		elif sound is false
			# no sound card: every sound call returns -1
		;;
		elif number is SYS_SOUND_WRITE
			call ok is UserRange: first second;
			if ok
				call result is Ac97.Write: first second;
			;;
		;;
		elif number is SYS_SOUND_RATE
			call result is Ac97.SetRate: first;
		;;
		elif number is SYS_SOUND_QUEUED
			call Ac97.Flush;
			call result is Ac97.Queued;
		;;
		elif number is SYS_SOUND_STOP
			call Ac97.Stop;
			result is 0;
		;;
		elif number is SYS_SOUND_VOLUME
			call Ac97.SetVolume: first;
			result is 0;
		;;

		frame:0.eax is result;
	[end]
}
