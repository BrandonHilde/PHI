# Kernel threads (32-bit kernels): a method run on its own, at the same time as the
# kernel's own code and as other threads, on whichever core is free.
#
#   use proc.threads;
#   int t: (Threads.Start: addr Count 3);      # Count: 3 runs on its own; -1 if it can't start
#   ...
#   call Threads.Wait: t;                       # back once Count has returned
#
#   [Count: int part: 0;]
#       ...
#   [end]
#
# A thread is a task of its own (lib/x86_32/tasks.asm), in ring 0 with a stack of
# STACK_SIZE, which the timer shares the CPU with like a program. It runs without the
# kernel lock, so threads run at once on several cores once Cores.SharePrograms has run
# (on one core, they take turns with the kernel, which gives up the CPU when it waits).
# The heap, log, atomic, locked and files (their own lock's; fs.readahead reads on a thread)
# work in a thread; the network and most OS.* calls don't yet, as they're the kernel lock's.
# A thread shares the class variables
# with everything else, so what it writes should go through locked or atomic (or into
# data that's only its own, like its element of an array).

use memory.heap;

phi.Threads:Kernel
{
	const u32 STACK_SIZE: 16384;
	const int MAX_THREADS: 64;              # as many tasks as the scheduler has

	ptr<u8> stacks[64];                     # each thread's stack, by its task number
	method<int> thread_work: 0;             # for ThreadsStart
	u32 thread_value: 0;
	ptr<u8> thread_stack: 0;
	int thread_task: 0;

	call OS.StartMultitasking;

	# run work: value as a thread of its own; its number, or -1 if there's no room
	[Start: method<int> work: 0; int value: 0;]
		ptr<u8> stack: new u8[STACK_SIZE];
		if stack is 0 return -1;
		thread_work is work;
		thread_value is value as u32;
		thread_stack is stack + STACK_SIZE;
		call ThreadsStart;
		if thread_task < 0
			free stack;
			return -1;
		;;
		stacks:thread_task is stack;
	[end: thread_task]

	# whether a thread has finished (its method has returned)
	[Done: int thread: 0;]
		if thread <= 0 or thread >= MAX_THREADS or stacks:thread is 0 return true;
	[end: (OS.TaskState: thread) >= 5]

	# wait until a thread has finished, then give its stack and number back
	[Wait: int thread: 0;]
		if thread <= 0 or thread >= MAX_THREADS or stacks:thread is 0 return;
		while not (Done: thread)
			call OS.Yield;
		;;
		free stacks:thread;
		stacks:thread is 0;
		call OS.FreeTask: thread;
	[end]
}

# the scheduler's new task (tasks.asm): thread_task = its number, or -1
asm.ThreadsStart
{
	mov eax, [{thread_work}]
	mov ecx, [{thread_value}]
	mov edx, [{thread_stack}]
	call phi_thread_start
	mov [{thread_task}], eax
	ret
}
