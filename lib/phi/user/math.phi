# Whole-number math helpers. Works in any kind of program.
#
#   use user.math;
#   int d: (Math.Abs: x1 - x0);
#   int w: (Math.Clamp: width 1 640);         # width, kept between 1 and 640
#   int r: (Math.Sqrt: dx * dx + dy * dy);    # the integer square root, rounded down

phi.Math:Library
{
	[Abs: int n: 0;]
		if n < 0
			return 0 - n;
		;;
	[end: n]

	[Min: int a: 0; int b: 0;]
		if a < b
			return a;
		;;
	[end: b]

	[Max: int a: 0; int b: 0;]
		if a > b
			return a;
		;;
	[end: b]

	# value, kept between low and high
	[Clamp: int value: 0; int low: 0; int high: 0;]
		if value < low
			return low;
		;;
		if value > high
			return high;
		;;
	[end: value]

	# -1, 0 or 1
	[Sign: int n: 0;]
		if n < 0
			return -1;
		;;
		if n > 0
			return 1;
		;;
	[end: 0]

	# the largest whole number whose square is at most n (0 for n below 1), worked out one
	# bit at a time so it needs no division
	[Sqrt: int n: 0;]
		if n < 1
			return 0;
		;;
		u32 value: n;
		u32 root: 0;
		u32 bit: 0x40000000;
		while bit > value
			bit is bit >> 2;
		;;
		while bit is not 0
			if value >= root + bit
				value is value - (root + bit);
				root is (root >> 1) + bit;
			;;
			else
				root is root >> 1;
			;;
			bit is bit >> 2;
		;;
	[end: root]
}
