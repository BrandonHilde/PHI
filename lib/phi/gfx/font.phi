# The 8x16 font, borrowed from the VGA card. 32-bit kernels and user programs.
#
#   use gfx.font;
#   u8 row: Font.glyphs:(ch * 16 + r);   # row r of character ch, leftmost pixel in bit 7
#
# In text mode the card keeps the shapes of its 256 characters (code page 437) in
# memory plane 2. Only a kernel can reach the card, so Screen.LoadFont (drivers.vbe)
# copies them here, and Screen.Start does that before it switches to graphics; a user
# program gets a copy from the kernel (gui.app does this, with OS.CopyFont).

phi.Font:Library
{
	const int W: 8;
	const int H: 16;
	u8 glyphs[4096];
	bln loaded: false;
}
