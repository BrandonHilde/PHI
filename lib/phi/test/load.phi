# The other end of phi load: a client that opens many TCP connections to a server
# (machine 1) and keeps them busy, as players in a lobby would. phi load builds it with a
# class LoadSettings (connections, seconds, port) and boots several of them on one
# network with the server (see Compiler/Phi.Cli/LoadTester.cs); or, with --target linux
# or windows, runs several as programs on this computer, against a server program.
#
# It's a :Library with no network of its own: phi load adds the one for where it runs
# (net.tcp in a kernel, net.sockets in a program), whose calls are the same.
#
# Each connection logs in ("login NAME PASSWORD", answered "welcome NAME"), then says a
# numbered line once a second ("say ...", answered "said ..."), checking that every
# answer comes back, in order, and at the end says "quit" (answered "bye"). Its last line
# is what phi load adds up:
#
#   load: connections 100 logged 100 answered 6000 wrong 0 quit 100 latency 1200 most 40
#
# (latency is the total, in ms, of the time each answer took; most is the longest.)
#
# With LoadSettings.tls, every connection is TLS 1.3 (net.tlslink), checking the server's
# certificate is for LoadSettings.host and goes back to LoadSettings.root (DER): each
# finishes its handshake before it logs in, and the time that takes is in the totals
# (handshake MS, and how many failed).

use net.tlslink;
use user.text;

phi.LoadClient:Library
{
	const int MOST: 256;                  # connections from one machine
	const int LINE: 64;                   # the longest answer kept
	const int ANSWER_WAIT: 15000;         # ms an answer may take before the run stops waiting

	int handles[MOST];
	int said[MOST];                       # lines this connection has said
	int sent_at[MOST];                    # when its unanswered line was said (0: none waiting)
	int next_at[MOST];                    # when it says its next line
	int lengths[MOST];
	u8 lines[MOST * LINE];                # each connection's answer so far
	bln welcomed[MOST];
	bln left[MOST];                       # it said quit, and bye came back
	u8 got[512];
	str text: [96];
	str expected: [96];

	int count: LoadSettings.connections;
	u32 logged: 0;
	u32 answered: 0;
	u32 wrong: 0;
	u32 quit: 0;
	u32 latency: 0;
	int most: 0;

	ptr<TlsLink> links: 0;                # with LoadSettings.tls: each connection's TLS
	u32 secure: 0;                        # handshakes done
	u32 refused: 0;                       # handshakes that failed
	int handshake: 0;                     # ms they all took

	if count > MOST
		count is MOST;
	;;
	bln ok: (Net.Start: Machine.address);
	if LoadSettings.tls
		call X509.Trust: addr LoadSettings.root LoadSettings.root.len;
		links is new TlsLink[count];
	;;
	call Run;

	[Run]
		# connect, trying again until the server is listening (it may still be starting)
		int start: (OS.GetTicks);
		while int c: 0; c < count; c++;
			handles:c is -1;
			while handles:c < 0 and (OS.GetTicks) - start < 60000
				handles:c is (Tcp.Connect: Machine.first LoadSettings.port);
				if handles:c < 0
					call OS.Sleep: 100;
				;;
			;;
			if LoadSettings.tls and handles:c >= 0
				if not (Secure.Connect: addr links:c handles:c addr LoadSettings.host)
					handles:c is -1;
				;;
			;;
		;;

		# every handshake done (or failed) before anyone logs in
		if LoadSettings.tls
			start is (OS.GetTicks);
			while secure + refused < count and (OS.GetTicks) - start < 120000
				call Answers;
				call Net.Wait;
			;;
			handshake is (OS.GetTicks) - start;
			log 'handshakes: ' secure ' done, ' refused ' refused, in ' handshake ' ms\n';
		;;

		# log every one in
		while int c: 0; c < count; c++;
			text is 'login m' Machine.number 'c' c ' pw' c;
			call Say: c;
		;;
		start is (OS.GetTicks);
		while logged < count and (OS.GetTicks) - start < 60000
			call Answers;
			call Net.Wait;
		;;
		log 'logged in: ' logged ' of ' count '\n';

		# a line a second from each, spread over the second, for the run
		start is (OS.GetTicks);
		while int c: 0; c < count; c++;
			next_at:c is start + c * 1000 / count;
		;;
		int stop: start + LoadSettings.seconds * 1000;
		while (OS.GetTicks) - stop < 0
			int now: (OS.GetTicks);
			while int c: 0; c < count; c++;
				if welcomed:c and sent_at:c is 0 and now - next_at:c >= 0
					text is 'say m' Machine.number ' c' c ' n' said:c;
					call Say: c;
					sent_at:c is now;
					if sent_at:c is 0
						sent_at:c is 1;
					;;
					next_at:c++ 1000;
				;;
			;;
			call Answers;
			call Net.Wait;
		;;

		# the last answers, then everyone quits
		start is (OS.GetTicks);
		while (Waiting) and (OS.GetTicks) - start < ANSWER_WAIT
			call Answers;
			call Net.Wait;
		;;
		while int c: 0; c < count; c++;
			text is 'quit';
			call Say: c;
		;;
		start is (OS.GetTicks);
		while quit < logged and (OS.GetTicks) - start < ANSWER_WAIT
			call Answers;
			call Net.Wait;
		;;
		log 'load: connections ' count ' logged ' logged ' answered ' answered ' wrong ' wrong ' quit ' quit ' latency ' latency ' most ' most;
		if LoadSettings.tls
			log ' handshake ' handshake ' refused ' refused;
			while int c: 0; c < count; c++;
				if handles:c >= 0
					call Secure.Close: addr links:c;
				;;
			;;
		;;
		log '\n';
		exit 0;
	[end]

	# true while any connection waits for an answer
	[Waiting]
		while int c: 0; c < count; c++;
			if sent_at:c is not 0 return true;
		;;
	[end: false]

	# text, and a line break, to connection c
	[Say: int c: 0;]
		if handles:c < 0 return;
		if LoadSettings.tls
			int taken: (Secure.Write: addr links:c text text.len);
			taken is (Secure.Write: addr links:c '\n' 1);
			return;
		;;
		call Tcp.Send: handles:c text text.len;
		call Tcp.Send: handles:c '\n' 1;
	[end]

	# what has come in on every connection, a line at a time
	[Answers]
		while int c: 0; c < count; c++;
			if handles:c >= 0
				if LoadSettings.tls
					call Pump: c;
				;;
				elif (Tcp.Waiting: handles:c) > 0
					call Lines: c (Tcp.Read: handles:c addr got 512);
				;;
			;;
		;;
	[end]

	# connection c's TLS: on with it, and its lines
	[Pump: int c: 0;]
		ptr<TlsLink> link: addr links:c;
		bln was: link.session.connected;
		bln going: (Secure.Pump: link);
		if link.session.connected and not was
			secure++;
		;;
		if not going
			if not link.session.connected
				refused++;
				log 'handshake ' c ' failed: ' link.session.error '\n';
			;;
			call Secure.Close: link;
			handles:c is -1;
			return;
		;;
		int n: (Secure.Read: link addr got 512);
		while n > 0
			call Lines: c n;
			n is (Secure.Read: link addr got 512);
		;;
	[end]

	# n bytes that came in on connection c (in got), a line at a time
	[Lines: int c: 0; int n: 0;]
		ptr<u8> line: addr lines + c * LINE;
		while int i: 0; i < n; i++;
			if got:i is '\n'
				line:(lengths:c) is 0;
				lengths:c is 0;
				call Answer: c line;
			;;
			elif lengths:c < LINE - 1
				line:(lengths:c) is got:i;
				lengths:c++;
			;;
		;;
	[end]

	[Answer: int c: 0; ptr<u8> line: 0;]
		if (Text.StartsWith: line 'welcome ') and welcomed:c is false
			welcomed:c is true;
			logged++;
		;;
		elif (Text.StartsWith: line 'said ')
			expected is 'said m' Machine.number ' c' c ' n' said:c;
			if (Text.Equal: line expected) and sent_at:c is not 0
				answered++;
				int took: (OS.GetTicks) - sent_at:c;
				latency++ took;
				if took > most
					most is took;
				;;
			;;
			else
				wrong++;
			;;
			said:c++;
			sent_at:c is 0;
		;;
		elif (Text.Equal: line 'bye') and left:c is false
			left:c is true;
			quit++;
		;;
	[end]
}
