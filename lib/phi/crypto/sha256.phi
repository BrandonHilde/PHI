# SHA-256 (FIPS 180-4): a 32-byte digest of any amount of data. Any kind of program.
#
#   use crypto.sha256;
#   u8 digest[32];
#   call Sha256.Hash: 'abc' 3 addr digest;
#
# For data that arrives in pieces, keep a Sha256State:
#
#   Sha256State s;
#   call Sha256.Init: addr s;
#   call Sha256.Update: addr s first 100;
#   call Sha256.Update: addr s second 20;
#   call Sha256.Final: addr s addr digest;
#
# Sha256.Copy duplicates a state, so a digest of what has come so far can be taken
# while the original carries on (TLS does this with its transcript of a handshake).

use crypto.bytes;

struct.Sha256State
{
	u32 h[8];
	u8 block[64];
	u32 used;                   # bytes waiting in block
	u32 bytes_low;              # how many bytes have been added, as 64 bits
	u32 bytes_high;
}

phi.Sha256:Library
{
	const u32 DIGEST_SIZE: 32;
	const u32 BLOCK_SIZE: 64;
	const u32 STATE_SIZE: 108;            # bytes in a Sha256State

	u32 sha_k: 0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
		0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
		0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
		0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
		0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
		0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
		0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
		0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2;
	u32 sha_w[64];
	Sha256State sha_one;                  # for Hash

	# the digest of length bytes of data
	[Hash: ptr<u8> data: 0; u32 length: 0; ptr<u8> digest: 0;]
		call Init: addr sha_one;
		call Update: addr sha_one data length;
		call Final: addr sha_one digest;
	[end]

	[Init: ptr<Sha256State> s: 0;]
		ptr<u32> h: addr s:0.h;
		h:0 is 0x6a09e667;
		h:1 is 0xbb67ae85;
		h:2 is 0x3c6ef372;
		h:3 is 0xa54ff53a;
		h:4 is 0x510e527f;
		h:5 is 0x9b05688c;
		h:6 is 0x1f83d9ab;
		h:7 is 0x5be0cd19;
		s:0.used is 0;
		s:0.bytes_low is 0;
		s:0.bytes_high is 0;
	[end]

	[Update: ptr<Sha256State> s: 0; ptr<u8> data: 0; u32 length: 0;]
		u32 total: s:0.bytes_low + length;
		if total < s:0.bytes_low
			s:0.bytes_high++;
		;;
		s:0.bytes_low is total;

		ptr<u8> block: addr s:0.block;
		u32 i: 0;
		while i < length
			if s:0.used is 0 and length - i >= BLOCK_SIZE
				# a whole block straight from the data
				call Compress: addr s:0.h data + i;
				i++ BLOCK_SIZE;
			;;
			else
				block:(s:0.used) is data:i;
				s:0.used++;
				i++;
				if s:0.used is BLOCK_SIZE
					call Compress: addr s:0.h block;
					s:0.used is 0;
				;;
			;;
		;;
	[end]

	# finish: the digest goes to digest (32 bytes); the state needs Init before reuse
	[Final: ptr<Sha256State> s: 0; ptr<u8> digest: 0;]
		u32 bits_high: (s:0.bytes_high << 3) | (s:0.bytes_low >> 29);
		u32 bits_low: s:0.bytes_low << 3;
		ptr<u8> block: addr s:0.block;

		# a 1 bit, zeros, then the length in bits in the last 8 bytes of a block
		u32 at: s:0.used;
		block:at is 0x80;
		at++;
		if at > 56
			while at < BLOCK_SIZE
				block:at is 0;
				at++;
			;;
			call Compress: addr s:0.h block;
			at is 0;
		;;
		while at < 56
			block:at is 0;
			at++;
		;;
		call PutBig: block + 56 bits_high;
		call PutBig: block + 60 bits_low;
		call Compress: addr s:0.h block;

		ptr<u32> h: addr s:0.h;
		while u32 i: 0; i < 8; i++;
			call PutBig: digest + i * 4 h:i;
		;;
		s:0.used is 0;
	[end]

	[Copy: ptr<Sha256State> from: 0; ptr<Sha256State> to: 0;]
		call Bytes.Copy: to from STATE_SIZE;
	[end]

	[PutBig: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 24;
		p:1 is value >> 16;
		p:2 is value >> 8;
		p:3 is value;
	[end]

	# mix one 64-byte block into the hash
	[Compress: ptr<u32> h: 0; ptr<u8> m: 0;]
		unsafe
			while u32 i: 0; i < 16; i++;
				u32 at: i * 4;
				sha_w:i is (m:at << 24) | (m:(at + 1) << 16) | (m:(at + 2) << 8) | m:(at + 3);
			;;
			while u32 i: 16; i < 64; i++;
				u32 w15: sha_w:(i - 15);
				u32 w2: sha_w:(i - 2);
				u32 sigma0: ((w15 >> 7) | (w15 << 25)) ^ ((w15 >> 18) | (w15 << 14)) ^ (w15 >> 3);
				u32 sigma1: ((w2 >> 17) | (w2 << 15)) ^ ((w2 >> 19) | (w2 << 13)) ^ (w2 >> 10);
				sha_w:i is sha_w:(i - 16) + sigma0 + sha_w:(i - 7) + sigma1;
			;;

			u32 a: h:0;
			u32 b: h:1;
			u32 c: h:2;
			u32 d: h:3;
			u32 e: h:4;
			u32 f: h:5;
			u32 g: h:6;
			u32 hh: h:7;
			while u32 i: 0; i < 64; i++;
				u32 sum1: ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7));
				u32 choose: (e & f) ^ (~e & g);
				u32 t1: hh + sum1 + choose + sha_k:i + sha_w:i;
				u32 sum0: ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10));
				u32 majority: (a & b) ^ (a & c) ^ (b & c);
				hh is g;
				g is f;
				f is e;
				e is d + t1;
				d is c;
				c is b;
				b is a;
				a is t1 + sum0 + majority;
			;;
			h:0 is h:0 + a;
			h:1 is h:1 + b;
			h:2 is h:2 + c;
			h:3 is h:3 + d;
			h:4 is h:4 + e;
			h:5 is h:5 + f;
			h:6 is h:6 + g;
			h:7 is h:7 + hh;
		;;
	[end]
}
