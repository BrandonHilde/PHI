# X.509 certificates (RFC 5280): reading one (DER), checking that its issuer signed it,
# that it's for a host name, and that a chain of them goes back to a root that's
# trusted. Any kind of program.
#
#   use crypto.x509;
#   call X509.Trust: root_der root_length;          # a root certificate to trust
#   Certificate chain[4];
#   bln ok: (X509.Parse: addr chain:0 leaf_der leaf_length);
#   ok is (X509.Parse: addr chain:1 middle_der middle_length);
#   ok is (X509.Chain: addr chain:0 2 'phi.test');  # false: X509.error says why
#
# A Certificate points into the DER it was read from, which must stay where it is. Keys
# can be RSA (of up to 4096 bits) or ECDSA on P-256 or P-384, and signatures RSA PKCS #1
# v1.5 or ECDSA, over SHA-256 or SHA-384. A host name is matched against the certificate's
# subjectAltName DNS names (*.example.com matches one label), or an IPv4 address against
# its iPAddress names. Each certificate but the root must be within its dates, now
# (OS.Now), or at X509.now when that's set.

use crypto.der;
use crypto.rsa;
use crypto.p256;
use crypto.p384;
use crypto.sha512;

# what's read from a certificate; each ptr<u8> points into its DER
struct.Certificate
{
	ptr<u8> der;
	u32 der_length;
	ptr<u8> tbs;                    # the part that's signed, header and all
	u32 tbs_length;
	u32 signed_with;                # X509.RSA_SHA256, ECDSA_SHA256, RSA_SHA384, ECDSA_SHA384, or 0 for another way
	ptr<u8> signature;              # the signature's bytes
	u32 signature_length;
	ptr<u8> issuer;                 # who signed it, as a DER Name (compared byte for byte)
	u32 issuer_length;
	ptr<u8> subject;                # who it's for, the same way
	u32 subject_length;
	ptr<u8> not_before;             # its dates, as text (YYMMDDHHMMSSZ, or YYYYMMDDHHMMSSZ)
	u32 not_before_length;
	ptr<u8> not_after;
	u32 not_after_length;
	u32 key_kind;                   # X509.RSA, X509.P256, X509.P384, or 0 for another kind
	ptr<u8> modulus;                # an RSA key's
	u32 modulus_length;
	ptr<u8> exponent;
	u32 exponent_length;
	ptr<u8> point;                  # an ECDSA key: 04 then x and y (65 bytes for P-256, 97 for P-384)
	bln ca;                         # it may sign other certificates
	int path_length;                # how many certificates may come between it and a leaf (-1: any)
	ptr<u8> names;                  # its subjectAltName's names, as DER (0 if it has none)
	u32 names_length;
}

phi.X509:Library
{
	const u32 RSA: 1;
	const u32 P256: 2;
	const u32 P384: 3;
	const u32 RSA_SHA256: 1;
	const u32 ECDSA_SHA256: 2;
	const u32 RSA_SHA384: 3;
	const u32 ECDSA_SHA384: 4;
	const u32 MAX_ROOTS: 16;
	const u32 MAX_DEPTH: 8;

	str error: '';
	# the time the dates are checked against, as seconds since 1970 (UTC): 0 for the time
	# now (OS.Now), or a time of its own (a test's, say, whose certificates were made then)
	u32 now: 0;
	u32 x509_month_days: 0 31 59 90 120 151 181 212 243 273 304 334;   # days before each month

	Certificate x509_roots[16];
	u32 x509_root_count: 0;
	u8 x509_digest[48];
	u8 x509_r[48];
	u8 x509_s[48];
	u8 x509_address[4];

	# the object identifiers this reads
	u8 oid_rsa_sha256: 0x2A 0x86 0x48 0x86 0xF7 0x0D 0x01 0x01 0x0B;
	u8 oid_ecdsa_sha256: 0x2A 0x86 0x48 0xCE 0x3D 0x04 0x03 0x02;
	u8 oid_rsa_sha384: 0x2A 0x86 0x48 0x86 0xF7 0x0D 0x01 0x01 0x0C;
	u8 oid_ecdsa_sha384: 0x2A 0x86 0x48 0xCE 0x3D 0x04 0x03 0x03;
	u8 oid_rsa: 0x2A 0x86 0x48 0x86 0xF7 0x0D 0x01 0x01 0x01;
	u8 oid_ec: 0x2A 0x86 0x48 0xCE 0x3D 0x02 0x01;
	u8 oid_p256: 0x2A 0x86 0x48 0xCE 0x3D 0x03 0x01 0x07;
	u8 oid_p384: 0x2B 0x81 0x04 0x00 0x22;
	u8 oid_basic_constraints: 0x55 0x1D 0x13;
	u8 oid_alt_names: 0x55 0x1D 0x11;
	u8 oid_key_usage: 0x55 0x1D 0x0F;

	# ---- reading a certificate

	# c = the certificate in der (length bytes); false if it can't be read (error says why)
	[Parse: ptr<Certificate> c: 0; ptr<u8> der: 0; u32 length: 0;]
		error is '';
		c.der is der;
		c.der_length is length;
		c.signed_with is 0;
		c.key_kind is 0;
		c.ca is false;
		c.path_length is -1;
		c.names is 0;
		c.names_length is 0;

		DerCursor top;
		top.pos is der;
		top.stop is der + length;
		if not (Der.Next: addr top) or Der.tag is not 0x30 return (X509.Fail: 'not a certificate');
		DerCursor whole;
		call Der.Enter: addr whole;

		# the part that's signed
		ptr<u8> start: whole.pos;
		if not (Der.Next: addr whole) or Der.tag is not 0x30 return (X509.Fail: 'no tbsCertificate');
		c.tbs is start;
		c.tbs_length is (Der.Since: start);
		DerCursor tbs;
		call Der.Enter: addr tbs;
		if not (Der.Next: addr tbs) return (X509.Fail: 'an empty tbsCertificate');
		if Der.tag is 0xA0
			if not (Der.Next: addr tbs) return (X509.Fail: 'no serial number');   # (past the version)
		;;
		if Der.tag is not 2 return (X509.Fail: 'no serial number');
		if not (Der.Next: addr tbs) or Der.tag is not 0x30 return (X509.Fail: 'no signature algorithm');

		start is tbs.pos;
		if not (Der.Next: addr tbs) or Der.tag is not 0x30 return (X509.Fail: 'no issuer');
		c.issuer is start;
		c.issuer_length is (Der.Since: start);

		if not (Der.Next: addr tbs) or Der.tag is not 0x30 return (X509.Fail: 'no validity');
		DerCursor dates;
		call Der.Enter: addr dates;
		if not (Der.Next: addr dates) return (X509.Fail: 'no notBefore');
		c.not_before is Der.content;
		c.not_before_length is Der.length;
		if not (Der.Next: addr dates) return (X509.Fail: 'no notAfter');
		c.not_after is Der.content;
		c.not_after_length is Der.length;

		start is tbs.pos;
		if not (Der.Next: addr tbs) or Der.tag is not 0x30 return (X509.Fail: 'no subject');
		c.subject is start;
		c.subject_length is (Der.Since: start);

		if not (Der.Next: addr tbs) or Der.tag is not 0x30 return (X509.Fail: 'no public key');
		if not (X509.ReadKey: c) return false;

		# the extensions, [3], after the optional unique IDs ([1] and [2])
		while (Der.Next: addr tbs)
			if Der.tag is 0xA3
				if not (X509.ReadExtensions: c) return false;
			;;
		;;

		# how it's signed, then the signature
		if not (Der.Next: addr whole) or Der.tag is not 0x30 return (X509.Fail: 'no signatureAlgorithm');
		DerCursor algorithm;
		call Der.Enter: addr algorithm;
		if not (Der.Next: addr algorithm) return (X509.Fail: 'no signatureAlgorithm');
		if (Der.IsOid: addr oid_rsa_sha256 9)
			c.signed_with is RSA_SHA256;
		;;
		if (Der.IsOid: addr oid_ecdsa_sha256 8)
			c.signed_with is ECDSA_SHA256;
		;;
		if (Der.IsOid: addr oid_rsa_sha384 9)
			c.signed_with is RSA_SHA384;
		;;
		if (Der.IsOid: addr oid_ecdsa_sha384 8)
			c.signed_with is ECDSA_SHA384;
		;;
		if not (Der.Next: addr whole) or Der.tag is not 3 or Der.length < 1 return (X509.Fail: 'no signatureValue');
		c.signature is Der.content + 1;               # (past the count of unused bits)
		c.signature_length is Der.length - 1;
	[end: true]

	# the public key, from the SubjectPublicKeyInfo read last
	[ReadKey: ptr<Certificate> c: 0;]
		DerCursor info;
		call Der.Enter: addr info;
		if not (Der.Next: addr info) or Der.tag is not 0x30 return (X509.Fail: 'no key algorithm');
		DerCursor algorithm;
		call Der.Enter: addr algorithm;
		if not (Der.Next: addr algorithm) return (X509.Fail: 'no key algorithm');
		u32 kind: 0;
		if (Der.IsOid: addr oid_rsa 9)
			kind is RSA;
		;;
		if (Der.IsOid: addr oid_ec 7) and (Der.Next: addr algorithm)
			if (Der.IsOid: addr oid_p256 8)
				kind is P256;
			;;
			if (Der.IsOid: addr oid_p384 5)
				kind is P384;
			;;
		;;
		if not (Der.Next: addr info) or Der.tag is not 3 or Der.length < 1 return (X509.Fail: 'no key');
		ptr<u8> key: Der.content + 1;
		u32 key_length: Der.length - 1;
		if kind is P256
			if key_length is not 65 or key:0 is not 4 return (X509.Fail: 'a P-256 key that isn\'t 65 bytes, 04 first');
			c.point is key;
		;;
		if kind is P384
			if key_length is not 97 or key:0 is not 4 return (X509.Fail: 'a P-384 key that isn\'t 97 bytes, 04 first');
			c.point is key;
		;;
		if kind is RSA
			# RSAPublicKey: the modulus, then the exponent
			if not (Der.Element: key key_length) or Der.tag is not 0x30 return (X509.Fail: 'an RSA key that can\'t be read');
			DerCursor numbers;
			call Der.Enter: addr numbers;
			if not (Der.Next: addr numbers) or Der.tag is not 2 return (X509.Fail: 'no RSA modulus');
			c.modulus is Der.content;
			c.modulus_length is Der.length;
			if not (Der.Next: addr numbers) or Der.tag is not 2 return (X509.Fail: 'no RSA exponent');
			c.exponent is Der.content;
			c.exponent_length is Der.length;
		;;
		c.key_kind is kind;
	[end: true]

	# basicConstraints and subjectAltName, from the [3] read last; false for an extension
	# marked critical that this doesn't know
	[ReadExtensions: ptr<Certificate> c: 0;]
		DerCursor outer;
		call Der.Enter: addr outer;
		if not (Der.Next: addr outer) or Der.tag is not 0x30 return (X509.Fail: 'extensions that can\'t be read');
		DerCursor list;
		call Der.Enter: addr list;
		while (Der.Next: addr list)
			if Der.tag is not 0x30 return (X509.Fail: 'an extension that can\'t be read');
			DerCursor one;
			call Der.Enter: addr one;
			if not (Der.Next: addr one) or Der.tag is not 6 return (X509.Fail: 'an extension without its identifier');
			u32 which: 0;
			if (Der.IsOid: addr oid_basic_constraints 3)
				which is 1;
			;;
			if (Der.IsOid: addr oid_alt_names 3)
				which is 2;
			;;
			if (Der.IsOid: addr oid_key_usage 3)
				which is 3;
			;;
			bln critical: false;
			if not (Der.Next: addr one) return (X509.Fail: 'an extension without its value');
			if Der.tag is 1
				critical is Der.length is 1 and Der.content:0 is not 0;
				if not (Der.Next: addr one) return (X509.Fail: 'an extension without its value');
			;;
			if Der.tag is not 4 return (X509.Fail: 'an extension without its value');
			if which is 0 and critical return (X509.Fail: 'an extension PHI doesn\'t know is marked critical');
			if which is 1
				# BasicConstraints: cA (false if it isn't there), then pathLenConstraint
				if not (Der.Element: Der.content Der.length) or Der.tag is not 0x30 return (X509.Fail: 'basicConstraints that can\'t be read');
				DerCursor basic;
				call Der.Enter: addr basic;
				if (Der.Next: addr basic) and Der.tag is 1
					c.ca is Der.length is 1 and Der.content:0 is not 0;
					if (Der.Next: addr basic) and Der.tag is 2 and Der.length is 1
						c.path_length is Der.content:0;
					;;
				;;
			;;
			if which is 2
				if not (Der.Element: Der.content Der.length) or Der.tag is not 0x30 return (X509.Fail: 'subjectAltName that can\'t be read');
				c.names is Der.content;
				c.names_length is Der.length;
			;;
		;;
	[end: true]

	# ---- checking

	# whether issuer's key signed c
	[CheckSignature: ptr<Certificate> c: 0; ptr<Certificate> issuer: 0;]
		# the digest of what's signed: SHA-256's 32 bytes or SHA-384's 48
		u32 digest_length: 32;
		if c.signed_with is RSA_SHA384 or c.signed_with is ECDSA_SHA384
			digest_length is 48;
			call Sha512.Hash384: c.tbs c.tbs_length addr x509_digest;
		;;
		else
			call Sha256.Hash: c.tbs c.tbs_length addr x509_digest;
		;;
		bln rsa: c.signed_with is RSA_SHA256 or c.signed_with is RSA_SHA384;
		bln ecdsa: c.signed_with is ECDSA_SHA256 or c.signed_with is ECDSA_SHA384;
		if rsa and issuer.key_kind is RSA
			return (Rsa.VerifyPkcs1: issuer.modulus issuer.modulus_length issuer.exponent issuer.exponent_length
			                         addr x509_digest c.signature c.signature_length digest_length);
		;;
		if ecdsa and issuer.key_kind is P256
			if not (X509.ReadEcdsa: c.signature c.signature_length 32) return false;
			return (P256.VerifyDigest: issuer.point addr x509_digest digest_length addr x509_r addr x509_s);
		;;
		if ecdsa and issuer.key_kind is P384
			if not (X509.ReadEcdsa: c.signature c.signature_length 48) return false;
			return (P384.VerifyDigest: issuer.point addr x509_digest digest_length addr x509_r addr x509_s);
		;;
	[end: false]

	# x509_r and x509_s = the two numbers of a DER ECDSA signature, size bytes each (32 for
	# P-256, 48 for P-384)
	[ReadEcdsa: ptr<u8> der: 0; u32 length: 0; u32 size: 32;]
		if not (Der.Element: der length) or Der.tag is not 0x30 return false;
		DerCursor numbers;
		call Der.Enter: addr numbers;
		if not (Der.Next: addr numbers) or Der.tag is not 2 return false;
		if not (Der.Number: addr x509_r size) return false;
		if not (Der.Next: addr numbers) or Der.tag is not 2 return false;
	[end: (Der.Number: addr x509_s size)]

	# whether c is for host (text): one of its subjectAltName DNS names is host, or is
	# *.rest where host is a label and then rest; letters match whatever their case
	[MatchesHost: ptr<Certificate> c: 0; ptr<u8> host: 0;]
		if c.names is 0 return false;
		u32 host_length: 0;
		while host:host_length is not 0
			host_length++;
		;;
		bln address: (X509.ReadAddress: host);
		DerCursor names;
		names.pos is c.names;
		names.stop is c.names + c.names_length;
		while (Der.Next: addr names)
			if address
				# an IPv4 address host is one of its iPAddress names
				if Der.tag is 0x87 and Der.length is 4 and (Bytes.Equal: Der.content addr x509_address 4) return true;
			;;
			elif Der.tag is 0x82                     # dNSName
				if (X509.SameText: Der.content Der.length host host_length) return true;
				if Der.length > 2 and Der.content:0 is 42 and Der.content:1 is 46       # *.
					# past the host's first label (which mustn't be empty)
					u32 dot: 0;
					while dot < host_length and host:dot is not 46
						dot++;
					;;
					if dot > 0 and dot < host_length
						if (X509.SameText: Der.content + 2 Der.length - 2 host + dot + 1 host_length - dot - 1) return true;
					;;
				;;
			;;
		;;
	[end: false]

	# whether host is an IPv4 address written out (10.0.2.2): if so, x509_address = its 4 bytes
	[ReadAddress: ptr<u8> host: 0;]
		u32 i: 0;
		while u32 part: 0; part < 4; part++;
			u32 value: 0;
			u32 digits: 0;
			while host:i >= 48 and host:i <= 57 and digits < 3
				value is value * 10 + host:i - 48;
				digits++;
				i++;
			;;
			if digits is 0 or value > 255 return false;
			x509_address:part is value;
			if part < 3
				if host:i is not 46 return false;
				i++;
			;;
		;;
	[end: host:i is 0]

	# whether a (a_length bytes) and b are the same text, whatever the case of their letters
	[SameText: ptr<u8> a: 0; u32 a_length: 0; ptr<u8> b: 0; u32 b_length: 0;]
		if a_length is not b_length return false;
		while u32 i: 0; i < a_length; i++;
			u32 x: a:i;
			u32 y: b:i;
			if x >= 65 and x <= 90
				x++ 32;
			;;
			if y >= 65 and y <= 90
				y++ 32;
			;;
			if x is not y return false;
		;;
	[end: true]

	# whether two DER Names are the same
	[SameName: ptr<u8> a: 0; u32 a_length: 0; ptr<u8> b: 0; u32 b_length: 0;]
	[end: a_length is b_length and (Bytes.Equal: a b a_length)]

	# ---- chains

	# trust the root certificate in der (length bytes), which must stay where it is
	[Trust: ptr<u8> der: 0; u32 length: 0;]
		if x509_root_count >= MAX_ROOTS return (X509.Fail: 'too many roots');
		if not (X509.Parse: addr x509_roots:x509_root_count der length) return false;
		x509_root_count++;
	[end: true]

	# forget the roots
	[Untrust]
		x509_root_count is 0;
	[end]

	# whether certs (count of them: the server's own first, then each one's issuer) are
	# for host and go back to a trusted root; error says why not
	[Chain: ptr<Certificate> certs: 0; u32 count: 0; ptr<u8> host: 0;]
		error is '';
		if count is 0 return (X509.Fail: 'no certificate');
		if not (X509.MatchesHost: addr certs:0 host) return (X509.Fail: 'the certificate isn\'t for this host');
		u32 i: 0;
		u32 time: now;
		if time is 0
			time is (OS.Now);
		;;
		while i < count and i < MAX_DEPTH
			ptr<Certificate> c: addr certs:i;
			# a trusted root itself (which is trusted whatever its dates)
			while u32 k: 0; k < x509_root_count; k++;
				ptr<Certificate> root: addr x509_roots:k;
				if c.der_length is root.der_length and (Bytes.Equal: c.der root.der c.der_length) return true;
			;;
			# any other must be within its dates
			if time < (X509.Time: c.not_before c.not_before_length) return (X509.Fail: 'a certificate isn\'t valid yet');
			if time > (X509.Time: c.not_after c.not_after_length) return (X509.Fail: 'a certificate has expired');
			# one a trusted root signed
			while u32 k: 0; k < x509_root_count; k++;
				ptr<Certificate> root: addr x509_roots:k;
				if (X509.SameName: c.issuer c.issuer_length root.subject root.subject_length)
					if (X509.CheckSignature: c root) return true;
				;;
			;;
			# else the next one signed it
			if i + 1 >= count return (X509.Fail: 'no trusted root signed the chain');
			ptr<Certificate> up: addr certs:(i + 1);
			if not (X509.SameName: c.issuer c.issuer_length up.subject up.subject_length)
				return (X509.Fail: 'a certificate\'s issuer isn\'t the next one');
			;;
			if not up.ca return (X509.Fail: 'a certificate is signed by one that isn\'t a CA');
			if up.path_length >= 0 and i > up.path_length return (X509.Fail: 'the chain is longer than a CA allows');
			if not (X509.CheckSignature: c up) return (X509.Fail: 'a certificate\'s signature doesn\'t check out');
			i++;
		;;
	[end: (X509.Fail: 'the chain is too long')]


	# a certificate's date (UTCTime YYMMDDHHMMSSZ, its years 1950 to 2049, or
	# GeneralizedTime YYYYMMDDHHMMSSZ) as seconds since 1970 (UTC); 0 before 1970, and the
	# most a u32 holds from 2106 on (and for text that isn't a date)
	[Time: ptr<u8> text: 0; u32 length: 0;]
		int year: 0;
		ptr<u8> rest: text;
		if length is 13
			year is (X509.Digits: text 2);
			if year < 50
				year++ 2000;
			;;
			else
				year++ 1900;
			;;
			rest is text + 2;
		;;
		elif length is 15
			year is (X509.Digits: text 4);
			rest is text + 4;
		;;
		else
			return 0xFFFFFFFF;
		;;
		u32 month: (X509.Digits: rest 2);
		u32 day: (X509.Digits: rest + 2 2);
		u32 hour: (X509.Digits: rest + 4 2);
		u32 minute: (X509.Digits: rest + 6 2);
		u32 second: (X509.Digits: rest + 8 2);
		if year < 1970 return 0;
		if year >= 2106 or month < 1 or month > 12 return 0xFFFFFFFF;
		# the days before this year (and the leap days among them), this month, and today
		int before: year - 1;
		u32 days: 365 * (year - 1970) + before / 4 - before / 100 + before / 400 - 477;
		days++ x509_month_days:(month - 1) + day - 1;
		bln leap: (year % 4 is 0 and year % 100 is not 0) or year % 400 is 0;
		if leap and month > 2
			days++;
		;;
	[end: days * 86400 + hour * 3600 + minute * 60 + second]

	# count decimal digits at text as a number
	[Digits: ptr<u8> text: 0; u32 count: 0;]
		u32 n: 0;
		while u32 i: 0; i < count; i++;
			n is n * 10 + text:i - 48;
		;;
	[end: n]
	# error = why, and false
	[Fail: ptr<u8> why: 0;]
		error is why;
	[end: false]
}
