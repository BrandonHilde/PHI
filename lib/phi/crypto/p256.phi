# ECDSA on the P-256 curve (FIPS 186-4, SEC 1): checking signatures (what most
# certificates and TLS servers that don't use RSA sign with), and making them with a
# private key. The math is crypto.ec's, which crypto.p384 shares. Any kind of program.
#
#   use crypto.p256;
#   bln good: (P256.Verify: public addr digest r s);         # a SHA-256 digest
#   good is (P256.VerifyDigest: public digest 48 r s);       # one of another size
#
#   u8 private[32];
#   u8 public[65];
#   bln ok: (P256.ReadPrivate: private public der length);   # a key file's DER (SEC 1 or PKCS #8)
#   ok is (P256.Sign: r s private addr digest);
#
# public is the key as a certificate holds it, 65 bytes (04, then x and y); a private key
# is 32 big-endian bytes; r and s are the signature's two numbers, 32 bytes each. Sign
# makes its nonce from the key and the digest (RFC 6979), not from random numbers: the
# same digest signs the same way, and a weak random generator can't give the key away.
# It isn't made to take the same time whatever the key (see crypto.ec).

use crypto.ec;

phi.P256:Library
{
	const u32 BYTES: 32;

	EcCurve curve;
	bln p256_ready: false;

	# the curve's object identifier, in key files
	u8 p256_oid: 0x2A 0x86 0x48 0xCE 0x3D 0x03 0x01 0x07;

	# whether r and s (32 bytes each) are public's signature of a SHA-256 digest
	[Verify: ptr<u8> public: 0; ptr<u8> digest: 0; ptr<u8> r: 0; ptr<u8> s: 0;]
	[end: (P256.VerifyDigest: public digest 32 r s)]

	# the same, for a digest of any size (its first 32 bytes, of a longer one)
	[VerifyDigest: ptr<u8> public: 0; ptr<u8> digest: 0; u32 length: 0; ptr<u8> r: 0; ptr<u8> s: 0;]
		call P256.Ready;
	[end: (Ec.Verify: addr curve public digest length r s)]

	# r and s (32 bytes each) = private's signature of a SHA-256 digest, with its nonce from
	# RFC 6979; false if private isn't a key (0, or not below n)
	[Sign: ptr<u8> r: 0; ptr<u8> s: 0; ptr<u8> private: 0; ptr<u8> digest: 0;]
		call P256.Ready;
	[end: (Ec.Sign: addr curve r s private digest 32)]

	# public (65 bytes: 04, x, y) = the public key of private (32 bytes); false if private
	# isn't a key
	[PublicFrom: ptr<u8> public: 0; ptr<u8> private: 0;]
		call P256.Ready;
	[end: (Ec.PublicFrom: addr curve public private)]

	# private (32 bytes) and public (65 bytes) = the key in a key file's DER: SEC 1's
	# ECPrivateKey (openssl ecparam -genkey) or PKCS #8 holding one (openssl genpkey); false
	# if it isn't a P-256 private key
	[ReadPrivate: ptr<u8> private: 0; ptr<u8> public: 0; ptr<u8> der: 0; u32 length: 0;]
		call P256.Ready;
	[end: (Ec.ReadPrivate: addr curve addr p256_oid 8 private public der length)]

	# the curve's numbers, the first time
	[Ready]
		if p256_ready return;
		p256_ready is true;
		call Ec.Setup: addr curve BYTES
			'ffffffff00000001000000000000000000000000ffffffffffffffffffffffff'
			'ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551'
			'5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b'
			'6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5';
	[end]
}
