# Helpers for byte strings: hex text, comparing, copying, clearing. Any kind of program.
#
#   use crypto.bytes;
#   u8 key[32];
#   int n: 0;
#   call n is Bytes.FromHex: '000102030405' addr key 32;    # 6
#   call Bytes.PrintHex: addr key n;                         # 000102030405
#   bln same: false;
#   call same is Bytes.Equal: addr key addr other 32;

phi.Bytes:Library
{
	str bytes_digits: '0123456789abcdef';
	u8 bytes_line[65];

	# print bytes as hex (two lowercase digits each), 32 bytes to a line
	[PrintHex: ptr<u8> data: 0; u32 length: 0;]
		u32 i: 0;
		while i < length
			u32 n: 0;
			while n < 32 and i < length
				bytes_line:(n * 2) is bytes_digits:(data:i >> 4);
				bytes_line:(n * 2 + 1) is bytes_digits:(data:i & 15);
				n++;
				i++;
			;;
			bytes_line:(n * 2) is 0;
			log addr bytes_line '\n';
		;;
	[end]

	# read hex text (spaces are skipped) into output; the number of bytes, or -1 if the
	# text has something that isn't a hex digit, an odd number of digits, or more than max bytes
	[FromHex: ptr<u8> text: 0; ptr<u8> output: 0; u32 max: 0;]
		int count: 0;
		u32 high: 0;
		bln have_high: false;
		bln ok: true;
		u32 i: 0;
		while ok and text:i is not 0
			u32 c: text:i;
			int value: -1;
			if c >= '0' and c <= '9'
				value is c - '0';
			;;
			elif c >= 'a' and c <= 'f'
				value is c - 'a' + 10;
			;;
			elif c >= 'A' and c <= 'F'
				value is c - 'A' + 10;
			;;
			elif c is not ' ' and c is not '\n' and c is not '\r' and c is not '\t'
				ok is false;
			;;

			if value >= 0
				if have_high
					if count >= max
						ok is false;
					;;
					else
						output:count is (high << 4) | value;
						count++;
					;;
					have_high is false;
				;;
				else
					high is value;
					have_high is true;
				;;
			;;
			i++;
		;;
		if ok is false or have_high
			count is -1;
		;;
	[end: count]

	# true if the two are the same; takes as long whatever they hold (for comparing secrets)
	[Equal: ptr<u8> a: 0; ptr<u8> b: 0; u32 length: 0;]
		u32 difference: 0;
		while u32 i: 0; i < length; i++;
			difference is difference | (a:i ^ b:i);
		;;
	[end: difference is 0]

	# copy length bytes (the two may not overlap)
	[Copy: ptr<u8> to: 0; ptr<u8> from: 0; u32 length: 0;]
		while u32 i: 0; i < length; i++;
			to:i is from:i;
		;;
	[end]

	# set length bytes to zero (to wipe a secret)
	[Zero: ptr<u8> to: 0; u32 length: 0;]
		while u32 i: 0; i < length; i++;
			to:i is 0;
		;;
	[end]
}
