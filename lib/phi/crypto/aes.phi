# AES-128 (FIPS 197): encrypting one 16-byte block with a 16-byte key. AES-GCM
# (crypto.aesgcm) is built on it. Any kind of program.
#
#   use crypto.aes;
#   call Aes.SetKey: key;                  # 16 bytes
#   call Aes.Encrypt: block output;        # 16 bytes in, 16 out
#
# Rounds use four tables of 256 words made from the S-box the first time a key is
# set, so each round is 16 lookups and xors. Lookups into tables indexed by secret
# bytes can leak through the CPU's cache timing, which matters on a machine shared
# with an attacker's code.

phi.Aes:Library
{
	u8 aes_sbox: 0x63 0x7c 0x77 0x7b 0xf2 0x6b 0x6f 0xc5 0x30 0x01 0x67 0x2b 0xfe 0xd7 0xab 0x76
		0xca 0x82 0xc9 0x7d 0xfa 0x59 0x47 0xf0 0xad 0xd4 0xa2 0xaf 0x9c 0xa4 0x72 0xc0
		0xb7 0xfd 0x93 0x26 0x36 0x3f 0xf7 0xcc 0x34 0xa5 0xe5 0xf1 0x71 0xd8 0x31 0x15
		0x04 0xc7 0x23 0xc3 0x18 0x96 0x05 0x9a 0x07 0x12 0x80 0xe2 0xeb 0x27 0xb2 0x75
		0x09 0x83 0x2c 0x1a 0x1b 0x6e 0x5a 0xa0 0x52 0x3b 0xd6 0xb3 0x29 0xe3 0x2f 0x84
		0x53 0xd1 0x00 0xed 0x20 0xfc 0xb1 0x5b 0x6a 0xcb 0xbe 0x39 0x4a 0x4c 0x58 0xcf
		0xd0 0xef 0xaa 0xfb 0x43 0x4d 0x33 0x85 0x45 0xf9 0x02 0x7f 0x50 0x3c 0x9f 0xa8
		0x51 0xa3 0x40 0x8f 0x92 0x9d 0x38 0xf5 0xbc 0xb6 0xda 0x21 0x10 0xff 0xf3 0xd2
		0xcd 0x0c 0x13 0xec 0x5f 0x97 0x44 0x17 0xc4 0xa7 0x7e 0x3d 0x64 0x5d 0x19 0x73
		0x60 0x81 0x4f 0xdc 0x22 0x2a 0x90 0x88 0x46 0xee 0xb8 0x14 0xde 0x5e 0x0b 0xdb
		0xe0 0x32 0x3a 0x0a 0x49 0x06 0x24 0x5c 0xc2 0xd3 0xac 0x62 0x91 0x95 0xe4 0x79
		0xe7 0xc8 0x37 0x6d 0x8d 0xd5 0x4e 0xa9 0x6c 0x56 0xf4 0xea 0x65 0x7a 0xae 0x08
		0xba 0x78 0x25 0x2e 0x1c 0xa6 0xb4 0xc6 0xe8 0xdd 0x74 0x1f 0x4b 0xbd 0x8b 0x8a
		0x70 0x3e 0xb5 0x66 0x48 0x03 0xf6 0x0e 0x61 0x35 0x57 0xb9 0x86 0xc1 0x1d 0x9e
		0xe1 0xf8 0x98 0x11 0x69 0xd9 0x8e 0x94 0x9b 0x1e 0x87 0xe9 0xce 0x55 0x28 0xdf
		0x8c 0xa1 0x89 0x0d 0xbf 0xe6 0x42 0x68 0x41 0x99 0x2d 0x0f 0xb0 0x54 0xbb 0x16;
	u32 aes_rcon: 0x01000000 0x02000000 0x04000000 0x08000000 0x10000000 0x20000000 0x40000000 0x80000000 0x1b000000 0x36000000;

	# te0:x is the S-box byte s times (2, 1, 1, 3), MixColumns' column; the others are it rotated
	u32 aes_te0[256];
	u32 aes_te1[256];
	u32 aes_te2[256];
	u32 aes_te3[256];
	bln aes_tables: false;

	u32 aes_round_keys[44];

	# expand a 16-byte key into the 11 round keys
	[SetKey: ptr<u8> key: 0;]
		if aes_tables is false
			call MakeTables;
		;;
		unsafe
			while u32 i: 0; i < 4; i++;
				u32 at: i * 4;
				aes_round_keys:i is (key:at << 24) | (key:(at + 1) << 16) | (key:(at + 2) << 8) | key:(at + 3);
			;;
			while u32 i: 4; i < 44; i++;
				u32 t: aes_round_keys:(i - 1);
				if (i & 3) is 0
					# rotate a byte left, put each byte through the S-box, add the round constant
					u32 r: (t << 8) | (t >> 24);
					t is (aes_sbox:(r >> 24) << 24) | (aes_sbox:((r >> 16) & 255) << 16) | (aes_sbox:((r >> 8) & 255) << 8) | aes_sbox:(r & 255);
					t is t ^ aes_rcon:((i >> 2) - 1);
				;;
				aes_round_keys:i is aes_round_keys:(i - 4) ^ t;
			;;
		;;
	[end]

	# encrypt one 16-byte block (input and output may be the same)
	[Encrypt: ptr<u8> input: 0; ptr<u8> output: 0;]
		unsafe
			u32 s0: ((input:0 << 24) | (input:1 << 16) | (input:2 << 8) | input:3) ^ aes_round_keys:0;
			u32 s1: ((input:4 << 24) | (input:5 << 16) | (input:6 << 8) | input:7) ^ aes_round_keys:1;
			u32 s2: ((input:8 << 24) | (input:9 << 16) | (input:10 << 8) | input:11) ^ aes_round_keys:2;
			u32 s3: ((input:12 << 24) | (input:13 << 16) | (input:14 << 8) | input:15) ^ aes_round_keys:3;
			u32 t0: 0;
			u32 t1: 0;
			u32 t2: 0;
			u32 t3: 0;
			u32 k: 4;
			while u32 round: 1; round < 10; round++;
				t0 is aes_te0:(s0 >> 24) ^ aes_te1:((s1 >> 16) & 255) ^ aes_te2:((s2 >> 8) & 255) ^ aes_te3:(s3 & 255) ^ aes_round_keys:k;
				t1 is aes_te0:(s1 >> 24) ^ aes_te1:((s2 >> 16) & 255) ^ aes_te2:((s3 >> 8) & 255) ^ aes_te3:(s0 & 255) ^ aes_round_keys:(k + 1);
				t2 is aes_te0:(s2 >> 24) ^ aes_te1:((s3 >> 16) & 255) ^ aes_te2:((s0 >> 8) & 255) ^ aes_te3:(s1 & 255) ^ aes_round_keys:(k + 2);
				t3 is aes_te0:(s3 >> 24) ^ aes_te1:((s0 >> 16) & 255) ^ aes_te2:((s1 >> 8) & 255) ^ aes_te3:(s2 & 255) ^ aes_round_keys:(k + 3);
				s0 is t0;
				s1 is t1;
				s2 is t2;
				s3 is t3;
				k++ 4;
			;;
			# the last round has no MixColumns: just the S-box, with the rows shifted
			t0 is (aes_sbox:(s0 >> 24) << 24) | (aes_sbox:((s1 >> 16) & 255) << 16) | (aes_sbox:((s2 >> 8) & 255) << 8) | aes_sbox:(s3 & 255);
			t1 is (aes_sbox:(s1 >> 24) << 24) | (aes_sbox:((s2 >> 16) & 255) << 16) | (aes_sbox:((s3 >> 8) & 255) << 8) | aes_sbox:(s0 & 255);
			t2 is (aes_sbox:(s2 >> 24) << 24) | (aes_sbox:((s3 >> 16) & 255) << 16) | (aes_sbox:((s0 >> 8) & 255) << 8) | aes_sbox:(s1 & 255);
			t3 is (aes_sbox:(s3 >> 24) << 24) | (aes_sbox:((s0 >> 16) & 255) << 16) | (aes_sbox:((s1 >> 8) & 255) << 8) | aes_sbox:(s2 & 255);
			call PutBig: output t0 ^ aes_round_keys:40;
			call PutBig: output + 4 t1 ^ aes_round_keys:41;
			call PutBig: output + 8 t2 ^ aes_round_keys:42;
			call PutBig: output + 12 t3 ^ aes_round_keys:43;
		;;
	[end]

	[MakeTables]
		while u32 x: 0; x < 256; x++;
			u32 s: aes_sbox:x;
			u32 doubled: (s << 1) ^ ((s >> 7) * 0x11B);     # s times 2 in GF(2^8)
			u32 word: (doubled << 24) | (s << 16) | (s << 8) | (doubled ^ s);
			aes_te0:x is word;
			aes_te1:x is (word >> 8) | (word << 24);
			aes_te2:x is (word >> 16) | (word << 16);
			aes_te3:x is (word >> 24) | (word << 8);
		;;
		aes_tables is true;
	[end]

	[PutBig: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 24;
		p:1 is value >> 16;
		p:2 is value >> 8;
		p:3 is value;
	[end]
}
