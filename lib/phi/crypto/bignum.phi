# Big numbers for public-key cryptography (RSA, and the curve math of ECDSA): unsigned
# numbers of up to 4096 bits, kept as 16-bit limbs, least significant first, one to a
# u32, so that a product of two limbs and what's carried still fit in 32 bits. Any kind
# of program.
#
#   use crypto.bignum;
#   Modulus m;
#   bln ok: (Big.Setup: addr m modulus 256);      # big-endian bytes, as certificates have them
#   u32 x[258];
#   ok is (Big.FromBytes: addr x m.limbs signature 256);
#   ok is (Big.PowMod: addr x addr x exponent 3 addr m);    # x = x^e mod m
#   call Big.ToBytes: output 256 addr x m.limbs;
#
# Multiplying modulo m is Montgomery's way, with no division: Setup works out what that
# needs once for each modulus, which must be odd (an RSA modulus and a curve's primes
# are). A number given to MontMul or PowMod has the modulus's limbs, and is below it.
#
# MontMul itself works 32 bits at a time, with 64-bit products: it joins the limbs in
# pairs, multiplies, and parts them again, so each pass of its loops does four times the
# work. That's why a modulus has an even number of limbs (one more than its bits need, if
# need be): R is the same number either way, and so is every number in Montgomery form.
# It's in assembly (BigMontMul), as the CPU's mul gives the 64-bit product of two 32-bit
# numbers in one instruction, and nearly all of a signature check is spent there.

use crypto.bytes;

# a modulus, and what multiplying by Montgomery's way needs for it
struct.Modulus
{
	u32 n[258];                 # the modulus, in limbs
	u32 r2[258];                # R^2 mod n, where R = 2^(16 limbs): it brings a number into Montgomery form
	u32 limbs;                  # how many limbs n has: an even number
	u32 inverse;                # -1/n mod 2^16
	u32 wide[129];              # the modulus 32 bits at a time, for MontMul
	u32 wide_inverse;           # -1/n mod 2^32
}

phi.Big:Library
{
	const u32 MAX: 258;         # limbs a number can have: 4096 bits, and two to spare
	const u32 MOST: 256;        # the most limbs a modulus can have (4096 bits)

	u32 big_t[260];
	u32 big_one[258];
	u32 big_x[258];
	u32 big_acc[258];
	u32 big_a[129];             # MontMul's two numbers, 32 bits at a time,
	u32 big_b[129];
	u32 big_w[131];             # and its sum
	ptr<u32> big_from_a: 0;     # for BigMontMul: the two numbers and where the product goes, in limbs,
	ptr<u32> big_from_b: 0;
	ptr<u32> big_to: 0;
	ptr<u32> big_n: 0;          # the modulus 32 bits at a time,
	u32 big_h: 0;               # how many of those it has,
	u32 big_limbs: 0;           # (for BigAddMod and BigSubMod: big_n is the modulus in limbs, this many)
	u32 big_inverse: 0;         # -1/n mod 2^32,
	u32 big_bi: 0;              # and its own: the part of b being multiplied by, and q
	u32 big_q: 0;

	# x (limbs limbs) = count big-endian bytes; false if the number needs more limbs
	[FromBytes: ptr<u32> x: 0; u32 limbs: 0; ptr<u8> bytes: 0; u32 count: 0;]
		bln fits: true;
		while u32 i: 0; i < limbs; i++;
			x:i is 0;
		;;
		while u32 i: 0; i < count; i++;
			u32 b: bytes:(count - 1 - i);
			u32 limb: i >> 1;
			if limb >= limbs
				if b is not 0
					fits is false;
				;;
			;;
			else
				if (i & 1) is 1
					x:limb is x:limb | (b << 8);
				;;
				else
					x:limb is x:limb | b;
				;;
			;;
		;;
	[end: fits]

	# count big-endian bytes = x (limbs limbs); the high bytes are 0 if count is more
	[ToBytes: ptr<u8> bytes: 0; u32 count: 0; ptr<u32> x: 0; u32 limbs: 0;]
		while u32 i: 0; i < count; i++;
			u32 limb: i >> 1;
			u32 v: 0;
			if limb < limbs
				v is x:limb;
			;;
			if (i & 1) is 1
				v is v >> 8;
			;;
			bytes:(count - 1 - i) is v & 255;
		;;
	[end]

	# -1, 0 or 1 as a is below, equal to or above b
	[Compare: ptr<u32> a: 0; ptr<u32> b: 0; u32 limbs: 0;]
		int result: 0;
		u32 i: limbs;
		while i > 0 and result is 0
			i--;
			if a:i < b:i
				result is -1;
			;;
			if a:i > b:i
				result is 1;
			;;
		;;
	[end: result]

	# a = a - b; the borrow out (1 when b was the bigger)
	[Subtract: ptr<u32> a: 0; ptr<u32> b: 0; u32 limbs: 0;]
		u32 borrow: 0;
		while u32 i: 0; i < limbs; i++;
			u32 d: a:i + 0x10000 - b:i - borrow;
			a:i is d & 0xFFFF;
			borrow is 1 - (d >> 16);
		;;
	[end: borrow]

	# a = a + b; the carry out (1 when the sum needs another limb)
	[Add: ptr<u32> a: 0; ptr<u32> b: 0; u32 limbs: 0;]
		u32 carry: 0;
		while u32 i: 0; i < limbs; i++;
			u32 s: a:i + b:i + carry;
			a:i is s & 0xFFFF;
			carry is s >> 16;
		;;
	[end: carry]

	# r = a
	[Copy: ptr<u32> r: 0; ptr<u32> a: 0; u32 limbs: 0;]
		while u32 i: 0; i < limbs; i++;
			r:i is a:i;
		;;
	[end]

	# whether x is 0
	[IsZero: ptr<u32> x: 0; u32 limbs: 0;]
		u32 any: 0;
		while u32 i: 0; i < limbs; i++;
			any is any | x:i;
		;;
	[end: any is 0]

	# m ready for count big-endian bytes of an odd modulus (leading zeros are fine);
	# false if it's even, 0, or more than 4096 bits
	[Setup: ptr<Modulus> m: 0; ptr<u8> bytes: 0; u32 count: 0;]
		while count > 0 and bytes:0 is 0
			bytes is bytes + 1;
			count--;
		;;
		if count is 0 or count > MOST * 2 return false;
		if (bytes:(count - 1) & 1) is 0 return false;
		m.limbs is ((count + 3) / 4) * 2;
		call Big.FromBytes: addr m.n m.limbs bytes count;
		while u32 j: 0; j < m.limbs / 2; j++;
			m.wide:j is m.n:(j + j) | (m.n:(j + j + 1) << 16);
		;;

		# -1/n mod 2^16, by Newton's way: each step doubles the bits that are right
		u32 n0: m.n:0;
		u32 inverse: 1;
		while int step: 0; step < 5; step++;
			inverse is (inverse * (2 - n0 * inverse)) & 0xFFFF;
		;;
		m.inverse is (0x10000 - inverse) & 0xFFFF;
		# and mod 2^32 the same way, in 64 bits so that nothing is lost
		u64 wide_n0: m.wide:0;
		u64 wide: 1;
		while int step: 0; step < 6; step++;
			u64 twice: (wide_n0 * wide) & 0xFFFFFFFF;
			wide is (wide * ((0x100000002 - twice) & 0xFFFFFFFF)) & 0xFFFFFFFF;
		;;
		m.wide_inverse is ((0x100000000 - wide) & 0xFFFFFFFF) as u32;

		# R mod n: n's top bit alone is below n, and doubling it up to R's bit, taking n off
		# whenever it's past n, is only as many doublings as n falls short of its limbs
		ptr<u32> x: addr m.r2;
		while u32 i: 0; i < m.limbs; i++;
			x:i is 0;
		;;
		u32 top: m.limbs * 16 - 1;
		while ((m.n:(top >> 4) >> (top & 15)) & 1) is 0
			top--;
		;;
		x:(top >> 4) is 1 << (top & 15);
		while u32 k: top; k < m.limbs * 16; k++;
			call Big.Double: x m;
		;;
		# R^2 mod n from that, which is 1 in Montgomery form: 2^(16 limbs) in Montgomery form
		# is R * R, and it's reached by squaring and doubling, a bit of 16 limbs at a time
		u32 power: m.limbs * 16;
		int bit: 15;
		while ((power >> bit) & 1) is 0
			bit--;
		;;
		while bit >= 0
			call Big.MontMul: x x x m;
			if ((power >> bit) & 1) is 1
				call Big.Double: x m;
			;;
			bit--;
		;;
	[end: true]

	# x = 2x mod n, for an x below n
	[Double: ptr<u32> x: 0; ptr<Modulus> m: 0;]
		u32 carry: 0;
		while u32 i: 0; i < m.limbs; i++;
			u32 v: (x:i << 1) | carry;
			x:i is v & 0xFFFF;
			carry is v >> 16;
		;;
		if carry is not 0 or (Big.Compare: x addr m.n m.limbs) >= 0
			call Big.Subtract: x addr m.n m.limbs;
		;;
	[end]

	# r = a + b mod n, for a and b below n; r may be a or b
	[AddMod: ptr<u32> r: 0; ptr<u32> a: 0; ptr<u32> b: 0; ptr<Modulus> m: 0;]
		big_from_a is a;
		big_from_b is b;
		big_to is r;
		big_n is addr m.n;
		big_limbs is m.limbs;
		call BigAddMod;
	[end]

	# r = a - b mod n, for a and b below n; r may be a or b
	[SubMod: ptr<u32> r: 0; ptr<u32> a: 0; ptr<u32> b: 0; ptr<Modulus> m: 0;]
		big_from_a is a;
		big_from_b is b;
		big_to is r;
		big_n is addr m.n;
		big_limbs is m.limbs;
		call BigSubMod;
	[end]

	# r = a * b / R mod n (Montgomery's product); r may be a or b
	[MontMul: ptr<u32> r: 0; ptr<u32> a: 0; ptr<u32> b: 0; ptr<Modulus> m: 0;]
		big_from_a is a;
		big_from_b is b;
		big_to is r;
		big_n is addr m.wide;
		big_h is m.limbs >> 1;
		big_inverse is m.wide_inverse;
		call BigMontMul;
	[end]

	# r = base ^ exponent mod n, the exponent as e_count big-endian bytes; false if the
	# base isn't below n
	[PowMod: ptr<u32> r: 0; ptr<u32> base: 0; ptr<u8> exponent: 0; u32 e_count: 0; ptr<Modulus> m: 0;]
		u32 n: m.limbs;
		if (Big.Compare: base addr m.n n) >= 0 return false;
		call Big.MontMul: addr big_x base addr m.r2 m;        # base, in Montgomery form
		call Big.MontPow: r addr big_x exponent e_count m;
		call Big.MontMul: r r addr big_one m;                 # out of Montgomery form (MontPow left big_one 1)
	[end: true]

	# r = base ^ exponent with both in Montgomery form (x R mod n), the exponent as e_count
	# big-endian bytes; r may be base
	[MontPow: ptr<u32> r: 0; ptr<u32> base: 0; ptr<u8> exponent: 0; u32 e_count: 0; ptr<Modulus> m: 0;]
		u32 n: m.limbs;
		while u32 j: 0; j < n; j++;
			big_one:j is 0;
		;;
		big_one:0 is 1;
		call Big.MontMul: addr big_acc addr big_one addr m.r2 m;   # 1, in Montgomery form
		while u32 i: 0; i < e_count; i++;
			u32 byte: exponent:i;
			int bit: 7;
			while bit >= 0
				call Big.MontMul: addr big_acc addr big_acc addr big_acc m;
				if ((byte >> bit) & 1) is 1
					call Big.MontMul: addr big_acc addr big_acc base m;
				;;
				bit--;
			;;
		;;
		call Big.Copy: r addr big_acc n;
	[end]
}

# Montgomery's product, for Big.MontMul: the limbs at big_to = those at big_from_a times
# those at big_from_b / 2^(32 big_h) mod the modulus at big_n. Four steps:
#  - the limbs joined in pairs into big_a and big_b (a limb is 16 bits in 32, so two make 32)
#  - for each 32 bits of b in turn: w = w + a * that, then w = (w + q * n) / 2^32, with
#    q = w's low 32 bits * big_inverse, which makes the low 32 bits of the sum 0
#  - w is below twice the modulus: the modulus off once if w isn't below it
#  - w parted into limbs again
asm.BigMontMul
{
	mov esi, [{big_from_a}]
	mov edi, [{big_from_b}]
	xor ecx, ecx
.join:
	mov eax, [esi + ecx*8 + 4]
	shl eax, 16
	or eax, [esi + ecx*8]
	mov [{big_a} + ecx*4], eax
	mov eax, [edi + ecx*8 + 4]
	shl eax, 16
	or eax, [edi + ecx*8]
	mov [{big_b} + ecx*4], eax
	mov dword [{big_w} + ecx*4], 0
	inc ecx
	cmp ecx, [{big_h}]
	jb .join
	mov dword [{big_w} + ecx*4], 0
	mov dword [{big_w} + ecx*4 + 4], 0

	mov esi, [{big_n}]
	xor edi, edi                         ; which part of b
.each:
	mov eax, [{big_b} + edi*4]
	mov [{big_bi}], eax
	xor ebx, ebx                         ; what's carried
	xor ecx, ecx
.multiply:
	mov eax, [{big_a} + ecx*4]
	mul dword [{big_bi}]
	add eax, [{big_w} + ecx*4]
	adc edx, 0
	add eax, ebx
	adc edx, 0
	mov [{big_w} + ecx*4], eax
	mov ebx, edx
	inc ecx
	cmp ecx, [{big_h}]
	jb .multiply
	add [{big_w} + ecx*4], ebx
	mov dword [{big_w} + ecx*4 + 4], 0
	adc dword [{big_w} + ecx*4 + 4], 0

	mov eax, [{big_w}]
	mul dword [{big_inverse}]
	mov [{big_q}], eax
	mul dword [esi]
	add eax, [{big_w}]
	adc edx, 0
	mov ebx, edx
	mov ecx, 1
.reduce:
	cmp ecx, [{big_h}]
	jae .reduced
	mov eax, [esi + ecx*4]
	mul dword [{big_q}]
	add eax, [{big_w} + ecx*4]
	adc edx, 0
	add eax, ebx
	adc edx, 0
	mov [{big_w} + ecx*4 - 4], eax
	mov ebx, edx
	inc ecx
	jmp .reduce
.reduced:
	mov eax, [{big_w} + ecx*4]
	add eax, ebx
	mov [{big_w} + ecx*4 - 4], eax
	mov eax, [{big_w} + ecx*4 + 4]
	adc eax, 0
	mov [{big_w} + ecx*4], eax
	inc edi
	cmp edi, [{big_h}]
	jb .each

	; the modulus comes off if w has gone past 2^(32 h), or isn't below it (from the top down)
	mov ecx, [{big_h}]
	cmp dword [{big_w} + ecx*4], 0
	jne .take
.compare:
	dec ecx
	mov eax, [{big_w} + ecx*4]
	cmp eax, [esi + ecx*4]
	ja .take
	jb .part
	test ecx, ecx
	jnz .compare
.take:
	mov edx, [{big_h}]
	xor ecx, ecx                         ; (and no borrow yet; inc and dec leave it be)
.subtract:
	mov eax, [{big_w} + ecx*4]
	sbb eax, [esi + ecx*4]
	mov [{big_w} + ecx*4], eax
	inc ecx
	dec edx
	jnz .subtract
.part:
	mov edi, [{big_to}]
	xor ecx, ecx
.split:
	mov eax, [{big_w} + ecx*4]
	movzx edx, ax
	mov [edi + ecx*8], edx
	shr eax, 16
	mov [edi + ecx*8 + 4], eax
	inc ecx
	cmp ecx, [{big_h}]
	jb .split
	ret
}

x64.BigMontMul
{
	mov rsi, [rel {big_from_a}]
	mov rdi, [rel {big_from_b}]
	lea r8, [rel {big_a}]
	lea r9, [rel {big_b}]
	lea r10, [rel {big_w}]
	mov r11d, [rel {big_h}]
	mov r12d, [rel {big_inverse}]
	xor ecx, ecx
.join:
	mov eax, [rsi + rcx*8 + 4]
	shl eax, 16
	or eax, [rsi + rcx*8]
	mov [r8 + rcx*4], eax
	mov eax, [rdi + rcx*8 + 4]
	shl eax, 16
	or eax, [rdi + rcx*8]
	mov [r9 + rcx*4], eax
	mov dword [r10 + rcx*4], 0
	inc ecx
	cmp ecx, r11d
	jb .join
	mov dword [r10 + rcx*4], 0
	mov dword [r10 + rcx*4 + 4], 0

	mov rsi, [rel {big_n}]
	xor edi, edi                         ; which part of b
.each:
	mov r13d, [r9 + rdi*4]
	xor ebx, ebx                         ; what's carried
	xor ecx, ecx
.multiply:
	mov eax, [r8 + rcx*4]
	mul r13d
	add eax, [r10 + rcx*4]
	adc edx, 0
	add eax, ebx
	adc edx, 0
	mov [r10 + rcx*4], eax
	mov ebx, edx
	inc ecx
	cmp ecx, r11d
	jb .multiply
	add [r10 + rcx*4], ebx
	mov dword [r10 + rcx*4 + 4], 0
	adc dword [r10 + rcx*4 + 4], 0

	mov eax, [r10]
	mul r12d
	mov r14d, eax                        ; q
	mul dword [rsi]
	add eax, [r10]
	adc edx, 0
	mov ebx, edx
	mov ecx, 1
.reduce:
	cmp ecx, r11d
	jae .reduced
	mov eax, [rsi + rcx*4]
	mul r14d
	add eax, [r10 + rcx*4]
	adc edx, 0
	add eax, ebx
	adc edx, 0
	mov [r10 + rcx*4 - 4], eax
	mov ebx, edx
	inc ecx
	jmp .reduce
.reduced:
	mov eax, [r10 + rcx*4]
	add eax, ebx
	mov [r10 + rcx*4 - 4], eax
	mov eax, [r10 + rcx*4 + 4]
	adc eax, 0
	mov [r10 + rcx*4], eax
	inc edi
	cmp edi, r11d
	jb .each

	; the modulus comes off if w has gone past 2^(32 h), or isn't below it (from the top down)
	mov ecx, r11d
	cmp dword [r10 + rcx*4], 0
	jne .take
.compare:
	dec ecx
	mov eax, [r10 + rcx*4]
	cmp eax, [rsi + rcx*4]
	ja .take
	jb .part
	test ecx, ecx
	jnz .compare
.take:
	mov edx, r11d
	xor ecx, ecx                         ; (and no borrow yet; inc and dec leave it be)
.subtract:
	mov eax, [r10 + rcx*4]
	sbb eax, [rsi + rcx*4]
	mov [r10 + rcx*4], eax
	inc ecx
	dec edx
	jnz .subtract
.part:
	mov rdi, [rel {big_to}]
	xor ecx, ecx
.split:
	mov eax, [r10 + rcx*4]
	movzx edx, ax
	mov [rdi + rcx*8], edx
	shr eax, 16
	mov [rdi + rcx*8 + 4], eax
	inc ecx
	cmp ecx, r11d
	jb .split
	ret
}

# For Big.AddMod: the limbs at big_to = those at big_from_a plus those at big_from_b, a
# limb at a time (16 bits in 32, so what's carried is the bit above), then the modulus
# (big_limbs limbs at big_n) taken off if the sum carried out or isn't below it.
asm.BigAddMod
{
	mov esi, [{big_from_a}]
	mov edi, [{big_from_b}]
	mov edx, [{big_to}]
	xor ebx, ebx
	xor ecx, ecx
.add:
	mov eax, [esi + ecx*4]
	add eax, [edi + ecx*4]
	add eax, ebx
	mov ebx, eax
	shr ebx, 16
	and eax, 0xFFFF
	mov [edx + ecx*4], eax
	inc ecx
	cmp ecx, [{big_limbs}]
	jb .add
	mov esi, [{big_n}]
	test ebx, ebx
	jnz .take
.compare:                                ; from the top limb down
	dec ecx
	mov eax, [edx + ecx*4]
	cmp eax, [esi + ecx*4]
	ja .take
	jb .done
	test ecx, ecx
	jnz .compare
.take:
	xor ebx, ebx
	xor ecx, ecx
.subtract:
	mov eax, [edx + ecx*4]
	sub eax, [esi + ecx*4]
	sub eax, ebx
	mov ebx, eax
	shr ebx, 31
	and eax, 0xFFFF
	mov [edx + ecx*4], eax
	inc ecx
	cmp ecx, [{big_limbs}]
	jb .subtract
.done:
	ret
}

x64.BigAddMod
{
	mov rsi, [rel {big_from_a}]
	mov rdi, [rel {big_from_b}]
	mov rdx, [rel {big_to}]
	xor ebx, ebx
	xor ecx, ecx
.add:
	mov eax, [rsi + rcx*4]
	add eax, [rdi + rcx*4]
	add eax, ebx
	mov ebx, eax
	shr ebx, 16
	and eax, 0xFFFF
	mov [rdx + rcx*4], eax
	inc ecx
	cmp ecx, [rel {big_limbs}]
	jb .add
	mov rsi, [rel {big_n}]
	test ebx, ebx
	jnz .take
.compare:                                ; from the top limb down
	dec ecx
	mov eax, [rdx + rcx*4]
	cmp eax, [rsi + rcx*4]
	ja .take
	jb .done
	test ecx, ecx
	jnz .compare
.take:
	xor ebx, ebx
	xor ecx, ecx
.subtract:
	mov eax, [rdx + rcx*4]
	sub eax, [rsi + rcx*4]
	sub eax, ebx
	mov ebx, eax
	shr ebx, 31
	and eax, 0xFFFF
	mov [rdx + rcx*4], eax
	inc ecx
	cmp ecx, [rel {big_limbs}]
	jb .subtract
.done:
	ret
}

# For Big.SubMod: the limbs at big_to = those at big_from_a less those at big_from_b (what's
# borrowed shows as the top bit of the 32), then the modulus put back on if that borrowed.
asm.BigSubMod
{
	mov esi, [{big_from_a}]
	mov edi, [{big_from_b}]
	mov edx, [{big_to}]
	xor ebx, ebx
	xor ecx, ecx
.subtract:
	mov eax, [esi + ecx*4]
	sub eax, [edi + ecx*4]
	sub eax, ebx
	mov ebx, eax
	shr ebx, 31
	and eax, 0xFFFF
	mov [edx + ecx*4], eax
	inc ecx
	cmp ecx, [{big_limbs}]
	jb .subtract
	test ebx, ebx
	jz .done
	mov esi, [{big_n}]
	xor ebx, ebx
	xor ecx, ecx
.add:
	mov eax, [edx + ecx*4]
	add eax, [esi + ecx*4]
	add eax, ebx
	mov ebx, eax
	shr ebx, 16
	and eax, 0xFFFF
	mov [edx + ecx*4], eax
	inc ecx
	cmp ecx, [{big_limbs}]
	jb .add
.done:
	ret
}

x64.BigSubMod
{
	mov rsi, [rel {big_from_a}]
	mov rdi, [rel {big_from_b}]
	mov rdx, [rel {big_to}]
	xor ebx, ebx
	xor ecx, ecx
.subtract:
	mov eax, [rsi + rcx*4]
	sub eax, [rdi + rcx*4]
	sub eax, ebx
	mov ebx, eax
	shr ebx, 31
	and eax, 0xFFFF
	mov [rdx + rcx*4], eax
	inc ecx
	cmp ecx, [rel {big_limbs}]
	jb .subtract
	test ebx, ebx
	jz .done
	mov rsi, [rel {big_n}]
	xor ebx, ebx
	xor ecx, ecx
.add:
	mov eax, [rdx + rcx*4]
	add eax, [rsi + rcx*4]
	add eax, ebx
	mov ebx, eax
	shr ebx, 16
	and eax, 0xFFFF
	mov [rdx + rcx*4], eax
	inc ecx
	cmp ecx, [rel {big_limbs}]
	jb .add
.done:
	ret
}
