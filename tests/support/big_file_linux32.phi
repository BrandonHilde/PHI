# A file made any size at once, with no room taken for it, for big_file_sizes_program.phi: on
# 32-bit Linux, in /tmp, which holds the gap as nothing. The same BigFile as the other systems'.

phi.BigFile:Linux32
{
	[Folder]
	[end: '/tmp/']

	[Pid]
	[end: (sys.GetPid)]

	# the file at path made (high * 4 GB + low) bytes long
	[Resize: ptr<u8> path: 0; u32 high: 0; u32 low: 0;]
	[end: (sys.Truncate64: path low high) is 0]
}

sys.GetPid: 20;
sys.Truncate64: 193  ptr<u8> path  u32 low  u32 high;
