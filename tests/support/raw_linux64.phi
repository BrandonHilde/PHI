# 64-bit Linux's system calls for sys_calls_program.phi: syscall, with x86-64's numbers.
# The same Raw as raw_linux32.phi: only the numbers differ.

phi.Raw:Linux64
{
	# text (ending at its 0) to standard output, straight from the system
	[Say: ptr<u8> text: 0;]
		u32 length: 0;
		while text:length is not 0
			length++;
		;;
		int written: (sys.Write: 1 text length);
	[end]

	[Pid]
	[end: (sys.GetPid)]

	[Close: int fd: 0;]
	[end: (sys.Close: fd)]

	# a page of memory of its own (mmap: six values, and a pointer back; in 64-bit
	# code the page is above 4 GB, so a pointer cut to 32 bits wouldn't reach it)
	[Page]
		ptr<u8> page: (sys.Map: 0 4096 3 0x22 -1 0);
		page:100 is 42;
	[end: page:100]

	# a position past 4 GB in a file of no size, and back: all 64 bits of it each way
	[Far: u64 where: 0;]
		int fd: (sys.MemoryFile: 'far' 0);
		u64 got: (sys.SeekFar: fd where 0);
		int closed: (sys.Close: fd);
	[end: got]
}

sys.MemoryFile: 319  ptr<u8> name  int flags;
sys.SeekFar: 8  int fd  u64 where  int from: u64;

sys.Write: 1  int fd  ptr<u8> data  u32 length;
sys.GetPid: 39;
sys.Map: 9  ptr<u8> address  u32 size  int protect  int flags  int fd  u32 offset: ptr<u8>;
sys.Close: 3  int fd;
