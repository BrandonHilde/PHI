# A file made any size at once, with no room taken for it, for big_file_sizes_program.phi: on
# 64-bit Linux, in /tmp, which holds the gap as nothing. The same BigFile as the other systems'.

phi.BigFile:Linux64
{
	[Folder]
	[end: '/tmp/']

	[Pid]
	[end: (sys.GetPid)]

	# the file at path made (high * 4 GB + low) bytes long
	[Resize: ptr<u8> path: 0; u32 high: 0; u32 low: 0;]
		u64 size: high;
		size is (size << 32) | low;
	[end: (sys.Truncate: path size as ptr<u8>) is 0]

	# length bytes of text written (high * 4 GB + low) bytes in
	[Mark: ptr<u8> path: 0; u32 high: 0; u32 low: 0; ptr<u8> text: 0; u32 length: 0;]
		u64 where: high;
		where is (where << 32) | low;
		int fd: (sys.OpenToMark: path 1 0);
		if fd < 0 return false;
		int wrote: (sys.WriteAt: fd text length where);
		int closed: (sys.CloseMarked: fd);
	[end: wrote is length]
}

sys.GetPid: 39;
sys.Truncate: 76  ptr<u8> path  ptr<u8> length;
sys.OpenToMark: 2  ptr<u8> path  int flags  int mode;
sys.WriteAt: 18  int fd  ptr<u8> data  u32 count  u64 where;
sys.CloseMarked: 3  int fd;
