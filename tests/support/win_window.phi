# What window_program.phi asks of Windows, to play the part of the user and look at what's
# shown: messages posted to the program's own window, as Windows would send them, and the
# pixels it paints, asked for in a bitmap (WM_PRINTCLIENT: PrintWindow won't print a hidden
# window). The window stays hidden (HostWindow.visible), so nothing pops up and nothing
# takes the keys from whoever's at the computer. x11_window.phi is the same for X.

use 'gdi32.dll' as Gdi32;
use 'user32.dll' as User32;

phi.WindowTest:Windows
{
	# a message in the window's queue, as Windows would put it there
	[Post: u32 message: 0; int w: 0; int l: 0;]
		call User32.PostMessageW: HostWindow.window message w as ptr<u8> l as ptr<u8>;
	[end]

	[At: int x: 0; int y: 0;]
	[end: (y << 16) | x]

	# Windows' number for a key by Input's (only those the test uses)
	[VirtualKey: int key: 0;]
		if key is Events.KEY_UP return 0x26;
		if key is Events.KEY_DOWN return 0x28;
		if key is Events.KEY_LEFT return 0x25;
		if key is Events.KEY_RIGHT return 0x27;
		if key is Events.KEY_ENTER return 0x0D;
		if key is Events.KEY_ESCAPE return 0x1B;
		if key is 'w' return 0x57;
	[end: key]

	[TypeChar: int c: 0;]
		call Post: 0x102 c 0;             # WM_CHAR
	[end]

	[KeyDown: int key: 0;]
		call Post: 0x100 (VirtualKey: key) 0;
	[end]

	[KeyUp: int key: 0;]
		call Post: 0x101 (VirtualKey: key) 0;
	[end]

	[MoveTo: int x: 0; int y: 0;]
		call Post: 0x200 0 (At: x y);
	[end]

	[LeftDown: int x: 0; int y: 0;]
		call Post: 0x201 1 (At: x y);
	[end]

	[LeftUp: int x: 0; int y: 0;]
		call Post: 0x202 0 (At: x y);
	[end]

	[LeftDouble: int x: 0; int y: 0;]
		call Post: 0x203 1 (At: x y);
	[end]

	[RightDown: int x: 0; int y: 0;]
		call Post: 0x204 2 (At: x y);
	[end]

	[RightUp: int x: 0; int y: 0;]
		call Post: 0x205 0 (At: x y);
	[end]

	# a notch towards the user
	[WheelDown: int x: 0; int y: 0;]
		call Post: 0x20A (-120 << 16) (At: x y);
	[end]

	[CloseIt]
		call Post: 0x10 0 0;              # WM_CLOSE
	[end]

	# the window's inside, across and down
	[ClientWidth]
		WinRect area;
		call User32.GetClientRect: HostWindow.window addr area;
	[end: area.right]

	[ClientHeight]
		WinRect area;
		call User32.GetClientRect: HostWindow.window addr area;
	[end: area.bottom]

	[TitleLength]
	[end: (User32.GetWindowTextLengthW: HostWindow.window)]

	# whether the user can change its size (it has the frame that's done with)
	[CanResize]
	[end: ((User32.GetWindowLongW: HostWindow.window (-16)) & 0x40000) is not 0]

	# whether a window that's showing still is once it can't be resized: the two are in one
	# word of Windows', and a game that asked for this vanished. (The window is shown off the
	# screen and without taking the keys, and hidden again.)
	[ShownWhenMadeFixed]
		call User32.SetWindowPos: HostWindow.window 0 (-32000) (-32000) 0 0 0x15;   # NOSIZE NOZORDER NOACTIVATE
		call User32.ShowWindow: HostWindow.window 4;      # SW_SHOWNOACTIVATE
		call HostWindow.SetResizable: 0;
		int shown: (User32.IsWindowVisible: HostWindow.window);
		call User32.ShowWindow: HostWindow.window 0;      # SW_HIDE
	[end: shown is not 0]

	# the color shown at x, y (0x00RRGGBB), from what the window paints
	[PixelAt: int x: 0; int y: 0;]
		ptr<u8> screen: (User32.GetDC: 0);
		ptr<u8> dc: (Gdi32.CreateCompatibleDC: screen);
		ptr<u8> picture: (Gdi32.CreateCompatibleBitmap: screen 400 300);
		ptr<u8> old: (Gdi32.SelectObject: dc picture);
		ptr<u8> answer: (User32.SendMessageW: HostWindow.window 0x318 dc 4 as ptr<u8>);   # WM_PRINTCLIENT, PRF_CLIENT
		u32 color: (Gdi32.GetPixel: dc x y);
		call Gdi32.SelectObject: dc old;
		call Gdi32.DeleteObject: picture;
		call Gdi32.DeleteDC: dc;
		call User32.ReleaseDC: 0 screen;
		# (Windows says colors as 0x00BBGGRR)
		u32 rgb: ((color & 0xFF) << 16) | (color & 0xFF00) | ((color >> 16) & 0xFF);
	[end: rgb]
}

User32.PostMessageW: ptr<u8> window  u32 message  ptr<u8> w  ptr<u8> l;
User32.SendMessageW: ptr<u8> window  u32 message  ptr<u8> w  ptr<u8> l: ptr<u8>;
User32.GetClientRect: ptr<u8> window  ptr<WinRect> area;
User32.GetWindowTextLengthW: ptr<u8> window;
User32.GetWindowLongW: ptr<u8> window  int index;
User32.IsWindowVisible: ptr<u8> window;
User32.GetDC: ptr<u8> window: ptr<u8>;
User32.ReleaseDC: ptr<u8> window  ptr<u8> dc;
Gdi32.CreateCompatibleBitmap: ptr<u8> dc  int w  int h: ptr<u8>;
Gdi32.GetPixel: ptr<u8> dc  int x  int y: u32;
