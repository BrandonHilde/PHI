# A small web and name server on a thread, for web_program.phi: so a program can test net.web with
# nothing outside itself, in every way a server can answer. It answers every name with 127.0.0.1,
# and http on one port and https on another (as phi.test, with the certificate chain net_tls uses).
#
# It handles one connection at a time, and that's enough here, as it gives up on a client that has
# stopped reading (one that has gone on to a new request for another part, say) after half a second, and
# goes on to the next; /never leaves its connection open.
#
# What's under /keep/ leaves its connection open for the next request, as a real server does, until
# the client closes it or another connection comes in (it still has one at a time): /keep/last and
# /keep/closing close theirs after answering (the second saying so first), and after /keep/drop-next
# the next request on that connection gets no answer, only the connection closed, which is what a
# client sees when a server closes a kept connection just as it's asked again. connections counts
# the connections it has taken.

use net.tlslink;
use user.threads;
use user.text;

phi.WebTestServer:Program
{
	const int BIG: 300000;

	u32 http_port: 0;
	u32 https_port: 0;
	u32 dns_port: 0;
	bln stopping: false;
	int thread: -1;

	u8 middle[632];
	u8 leaf[428];
	u8 key[121];
	u8 root_der[843];
	TlsIdentity identity;

	int http_listener: -1;
	int https_listener: -1;
	int dns_socket: -1;

	# for what's being answered
	bln secure: false;
	int connection: -1;
	TlsLink link;
	u8 asked[4096];
	int asked_length: 0;
	int body_at: 0;
	int body_length: 0;
	str verb: [15];
	str path: [255];
	int asks: 0;                          # how many requests it has had
	int connections: 0;                   # how many connections it has taken
	bln kept_open: false;                 # the connection is waiting for its next request
	bln drop_next: false;                 # ...which gets no answer
	int hung: -1;
	bln gave_up: false;                   # the client stopped reading what's being sent

	# three ports that can be had, and the thread
	[Start]
		call Bytes.FromHex: '' addr leaf 428;
		call Bytes.FromHex: '' addr middle 632;
		call Bytes.FromHex: '307702010104201c3c67d53150963e964e28135a7ee1e5c73592704c32240dbc57d6a0cbbe4378a00a06082a8648ce3d030107a14403420004b82ac3af23fdfe999807bb6b796499fc55d95dfda7e6c66db34219034f33a66253cfc9efce24a7f64bd19c0627079a227ec5e7d515201056f72ba50bf8f27c45' addr key 121;
		call Bytes.FromHex: '' addr root_der 843;
		bln made: (Tls13.Identity: addr identity addr leaf 428 addr key 121) and (Tls13.AddIssuer: addr identity addr middle 632);
		log 'the server: ' made '\n';

		u32 port: 43000 + ((OS.CurrentTask) % 9000) as u32;
		while http_listener < 0 or https_listener < 0 or dns_socket < 0
			if http_listener >= 0
				call Tcp.StopListening: http_listener;
			;;
			if https_listener >= 0
				call Tcp.StopListening: https_listener;
			;;
			if dns_socket >= 0
				call Udp.Close: dns_socket;
			;;
			http_listener is (Tcp.Listen: port);
			https_listener is (Tcp.Listen: port + 1);
			dns_socket is (Udp.Open: port + 2);
			http_port is port;
			https_port is port + 1;
			dns_port is port + 2;
			port++ 3;
		;;
		thread is (Threads.Start: addr Serve 0);
	[end]

	[Stop]
		atomic stopping is true;
		call Threads.Wait: thread;
		if kept_open
			call Hang;
		;;
		call Tcp.StopListening: http_listener;
		call Tcp.StopListening: https_listener;
		call Udp.Close: dns_socket;
	[end]

	# the root of the certificates it shows, to trust
	[TrustRoot]
		call X509.Trust: addr root_der 843;
	[end]

	[Serve: int unused: 0;]
		UdpDatagram d;
		while not stopping
			bln did: false;
			if (Udp.Receive: dns_socket addr d)
				call Name: addr d;
				did is true;
			;;
			if kept_open
				int waiting: (KeptState);
				if waiting is not 0
					call Next: waiting > 0;
					did is true;
				;;
			;;
			int c: (Tcp.Accept: http_listener);
			if c >= 0
				call Answer: c false;
				did is true;
			;;
			c is (Tcp.Accept: https_listener);
			if c >= 0
				call Answer: c true;
				did is true;
			;;
			if not did
				call OS.Sleep: 1;
			;;
		;;
	[end]

	# every name is here
	[Name: ptr<UdpDatagram> d: 0;]
		u8 reply[512];
		ptr<u8> q: addr d.data;
		int ended: 12;
		while q:ended is not 0
			ended++ q:ended + 1;
		;;
		ended++ 5;
		while int i: 0; i < ended; i++;
			reply:i is q:i;
		;;
		call Net.Put16: addr reply + 2 0x8180;
		call Net.Put16: addr reply + 4 1;
		call Net.Put16: addr reply + 6 1;
		int pos: ended;
		reply:pos is 0xC0;
		reply:(pos + 1) is 12;
		call Net.Put16: addr reply + pos + 2 1;
		call Net.Put16: addr reply + pos + 4 1;
		call Net.Put32: addr reply + pos + 6 300;
		call Net.Put16: addr reply + pos + 10 4;
		call Net.Put32: addr reply + pos + 12 0x7F000001;
		bln sent: (Udp.SendTo: dns_socket d.from d.from_port addr reply (pos + 16) as u32);
	[end]

	# what the kept connection has for us: 1 for a request, -1 if the client closed it, 0 for nothing yet
	[KeptState]
		if secure
			if not (Secure.Pump: addr link) return -1;
			if link.session.app_left > 0 return 1;
			if link.session.closed return -1;
			return 0;
		;;
		int ready: (Tcp.Waiting: connection);
		if ready < 0 return -1;
		if ready > 0 return 1;
	[end: 0]

	# the kept connection's next request answered, or the connection closed
	[Next: bln asked_again: false;]
		kept_open is false;
		if asked_again and not drop_next and (ReadRequest)
			atomic asks++;
			call Respond;
			if (Stays)
				kept_open is true;
				return;
			;;
		;;
		drop_next is false;
		call Hang;
	[end]

	# whether the connection stays open after what was just answered
	[Stays]
		if gave_up or (Find: 'Connection: close') >= 0 return false;
		if path is '/keep/last' or path is '/keep/closing' return false;
	[end: (Text.StartsWith: addr path:0 '/keep/')]

	# a request on a new connection, answered, and closed
	[Answer: int c: 0; bln on_tls: false;]
		if kept_open
			kept_open is false;
			drop_next is false;
			call Hang;
		;;
		atomic connections++;
		connection is c;
		secure is on_tls;
		gave_up is false;
		if secure
			if not (Secure.Accept: addr link c addr identity)
				call Tcp.Close: c;
				return;
			;;
			int start: (OS.GetTicks);
			while not link.session.connected
				if not (Secure.Pump: addr link) or (OS.GetTicks) - start > 5000
					call Secure.Close: addr link;
					return;
				;;
				if not link.session.connected
					call OS.Sleep: 1;
				;;
			;;
		;;
		if (ReadRequest)
			atomic asks++;
			call Respond;
			if (Stays)
				kept_open is true;
				return;
			;;
		;;
		if path is '/never'
			return;
		;;
		call Hang;
	[end]

	[Hang]
		if secure
			# (what's left goes, then close_notify)
			int start: (OS.GetTicks);
			while not gave_up and (Tls13.Pending: addr link.session) > 0 and (OS.GetTicks) - start < 5000
				if not (Secure.Pump: addr link) break;
				call OS.Sleep: 1;
			;;
			call Secure.Close: addr link;
		;;
		else
			call Tcp.Close: connection;
		;;
	[end]

	# the verb, the path, the headers and any body
	[ReadRequest]
		asked_length is 0;
		int start: (OS.GetTicks);
		body_at is -1;
		while body_at < 0 and asked_length < 4095
			int got: (Some: addr asked:asked_length 4095 - asked_length);
			if got < 0 return false;
			asked_length++ got;
			while int i: 3; i < asked_length; i++;
				if asked:i is 10 and asked:(i - 1) is 13 and asked:(i - 2) is 10 and asked:(i - 3) is 13 and body_at < 0
					body_at is i + 1;
				;;
			;;
			if got is 0
				if (OS.GetTicks) - start > 5000 return false;
				call OS.Sleep: 1;
			;;
		;;
		if body_at < 0 return false;
		asked:asked_length is 0;
		verb is '';
		int i: 0;
		while asked:i is not ' '
			verb++ asked:i as chr;
			i++;
		;;
		i++;
		path is '';
		while asked:i is not ' '
			path++ asked:i as chr;
			i++;
		;;
		# what's still to come of the body
		int wanted: (HeaderNumber: 'Content-Length: ');
		start is (OS.GetTicks);
		while asked_length - body_at < wanted and asked_length < 4095
			int got: (Some: addr asked:asked_length 4095 - asked_length);
			if got < 0 return false;
			asked_length++ got;
			if got is 0
				if (OS.GetTicks) - start > 5000 return false;
				call OS.Sleep: 1;
			;;
		;;
		asked:asked_length is 0;
		body_length is asked_length - body_at;
	[end: true]

	# what's there now, without waiting: how much; -1 once it's closed
	[Some: ptr<u8> to: 0; int room: 0;]
		if secure
			if not (Secure.Pump: addr link) return -1;
			int got: (Secure.Read: addr link to room as u32);
			if got < 0 return 0;
			return got;
		;;
		int ready: (Tcp.Waiting: connection);
		if ready < 0 return -1;
		if ready is 0 return 0;
	[end: (Tcp.Read: connection to room as u32)]

	# the number after this in the request; 0 if it isn't there
	[HeaderNumber: ptr<u8> name: 0;]
		int place: (Find: name);
		if place < 0 return 0;
		int number: 0;
		place++ (Text.Length: name);
		while asked:place >= '0' and asked:place <= '9'
			number is number * 10 + asked:place - '0';
			place++;
		;;
	[end: number]

	# where this is in the request; -1 if it isn't
	[Find: ptr<u8> what: 0;]
		int length: (Text.Length: what);
		while int i: 0; i + length <= body_at; i++;
			bln same: true;
			while int k: 0; k < length and same; k++;
				same is (asked:(i + k) is what:k);
			;;
			if same return i;
		;;
	[end: -1]

	# length bytes to the client, or as much as it takes: gave_up if it stops taking them
	[Out: ptr<u8> data: 0; int length: 0;]
		if length <= 0 or gave_up return;
		int done: 0;
		int moved: (OS.GetTicks);
		while done < length or (secure and (Tls13.Pending: addr link.session) > 0)
			int took: 0;
			if secure
				u32 waiting: (Tls13.Pending: addr link.session);
				if done < length
					took is (Secure.Write: addr link data + done (length - done) as u32);
					if took < 0 return;
					done++ took;
				;;
				if not (Secure.Pump: addr link) return;
				if (Tls13.Pending: addr link.session) < waiting
					took++;
				;;
			;;
			else
				took is (Tcp.Send: connection data + done (length - done) as u32);
				if took < 0 return;
				done++ took;
			;;
			if took > 0
				moved is (OS.GetTicks);
			;;
			elif (OS.GetTicks) - moved > 500
				gave_up is true;
				return;
			;;
			else
				call OS.Sleep: 1;
			;;
		;;
	[end]

	[Say: str text;]
		call Out: addr text:0 text.len;
	[end]

	[Respond]
		when path
			is '/hello'
				call Say: 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Phi-Test: Yes  \r\nContent-Length: 11\r\n\r\nhello, web\n';
			;;
			is '/chunked'
				call Say: 'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n';
				call Say: '5\r\nhello\r\n';
				call Say: '7;with=extension\r\n, chunk\r\n';
				call Say: 'A\r\ns of text\n\r\n';
				call Say: '0\r\nX-Trailer: after\r\n\r\n';
			;;
			is '/chunked-cut'
				call Say: 'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel';
			;;
			is '/close'
				call Say: 'HTTP/1.0 200 OK\r\n\r\nuntil it closes\n';
			;;
			is '/moved'
				call Say: 'HTTP/1.1 302 Found\r\nLocation: /hello\r\nContent-Length: 0\r\n\r\n';
			;;
			is '/moved-whole'
				str whole: ('HTTP/1.1 301 Moved\r\nContent-Length: 0\r\nLocation: http://phi.test:' http_port '/hello\r\n\r\n');
				call Say: whole;
			;;
			is '/dir/beside'
				call Say: 'HTTP/1.1 307 Temporary\r\nLocation: there?x=1\r\nContent-Length: 0\r\n\r\n';
			;;
			is '/dir/there?x=1'
				call Say: 'HTTP/1.1 200 OK\r\nContent-Length: 7\r\n\r\nbeside\n';
			;;
			is '/loop'
				call Say: 'HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\n\r\n';
			;;
			is '/see-other'
				call Say: 'HTTP/1.1 303 See Other\r\nLocation: /echo\r\nContent-Length: 0\r\n\r\n';
			;;
			is '/echo'
				call Echo;
			;;
			is '/big'
				call Big: true;
			;;
			is '/big-no-range'
				call Big: false;
			;;
			is '/missing'
				call Say: 'HTTP/1.1 404 Not Found\r\nContent-Length: 10\r\n\r\nnot here!\n';
			;;
			is '/cut'
				call Say: 'HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nshort';
			;;
			is '/garbage'
				call Say: 'this is not what a web server says\r\n\r\n';
			;;
			is '/nothing'
				call Say: 'HTTP/1.1 204 No Content\r\n\r\n';
			;;
			is '/continue'
				call Say: 'HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nafter\n';
			;;
			is '/never'
				hung is connection;
			;;
			is '/keep/chunked'
				call Say: 'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n';
				call Say: '4\r\nkept\r\n';
				call Say: '1\r\n\n\r\n';
				call Say: '0\r\n\r\n';
			;;
			is '/keep/moved'
				call Say: 'HTTP/1.1 302 Found\r\nLocation: /keep/a\r\nContent-Length: 6\r\n\r\nmoved\n';
			;;
			is '/keep/long-moved'
				call Say: 'HTTP/1.1 302 Found\r\nLocation: /keep/a\r\nContent-Length: 5000\r\n\r\n';
				u8 filler[1000];
				while int i: 0; i < 1000; i++;
					filler:i is '.';
				;;
				while int n: 0; n < 5; n++;
					call Out: addr filler 1000;
				;;
			;;
			is '/keep/closing'
				call Say: 'HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 5\r\n\r\nkept\n';
			;;
			is '/keep/drop-next'
				drop_next is true;
				call Say: 'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nkept\n';
			;;
			else
				if (Text.StartsWith: addr path:0 '/keep/')
					call Say: 'HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nkept\n';
				;;
				else
					call Say: 'HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n';
				;;
			;;
		;;
	[end]

	# what it was asked: the verb and path, a header, and the body
	[Echo]
		str body: (verb ' ' path '\n');
		int place: (Find: 'X-Custom: ');
		if place >= 0
			body++ 'custom: ';
			place++ 10;
			while asked:place is not 13
				body++ asked:place as chr;
				place++;
			;;
			body++ '\n';
		;;
		if body_length > 0
			body++ 'body: ';
			while int i: 0; i < body_length; i++;
				body++ asked:(body_at + i) as chr;
			;;
			body++ '\n';
		;;
		str head: ('HTTP/1.1 200 OK\r\nContent-Length: ' body.len '\r\n\r\n');
		call Say: head;
		call Say: body;
	[end]

	# BIG bytes, each the place it's at mod 251, from where a Range says if it can
	[Big: bln can_range: false;]
		int from: 0;
		int place: (Find: 'Range: bytes=');
		if can_range and place >= 0
			from is (HeaderNumber: 'Range: bytes=');
		;;
		if from >= BIG
			call Say: 'HTTP/1.1 416 Range Not Satisfiable\r\nContent-Length: 0\r\n\r\n';
			return;
		;;
		if can_range and place >= 0
			str head: ('HTTP/1.1 206 Partial Content\r\nContent-Range: bytes ' from '-' BIG - 1 '/' BIG '\r\nContent-Length: ' BIG - from '\r\n\r\n');
			call Say: head;
		;;
		else
			str head: ('HTTP/1.1 200 OK\r\nContent-Length: ' BIG '\r\n\r\n');
			call Say: head;
		;;
		u8 piece[1024];
		int at_byte: from;
		while at_byte < BIG and not gave_up
			int n: 0;
			while n < 1024 and at_byte + n < BIG
				piece:n is ((at_byte + n) % 251) as u8;
				n++;
			;;
			call Out: addr piece n;
			at_byte++ n;
		;;
	[end]
}
