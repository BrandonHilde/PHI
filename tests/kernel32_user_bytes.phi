# Process.CopyBytesToUser and CopyBytesFromUser: a program's own memory goes either way, and
# anything else (the kernel's memory, a count that went negative) copies nothing at all.
use proc.process;

phi.UserBytesTest:Kernel
{
	const u32 TO_USER: 110;
	const u32 FROM_USER: 111;
	const u32 WHERE: 112;

	method<u32 u32 u32 u32 u32: int> other_calls: Process.more_calls;
	Process.more_calls is addr Handle;

	u8 kept[8];
	while int i: 0; i < 8; i++;
		kept:i is ('a' + i) as u8;
	;;

	int pid: (Process.Spawn: 'BYTES.BIN');
	int code: (Process.Wait: pid);
	log 'program ended: ' code '\n';
	log 'kept: ';
	while int i: 0; i < 8; i++;
		log kept:i as chr;
	;;
	log '\n';
	exit 0;

	[Handle: u32 number: 0; u32 a: 0; u32 b: 0; u32 c: 0; u32 d: 0;]
		if number is TO_USER
			if (Process.CopyBytesToUser: a addr kept b) return 1;
			return 0;
		;;
		if number is FROM_USER
			if (Process.CopyBytesFromUser: a addr kept b) return 1;
			return 0;
		;;
		if number is WHERE return addr kept as int;
		int passed: -1;
		if other_calls is not 0
			call passed is other_calls: number a b c d;
		;;
	[end: passed]
}
