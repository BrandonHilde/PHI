# Made by tests/support/vec_lanes.py: every vec operation on every kind of lane (see there).
phi.VecLanesProgram:Program
{
	call Test_i8: 0;
	call Test_i8: 2;
	call Test_i8: 7;
	call Test_i8: 8;
	call Test_i8: 40;
	call Test_u8: 0;
	call Test_u8: 2;
	call Test_u8: 7;
	call Test_u8: 8;
	call Test_u8: 40;
	call Test_i16: 0;
	call Test_i16: 2;
	call Test_i16: 15;
	call Test_i16: 16;
	call Test_i16: 40;
	call Test_u16: 0;
	call Test_u16: 2;
	call Test_u16: 15;
	call Test_u16: 16;
	call Test_u16: 40;
	call Test_int: 0;
	call Test_int: 2;
	call Test_int: 31;
	call Test_int: 32;
	call Test_int: 40;
	call Test_u32: 0;
	call Test_u32: 2;
	call Test_u32: 31;
	call Test_u32: 32;
	call Test_u32: 40;
	call Test_i64: 0;
	call Test_i64: 2;
	call Test_i64: 63;
	call Test_i64: 64;
	call Test_i64: 40;
	call Test_u64: 0;
	call Test_u64: 2;
	call Test_u64: 63;
	call Test_u64: 64;
	call Test_u64: 40;
	call Test_f32;
	call Test_f64;
	call Conversions;
	exit 0;

	[Test_i8: int s: 0;]
		vec<i8> a: -128 -127 -100 -2 -1 0 1 2 3 50 100 126 127 -50 7 -7;
		vec<i8> b: 1 -1 100 -2 127 -128 5 -3 0 60 -100 1 127 -128 9 13;
		log 'i8 a: ' a '\n';
		log 'i8 add: ' (a + b) '\n';
		log 'i8 sub: ' (a - b) '\n';
		log 'i8 mul: ' (a * b) '\n';
		log 'i8 neg: ' (-a) '\n';
		log 'i8 min: ' (a.Min: b) '\n';
		log 'i8 max: ' (a.Max: b) '\n';
		log 'i8 smallest: ' (a.Smallest) '\n';
		log 'i8 largest: ' (a.Largest) '\n';
		log 'i8 sum: ' (a.Sum) '\n';
		log 'i8 and: ' (a & b) '\n';
		log 'i8 or: ' (a | b) '\n';
		log 'i8 xor: ' (a ^ b) '\n';
		log 'i8 not: ' (~a) '\n';
		log 'i8 abs: ' (a.Abs) '\n';
		log 'i8 shl 0: ' (a << 0) '\n';
		log 'i8 shr 0: ' (a >> 0) '\n';
		log 'i8 shl 1: ' (a << 1) '\n';
		log 'i8 shr 1: ' (a >> 1) '\n';
		log 'i8 shl 3: ' (a << 3) '\n';
		log 'i8 shr 3: ' (a >> 3) '\n';
		log 'i8 shl 7: ' (a << 7) '\n';
		log 'i8 shr 7: ' (a >> 7) '\n';
		log 'i8 shl 8: ' (a << 8) '\n';
		log 'i8 shr 8: ' (a >> 8) '\n';
		log 'i8 shl 100: ' (a << 100) '\n';
		log 'i8 shr 100: ' (a >> 100) '\n';
		if s >= 0
			log 'i8 shl var: ' (a << s) '\n';
			log 'i8 shr var: ' (a >> s) '\n';
		;;
		log 'i8 addsat: ' (a.AddSat: b) '\n';
		log 'i8 subsat: ' (a.SubSat: b) '\n';
		vec<i8> one: 1;
		vec<i8> zero: 0;
		vec<i8> lt: (a.Less: b);
		vec<i8> gt: (a.Greater: b);
		vec<i8> eq: (a.Equal: a);
		vec<i8> eqb: (a.Equal: b);
		log 'i8 less: ' (lt.Pick: one zero) '\n';
		log 'i8 greater: ' (gt.Pick: one zero) '\n';
		log 'i8 equal: ' (eq.Pick: one zero) '\n';
		log 'i8 equal b: ' (eqb.Pick: one zero) '\n';
		log 'i8 any: ' (lt.Any) '\n';
		log 'i8 all: ' (lt.All) '\n';
		log 'i8 all equal: ' (eq.All) '\n';
		log 'i8 is: ' (a is a) '\n';
		log 'i8 is b: ' (a is b) '\n';
		log 'i8 is not: ' (a is not b) '\n';
		log 'i8 lane: ' a:1 '\n';
		a:0 is b:1;
		log 'i8 set: ' a:0 '\n';
		a:0 is -128;
		log 'i8 widen: ' (a.Widen) '\n';
		log 'i8 widen high: ' (a.WidenHigh) '\n';
	[end]

	[Test_u8: int s: 0;]
		vec<u8> a: 0 1 2 127 128 200 255 254 10 20 30 40 50 60 70 80;
		vec<u8> b: 255 1 254 1 128 100 255 1 5 7 9 11 13 15 17 19;
		log 'u8 a: ' a '\n';
		log 'u8 add: ' (a + b) '\n';
		log 'u8 sub: ' (a - b) '\n';
		log 'u8 mul: ' (a * b) '\n';
		log 'u8 neg: ' (-a) '\n';
		log 'u8 min: ' (a.Min: b) '\n';
		log 'u8 max: ' (a.Max: b) '\n';
		log 'u8 smallest: ' (a.Smallest) '\n';
		log 'u8 largest: ' (a.Largest) '\n';
		log 'u8 sum: ' (a.Sum) '\n';
		log 'u8 and: ' (a & b) '\n';
		log 'u8 or: ' (a | b) '\n';
		log 'u8 xor: ' (a ^ b) '\n';
		log 'u8 not: ' (~a) '\n';
		log 'u8 shl 0: ' (a << 0) '\n';
		log 'u8 shr 0: ' (a >> 0) '\n';
		log 'u8 shl 1: ' (a << 1) '\n';
		log 'u8 shr 1: ' (a >> 1) '\n';
		log 'u8 shl 3: ' (a << 3) '\n';
		log 'u8 shr 3: ' (a >> 3) '\n';
		log 'u8 shl 7: ' (a << 7) '\n';
		log 'u8 shr 7: ' (a >> 7) '\n';
		log 'u8 shl 8: ' (a << 8) '\n';
		log 'u8 shr 8: ' (a >> 8) '\n';
		log 'u8 shl 100: ' (a << 100) '\n';
		log 'u8 shr 100: ' (a >> 100) '\n';
		if s >= 0
			log 'u8 shl var: ' (a << s) '\n';
			log 'u8 shr var: ' (a >> s) '\n';
		;;
		log 'u8 addsat: ' (a.AddSat: b) '\n';
		log 'u8 subsat: ' (a.SubSat: b) '\n';
		log 'u8 average: ' (a.Average: b) '\n';
		vec<u8> one: 1;
		vec<u8> zero: 0;
		vec<u8> lt: (a.Less: b);
		vec<u8> gt: (a.Greater: b);
		vec<u8> eq: (a.Equal: a);
		vec<u8> eqb: (a.Equal: b);
		log 'u8 less: ' (lt.Pick: one zero) '\n';
		log 'u8 greater: ' (gt.Pick: one zero) '\n';
		log 'u8 equal: ' (eq.Pick: one zero) '\n';
		log 'u8 equal b: ' (eqb.Pick: one zero) '\n';
		log 'u8 any: ' (lt.Any) '\n';
		log 'u8 all: ' (lt.All) '\n';
		log 'u8 all equal: ' (eq.All) '\n';
		log 'u8 is: ' (a is a) '\n';
		log 'u8 is b: ' (a is b) '\n';
		log 'u8 is not: ' (a is not b) '\n';
		log 'u8 lane: ' a:1 '\n';
		a:0 is b:1;
		log 'u8 set: ' a:0 '\n';
		a:0 is 0;
		log 'u8 widen: ' (a.Widen) '\n';
		log 'u8 widen high: ' (a.WidenHigh) '\n';
	[end]

	[Test_i16: int s: 0;]
		vec<i16> a: -32768 -1 0 1 32767 -300 1234 -5000;
		vec<i16> b: 1 -1 32767 -32768 1 300 -1234 7;
		log 'i16 a: ' a '\n';
		log 'i16 add: ' (a + b) '\n';
		log 'i16 sub: ' (a - b) '\n';
		log 'i16 mul: ' (a * b) '\n';
		log 'i16 neg: ' (-a) '\n';
		log 'i16 min: ' (a.Min: b) '\n';
		log 'i16 max: ' (a.Max: b) '\n';
		log 'i16 smallest: ' (a.Smallest) '\n';
		log 'i16 largest: ' (a.Largest) '\n';
		log 'i16 sum: ' (a.Sum) '\n';
		log 'i16 and: ' (a & b) '\n';
		log 'i16 or: ' (a | b) '\n';
		log 'i16 xor: ' (a ^ b) '\n';
		log 'i16 not: ' (~a) '\n';
		log 'i16 abs: ' (a.Abs) '\n';
		log 'i16 shl 0: ' (a << 0) '\n';
		log 'i16 shr 0: ' (a >> 0) '\n';
		log 'i16 shl 1: ' (a << 1) '\n';
		log 'i16 shr 1: ' (a >> 1) '\n';
		log 'i16 shl 3: ' (a << 3) '\n';
		log 'i16 shr 3: ' (a >> 3) '\n';
		log 'i16 shl 15: ' (a << 15) '\n';
		log 'i16 shr 15: ' (a >> 15) '\n';
		log 'i16 shl 16: ' (a << 16) '\n';
		log 'i16 shr 16: ' (a >> 16) '\n';
		log 'i16 shl 100: ' (a << 100) '\n';
		log 'i16 shr 100: ' (a >> 100) '\n';
		if s >= 0
			log 'i16 shl var: ' (a << s) '\n';
			log 'i16 shr var: ' (a >> s) '\n';
		;;
		log 'i16 addsat: ' (a.AddSat: b) '\n';
		log 'i16 subsat: ' (a.SubSat: b) '\n';
		vec<i16> one: 1;
		vec<i16> zero: 0;
		vec<i16> lt: (a.Less: b);
		vec<i16> gt: (a.Greater: b);
		vec<i16> eq: (a.Equal: a);
		vec<i16> eqb: (a.Equal: b);
		log 'i16 less: ' (lt.Pick: one zero) '\n';
		log 'i16 greater: ' (gt.Pick: one zero) '\n';
		log 'i16 equal: ' (eq.Pick: one zero) '\n';
		log 'i16 equal b: ' (eqb.Pick: one zero) '\n';
		log 'i16 any: ' (lt.Any) '\n';
		log 'i16 all: ' (lt.All) '\n';
		log 'i16 all equal: ' (eq.All) '\n';
		log 'i16 is: ' (a is a) '\n';
		log 'i16 is b: ' (a is b) '\n';
		log 'i16 is not: ' (a is not b) '\n';
		log 'i16 lane: ' a:1 '\n';
		a:0 is b:1;
		log 'i16 set: ' a:0 '\n';
		a:0 is -32768;
		log 'i16 widen: ' (a.Widen) '\n';
		log 'i16 widen high: ' (a.WidenHigh) '\n';
		log 'i16 narrow: ' (a.Narrow: b) '\n';
	[end]

