		;;
		vec<int> one: 1;
		vec<int> zero: 0;
		vec<int> lt: (a.Less: b);
		vec<int> gt: (a.Greater: b);
		vec<int> eq: (a.Equal: a);
		vec<int> eqb: (a.Equal: b);
		log 'int less: ' (lt.Pick: one zero) '\n';
		log 'int greater: ' (gt.Pick: one zero) '\n';
		log 'int equal: ' (eq.Pick: one zero) '\n';
		log 'int equal b: ' (eqb.Pick: one zero) '\n';
