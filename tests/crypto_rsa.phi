# runs only in 32 and 64 bits: its numbers take more room than a 16-bit program has
# RSA signatures of a SHA-256 digest checked: PKCS #1 v1.5 with 2048 and 4096-bit keys,
# and PSS (MGF1-SHA256, a 32-byte salt), all made by OpenSSL 3.2 (openssl dgst -sha256
# -sign, with -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32 for PSS); then
# each one changed a little, which must fail.
use crypto.rsa;

phi.CryptoRsa:Library
{
	u8 n2048[256];
	u8 n4096[512];
	u8 pkcs1[256];
	u8 pss[256];
	u8 pkcs1_4096[512];
	u8 e: 1 0 1;                    # 65537
	u8 digest[32];
	int got: 0;

	got is (Bytes.FromHex: '' addr n2048 256);
	got++ (Bytes.FromHex: '' addr n4096 512);
	got++ (Bytes.FromHex: '' addr pkcs1 256);
	got++ (Bytes.FromHex: '' addr pss 256);
	got++ (Bytes.FromHex: '' addr pkcs1_4096 512);
	log 'bytes: ' got '\n';
	call Sha256.Hash: 'PHI signs this message.' 23 addr digest;

	log 'pkcs1, 2048 bits: ' (Rsa.VerifyPkcs1: addr n2048 256 addr e 3 addr digest addr pkcs1 256) '\n';
	log 'pss, 2048 bits: ' (Rsa.VerifyPss: addr n2048 256 addr e 3 addr digest addr pss 256) '\n';
	log 'pkcs1, 4096 bits: ' (Rsa.VerifyPkcs1: addr n4096 512 addr e 3 addr digest addr pkcs1_4096 512) '\n';

	# the wrong kind, the wrong key, another digest, a changed signature
	log 'pss as pkcs1: ' (Rsa.VerifyPkcs1: addr n2048 256 addr e 3 addr digest addr pss 256) '\n';
	log 'pkcs1 as pss: ' (Rsa.VerifyPss: addr n2048 256 addr e 3 addr digest addr pkcs1 256) '\n';
	log 'another key: ' (Rsa.VerifyPkcs1: addr n4096 512 addr e 3 addr digest addr pkcs1 256) '\n';
	digest:5 is digest:5 ^ 1;
	log 'another digest: ' (Rsa.VerifyPkcs1: addr n2048 256 addr e 3 addr digest addr pkcs1 256)
	    ' ' (Rsa.VerifyPss: addr n2048 256 addr e 3 addr digest addr pss 256) '\n';
	digest:5 is digest:5 ^ 1;
	pss:100 is pss:100 ^ 0x40;
	log 'a changed signature: ' (Rsa.VerifyPss: addr n2048 256 addr e 3 addr digest addr pss 256) '\n';
	# a signature past the modulus can't be one
	log 'past the modulus: ' (Rsa.VerifyPkcs1: addr n2048 256 addr e 3 addr digest addr n2048 256) '\n';
}
