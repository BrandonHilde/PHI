phi.UnsignedArguments:Kernel
{
	u32 big: 0x80000000;
	method<int: int> kept: addr Take;
	call Take: big;
	call Take: big + 1;
	call Take: 0x80000000;
	int n: (Take: big);
	call kept: big;

	# what's said to be meant, or known to fit, or can't be too big
	call Take: big as int;
	call Take: 5;
	call Take: big & 0xFF;
	call Take: big >> 1;
	call Take: big / 2;
	call Take: big % 100;
	u8 small: 1;
	call Take: small;
	log n '\n';

	# the other way: a signed number going to a u32
	int count: 3;
	i16 short: 3;
	i8 tiny: 3;
	method<u32: u32> keptU: addr TakeU;
	call TakeU: count;
	call TakeU: count + 1;
	call TakeU: (-1);
	call TakeU: short;
	call TakeU: tiny;
	call TakeU: (Take: 5);
	call keptU: count;

	# what's said to be meant, or can't be negative, or was never signed
	int numbers: 1 2 3;
	str text: 'abc';
	call TakeU: count as u32;
	call TakeU: (-1) as u32;
	call TakeU: 5;
	call TakeU: 0x80000000;
	call TakeU: count & 0xFF;
	call TakeU: numbers.len;
	call TakeU: text.len;
	call TakeU: small;
	call TakeU: big;

	[Take: int value: 0;]
	[end: value]

	[TakeU: u32 value: 0;]
	[end: value]
}
