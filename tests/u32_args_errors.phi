# A constant that can never fit where it's going is an error when the program is built.
# Anything else that might not fit is checked when it runs (numbers_checked), and what's
# known to fit, or says `as`, isn't.
phi.UnsignedArguments:Kernel
{
	method<int: int> kept: addr Take;
	method<u32: u32> keptU: addr TakeU;

	call Take: 0x80000000;
	int a: 0x80000000;
	a is 0xFFFFFFFF;
	call kept: 0xFFFFFFFF;

	call TakeU: (-1);
	u32 b: -1;
	b is -5;
	call keptU: (-1);

	# what fits, and what says it's meant
	int c: 0x7FFFFFFF;
	c is 0x80000000 as int;
	u32 d: 0x80000000;
	d is (-1) as u32;
	call Take: 0xFFFFFFFF as int;
	call TakeU: (-1) as u32;
	call TakeU: 5;
	log a ' ' b ' ' c ' ' d '\n';

	[Take: int value: 0;]
	[end: value]

	[TakeU: u32 value: 0;]
	[end: value]
}
