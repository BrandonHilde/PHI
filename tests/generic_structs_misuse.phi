# What's said when a struct that takes types is used with a type its code doesn't suit: the
# error is in the struct, and says which use it was for. And when its name is used alone.
struct.Stack<Item>
{
	Item items[];

	[Push: Item item;]
		items++ item;
	[end]

	[Top]
	[end: items:(items.len - 1) + 1]

	[Wrong]
	[end: nothing_here]

	# what's wrong in a method nothing uses isn't said: this suits no type, and nobody calls it
	[Unused]
	[end: also_nothing]

	# but one that's only called by another that is used counts as used
	[Inner]
	[end: deep_nothing]

	[Outer]
	[end: (Inner)]
}

phi.GenericStructsMisuse:Kernel
{
	new Stack<int> numbers;
	new Stack<u8> small;
	new Stack<str> names;
	new Stack alone;
	call numbers.Push: 'text';
	log (names.Top) (numbers.Wrong) (small.Outer);
}
