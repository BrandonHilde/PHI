# str arrays without a most (str names[];): each element's text grows on the heap, and
# the array grows as it's added to, like any array without a size.
phi.TextGrowingArrays:Kernel
{
	str names[];
	names++ 'ann';
	names++ 'bob' 'cy';                     # two more: a list adds each value
	log names.len ': ' names:0 ' ' names:1 ' ' names:2 '\n';

	# an element takes text longer than it had, and text built from a list
	names:0 is 'annabelle, whose name is much longer now';
	names:2 is 'cy number ' 3;
	log names:0 '\n' names:2 '\n';

	# past the room it started with
	str label: '';
	while int i: 0; i < 10; i++;
		label is 'player ' i;
		names++ label;
	;;
	log names.len ': ' names:3 ' ... ' names:12 '\n';

	while each n in names
		if n.len < 4
			log n ' is short\n';
		;;
	;;

	# made shorter: the dropped elements' texts go back, and adding uses their places again
	u32 kept: Heap.used_blocks;
	names.len is 3;
	log names.len ', ten texts back: ' (Heap.used_blocks is kept - 10) '\n';
	names++ 'dee';
	log names.len ': ' names:3 '\n';

	# passed to a method that takes str rows[]: it reads them, and makes them longer
	log 'letters: ' (Letters: names) '\n';
	call Shout: names;
	log names:0 ' ' names:3 '\n';

	# compared whole, with another that grows and with one that has a most
	str same[];
	str fixed[atmost 4];
	same++ 'x' 'y';
	fixed++ 'x' 'y';
	log 'compared: ' (same is fixed) ' ' (same is names) '\n';

	# copied whole: into one that grows (from any str array), and from one into one with a most
	str copy[];
	copy is names;
	log 'copied: ' copy.len ' ' copy:3 ', the same: ' (copy is names) '\n';
	copy:0 is 'only the copy changes';
	log names:0 ' / ' copy:0 '\n';
	copy is fixed;
	log 'from atmost: ' copy.len ' ' copy:1 '\n';
	fixed is same;
	log 'into atmost: ' fixed.len ' ' fixed:1 '\n';
	copy.len is 0;
	u32 roomOnly: Heap.used_blocks;
	copy is names;
	copy.len is 0;
	log 'its texts back: ' (Heap.used_blocks is roomOnly) '\n';

	# a method's own array, and its texts, go back to the heap when it ends
	u32 before: Heap.used_blocks;
	call Local;
	log 'every block back: ' (Heap.used_blocks is before) '\n';
	exit 0;

	[Letters: str rows[];]
		int total: 0;
		while int i: 0; i < rows.len; i++;
			total++ rows:i.len;
		;;
	[end: total]

	[Shout: str rows[];]
		while int i: 0; i < rows.len; i++;
			rows:i is rows:i '!';
		;;
	[end]

	[Local:]
		str words[];
		str word: '';
		while int i: 0; i < 20; i++;
			word is 'word number ' i;
			words++ word;
		;;
		log words.len ' words, the last: ' words:19 '\n';
	[end]
}
