phi.Bounds:Library
{
	int numbers: 1 2 3 4;                 # (four: so guard comes right after it, on a word)
	int guard: 0;
	int i: 4;

	unsafe
		# no check: this writes just past the array, into guard
		numbers:i is 42;
	;;
	debug 'guard ' guard '\n';

	i is 5;
	numbers:i is 1;
	debug 'not reached\n';
}
