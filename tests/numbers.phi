phi.Numbers:Library
{
	int a: 7;
	int b: -3;
	byt small: 250;
	bln yes: true;

	log a ' ' b ' ' small ' ' yes '\n';

	# precedence and signed math
	log 2 + 3 * 4 ' ' (2 + 3) * 4 ' ' a / 2 ' ' a % 3 ' ' b / 2 ' ' b % 2 '\n';

	# byt wraps at 256
	small++10;
	log small '\n';

	# comparisons and logic as values
	bln both: a > 0 and b > 0;
	bln either: a > 0 or b > 0;
	bln neither: not either;
	log both ' ' either ' ' neither '\n';

	# built-in constants
	log Colors.White ' ' Colors.LightGreen '\n';

	int big: 2147483647;
	big++1;
	log big '\n';

	int x: a * a - b;
	log x;
}
