# vec<T> as it moves about a program: given to methods and given back, kept across calls
# (in the frame), in a class's variables and arrays, in a struct's fields, read and written
# through a pointer, a lane chosen when it runs (and one outside it, caught), and f32s.

struct.Particle
{
	vec<f32> place;
	vec<f32> speed;
	int id;
}

phi.VecProgram:Program
{
	vec<int> total;
	vec<f64> steps[3];

	call Run;
	# (catching is the generator's: a vec method's error, caught by a method without one)
	if call LaneOf: 4 throws err
		log 'lane 4: ' err.message '\n';
	;;
	exit 0;

	# a vec given, a vec given back
	[Scaled: vec<f32> v: 0; f32 by: 1.0;]
	[end: v * by]

	[Dot: vec<f32> a: 0; vec<f32> b: 0;]
		vec<f32> both: a * b;
	[end: (both.Sum)]

	[Noisy: int n: 0;]
		# a call between: whatever's in a register goes, so a vec lives in the frame across it
		log '';
	[end: n + 1]

	[Brighten: ptr<u8> pixels: 0; u32 bytes: 0; u8 amount: 0;]
		vec<u8> add: amount;
		u32 whole: bytes / add.len;
		ptr<vec<u8>> blocks: pixels as ptr<vec<u8>>;
		while u32 i: 0; i < whole; i++;
			vec<u8> block: blocks:i;
			blocks:i is (block.AddSat: add);
		;;
		# what's left, a byte at a time
		while u32 i: whole * add.len; i < bytes; i++;
			int sum: pixels:i + amount;
			if sum > 255
				sum is 255;
			;;
			pixels:i is sum as u8;
		;;
	[end]

	[Lane: vec<int> v: 0; int i: 0;]
	[end: v:i]

	[LaneOf: int i: 0;]
		vec<int> v: 10 20 30 40;
	[end: v:i]

	[Run:]
		vec<f32> a: 1.0 2.0 3.0 4.0;
		vec<f32> b: (Scaled: a 0.5);
		log 'scaled: ' b ', dot: ' (Dot: a a) '\n';

		# across calls: many vecs at once, and a call between each use
		vec<int> x: 1;
		vec<int> y: 2;
		vec<int> z: 3;
		int k: (Noisy: 1);
		vec<int> w: x + y * z;
		k is (Noisy: k);
		log 'across calls: ' w ' ' (x + y + z) ' ' k '\n';

		# a class's variables
		total is w;
		total:3 is 100;
		steps:1 is 0.25;
		steps:2 is steps:1 * 4.0;
		log 'class: ' total ' / ' steps:0 ' / ' steps:1 ' / ' steps:2 '\n';

		# a struct's fields
		new Particle p;
		p.place is 1.0 2.0 3.0 0.0;
		p.speed is 0.5;
		p.place is p.place + p.speed;
		p.id is 7;
		log 'particle ' p.id ': ' p.place '\n';

		# memory, through a pointer: 40 bytes, 2 vecs and 8 left over
		ptr<u8> pixels: new u8[40];
		while int i: 0; i < 40; i++;
			pixels:i is (i * 7) as u8;
		;;
		call Brighten: pixels 40 30;
		log 'pixels: ' pixels:0 ' ' pixels:1 ' ' pixels:35 ' ' pixels:39 '\n';
		free pixels;

		# a lane chosen when it runs, and one that isn't there
		vec<int> lanes: 10 20 30 40;
		int sum: 0;
		while int i: 0; i < lanes.len; i++;
			sum is sum + lanes:i;
		;;
		log 'lanes: ' sum ' ' (Lane: lanes 2) '\n';

		# f32s on their own: rounded as they're kept
		f32 third: 1.0 / 3.0;
		f64 wide: 1.0 / 3.0;
		log 'f32: ' (third is wide) ' ' (third as f64 * 3.0 - 1.0 > 0.0) '\n';
	[end]
}
