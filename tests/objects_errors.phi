# Mistakes with objects that PHI catches when building.
struct.Point
{
	i16 x;
	i16 y;
}

struct.Node
{
	u32 value;
	new Node next;
}

phi.ObjectsErrors:Kernel
{
	new u32 count;
	new Point p: 1 2 3;
	free p;
	Node loose;
	new Node a;
	a.next takes a;
	ptr<Point> raw: 0;
	p takes raw;
	p is raw;
	call Show: (Make: 1 2);
	int n: p;

	[Show: Point shown;]
	[end]

	[Make: i16 x: 0; i16 y: 0;]
		new Point made: x y;
	[end: made]
}
