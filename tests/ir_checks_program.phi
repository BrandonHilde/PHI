# Checks a method's code makes as its class statements' code does (a program, so it runs on
# Linux 32 and 64-bit, Windows and macOS): an [atmost N] array's index is checked against how
# many it holds, not its room; a count of 2 billion or more to Mem.Copy, Move, Fill or Fill32
# is an error naming the call's line; and a call's new object kept in an interface frees what
# the interface had with that object's own struct's free.
use memory.mem;

interface.Shape
{
	[Area]
}

struct.Circle has Shape
{
	int r;

	[Area]
	[end: 3 * r * r]
}

struct.Rect has Shape
{
	int w;
	int h;
	new str name;

	[Area]
	[end: w * h]
}

phi.IrChecksProgram:Program
{
	int scores[atmost 8];
	u8 a[16];
	u8 b[16];

	u32 before: Heap.used_blocks;
	call Indexes;
	call Counts;
	call Kept;
	log 'blocks back: ' (Heap.used_blocks is before) '\n';
	exit 0;

	[Indexes]
		scores++ 4 5;
		int i: 1;
		log 'in: ' scores:i '\n';
		i++ 2;
		int got: 0;
		if call got is Read: i throws err
			log err '\n';
		;;
		if call got is ReadLocal: 2 throws err
			log err '\n';
		;;
	[end]

	[Read: int i;]
	[end: scores:i]

	[ReadLocal: int i;]
		u8 local[atmost 4];
		local++ 9;
	[end: local:i]

	[Counts]
		u32 size: 2;
		if call Mem.Copy: addr a addr b size - 4 throws err
			log err '\n';
		;;
		if call Mem.Fill: addr a 9 size - 4 throws err
			log err '\n';
		;;
		call Mem.Fill: addr a 7 size;
		log 'filled: ' a:1 ' ' a:2 '\n';
	[end]

	[Kept]
		new Rect r: 3 4;
		r.name is 'a box with a name long enough to be its own block';
		new Shape s: r;
		call s is MakeCircle: 2;
		log 'kept area ' (s.Area) '\n';
		call s is MakeCircle: 3;
		log 'kept again ' (s.Area) '\n';
	[end]

	[MakeCircle: int r;]
		new Circle made: r;
	[end: made]
}
