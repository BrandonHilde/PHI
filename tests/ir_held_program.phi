# A loop keeps the class variables it changes in registers, in the intermediate form as in the
# generator (PHI_IR=1). A method it calls reads them from memory, so they're written back
# before each call and read again after (it found a program that printed what a variable had
# been before the loop); and before a return out of the loop. Its expected output is the generator's.
phi.IrHeldProgram:Program
{
	int counter: 0;
	int total: 0;
	u32 mask: 0;

	log (Calls: 5) ' ' counter ' ' total '\n';
	log (Returns: 100) ' ' counter ' ' total '\n';
	log (Nested: 4) ' ' counter ' ' total ' ' mask '\n';
	log (Divides: 6 0) ' ' counter '\n';
	exit 0;

	# what Seen reads has to be the loop's latest
	[Calls: int n: 0;]
		int seen: 0;
		while int i: 0; i < n; i++;
			counter++ 10;
			total is total + i;
			seen is seen + (Seen);
		;;
	[end: seen]

	[Seen]
	[end: counter * 1000 + total]

	# a return from inside the loop leaves them written back
	[Returns: int limit: 0;]
		while true
			counter++;
			total++ 2;
			if counter > limit
				return counter;
			;;
		;;
	[end: -1]

	# a loop inside one that holds them
	[Nested: int n: 0;]
		while int i: 0; i < n; i++;
			counter++;
			while int k: 0; k < n; k++;
				total++ k;
				mask is mask | (1 << k) as u32;
			;;
			if i is 2
				call Bump;
			;;
		;;
	[end: total]

	[Bump]
		counter++ 1000;
	[end]

	# a division that may stop: written back around it
	[Divides: int n: 0; int by: 0;]
		int got: 0;
		while int i: 0; i < n; i++;
			counter++;
			if i is 3
				if call Share: i by throws err
					got is -counter;
				;;
			;;
		;;
	[end: got]

	[Share: int a: 0; int b: 0;]
	[end: a / b]
}
