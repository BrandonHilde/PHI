# runs only in 32 and 64 bits: its numbers take more room than a 16-bit program has
# X.509 remembering the certificates it has checked (crypto_x509's chain): a chain checked
# again costs no signature, nor does another name the same certificate is for; a certificate
# under a remembered issuer costs one. What's remembered holds only between its dates, for
# the same bytes, and until the roots change. The host is matched every time.
use crypto.x509;

phi.CryptoX509Known:Library
{
	u8 root[843];
	u8 middle[632];
	u8 leaf[428];
	Certificate chain[2];
	int got: 0;
	u32 checks: 0;

	got is (Bytes.FromHex: '' addr root 843);
	got++ (Bytes.FromHex: '' addr middle 632);
	got++ (Bytes.FromHex: '' addr leaf 428);
	bln read: (X509.Parse: addr chain:1 addr middle 632) and (X509.Parse: addr chain:0 addr leaf 428);
	X509.now is 1793923200;                   # 2026-11-05: the certificates are from 2026-11-02
	log 'read: ' read ', trust: ' (X509.Trust: addr root 843) '\n';

	call Check: 'the first time' 'phi.test';
	log 'kept: ' X509.x509_known_count ', how far down each may stand: ' X509.x509_known_depth:0 ' ' X509.x509_known_depth:1 '\n';
	call Check: 'again' 'phi.test';
	call Check: 'another of its names' 'zone7.games.phi.test';
	call Check: 'a name that isn\'t its' 'example.com';
	# (it chained to a root, whatever comes with it this time)
	log 'sent without its issuer: ' (X509.Chain: addr chain:0 1 'phi.test') '\n';
	checks is X509.x509_checks;

	# outside its dates it isn't taken as checked: the walk goes on, and says why not
	X509.now is 1830297600;                   # 2028-01-01
	call Check: 'after its dates' 'phi.test';
	X509.now is 1777593600;                   # 2026-05-01
	call Check: 'before them' 'phi.test';
	X509.now is 1793923200;
	call Check: 'within them again' 'phi.test';

	# other bytes are another certificate
	chain:0.not_before:3 is chain:0.not_before:3 ^ 1;
	call Check: 'changed' 'phi.test';
	chain:0.not_before:3 is chain:0.not_before:3 ^ 1;
	call Check: 'as it was' 'phi.test';

	# only its issuer remembered, as when another server has the same one
	call X509.Forget;
	int walked: (X509.Walk: addr chain:1 1 X509.now);
	call X509.Remember: addr chain:1 walked;
	checks is X509.x509_checks;
	log 'the issuer alone: ' walked ', kept: ' X509.x509_known_count '\n';
	call Check: 'under a remembered issuer' 'phi.test';
	call Check: 'and again' 'phi.test';

	# the roots change: nothing is remembered
	call X509.Untrust;
	log 'kept without the roots: ' X509.x509_known_count '\n';
	call Check: 'no roots' 'phi.test';
	bln trusted: (X509.Trust: addr root 843);
	call Check: 'the root back' 'phi.test';
	bln more: (X509.Trust: addr root 843);
	log 'kept after another root: ' X509.x509_known_count '\n';

	# more than it keeps: the oldest go, and what's left still stands
	u8 digest[32];
	while u32 i: 0; i < 40; i++;
		digest:0 is i;
		call X509.Keep: addr digest 0 0xFFFFFFFF 0;
	;;
	log 'kept at most: ' X509.x509_known_count ', the first gone: ' ((X509.Known: addr digest) >= 0);
	digest:0 is 0;
	log ' ' ((X509.Known: addr digest) < 0) '\n';

	# a chain, the signatures it took, and whether it stopped at a certificate remembered
	[Check: ptr<u8> what: 0; ptr<u8> host: 0;]
		u32 remembered: X509.x509_remembered;
		bln good: (X509.Chain: addr chain:0 2 host);
		log what ': ' good ', signatures ' X509.x509_checks - checks ', remembered ' X509.x509_remembered - remembered;
		if not good
			log ' (' X509.error ')';
		;;
		log '\n';
		checks is X509.x509_checks;
	[end]
}
