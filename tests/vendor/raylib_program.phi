# raylib from the vendor folder (use vendor.raylib;), with no window: nothing is declared
# here, since the module has every function, struct and constant. Its constants and colours
# by name, maths on vectors, a matrix and a quaternion, a ray against a sphere and a box
# (structs within structs, and C's bool in one), collisions, colours, text, and an image in
# memory drawn into and read back. A call that gives a struct is used as a value: declared
# from, given straight to another call, and read a field of. One source: a macOS program,
# a Windows one in 32 and 64 bits, and a 64-bit Linux one give the same.
use vendor.raylib;

phi.RaylibProgram:Program
{
	Image image;

	call Ray.SetTraceLogLevel: Ray.LOG_NONE;
	log 'raylib ' Ray.RAYLIB_VERSION_MAJOR '.' Ray.RAYLIB_VERSION_MINOR ', keys: ' Ray.KEY_ESCAPE ' ' Ray.KEY_SPACE ', flags: '
	    (Ray.FLAG_VSYNC_HINT | Ray.FLAG_WINDOW_RESIZABLE) '\n';
	log 'colours: ' Ray.RAYWHITE.r ' ' Ray.GOLD.g ' ' Ray.BLANK.a ' ' (Ray.ColorToInt: Ray.MAROON) '\n';

	# maths
	Vector2 a;
	a.x is 3;
	a.y is 4;
	Vector2 b: (Ray.Vector2Scale: a 0.5);
	Vector2 sum: (Ray.Vector2Add: a b);
	log 'add: ' sum.x ' ' sum.y ', length: ' (Ray.Vector2Length: a) ', far: ' (Ray.Vector2Distance: a (Ray.Vector2Zero)) '\n';
	Vector3 right;
	right.x is 1;
	Vector3 up;
	up.y is 1;
	Vector3 forward: (Ray.Vector3CrossProduct: right up);
	log 'cross: ' forward.x ' ' forward.y ' ' forward.z ', dot: ' (Ray.Vector3DotProduct: right up) '\n';
	Matrix moved: (Ray.MatrixTranslate: 5 6 7);
	Vector3 there: (Ray.Vector3Transform: forward moved);
	log 'moved: ' there.x ' ' there.y ' ' there.z ', determinant: ' (Ray.MatrixDeterminant: (Ray.MatrixScale: 2 3 4)) '\n';
	Quaternion turn: (Ray.QuaternionFromAxisAngle: up Ray.PI);
	Vector3 turned: (Ray.Vector3RotateByQuaternion: right turn);
	log 'turned: ' (turned.x < -0.99) ' ' (turned.z < 0.01 and turned.z > -0.01) ', clamp: ' (Ray.Clamp: 7 0 5) ' ' (Ray.Lerp: 0 10 0.5) '\n';

	# a ray against a sphere and a box
	Ray ray;
	ray.position.z is -10;
	ray.direction.z is 1;
	RayCollision hit: (Ray.GetRayCollisionSphere: ray (Ray.Vector3Zero) 2);
	log 'sphere: ' hit.hit ' at ' hit.distance ', its normal ' hit.normal.z '\n';
	BoundingBox box;
	box.min.x is 5;
	box.min.y is 5;
	box.min.z is 5;
	box.max.x is 6;
	box.max.y is 6;
	box.max.z is 6;
	log 'box: ' (Ray.GetRayCollisionBox: ray box).hit '\n';

	# collisions
	Rectangle first;
	first.width is 10;
	first.height is 10;
	Rectangle second;
	second.x is 6;
	second.y is 8;
	second.width is 10;
	second.height is 10;
	Rectangle both: (Ray.GetCollisionRec: first second);
	log 'overlap: ' (Ray.CheckCollisionRecs: first second) ' ' both.x ' ' both.y ' ' both.width ' ' both.height '\n';
	log 'point in: ' (Ray.CheckCollisionPointRec: a first) ' ' (Ray.CheckCollisionPointRec: sum second) ', circles: '
	    (Ray.CheckCollisionCircles: a 2 b 2) ' ' (Ray.CheckCollisionCircles: a 0.5 b 0.5) '\n';

	# colours
	Color red: (Ray.ColorFromHSV: 0 1 1);
	Color blue: (Ray.GetColor: 0x0000FFFF);
	log 'red: ' red.r ' ' red.g ' ' red.b ' ' red.a ', faded: ' (Ray.Fade: red 0.5).a ', between: ' (Ray.ColorLerp: red blue 0.5).b
	    ', the same: ' (Ray.ColorIsEqual: red Ray.RED) ' ' (Ray.ColorIsEqual: red (Ray.GetColor: 0xFF0000FF)) '\n';

	# text
	str name: 'raylib';
	log 'text: ' (Ray.TextLength: name) ' ' (Ray.TextIsEqual: name 'raylib') ' ' (Ray.TextToUpper: name) ' ' (Ray.TextToInteger: '1234')
	    ' ' (Ray.TextSubtext: 'hello there' 6 5) ' ' (Ray.TextFindIndex: 'hello there' 'there') '\n';

	# an image in memory, drawn into and read back
	image is (Ray.GenImageColor: 32 16 blue);
	log 'image: ' image.width ' x ' image.height ', format ' (image.format is Ray.PIXELFORMAT_UNCOMPRESSED_R8G8B8A8) ', ' (image.data is not 0) '\n';
	call Ray.ImageDrawRectangle: addr image 4 2 8 6 red;
	a.x is 24;
	a.y is 8;
	call Ray.ImageDrawCircleV: addr image a 3 Ray.GREEN;
	call Ray.ImageDrawPixel: addr image 31 15 (Ray.ColorFromHSV: 0 1 1);
	call Show: 0 0;
	call Show: 4 2;
	call Show: 12 8;
	call Show: 24 8;
	call Show: 31 15;
	log '\n';
	int reds: 0;
	while int y: 0; y < 16; y++;
		while int x: 0; x < 32; x++;
			if (Ray.ColorIsEqual: (Ray.GetImageColor: image x y) red)
				reds++;
			;;
		;;
	;;
	log 'red pixels: ' reds '\n';
	first.x is 4;
	first.y is 2;
	first.width is 8;
	first.height is 8;
	call Ray.ImageCrop: addr image first;
	call Ray.ImageFlipVertical: addr image;
	log 'cropped: ' image.width ' x ' image.height;
	call Show: 0 0;
	call Show: 0 7;
	log '\n';
	call Ray.UnloadImage: image;
	exit 0;

	[Show: int x; int y;]
		Color c: (Ray.GetImageColor: image x y);
		log ' (' c.r ' ' c.g ' ' c.b ')';
	[end]
}
