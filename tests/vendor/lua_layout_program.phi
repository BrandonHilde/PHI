# Every struct of vendor/lua is as large as C has it, on the system this is built for:
# written by vendor/bindgen.py, with C's sizes as clang gives them for macOS and 64-bit Linux, 64-bit Windows, 32-bit Windows.
use vendor.lua;

phi.LuaLayoutProgram:Program
{
	int wrong: 0;
	int which: 2;
	if (sizeof ptr<u8>) is 8
		which is 1;
		if (sizeof lng) is 8
			which is 0;
		;;
	;;
	call Same: 'lua_Debug' (sizeof lua_Debug) 144 144 116;
	call Same: 'luaL_Reg' (sizeof luaL_Reg) 16 16 8;
	call Same: 'luaL_Buffer' (sizeof luaL_Buffer) 1056 1056 528;
	call Same: 'luaL_Stream' (sizeof luaL_Stream) 16 16 8;
	log '4 structs, ' wrong ' wrong\n';
	exit wrong;

	[Same: ptr<u8> name; int here; int unix; int windows64; int windows32;]
		int c: unix;
		if which is 1
			c is windows64;
		;;
		if which is 2
			c is windows32;
		;;
		if here is not c
			wrong++;
			log name ' is ' here ' bytes here and ' c ' in C\n';
		;;
	[end]
}
