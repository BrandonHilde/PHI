# Lua from the vendor folder (use vendor.lua;): Lua's code run from PHI, PHI methods Lua's
# code calls (addr foreign, a hundred times over), whole numbers, floats and text both
# ways, a table built here and read there, and what Lua says when its code is wrong. The
# calls are Lua's manual's own, with what C has as macros (lua_pcall, lua_tostring,
# lua_register, luaL_dostring) as methods. One source, the same on each system.
use vendor.lua;

phi.LuaProgram:Program
{
	int called: 0;
	ptr<lua_State> L: (Lua.luaL_newstate);
	call Lua.luaL_openlibs: L;
	log 'Lua ' Lua.LUA_VERSION_MAJOR_N '.' Lua.LUA_VERSION_MINOR_N '\n';

	call Lua.lua_register: L 'twice' addr foreign Twice;
	call Lua.lua_register: L 'hypot' addr foreign Hypot;
	call Do: 'total = 0  for i = 1, 100 do total = total + twice(i) end';
	call Do: 'name = string.rep("ab", 3) .. "!"  h = hypot(3, 4)  big = 2^40 + twice(21)';
	int kind: (Lua.lua_getglobal: L 'total');
	log 'total ' (Lua.lua_tointeger: L (-1)) ' after ' called ' calls\n';
	kind is (Lua.lua_getglobal: L 'name');
	log 'name ' (Lua.lua_tostring: L (-1)) ', a ' (Lua.luaL_typename: L (-1)) '\n';
	kind is (Lua.lua_getglobal: L 'h');
	log 'h ' (Lua.lua_tonumber: L (-1)) '\n';
	kind is (Lua.lua_getglobal: L 'big');
	log 'big ' (Lua.lua_tointeger: L (-1)) ' ' (Lua.lua_isnil: L (-1)) '\n';
	call Lua.lua_pop: L 4;

	# a table made here, which Lua's code reads
	call Lua.lua_newtable: L;
	call Lua.lua_pushinteger: L 640;
	call Lua.lua_setfield: L (-2) 'width';
	kind is (Lua.lua_pushstring: L 'PHI') as int;
	call Lua.lua_setfield: L (-2) 'maker';
	call Lua.lua_setglobal: L 'screen';
	call Do: 'said = screen.maker .. " " .. screen.width * 2';
	kind is (Lua.lua_getglobal: L 'said');
	log 'said ' (Lua.lua_tostring: L (-1)) ' ' (kind is Lua.LUA_TSTRING) '\n';
	call Lua.lua_pop: L 1;

	# a Lua function called from here
	call Do: 'function area(w, h) return w * h, w + h end';
	kind is (Lua.lua_getglobal: L 'area');
	call Lua.lua_pushinteger: L 6;
	call Lua.lua_pushinteger: L 7;
	int bad: (Lua.lua_pcall: L 2 2 0);
	log 'area ' (Lua.lua_tointeger: L (-2)) ' ' (Lua.lua_tointeger: L (-1)) ' ' bad '\n';
	call Lua.lua_pop: L 2;

	# an address of -1, as C writes (void *)-1, is all of its bits; and a form of one of
	# Lua's functions declared here, under a name of this file's own
	call Lua.lua_pushlightuserdata: L (-1);
	ptr<u8> all: (Lua.lua_touserdata: L (-1));
	log 'an address of -1: ' ((all + 1) is 0) ' ' (AllOnes) ', version ' (Lua.version_as_number: L) '\n';
	call Lua.lua_pop: L 1;

	call Do: 'this is not lua';
	call Do: 'error("said in lua")';
	log 'stack ' (Lua.lua_gettop: L) '\n';
	call Lua.lua_close: L;
	exit 0;

	[Do: ptr<u8> code;]
		if (Lua.luaL_dostring: L code) is not Lua.LUA_OK
			log 'lua says: ' (Lua.lua_tostring: L (-1)) '\n';
			call Lua.lua_pop: L 1;
		;;
	[end]

	# the same from a method
	[AllOnes]
		call Lua.lua_pushlightuserdata: L (-1);
		ptr<u8> given: (Lua.lua_touserdata: L (-1));
		call Lua.lua_pop: L 1;
	[end: (given + 1) is 0]

	[Twice: ptr<lua_State> state: 0;]
		called++;
		call Lua.lua_pushinteger: state (Lua.lua_tointeger: state 1) * 2;
	[end: 1]

	[Hypot: ptr<lua_State> state: 0;]
		f64 a: (Lua.lua_tonumber: state 1);
		f64 b: (Lua.lua_tonumber: state 2);
		call Lua.lua_pushnumber: state (Float.Sqrt: a * a + b * b);
	[end: 1]
}

Lua.version_as_number = 'lua_version': ptr<lua_State> L: f64;
