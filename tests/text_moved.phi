# Text pointers kept as text: p + n in what's printed or built into a str, and a method
# ending with a literal whose returns are text pointers.
phi.TextMoved:Kernel
{
	ptr<u8> p: 'hello';
	str s: '';
	s++ p + 1;
	s++ ' ' p + 4 - 1;
	log s '\n';
	log p + 2 '\n';
	int n: 8;
	n is n + 1;                        # a number stays a number
	log n '\n';

	u8 names[32];
	names:0 is 'a';
	names:1 is 'd';
	names:2 is 'a';
	names:16 is 'b';
	names:17 is 'o';
	log (NameOf: 0) ' ' (NameOf: 1) ' ' (NameOf: 5) '\n';
	log (Label: 2) ' ' (Label: 0) '\n';
	exit 0;

	# the literal is a ptr<u8> too, since the other results are
	[NameOf: int i: 0;]
		if i < 2 return addr names:(i * 16);
	[end: 'nobody']

	[Label: int n: 0;]
		ptr<u8> q: 'two';
		if n is 2 return q;
	[end: 'other']
}
