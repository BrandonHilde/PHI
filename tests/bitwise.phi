phi.Boot:Bootloader
{
	call Bootloader.JumpToSectorTwo;
}

phi.Bits:OS
{
	int a: 1100b;
	int flags: 0;

	debug (12 & 10) ' ' (12 | 10) ' ' (12 ^ 10) ' ' ~0 '\n';
	debug (1 << 4) ' ' (256 >> 4) ' ' (-16 >> 2) '\n';

	flags is flags | (1 << 3);
	flags is flags | 1;
	debug flags ' ' (flags & (1 << 3)) '\n';
	flags is flags & ~1;
	debug flags '\n';

	# precedence: shifts before &, & before |, all before comparisons
	if 1 << 2 | 1 is 5
		debug 'precedence ok\n';
	;;
	if a & 4
		debug 'bit 2 set\n';
	;;
	if 7 <= 7 and (8 >= 9) is false
		debug 'compare ok\n';
	;;
	exit 0;
}
