# A character of the text a call gives, with no variable between: (Name):0. The same in 32 and
# 64 bits (64-bit code refused it: "an index isn't in 64-bit programs yet").
struct.Namer
{
	int n;

	[Word]
		str s: 'struct';
	[end: s]
}

phi.StrResultIndexProgram:Program
{
	int place: 2;
	new Namer namer;
	log (Name):0 (Name):place ' ' (Name):(place - 1) as int ' ' (namer.Word):1 '\n';
	chr c: (Long: 3):4;
	log c ' ' ((Long: 2):5 is 'c') '\n';

	# past the room the text has, it's the error an index past a variable's is: the room is
	# what's checked (256 bytes for text that grows), as it is for a str variable
	call Past: 2;
	if call Past: 300 throws err
		log err '\n';
	;;
	exit 0;

	[Past: int place: 0;]
		chr c: (Name):place;
		log (c as int) ' ';
	[end]

	[Name]
		str s: 'phi';
	[end: s]

	[Long: int times: 0;]
		str s: '';
		while int i: 0; i < times; i++;
			s++ 'abc';
		;;
	[end: s]
}
