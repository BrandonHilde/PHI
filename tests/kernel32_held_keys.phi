# Held keys for a program on the desktop: OS.IsKeyDown asks drivers.input (for the
# window in front), and asking it no longer takes the keyboard away from the desktop.
use gui.desktop;

phi.Test:Kernel
{
	bln ok: (Screen.Start: 640 480);
	call Desktop.Start;
	int pid: (Desktop.Run: 'HOLDER.BIN' 'Holder' 40 40);
	debug 'desktop: started ' (pid > 0) '\n';
	while Desktop.windows.len > 0
		call Desktop.Step;
		call OS.Yield;
	;;
	debug 'desktop: no windows left\n';
	call OS.Sleep: 2500;            # (the input script is still holding the key)
	exit 0;
}
