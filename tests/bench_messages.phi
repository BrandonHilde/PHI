# Benchmarks for a server's network messages: packing and unpacking them, a snapshot
# of only what changed since the last one, finding the session a packet belongs to,
# and authenticating packets. phi test --bench compares the counts with
# bench_messages.bench; the totals show a change that reads or writes differently.
use data.map;
use crypto.hmac;
use test.bench;

phi.BenchMessages:Kernel
{
	const int MESSAGES: 10000;
	const int SIZE: 10;                   # a move: type, entity (4 bytes), x and y (2 each), flags
	const u8 MOVE: 3;
	const int ENTITIES: 1000;
	const int CLIENTS: 500;

	ptr<u8> buffer: new u8[MESSAGES * SIZE];
	u16 last[ENTITIES * 2];               # each entity's x and y in the last snapshot
	u16 now[ENTITIES * 2];
	u32 clients[CLIENTS];                 # each client's address and port, as one key
	u8 key[32];
	u8 packet[64];
	u8 mac[32];
	u32 seed: 777;

	# packing 10,000 moves into bytes, as they'd go out
	call Bench.Start;
	while int i: 0; i < MESSAGES; i++;
		ptr<u8> m: buffer + i * SIZE;
		m:0 is MOVE;
		call Put32: m + 1 1000 + i;
		call Put16: m + 5 i * 3;
		call Put16: m + 7 i * 7;
		m:9 is i & 0xFF;
	;;
	call Bench.Stop: 'pack 10000 move messages';

	# and reading them back, as they'd come in
	u32 sum: 0;
	call Bench.Start;
	while int i: 0; i < MESSAGES; i++;
		ptr<u8> got: buffer + i * SIZE;
		if got:0 is MOVE
			sum is sum + (Get32: got + 1) + (Get16: got + 5) + (Get16: got + 7) + got:9;
		;;
	;;
	call Bench.Stop: 'unpack 10000 move messages';
	log 'unpacked: ' sum '\n';

	# a snapshot of 1,000 entities where one in eight moved: a bit for each saying
	# whether it moved, then the new positions of the ones that did
	while int i: 0; i < ENTITIES * 2; i++;
		last:i is (Random: 4096);
		now:i is last:i;
	;;
	while int e: 0; e < ENTITIES; e++;
		if (Random: 8) is 0
			now:(e * 2) is (Random: 4096);
		;;
	;;
	call Bench.Start;
	int bytes: (Snapshot);
	call Bench.Stop: 'snapshot of 1000 entities, 1 in 8 moved';
	log 'snapshot: ' bytes ' bytes, checksum ' (Checksum: bytes) '\n';

	# which session a packet is for, by the address and port it came from
	ptr<MapData> sessions: (Map.New);
	while int c: 0; c < CLIENTS; c++;
		clients:c is ((Random: 65536) << 16) | (Random: 65536);    # address's last 2 bytes, port
		call Map.Set: sessions clients:c c;
	;;
	u32 found: 0;
	call Bench.Start;
	while int i: 0; i < MESSAGES; i++;
		int pick: (Random: CLIENTS);
		if (Map.Get: sessions clients:pick 0xFFFFFFFF) is pick
			found++;
		;;
	;;
	call Bench.Stop: 'find the session for 10000 packets';
	log 'sessions found: ' found ' of ' MESSAGES ' (' sessions:0.count ' clients)\n';

	# signing each packet with the session's key (HMAC-SHA256)
	while int i: 0; i < 32; i++;
		key:i is i * 5;
	;;
	while int i: 0; i < 64; i++;
		packet:i is i;
	;;
	call Bench.Start;
	while int i: 0; i < 200; i++;
		packet:0 is i;
		call Hmac.Mac: addr key 32 addr packet 64 addr mac;
	;;
	call Bench.Stop: 'hmac 200 packets of 64 bytes';
	log 'last mac: ';
	call Bytes.PrintHex: addr mac 32;
	exit 0;

	# a number from 0 to limit - 1 (xorshift, so every run is the same)
	[Random: u32 limit: 1;]
		seed is seed ^ (seed << 13);
		seed is seed ^ (seed >> 17);
		seed is seed ^ (seed << 5);
		int result: seed % limit;
	[end: result]

	# numbers in network order: the high byte first
	[Put16: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 8;
		p:1 is value;
	[end]

	[Put32: ptr<u8> p: 0; u32 value: 0;]
		p:0 is value >> 24;
		p:1 is value >> 16;
		p:2 is value >> 8;
		p:3 is value;
	[end]

	[Get16: ptr<u8> p: 0;]
	[end: (p:0 << 8) | p:1]

	[Get32: ptr<u8> p: 0;]
	[end: (p:0 << 24) | (p:1 << 16) | (p:2 << 8) | p:3]

	# the snapshot into buffer; its size in bytes
	[Snapshot]
		int mask: ENTITIES / 8;
		while int i: 0; i < mask; i++;
			buffer:i is 0;
		;;
		int pos: mask;
		while int e: 0; e < ENTITIES; e++;
			if now:(e * 2) is not last:(e * 2) or now:(e * 2 + 1) is not last:(e * 2 + 1)
				buffer:(e / 8) is buffer:(e / 8) | (1 << (e % 8));
				call Put16: buffer + pos now:(e * 2);
				call Put16: buffer + pos + 2 now:(e * 2 + 1);
				pos++ 4;
			;;
		;;
	[end: pos]

	[Checksum: int bytes: 0;]
		u32 sum: 0;
		while int i: 0; i < bytes; i++;
			sum is sum * 31 + buffer:i;
		;;
	[end: sum]
}
