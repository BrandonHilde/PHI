# Shifting a 64-bit number by a constant has instructions of its own for each count (a part
# of 32 or more moves one half to the other); by a variable it tests the count as it runs. Both
# must give the same, for every count, and so must math with a constant on the right.
# runs only in 32 and 64 bits: 64-bit numbers
phi.Int64Shifts:Library
{
	u64 values: 0 1 0x8000000000000000 0xFFFFFFFFFFFFFFFF 0x0123456789ABCDEF 0xFEDCBA9876543210 0x00000000FFFFFFFF 0xFFFFFFFF00000000;
	i64 signed: 0 1 -1 -2 0x0123456789ABCDEF -81985529216486896 4294967295 -4294967296;
	int wrong: 0;
	int n: 0;

	while int v: 0; v < 8; v++;
		u64 a: values:v;
