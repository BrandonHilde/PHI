		n is 0;
		if (a << 0) is not (a << n) or (a >> 0) is not (a >> n) or (b << 0) is not (b << n) or (b >> 0) is not (b >> n)
			wrong++;
		;;
		n is 1;
		if (a << 1) is not (a << n) or (a >> 1) is not (a >> n) or (b << 1) is not (b << n) or (b >> 1) is not (b >> n)
