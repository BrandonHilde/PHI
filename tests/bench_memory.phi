# Benchmarks for the kernel heap, pools and maps: phi test --bench compares the counts
# with bench_memory.bench.
use memory.pool;
use data.map;
use test.bench;

struct.Node
{
	u32 value;
	ptr<Node> next;
}

phi.BenchMemory:Kernel
{
	# allocating and freeing 2000 nodes, kept in a list so each Alloc walks the ones before it
	ptr<Node> head: 0;
	call Bench.Start;
	while u32 i: 0; i < 2000; i++;
		ptr<Node> n: new Node;
		n:0.value is i;
		n:0.next is head;
		head is n;
	;;
	call Bench.Stop: 'heap alloc 2000';

	call Bench.Start;
	while head is not 0
		ptr<Node> rest: head:0.next;
		free head;
		head is rest;
	;;
	call Bench.Stop: 'heap free 2000';

	# one block made and freed again and again, the usual case for a short-lived object
	call Bench.Start;
	while u32 i: 0; i < 2000; i++;
		ptr<u8> buffer: new u8[256];
		free buffer;
	;;
	call Bench.Stop: 'heap alloc and free 256 bytes x2000';

	# 100,000 objects from the heap, then from a pool, kept until all are made
	ptr<u32> objects: new u32[100000];
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		objects:i is new Node;
	;;
	call Bench.Stop: 'heap alloc 100000 nodes';
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		free objects:i;
	;;
	call Bench.Stop: 'heap free 100000 nodes';

	ptr<PoolData> nodes: (Pool.New: sizeof Node 1024);
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		objects:i is (Pool.Alloc: nodes);
	;;
	call Bench.Stop: 'pool alloc 100000 nodes';
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		call Pool.Free: nodes objects:i;
	;;
	call Bench.Stop: 'pool free 100000 nodes';
	log 'pool in use: ' nodes:0.used '\n';
	call Pool.Delete: nodes;
	free objects;

	# a map of 100,000 IDs, then each one found
	ptr<MapData> ids: (Map.New);
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		call Map.Set: ids 1000000 + i * 13 i;
	;;
	call Bench.Stop: 'map set 100000 keys';
	bln all: true;
	call Bench.Start;
	while u32 i: 0; i < 100000; i++;
		if (Map.Get: ids 1000000 + i * 13 0xFFFFFFFF) is not i
			all is false;
		;;
	;;
	call Bench.Stop: 'map get 100000 keys';
	log 'map found all: ' all ' places: ' ids:0.capacity '\n';
	call Map.Delete: ids;

	debug 'blocks in use: ' Heap.used_blocks '\n';
	exit 0;
}
