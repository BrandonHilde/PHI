# Methods that give str, through the intermediate form: what's given copied where the caller
# says (a slot that grows, with a heap), from a return and an [end: ...]; the call's text used,
# kept in a str (call s is Name: ...;), put in one, passed on; each compared with PHI_IR=0's.
phi.IrTextResults:Program
{
	str kept: '';
	log (Name: 3) '\n';
	str s: (Name: 4);
	log s '\n';
	call kept is Name: 5;
	log kept '\n';
	str sized: [32];
	call sized is Name: 6;
	log sized '\n';
	log (Twice: 'ab') ' ' (Twice: (Twice: 'cd')) '\n';
	log (Long: 50).len '\n';
	call Name: 9;
	if call Failing throws err
		log 'caught: ' err.text '\n';
	;;
	log (Short: 1) '\n';
	str t: (Short: 0);
	log t '\n';
	t is (Name: 7);
	log t '\n';
	exit 0;

	[Name: int n: 0;]
		str made: 'name ';
		made++ n;
		return made;
	[end: '']

	[Twice: str t: '';]
	[end: (t t)]

	[Long: int n: 0;]
		str made: '';
		while int i: 0; i < n; i++;
			made++ 'abcdefghij';
		;;
	[end: made]

	[Failing:]
		str t: (Long: 3);
		throw t;
	[end]

	[Short: int n: 0;]
		if n > 0 return 'positive';
	[end: 'not']
}
