# A PHI TLS server (net.tlslink) and the host's own TLS 1.3 client (.NET's SslStream,
# Windows' SChannel on Windows): this kernel shows the leaf of crypto_x509's chain (its
# P-256 key, then the intermediate) on port 5443, which the input script's tls line
# reaches from the host, checking the certificate against crypto_x509's root and that
# it's for phi.test, and sends a line, which comes back.
use net.tcp;
use net.tlslink;

phi.TlsHostClient:Kernel
{
	u8 middle[632];
	u8 leaf[428];
	u8 key[121];
	u8 buffer[512];
	TlsIdentity identity;
	TlsLink link;

	call Bytes.FromHex: '' addr middle 632;
	call Bytes.FromHex: '' addr leaf 428;
	call Bytes.FromHex: '307702010104201c3c67d53150963e964e28135a7ee1e5c73592704c32240dbc57d6a0cbbe4378a00a06082a8648ce3d030107a14403420004b82ac3af23fdfe999807bb6b796499fc55d95dfda7e6c66db34219034f33a66253cfc9efce24a7f64bd19c0627079a227ec5e7d515201056f72ba50bf8f27c45' addr key 121;
	bln ok: (Tls13.Identity: addr identity addr leaf 428 addr key 121) and (Tls13.AddIssuer: addr identity addr middle 632);
	ok is ok and (Net.Start);
	int listener: (Tcp.Listen: 5443);
	log 'listening: ' (ok and listener >= 0) '\n';

	int c: -1;
	int start: (OS.GetTicks);
	while c < 0 and (OS.GetTicks) - start < 30000
		c is (Tcp.Accept: listener);
		call Net.Wait;
	;;
	log 'accepted: ' (c >= 0) ' ' (Secure.Accept: addr link c addr identity) '\n';
	u32 echoed: 0;
	bln going: true;
	while going and (OS.GetTicks) - start < 30000
		going is (Secure.Pump: addr link);
		int got: (Secure.Read: addr link addr buffer 512);
		while got > 0
			echoed++ (Secure.Write: addr link addr buffer got);
			got is (Secure.Read: addr link addr buffer 512);
		;;
		call Net.Wait;
	;;
	# which suite depends on the order the host's TLS library offers them in: Windows' SChannel
	# gets AES-128-GCM, OpenSSL (on Linux) ChaCha20-Poly1305; either is one PHI offers
	log 'connected: ' link.session.connected ', a suite PHI offers: ' ((link.session.suite is Tls13.AES_128_GCM) or (link.session.suite is Tls13.CHACHA20_POLY1305)) ', echoed ' echoed ' ' link.session.error '\n';
	call Secure.Close: addr link;
	exit 0;
}
