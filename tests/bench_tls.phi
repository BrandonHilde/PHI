# Benchmarks for what a TLS handshake costs beyond bench_crypto's: phi test --bench
# compares the counts with bench_tls.bench. A server signs once (P-256); a client checks
# that signature and the chain (here crypto_x509's: an ECDSA signature and an RSA-2048
# one), and each side does one X25519 (bench_crypto). Each result is printed too.
use crypto.x509;
use test.bench;

phi.BenchTls:Kernel
{
	u8 private[32];
	u8 public[65];
	u8 digest[32];
	u8 r[32];
	u8 s[32];
	u8 modulus[256];
	u8 signature[256];
	u8 e: 1 0 1;
	u8 root[843];
	u8 middle[632];
	u8 leaf[428];
	Certificate chain[2];

	call Bytes.FromHex: 'c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721' addr private 32;
	call Sha256.Hash: 'sample' 6 addr digest;
	call P256.PublicFrom: addr public addr private;
	call Bytes.FromHex: '' addr modulus 256;
	call Bytes.FromHex: '' addr signature 256;
	call Bytes.FromHex: '' addr root 843;
	call Bytes.FromHex: '' addr middle 632;
	call Bytes.FromHex: '' addr leaf 428;

	call Bench.Start;
	bln signed: (P256.Sign: addr r addr s addr private addr digest);
	call Bench.Stop: 'p256 sign';
	log 'signed: ' signed ' ';
	call Bytes.PrintHex: addr r 32;

	call Bench.Start;
	bln good: (P256.Verify: addr public addr digest addr r addr s);
	call Bench.Stop: 'p256 verify';
	log 'verified: ' good '\n';

	call Sha256.Hash: 'PHI signs this message.' 23 addr digest;
	call Bench.Start;
	good is (Rsa.VerifyPkcs1: addr modulus 256 addr e 3 addr digest addr signature 256);
	call Bench.Stop: 'rsa-2048 verify';
	log 'rsa: ' good '\n';

	call X509.Trust: addr root 843;
	call Bench.Start;
	good is (X509.Parse: addr chain:0 addr leaf 428) and (X509.Parse: addr chain:1 addr middle 632) and (X509.Chain: addr chain:0 2 'phi.test');
	call Bench.Stop: 'x509 chain of 2';
	log 'chain: ' good '\n';
	exit 0;
}
