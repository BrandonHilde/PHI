# Benchmarks for what a TLS handshake costs beyond bench_crypto's: phi test --bench
# compares the counts with bench_tls.bench. A server signs once (P-256, or P-384); a
# client checks that signature and the chain (here crypto_x509's: an ECDSA signature and
# an RSA-2048 one; or P-384 ones, as Let's Encrypt's ECDSA chains have), and each side
# does one X25519 (bench_crypto). Each result is printed too.
#
# The chain of 3 is the shape Let's Encrypt's servers send (Wikipedia's, say): a P-256 leaf
# and two P-384 intermediates under a P-384 root, so three P-384 signatures, each over
# SHA-384 (OpenSSL 3.6 made it, and openssl verify accepts it). The same chain again is what
# a second handshake with a server costs, once X509 remembers what it checked.
use crypto.x509;
use crypto.sha512;
use test.bench;

phi.BenchTls:Kernel
{
	u8 private[32];
	u8 public[65];
	u8 digest[32];
	u8 r[32];
	u8 s[32];
	u8 modulus[256];
	u8 signature[256];
	u8 e: 1 0 1;
	u8 root[843];
	u8 middle[632];
	u8 leaf[428];
	Certificate chain[2];
	u8 private384[48];
	u8 public384[97];
	u8 digest384[48];
	u8 r384[48];
	u8 s384[48];
	u8 deep_root[530];
	u8 upper[501];
	u8 lower[491];
	u8 deep_leaf[436];
	Certificate deep[3];

	call Bytes.FromHex: 'c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721' addr private 32;
	call Sha256.Hash: 'sample' 6 addr digest;
	call P256.PublicFrom: addr public addr private;
	call Bytes.FromHex: '' addr modulus 256;
	call Bytes.FromHex: '' addr signature 256;
	call Bytes.FromHex: '' addr root 843;
	call Bytes.FromHex: '' addr middle 632;
	call Bytes.FromHex: '' addr leaf 428;

	call Bytes.FromHex: '' addr deep_root 530;
	call Bytes.FromHex: '' addr upper 501;
	call Bytes.FromHex: '' addr lower 491;
	call Bytes.FromHex: '' addr deep_leaf 436;

	call Bench.Start;
	bln signed: (P256.Sign: addr r addr s addr private addr digest);
	call Bench.Stop: 'p256 sign';
	log 'signed: ' signed ' ';
	call Bytes.PrintHex: addr r 32;

	call Bench.Start;
	bln good: (P256.Verify: addr public addr digest addr r addr s);
	call Bench.Stop: 'p256 verify';
	log 'verified: ' good '\n';

	call Sha256.Hash: 'PHI signs this message.' 23 addr digest;
	call Bench.Start;
	good is (Rsa.VerifyPkcs1: addr modulus 256 addr e 3 addr digest addr signature 256);
	call Bench.Stop: 'rsa-2048 verify';
	log 'rsa: ' good '\n';

	X509.now is 1793923200;                   # 2026-11-05: the test certificates are from 2026-11-02
	call X509.Trust: addr root 843;
	call Bench.Start;
	good is (X509.Parse: addr chain:0 addr leaf 428) and (X509.Parse: addr chain:1 addr middle 632) and (X509.Chain: addr chain:0 2 'phi.test');
	call Bench.Stop: 'x509 chain of 2';
	log 'chain: ' good '\n';

	call Bytes.FromHex: '06b9cd63cd88584b760a2c4448ee90efda0f7568eb5f35287c4e41b8cbfeec986b870f4b893918c1c6cd3cc1695a80f9' addr private384 48;
	call P384.PublicFrom: addr public384 addr private384;
	call Sha512.Hash384: 'sample' 6 addr digest384;
	call Bench.Start;
	signed is (P384.Sign: addr r384 addr s384 addr private384 addr digest384);
	call Bench.Stop: 'p384 sign';
	call Bench.Start;
	good is (P384.Verify: addr public384 addr digest384 addr r384 addr s384);
	call Bench.Stop: 'p384 verify';
	log 'p384: ' signed ' ' good '\n';

	X509.now is 1794528000;                   # 2026-11-12: this chain is from 2026-11-11
	call X509.Trust: addr deep_root 530;
	call Bench.Start;
	good is (X509.Parse: addr deep:0 addr deep_leaf 436) and (X509.Parse: addr deep:1 addr lower 491) and (X509.Parse: addr deep:2 addr upper 501) and (X509.Chain: addr deep:0 3 'phi.test');
	call Bench.Stop: 'x509 chain of 3, p384';
	u32 checks: X509.x509_checks;
	call Bench.Start;
	bln again: (X509.Parse: addr deep:0 addr deep_leaf 436) and (X509.Parse: addr deep:1 addr lower 491) and (X509.Parse: addr deep:2 addr upper 501) and (X509.Chain: addr deep:0 3 'phi.test');
	call Bench.Stop: 'the same chain again';
	log 'deep chain: ' good ' ' again ', signatures the second time: ' X509.x509_checks - checks '\n';
	exit 0;
}
