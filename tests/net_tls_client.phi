# One of net_tls's three clients (see net_tls.phi): trusts crypto_x509's root, connects
# to the server as phi.test (net.tls checks its certificate), sends 20000 bytes and reads
# them back, checking every one, and closes.
use net.tls;

phi.TlsClient:Kernel
{
	const u32 TOTAL: 20000;

	u8 root[843];
	u8 chunk[1000];
	u8 buffer[2048];
	call Bytes.FromHex: '' addr root 843;
	call X509.Trust: addr root 843;
	bln ok: (Net.Start: Machine.address);
	bln connected: false;
	while int tries: 0; tries < 30 and not connected; tries++;
		connected is (Tls.Connect: Machine.first 5443 'phi.test');
		if not connected
			call OS.Sleep: 200;
		;;
	;;
	log 'connected: ' connected ', verified: ' Tls.verified ' ' Tls.error '\n';
	call Run;

	[Run]
		u32 me: Machine.number;
		u32 sent: 0;
		u32 received: 0;
		bln in_order: true;
		while sent < TOTAL
			u32 n: TOTAL - sent;
			if n > 1000
				n is 1000;
			;;
			while u32 i: 0; i < n; i++;
				chunk:i is ((sent + i) * 7 + me) & 0xFF;
			;;
			int wrote: (Tls.Write: addr chunk n);
			if wrote < 0 break;
			sent++ n;
		;;
		while received < TOTAL
			int got: (Tls.Read: addr buffer 2048);
			if got <= 0 break;
			while int i: 0; i < got; i++;
				if buffer:i is not ((received + i) * 7 + me) & 0xFF
					in_order is false;
				;;
			;;
			received++ got;
		;;
		log 'sent ' sent ', received ' received ', in order: ' in_order '\n';
		call Tls.Close;
		exit 0;
	[end]
}
