struct.Point
{
	i16 x;
	i16 y;
}

struct.Entry
{
	u8 name[11];
	u8 kind;
	u32 size;
	Point at;
	ptr<Entry> next;
}

phi.Sizeof:Library
{
	const int ENTRY: sizeof Entry;
	u8 scratch[sizeof Entry];
	Entry entries[4];
	str label: [20];
	str greeting: 'hi';
	u16 ports: 1 2 3;

	debug sizeof u8 ' ' sizeof u16 ' ' sizeof int ' ' sizeof bln ' ' sizeof ptr<Entry> '\n';
	debug sizeof Point ' ' ENTRY ' ' scratch.len '\n';
	debug sizeof entries ' ' sizeof entries:0 ' ' sizeof entries:1.name ' ' sizeof ports '\n';
	debug sizeof label ' ' sizeof greeting '\n';

	# the size of a struct, used to step through memory
	ptr<u8> first: addr entries:0;
	ptr<u8> second: addr entries:1;
	debug (second - first is sizeof Entry) '\n';
}
