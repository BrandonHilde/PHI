# A method's variables can be big in a program on PHI OS too, up to half its 64 KB stack
# (tests/big_frame_program.phi is the same on Linux). Each call of Deep takes 12,000 bytes,
# more than the two pages kept under a thread's stack, so only reaching the frame a page at
# a time stops it there.
use user.threads;

phi.Frames:Program
{
	int depth: 0;
	int stopped: 0;
	int fitted: 0;
	ptr<u32> under: new u32[64];
	under:63 is 12345;

	log (Sum: 3) ' ' (Wide: 7) '\n';
	if call Deep throws err
		log 'caught: ' (err.kind is ErrorKind.STACK) ' ' (depth > 3) '\n';
	;;
	log (Sum: 5) '\n';

	int t: (Threads.Start: addr OnAThread 1);
	call Threads.Wait: t;
	t is (Threads.Start: addr OnAThread 2);
	call Threads.Wait: t;
	log 'the heap: ' under:63 '\n';

	# a big frame from every depth near the end of a thread's stack: stopped each time it
	# doesn't fit, and what's on the heap beside the stack is as it was
	ptr<u8> beside: new u8[65536];
	while int i: 0; i < 65536; i++;
		beside:i is 0x5A;
	;;
	t is (Threads.Start: addr NearTheEnd 0);
	call Threads.Wait: t;
	int changed: 0;
	while int i: 0; i < 65536; i++;
		if beside:i is not 0x5A
			changed++;
		;;
	;;
	log 'near the end: ' (stopped > 0) ' ' (fitted > 0) ' ' changed '\n';
	exit 0;

	[NearTheEnd: int part: 0;]
		while int steps: 0; steps < 400; steps++;
			if call Step: steps throws err
				stopped++;
			;;
			else
				fitted++;
			;;
		;;
	[end]

	# down by about 1,000 bytes a call, then the big frame
	[Step: int left: 0;]
		u8 step[1000];
		step:0 is left;
		if left > 0
			call Step: left - 1;
			return step:0;
		;;
		call Block;
	[end: step:0]

	[Block]
		u8 block[30000];
		block:0 is 1;
		block:(30000 - 1) is 2;
	[end: block:0 + block:(30000 - 1)]

	# 28,000 bytes of variables in one array
	[Wide: int seed: 0;]
		u32 numbers[7000];
		while int i: 0; i < 7000; i++;
			numbers:i is i * seed;
		;;
		u32 total: 0;
		while int i: 0; i < 7000; i is i + 1000;
			total++ numbers:i;
		;;
	[end: total + numbers:6999]

	# 24,000 bytes, in three
	[Sum: int seed: 0;]
		u8 a[8000];
		u8 b[8000];
		u8 c[8000];
		while int i: 0; i < 8000; i++;
			a:i is i + seed;
			b:i is i * 3;
			c:i is 255 - i;
		;;
		int total: 0;
		while int i: 0; i < 8000; i++;
			total++ a:i + b:i + c:i;
		;;
	[end: total]

	[OnAThread: int part: 0;]
		depth is 0;
		if call Deep throws err
			log 'thread ' part ': ' (err.kind is ErrorKind.STACK) ' ' (depth > 0) '\n';
		;;
	[end]

	# each call takes 12,000 bytes: past the pages kept under a stack, in one step
	[Deep]
		u8 held[6000];
		u8 more[6000];
		held:0 is depth;
		more:5999 is depth;
		depth++;
		call Deep;
		log held:0 more:5999;
	[end]
}
