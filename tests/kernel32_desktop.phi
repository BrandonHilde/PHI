# The desktop: a program in a window, clicked, typed to, dragged and closed.
use gui.desktop;

phi.Test:Kernel
{
	bln ok: (Screen.Start: 640 480);
	call Desktop.Start;
	int pid: (Desktop.Run: 'PAINTER.BIN' 'Painter' 40 40);
	debug 'desktop: started ' (pid > 0) '\n';
	while Desktop.windows.len > 0
		call Desktop.Step;
		call OS.Yield;
	;;
	debug 'desktop: no windows left\n';
	call OS.Sleep: 1000;            # (the input script is still letting go of the button)
	exit 0;
}
