# runs only in 32 and 64 bits: its numbers take more room than a 16-bit program has
# X.509 with P-384 and SHA-384, the way Let's Encrypt's ECDSA chain is made: a chain
# OpenSSL 3.2 made (and openssl verify accepts) of a root with a P-384 key, an
# intermediate with a P-384 key it signed, and a leaf for phi.test with a P-256 key the
# intermediate signed, each signature ecdsa-with-SHA384; and a root with an RSA key that
# signed itself with sha384WithRSAEncryption. Then a changed leaf.
use crypto.x509;

phi.CryptoX509P384:Library
{
	u8 root[515];
	u8 middle[494];
	u8 leaf[434];
	u8 rsa[803];
	Certificate trusted;
	Certificate chain[2];
	Certificate own;

	call Bytes.FromHex: '' addr root 515;
	call Bytes.FromHex: '' addr middle 494;
	call Bytes.FromHex: '' addr leaf 434;
	call Bytes.FromHex: '' addr rsa 803;
	log 'read: ' (X509.Parse: addr trusted addr root 515) ' ' (X509.Parse: addr chain:1 addr middle 494)
	    ' ' (X509.Parse: addr chain:0 addr leaf 434) ' ' (X509.Parse: addr own addr rsa 803) ' ' X509.error '\n';
	log 'keys: ' trusted.key_kind ' ' chain:1.key_kind ' ' chain:0.key_kind ' ' own.key_kind
	    ', signed with: ' trusted.signed_with ' ' chain:1.signed_with ' ' chain:0.signed_with ' ' own.signed_with '\n';
	log 'signatures: ' (X509.CheckSignature: addr trusted addr trusted) ' ' (X509.CheckSignature: addr chain:1 addr trusted)
	    ' ' (X509.CheckSignature: addr chain:0 addr chain:1) ' ' (X509.CheckSignature: addr own addr own)
	    ', wrong signer: ' (X509.CheckSignature: addr chain:0 addr trusted) '\n';
	log 'trust: ' (X509.Trust: addr root 515) '\n';
	log 'chain: ' (X509.Chain: addr chain:0 2 'phi.test') ' ' X509.error '\n';
	log 'another host: ' (X509.Chain: addr chain:0 2 'example.com') ' (' X509.error ')\n';

	# a byte of the leaf's key changed: part of what the intermediate signed
	u32 pos: chain:0.point - addr leaf + 5;
	leaf:pos is leaf:pos ^ 1;
	log 'changed: ' (X509.Chain: addr chain:0 2 'phi.test') ' (' X509.error ')\n';
	leaf:pos is leaf:pos ^ 1;
	log 'as it was: ' (X509.Chain: addr chain:0 2 'phi.test') '\n';
}
