# A TLS server (net.tlslink over net.tcp): this kernel shows the leaf of crypto_x509's
# chain (its P-256 key, then the intermediate) on port 5443, and three clients
# (net_tls_client.phi, with net.tls, which checks the certificate) each send 20000 bytes,
# which it sends back, over a network that loses one frame in 40 (net_tls.machines). It
# looks after the three at once without ever waiting.
use net.tcp;
use net.tlslink;

phi.TlsServer:Kernel
{
	const int MOST: 8;                    # machine numbers go up to this

	u8 middle[632];
	u8 leaf[428];
	u8 key[121];
	TlsIdentity identity;
	TlsLink links[8];
	bln open[8];
	u32 echoed[8];
	bln shook[8];
	int finished: 0;
	u8 buffer[2048];

	call Bytes.FromHex: '' addr middle 632;
	call Bytes.FromHex: '' addr leaf 428;
	call Bytes.FromHex: '307702010104201c3c67d53150963e964e28135a7ee1e5c73592704c32240dbc57d6a0cbbe4378a00a06082a8648ce3d030107a14403420004b82ac3af23fdfe999807bb6b796499fc55d95dfda7e6c66db34219034f33a66253cfc9efce24a7f64bd19c0627079a227ec5e7d515201056f72ba50bf8f27c45' addr key 121;
	log 'identity: ' (Tls13.Identity: addr identity addr leaf 428 addr key 121) ' ' (Tls13.AddIssuer: addr identity addr middle 632) '\n';
	bln ok: (Net.Start: Machine.address);
	int listener: (Tcp.Listen: 5443);
	log 'listening: ' (listener >= 0) '\n';
	call Run;

	[Run]
		int start: (OS.GetTicks);
		while finished < Machine.count - 1 and (OS.GetTicks) - start < 120000
			int c: (Tcp.Accept: listener);
			if c >= 0
				int m: (Tcp.Address: c) & 0xFF;
				if (Secure.Accept: addr links:m c addr identity)
					open:m is true;
				;;
			;;
			while int m: 2; m <= Machine.count; m++;
				if open:m
					call Serve: m;
				;;
			;;
			call Net.Wait;
		;;
		while int m: 2; m <= Machine.count; m++;
			log 'machine ' m ': handshake ' shook:m ', echoed ' echoed:m '\n';
		;;
		exit 0;
	[end]

	# one client: on with its handshake, and what it sends, sent back
	[Serve: int m: 0;]
		ptr<TlsLink> link: addr links:m;
		bln going: (Secure.Pump: link);
		if link.session.connected
			shook:m is true;
		;;
		int got: (Secure.Read: link addr buffer 2048);
		while got > 0
			int taken: (Secure.Write: link addr buffer got as u32);
			echoed:m++ taken;
			got is (Secure.Read: link addr buffer 2048);
		;;
		if not going
			if link.session.failed
				log 'machine ' m ' failed: ' link.session.error '\n';
			;;
			call Secure.Close: link;
			open:m is false;
			finished++;
		;;
	[end]
}
