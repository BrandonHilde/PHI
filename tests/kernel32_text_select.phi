# Text fields in a program's window: selecting text (Shift, Ctrl+A, a drag, a double
# click), Tab between fields, and right-button presses as events.
use gui.desktop;

phi.Test:Kernel
{
	bln ok: (Screen.Start: 640 480);
	call Desktop.Start;
	int pid: (Desktop.Run: 'FIELDS.BIN' 'Fields' 40 40);
	while Desktop.windows.len > 0
		call Desktop.Step;
		call OS.Yield;
	;;
	debug 'desktop: no windows left\n';
	call OS.Sleep: 1000;            # (the input script is still sending the last key)
	exit 0;
}
