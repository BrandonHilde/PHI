# Mistakes with has.
struct.Point
{
	int x;
}

phi.HasErrors:Kernel
{
	int scores[3];
	str names[];
	int n: 5;
	Point points[2];
	lock guards[2];
	str line: 'x';
	bln a: n has 5;
	bln b: names has 5;
	bln c: points has n;
	bln d: guards has 1;
	bln e: line has 7;
	bln f: scores has 'a long text';
	exit 0;
}
