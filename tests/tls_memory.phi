# runs only in 32 and 64 bits: its numbers take more room than a 16-bit program has
# TLS 1.3 with both sides in this program (net.tls13): a server showing the leaf of
# crypto_x509's chain (its P-256 key, then the intermediate) and a client that trusts the
# root, joined in memory. The handshake, data both ways (a little, then 40000 bytes),
# close_notify; then a client that wants another host, one that trusts nothing, one that
# offers only ChaCha20-Poly1305, and a byte changed on the way, each of which must fail
# (or, for ChaCha20, work).
use net.tls13;

phi.TlsMemory:Library
{
	u8 root[843];
	u8 middle[632];
	u8 leaf[428];
	u8 key[121];
	u8 buffer[2000];
	TlsIdentity identity;
	TlsIdentity other;
	TlsSession client;
	TlsSession server;
	u32 rounds: 0;

	call Bytes.FromHex: '' addr root 843;
	call Bytes.FromHex: '' addr middle 632;
	call Bytes.FromHex: '' addr leaf 428;
	call Bytes.FromHex: '307702010104201c3c67d53150963e964e28135a7ee1e5c73592704c32240dbc57d6a0cbbe4378a00a06082a8648ce3d030107a14403420004b82ac3af23fdfe999807bb6b796499fc55d95dfda7e6c66db34219034f33a66253cfc9efce24a7f64bd19c0627079a227ec5e7d515201056f72ba50bf8f27c45' addr key 121;
	log 'identity: ' (Tls13.Identity: addr identity addr leaf 428 addr key 121) ' '
	    (Tls13.AddIssuer: addr identity addr middle 632) ' ' X509.error '\n';
	log 'the wrong key: ' (Tls13.Identity: addr other addr middle 632 addr key 121) ' (' X509.error ')\n';
	call X509.Trust: addr root 843;

	# the handshake
	call Start: 'phi.test' 3;
	log 'connected: ' client.connected ' ' server.connected ', verified: ' client.verified
	    ', suite: ' client.suite ' ' server.suite ', rounds: ' rounds ' ' client.error server.error '\n';

	# a little each way
	log 'client writes: ' (Tls13.Write: addr client 'hello, server' 13) '\n';
	call Shuttle;
	int got: (Tls13.Read: addr server addr buffer 2000);
	buffer:got is 0;
	log 'server reads: ' got ' [' addr buffer ']\n';
	log 'server writes: ' (Tls13.Write: addr server 'hello, client' 13) '\n';
	call Shuttle;
	got is (Tls13.Read: addr client addr buffer 2000);
	buffer:got is 0;
	log 'client reads: ' got ' [' addr buffer '], then: ' (Tls13.Read: addr client addr buffer 2000) '\n';

	# 40000 bytes, server to client, as it would go: written as there's room, read as it comes
	u32 sent: 0;
	u32 received: 0;
	u32 sum: 0;
	u8 chunk[1000];
	while u32 i: 0; i < 1000; i++;
		chunk:i is i % 251;
	;;
	while received < 40000 and rounds < 1000
		if sent < 40000
			u32 n: 40000 - sent;
			if n > 1000
				n is 1000;
			;;
			int took: (Tls13.Write: addr server addr chunk n);
			if took > 0
				sent++ took;
			;;
		;;
		call Shuttle;
		got is (Tls13.Read: addr client addr buffer 2000);
		while got > 0
			while int i: 0; i < got; i++;
				sum++ buffer:i;
			;;
			received++ got;
			got is (Tls13.Read: addr client addr buffer 2000);
		;;
		rounds++;
	;;
	log 'bulk: ' sent ' sent, ' received ' received, sum ' sum '\n';

	# close_notify
	call Tls13.Close: addr client;
	call Shuttle;
	log 'closed: ' server.closed ' ' (Tls13.Read: addr server addr buffer 2000) '\n';
	call Tls13.Free: addr client;
	call Tls13.Free: addr server;

	call Start: 'other.test' 3;
	log 'another host: ' client.connected ' ' server.connected ' (' client.error '; ' server.error ')\n';
	call Tls13.Free: addr client;
	call Tls13.Free: addr server;

	call Start: 'zone4.games.phi.test' 2;
	log 'chacha20 and a wildcard: ' client.connected ' ' server.connected ' ' client.suite ' ' server.suite '\n';
	call Tls13.Free: addr client;
	call Tls13.Free: addr server;

	call X509.Untrust;
	call Start: 'phi.test' 3;
	log 'nothing trusted: ' client.connected ' (' client.error '; ' server.error ')\n';
	call Tls13.Free: addr client;
	call Tls13.Free: addr server;
	call X509.Trust: addr root 843;

	# a byte of the server's first flight changed (in its certificate's signature)
	call Tls13.Client: addr client 'phi.test';
	call Tls13.Server: addr server addr identity;
	call Move: addr client addr server 0;
	u32 n: (Tls13.Pending: addr server);
	ptr<u8> flight: (Tls13.Outgoing: addr server);
	flight:(n - 300) is flight:(n - 300) ^ 1;
	call Shuttle;
	call Shuttle;
	log 'changed on the way: ' client.connected ' (' client.error '; ' server.error ')\n';
	call Tls13.Free: addr client;
	call Tls13.Free: addr server;

	# a fresh pair, joined until they're connected (or one fails)
	[Start: ptr<u8> host: 0; u32 offer: 3;]
		client.offer is offer;
		server.offer is 3;
		call Tls13.Client: addr client host;
		call Tls13.Server: addr server addr identity;
		rounds is 0;
		while rounds < 20 and not (client.connected and server.connected) and not client.failed and not server.failed
			call Shuttle;
			rounds++;
		;;
		call Shuttle;                     # (an alert a failed side sent)
	[end]

	# what each side has to send, given to the other
	[Shuttle]
		call Move: addr client addr server 0;
		call Move: addr server addr client 0;
	[end]

	# as much of from's output as to has room for (all of it, or none if bytes is 1)
	[Move: ptr<TlsSession> from: 0; ptr<TlsSession> to: 0; u32 none: 0;]
		u32 n: (Tls13.Pending: from);
		if n > to.room
			n is to.room;
		;;
		if n is 0 or to.failed return;
		call Bytes.Copy: (Tls13.Room: to) (Tls13.Outgoing: from) n;
		call Tls13.Sent: from n;
		call Tls13.Received: to n;
	[end]
}
