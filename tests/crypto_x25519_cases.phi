	# the answer where the scalar or the point was
	call Bytes.FromHex: 'a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4' addr scalar 32;
	call Bytes.FromHex: 'e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c' addr point 32;
	call Bytes.FromHex: 'c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552' addr want 32;
	call X25519.ScalarMult: addr point addr scalar addr point;
	log 'into its own point: ' (Bytes.Equal: addr point addr want 32) '\n';

	[Case: ptr<u8> k: 0; ptr<u8> u: 0; ptr<u8> answer: 0;]
		cases++;
		call Bytes.FromHex: k addr scalar 32;
		call Bytes.FromHex: u addr point 32;
		call Bytes.FromHex: answer addr want 32;
		call X25519.ScalarMult: addr got addr scalar addr point;
		if not (Bytes.Equal: addr got addr want 32)
			wrong++;
			log 'case ' cases ' is wrong\n';
		;;
	[end]
}
