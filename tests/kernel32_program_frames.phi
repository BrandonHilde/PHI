# A user program on PHI OS whose methods have big variables (kernel32_program_frames.rootfs):
# they work, the stack running out under them is still caught on its first thread and its
# others, and the kernel has all the program's memory back after.
use proc.process;

phi.Test:Kernel
{
	u32 framesBefore: Frames.free_frames;
	int code: (Process.Wait: (Process.Spawn: 'FRAMES.BIN'));
	log 'exit code: ' code '\n';
	log 'memory back: ' (Frames.free_frames is framesBefore) '\n';
	exit 0;
}
