# Benchmark for audio.synth: one second of a four-voice song, rendered in memory (no
# sound card needed). phi test --bench compares the count with bench_synth.bench; the
# checksum shows a change that makes a different sound.
use audio.synth;
use test.bench;

phi.BenchSynth:Kernel
{
	u8 sound[4096];
	bln ok: false;
	call ok is Synth.Load: 't140 @0 o4 l8 c e g >c <g e c e\n@2 o3 l4 c g c g\n@3 o5 l16 [c d e f]4\n@5 l8 c r c r c r c r' 44100;
	log 'loaded: ' ok '\n';

	u32 left: 44100;
	u32 sum: 0;
	u64 spent: 0;                               # only Render is timed, not the checksum
	while left > 0
		u32 frames: 1024;
		if left < frames
			frames is left;
		;;
		u32 got: 0;
		u64 before: (Bench.Count);
		call got is Synth.Render: addr sound frames;
		spent++ (Bench.Count) - before;
		while u32 i: 0; i < got * 4; i++;
			sum is sum * 31 + sound:i;
		;;
		left-- frames;
	;;
	debug 'bench synth 4 voices 1 s ' spent '\n';
	log 'checksum: ' sum '\n';
	exit 0;
}
