# The heap with blocks of many sizes, half freed each round in a mixed order, so they
# merge with the free ones beside them; every block still holds what was put in it. A
# program, so it runs on Linux (32 and 64-bit) and Windows.
phi.HeapChurn:Program
{
	ptr<u8> blocks[40];
	u32 seed: 7;
	while int round: 0; round < 20; round++;
		while int i: 0; i < 40; i++;
			if blocks:i is 0
				u32 size: (Random: 200) + 1;
				blocks:i is new u8[size];
				blocks:i:0 is i;
			;;
		;;
		# free about half, in a mixed order
		while int i: 0; i < 40; i++;
			if (Random: 2) is 0 and blocks:i is not 0
				if blocks:i:0 is not i
					log 'corrupt at ' i '\n';
				;;
				free blocks:i;
				blocks:i is 0;
			;;
		;;
	;;
	log 'used blocks ' Heap.used_blocks '\n';

	[Random: u32 limit: 1;]
		seed is seed ^ (seed << 13);
		seed is seed ^ (seed >> 17);
		seed is seed ^ (seed << 5);
	[end: seed % limit]
}
