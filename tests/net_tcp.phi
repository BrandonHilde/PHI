# A TCP server: this kernel listens, and three clients (net_tcp_client.phi) each
# connect, send 64 KB and read 32 KB back, over a network that loses one frame in 40
# (net_tcp.machines), so segments are sent again and arrive out of order. The server
# looks after all three at once without ever waiting, and checks every byte.
use net.tcp;

phi.TcpServer:Kernel
{
	const u32 RECEIVE: 65536;             # from each client
	const u32 SEND: 32768;                # to each
	const int MOST: 8;                    # machine numbers go up to this

	int handles[MOST];                    # each client's connection, by machine number
	u32 received[MOST];
	u32 sent[MOST];
	bln in_order[MOST];
	int finished: 0;
	u8 buffer[2048];
	u8 chunk[1024];

	bln ok: (Net.Start: Machine.address);
	int listener: (Tcp.Listen: 5000);
	log 'listening: ' (listener >= 0) '\n';
	call Run;

	[Run]
		while int m: 0; m < MOST; m++;
			handles:m is -1;
			in_order:m is true;
		;;
		int start: (OS.GetTicks);
		while finished < Machine.count - 1 and (OS.GetTicks) - start < 60000
			int c: (Tcp.Accept: listener);
			if c >= 0
				handles:((Tcp.Address: c) & 0xFF) is c;
			;;
			while int m: 2; m <= Machine.count; m++;
				call Serve: m;
			;;
			call Net.Wait;
		;;

		while int m: 2; m <= Machine.count; m++;
			log 'machine ' m ': received ' received:m ', in order: ' in_order:m ', sent ' sent:m '\n';
		;;
		log 'sent again: ' (Tcp.retransmits > 0) ', kept early segments: ' (Tcp.early_segments > 0) '\n';

		# the closed connections linger until their FINs are answered
		start is (OS.GetTicks);
		while Tcp.open_count > 0 and (OS.GetTicks) - start < 10000
			call Net.Wait;
		;;
		log 'connections left: ' Tcp.open_count '\n';
		exit 0;
	[end]

	# one client: read what's there, send what fits, and close once both are done
	[Serve: int m: 0;]
		int c: handles:m;
		if c < 0 return;
		int ready: (Tcp.Waiting: c);
		if ready > 0
			int got: (Tcp.Read: c addr buffer 2048);
			while int i: 0; i < got; i++;
				if buffer:i is not ((received:m + i) * 7 + m) & 0xFF
					in_order:m is false;
				;;
			;;
			received:m++ got;
		;;
		# as much as the send buffer takes, so several segments are on their way at once
		int taken: 1;
		while sent:m < SEND and taken > 0
			u32 n: SEND - sent:m;
			if n > 1024
				n is 1024;
			;;
			while u32 i: 0; i < n; i++;
				chunk:i is ((sent:m + i) * 13 + m) & 0xFF;
			;;
			taken is (Tcp.Send: c addr chunk n);
			if taken > 0
				sent:m++ taken;
			;;
		;;
		if ready < 0                          # the client has closed (or the connection broke)
			call Tcp.Close: c;
			handles:m is -1;
			finished++;
		;;
	[end]
}
