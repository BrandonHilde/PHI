# Text in a program's structs: str name: [N]; and chr name[N]; (with or without atmost)
# hold text of up to N characters in the struct itself: set, built, compared, indexed,
# measured, in an array of structs and through a pointer, and passed as text and as the
# caller's str. A program, so it runs on Linux (32 and 64-bit) and Windows.
struct.Account
{
	int id;
	str name: [8];
	chr home[atmost 12];
	u8 after;                   # stays put: the texts have their room
}

phi.StrFields:Program
{
	Account a;
	a.id is 7;
	a.after is 99;
	a.name is 'Ada';
	a.name++ ' Lovelace';                    # cut to fit: 8 characters
	a.home is 'HOME/' a.id;
	log a.name '|' a.home '|' a.after '\n';
	log a.name.len ' ' a.name.max ' ' a.home.len ' ' a.home.max ' ' sizeof a.name ' ' sizeof Account '\n';

	# compared, indexed, passed where a ptr<u8> goes
	if a.home is 'HOME/7'
		log 'same\n';
	;;
	log a.name:0 a.name:4 '\n';
	log (Count: a.name) '\n';
	Account people[3];
	people:1.name is 'Cy';
	people:1.home is 'away';
	people:1.home++ ' from home';
	log people:1.name ' ' people:1.name.len ' ' people:1.home ' ' people:1.home:2 '\n';
	ptr<Account> p: addr people:1;
	p.name++ 'rus';
	log p.name ' ' p.name.len ' ' (p.name is 'Cyru') '\n';
	call Show: p.home;
	call Grow: a.name;
	log a.name '\n';

	str title: [atmost 5];
	chr code[6];
	title is 'abcdefgh';
	code is title 'xyz';
	log title ' ' code ' ' code.max '\n';
	exit 0;

	[Count: ptr<u8> text: 0;]
		int n: 0;
		while text:n is not 0
			n++;
		;;
	[end: n]
	[Show: str text;]
		log '<' text ' ' text.len ' ' text.max '>\n';
	[end]
	[Grow: str text;]
		text is 'Grace Hopper';
	[end]
}
