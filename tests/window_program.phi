# A window on Windows and Linux, behind gui.app's calls (lib/phi/host/window_windows.phi and
# window_linux.phi, H7 step 1): the same program a PHI OS desktop would run. Its pixels shown,
# the font, and what the user does: keys, held keys, the mouse and its buttons, the wheel,
# resizing, and closing it. The window is hidden, and WindowTest (support/win_window.phi,
# x11_window.phi) plays the user, so nothing pops up or takes the keys. On Linux this needs
# an X server (WSLg has one).
use gui.app;
use support.win_window;
use support.x11_window;

phi.WindowProgram:Program
{
	HostWindow.visible is false;

	log 'open: ' (App.Open: 200 100) ', inside: ' (WindowTest.ClientWidth) ' x ' (WindowTest.ClientHeight) '\n';
	log 'no event yet: ' (App.NextEvent) '\n';

	# the font: shapes for the letters, nothing for a space
	int ink_a: 0;
	int ink_space: 0;
	while int r: 0; r < 16; r++;
		ink_a++ Font.glyphs:('A' * 16 + r);
		ink_space++ Font.glyphs:(' ' * 16 + r);
	;;
	log 'the font: ' Font.loaded ', an A has ink: ' (ink_a > 0) ', a space has: ' ink_space '\n';

	# what's drawn is what's shown
	call Draw.Clear: 0x102030;
	call Draw.FillRect: 10 10 20 20 0xE0483E;
	call App.Present;
	log 'shown: ' ((WindowTest.PixelAt: 5 5) is 0x102030) ' ' ((WindowTest.PixelAt: 15 15) is 0xE0483E) ' ' ((WindowTest.PixelAt: 199 99) is 0x102030) '\n';

	# keys: one that types, one that doesn't, and one held
	call WindowTest.TypeChar: 'a';
	call App.WaitEvent;
	log 'typed: ' (App.event.kind is Events.KEY) ' ' ((App.event.value & Events.KEY_MASK) is 'a') '\n';
	call WindowTest.KeyDown: Events.KEY_UP;
	call App.WaitEvent;
	log 'up: ' ((App.event.value & Events.KEY_MASK) is Events.KEY_UP) ', held: ' (OS.IsKeyDown: Events.KEY_UP) '\n';
	call WindowTest.KeyUp: Events.KEY_UP;
	log 'let go: ' (OS.IsKeyDown: Events.KEY_UP) '\n';
	call WindowTest.KeyDown: 'w';                # held as 'w', as a game looks for it
	log 'w held: ' (OS.IsKeyDown: 'w') '\n';
	call WindowTest.KeyUp: 'w';
	log 'w let go: ' (OS.IsKeyDown: 'w') '\n';
	call Drain;

	# the mouse: moves come together, a press says which button
	call WindowTest.MoveTo: 1 1;
	call WindowTest.MoveTo: 2 2;
	call WindowTest.MoveTo: 30 40;
	call App.WaitEvent;
	log 'moved: ' App.event.x ' ' App.event.y ', and no more: ' (App.NextEvent) '\n';
	call WindowTest.LeftDown: 31 41;
	call App.WaitEvent;
	log 'left: ' App.event.x ' ' App.event.y ' buttons ' App.event.value ' clicks ' App.event.clicks ' pressed ' App.event.pressed '\n';
	call WindowTest.LeftUp: 31 41;
	call App.WaitEvent;
	log 'up: buttons ' App.event.value ' clicks ' App.event.clicks ' pressed ' App.event.pressed '\n';
	call WindowTest.LeftDouble: 31 41;
	call App.WaitEvent;
	log 'double: clicks ' App.event.clicks '\n';
	call WindowTest.LeftUp: 31 41;
	call App.WaitEvent;
	call WindowTest.RightDown: 5 6;
	call App.WaitEvent;
	log 'right: buttons ' App.event.value ' pressed ' App.event.pressed '\n';
	call WindowTest.RightUp: 5 6;
	call App.WaitEvent;
	call WindowTest.WheelDown: 5 6;
	call App.WaitEvent;
	log 'wheel: ' App.event.wheel '\n';

	# a new size (as dragging its edge would make it): the program is told, and draws at it
	call HostWindow.Fit: 300 150;
	call App.WaitEvent;
	log 'resize: ' (App.event.kind is Events.RESIZE) ' ' App.event.x ' ' App.event.y '\n';
	log 'resized: ' (App.Resize: App.event.x App.event.y) ', inside: ' (WindowTest.ClientWidth) ' x ' (WindowTest.ClientHeight) '\n';
	call Draw.Clear: 0x3DBE5A;
	call App.Present;
	log 'shown again: ' ((WindowTest.PixelAt: 299 149) is 0x3DBE5A) '\n';

	# its title, whether it can be resized, and whether it's in front (it's hidden)
	call App.SetTitle: 'Hello';
	log 'title: ' (WindowTest.TitleLength) ', can be resized: ' (WindowTest.CanResize) '\n';
	call App.SetResizable: false;
	log 'then not: ' (WindowTest.CanResize) ', in front: ' (App.Focused) '\n';
	log 'a program in a window of its own: ' (App.OpenWindow: 'X.BIN' '') '\n';

	# closing it asks the program
	call WindowTest.CloseIt;
	call App.WaitEvent;
	log 'close: ' (App.event.kind is Events.CLOSE) '\n';
	exit 0;

	[Drain]
		while (App.NextEvent)
		;;
	[end]
}
