# net_dns's other machine: its kernel asks the server's names through net.dns, and so does a
# program through net.sockets (net_dns_client.rootfs/ask.phi), which gets the server from its kernel.
use proc.process;
use net.calls;
use net.dns;
use net.udp;

phi.NetDnsClient:Kernel
{
	bln ok: (Net.Start: Machine.address);
	Net.dns is Machine.first;
	log 'client: ' ok '\n';

	call Show: 'one.phi.test';
	call Show: 'behind.phi.test';
	call Show: 'top.phi.test';
	call Show: 'nothing.phi.test';
	call Show: '10.9.8.7';

	int code: (Process.Wait: (Process.Spawn: 'ASK.BIN'));
	log 'the program ended with ' code '\n';

	# (the server stops when it hears this)
	int s: (Udp.Open);
	call Udp.SendTo: s Machine.first 53 'done' 4;
	exit 0;

	[Show: ptr<u8> name: 0;]
		u32 address: (Dns.Resolve: name);
		log name ': ';
		call Net.PrintIp: address;
		log '\n';
	[end]
}
