use drivers.rtc;

phi.Clock:Library
{
	call Rtc.Read;
	debug 'year ok: ' (Rtc.year >= 2024 and Rtc.year < 2100) '\n';
	debug 'date ok: ' (Rtc.month >= 1 and Rtc.month <= 12 and Rtc.day >= 1 and Rtc.day <= 31) '\n';
	debug 'time ok: ' (Rtc.hour < 24 and Rtc.minute < 60 and Rtc.second < 60) '\n';

	# the host's time zone, which phi test passes to QEMU
	debug 'host zone ok: ' (Rtc.zone >= -720 and Rtc.zone <= 840 and Rtc.zone is (Rtc.HostZone)) '\n';

	# time zones: across midnight, the end of a month and of a year, and a leap day
	call Show: 2025 12 31 23 30 90;
	call Show: 2026 1 1 0 15 -60;
	call Show: 2024 2 28 22 0 180;
	call Show: 2023 2 28 22 0 180;
	call Show: 2026 3 1 1 0 -330;
	call Show: 2026 6 15 12 0 0;

	call Rtc.SetZone: 60;
	call Rtc.ReadLocal;
	debug 'local ok: ' (Rtc.hour < 24 and Rtc.day >= 1) '\n';
	exit 0;

	[Show: int y: 0; int m: 0; int d: 0; int h: 0; int min: 0; int add: 0;]
		Rtc.year is y;
		Rtc.month is m;
		Rtc.day is d;
		Rtc.hour is h;
		Rtc.minute is min;
		call Rtc.AddMinutes: add;
		debug Rtc.year '-' Rtc.month '-' Rtc.day ' ' Rtc.hour ':' Rtc.minute '\n';
	[end]
}
