phi.NegativeLists:Library
{
	# a '-' with a space before it and none after starts a new value
	int values: 3 1 2 -1 -2;
	debug values.len ':';
	while int i: 0; i < values.len; i++;
		debug ' ' values:i;
	;;
	debug '\n';

	# spaced on both sides, or not at all, it still subtracts
	int x: 10;
	int both: x - 1 x-1 (x -1);
	debug both.len ': ' both:0 ' ' both:1 ' ' both:2 '\n';

	# call arguments work the same way
	int got: 0;
	call got is Pair: x -1;
	debug 'pair ' got '\n';
	call got is Pair: x - 1 -1;
	debug 'pair ' got '\n';

	# and log
	debug 5 -3 '\n';

	[Pair: int a: 0; int b: 0;]
	[end: a * 100 + b]
}
