# Dividing by zero, using an empty object, reading through a null pointer and reading
# memory that isn't the program's: each caught as an error of its own kind, two methods
# down with text there to give back, many times over; then one that isn't caught.

struct.Node
{
	int value;
}

phi.Faults:Program
{
	int zero: 0;
	if call Deep: 2 0 throws err
		log 'divide: ' (err.kind is ErrorKind.DIVIDE) ' ' err '\n';
	;;
	if call Deep: 2 1 throws err
		log 'empty: ' (err.kind is ErrorKind.EMPTY) ' ' err '\n';
	;;
	if call Deep: 2 2 throws err
		log 'null: ' (err.kind is ErrorKind.EMPTY) '\n';
	;;
	if call Deep: 2 3 throws err
		log 'not its own: ' (err.kind is ErrorKind.ACCESS) ' ' err '\n';
	;;
	int caught: 0;
	while int i: 0; i < 50; i++;
		if call Deep: 3 (i % 4) throws err
			caught++;
		;;
	;;
	log 'again: ' caught ' caught\n';
	call Deep: 0 0;                     # not caught: the program ends
	log 'not here\n';

	[Deep: int depth: 0; int what: 0;]
		str held: ('held at ' depth);
		if depth > 0
			call Deep: depth - 1 what;
			return;
		;;
		when what
			is 0
				int n: 7 / zero;
			;;
			is 1
				new Node node;
				node is empty;
				int v: node.value;
			;;
			is 2
				ptr<u32> nothing: 0;
				u32 w: nothing:0;
			;;
			else
				ptr<u32> kernel: 0x100000;
				u32 w: kernel:0;
			;;
		;;
	[end]
}
