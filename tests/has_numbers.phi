# runs only in 32 and 64 bits: 64-bit numbers and floating point need 32-bit code
# has on arrays of 64-bit numbers and of floating point numbers, compared as is compares
# them: a 64-bit number whole (two that differ only in their high or low half are
# different), and floats by value (0.0 is -0.0, an int finds the same float, and nan is
# nothing, not even itself). Fixed arrays, growing ones, and an array parameter.

phi.HasNumbers:Library
{
	i64 big: 5000000000 -7 0x100000000;
	u64 huge: 0xFFFFFFFF00000000 1;
	f64 reals: 1.5 -0.0 2.0;
	f32 halves: 0.5 0.25;
	f16 tiny: 3.0 0.125;
	f64 grown[];
	f64 none: 0.0;

	log 'i64: ' (big has 5000000000) ' ' (big has -7) ' ' (big has 1) ' ' (big has 0x100000000)
	    ', not: ' (big has 705032704) ' ' (big has 0) '\n';
	log 'u64: ' (huge has 0xFFFFFFFF00000000) ' ' (huge has 1) ', not: ' (huge has 0xFFFFFFFF) ' ' (huge has 0) '\n';
	log 'f64: ' (reals has 1.5) ' ' (reals has 0.0) ' ' (reals has 2) ', not: ' (reals has 1.25) ' ' (reals has 3) '\n';
	log 'f32: ' (halves has 0.5) ' ' (halves has 0.25) ', not: ' (halves has 0.3) '\n';
	log 'f16: ' (tiny has 3) ' ' (tiny has 0.125) ', not: ' (tiny has 3.5) '\n';

	f64 nan: none / none;
	grown++ 4.5;
	grown++ nan;
	log 'growing: ' (grown has 4.5) ', nan: ' (grown has nan) ' ' (nan is nan) ', empty: ' (Find: grown 4.5) '\n';
	grown.len is 0;
	log 'emptied: ' (grown has 4.5) ', a parameter: ' (Find: reals 2.0) ' ' (Find: reals 2.5) '\n';

	[Find: f64 list[]; f64 value: 0.0;]
	[end: list has value]
}
