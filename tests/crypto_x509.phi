# runs only in 32 and 64 bits: its numbers take more room than a 16-bit program has
# X.509: a chain OpenSSL 3.2 made (and openssl verify accepts) read and checked: a root
# with an RSA key, an intermediate with a P-256 key it signed (sha256WithRSAEncryption,
# a CA with pathlen 0), and a leaf the intermediate signed (ecdsa-with-SHA256) for
# phi.test and *.games.phi.test. Then host names, a chain without its root, an untrusted
# root, and a changed leaf.
use crypto.x509;

phi.CryptoX509:Library
{
	u8 root[843];
	u8 middle[632];
	u8 leaf[428];
	Certificate chain[2];
	Certificate trusted;
	int got: 0;

	got is (Bytes.FromHex: '' addr root 843);
	got++ (Bytes.FromHex: '' addr middle 632);
	got++ (Bytes.FromHex: '' addr leaf 428);
	log 'bytes: ' got '\n';

	log 'read: ' (X509.Parse: addr trusted addr root 843) ' ' (X509.Parse: addr chain:1 addr middle 632)
	    ' ' (X509.Parse: addr chain:0 addr leaf 428) ' ' X509.error '\n';
	log 'keys: ' trusted.key_kind ' ' chain:1.key_kind ' ' chain:0.key_kind
	    ', signed with: ' trusted.signed_with ' ' chain:1.signed_with ' ' chain:0.signed_with '\n';
	log 'ca: ' trusted.ca ' ' chain:1.ca ' ' chain:0.ca ', path lengths: ' trusted.path_length ' ' chain:1.path_length '\n';
	log 'rsa modulus bytes: ' trusted.modulus_length ', exponent bytes: ' trusted.exponent_length '\n';

	log 'signatures: ' (X509.CheckSignature: addr trusted addr trusted) ' ' (X509.CheckSignature: addr chain:1 addr trusted)
	    ' ' (X509.CheckSignature: addr chain:0 addr chain:1) ', wrong signer: ' (X509.CheckSignature: addr chain:0 addr trusted) '\n';

	log 'hosts: ' (X509.MatchesHost: addr chain:0 'phi.test') ' ' (X509.MatchesHost: addr chain:0 'PHI.Test')
	    ' ' (X509.MatchesHost: addr chain:0 'zone1.games.phi.test') ', not: ' (X509.MatchesHost: addr chain:0 'games.phi.test')
	    ' ' (X509.MatchesHost: addr chain:0 'a.b.games.phi.test') ' ' (X509.MatchesHost: addr chain:0 'example.com')
	    ' ' (X509.MatchesHost: addr chain:0 '.games.phi.test') '\n';

	log 'untrusted: ' (X509.Chain: addr chain:0 2 'phi.test') ' (' X509.error ')\n';
	X509.now is 1793923200;                   # 2026-11-05: the certificates are from 2026-11-02
	log 'trust: ' (X509.Trust: addr root 843) '\n';
	log 'chain: ' (X509.Chain: addr chain:0 2 'phi.test') ' ' (X509.Chain: addr chain:0 2 'zone7.games.phi.test') '\n';

	# the leaf is good for a year from 2026-11-02: not before it, nor after
	log 'dates: ' (X509.Time: chain:0.not_before chain:0.not_before_length) ' to ' (X509.Time: chain:0.not_after chain:0.not_after_length) '\n';
	X509.now is 1777593600;                   # 2026-05-01
	log 'before: ' (X509.Chain: addr chain:0 2 'phi.test') ' (' X509.error ')\n';
	X509.now is 1830297600;                   # 2028-01-01
	log 'after: ' (X509.Chain: addr chain:0 2 'phi.test') ' (' X509.error ')\n';
	X509.now is 1793923200;
	log 'another host: ' (X509.Chain: addr chain:0 2 'example.com') ' (' X509.error ')\n';
	# (what has checked out is remembered, and would pass without its issuer: crypto_x509_known)
	call X509.Forget;
	log 'no intermediate: ' (X509.Chain: addr chain:0 1 'phi.test') ' (' X509.error ')\n';
	log 'the intermediate alone: ' (X509.Chain: addr chain:1 1 'phi.test') ' (' X509.error ')\n';

	# a digit of the leaf's notBefore changed: its signature no longer covers it
	chain:0.not_before:3 is chain:0.not_before:3 ^ 1;
	log 'changed: ' (X509.Chain: addr chain:0 2 'phi.test') ' (' X509.error ')\n';
	chain:0.not_before:3 is chain:0.not_before:3 ^ 1;
	log 'as it was: ' (X509.Chain: addr chain:0 2 'phi.test') '\n';
	call X509.Untrust;
	log 'roots forgotten: ' (X509.Chain: addr chain:0 2 'phi.test') '\n';
}
