phi.Boot:Bootloader
{
	call Bootloader.JumpToSectorTwo;
}

phi.Arrays:OS
{
	int numbers: 1 3 5 9 2;
	int sum: 0;
	int squares[5];

	while int i: 0; i < numbers.len; i++;
		sum++numbers:i;
		squares:i is numbers:i * numbers:i;
	;;
	log sum ' ' numbers.len '\n';

	while int j: 0; j < 5; j++;
		log squares:j ' ';
	;;
	log '\n';

	byt flags: 0 1 0;
	flags:2 is 1;
	log flags:0 flags:1 flags:2 '\n';

	int k: 4;
	while k > 0
		k--;
		log k;
	;;
}
