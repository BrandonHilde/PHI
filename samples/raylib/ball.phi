# A window through raylib: a ball that follows the mouse and leaves a trail, until the
# window is closed or Escape is pressed. raylib comes with PHI, in the vendor folder:
# use vendor.raylib; brings in every function, struct and constant it has, and a build puts
# the library itself beside the program. The same source is a Windows program, a macOS one
# and a 64-bit Linux one.
#
#   phi run samples/raylib/ball.phi --target macos        (or windows64, windows, linux64)
use vendor.raylib;

phi.Ball:Program
{
	Vector2 trail[24];
	int frames: 0;
	Color back: (Ray.GetColor: 0x181C30FF);

	call Ray.SetTraceLogLevel: Ray.LOG_WARNING;
	call Ray.InitWindow: 640 400 'PHI and raylib';
	call Ray.SetTargetFPS: 60;
	while not (Ray.WindowShouldClose)
		while int i: 23; i > 0; i--;
			trail:i is trail:(i - 1);
		;;
		trail:0 is (Ray.GetMousePosition);

		call Ray.BeginDrawing;
		call Ray.ClearBackground: back;
		while int i: 23; i >= 0; i--;
			call Ray.DrawCircleV: trail:i 22.0 - i * 0.75 (Ray.Fade: Ray.ORANGE 1.0 - i / 24.0);
		;;
		call Ray.DrawText: 'move the mouse; Escape ends' 12 12 20 Ray.RAYWHITE;
		call Ray.DrawFPS: 12 370;
		call Ray.EndDrawing;
		frames++;
	;;
	call Ray.CloseWindow;
	log frames ' frames\n';
	exit 0;
}
