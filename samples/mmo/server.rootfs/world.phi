# The mmo sample's world, a user program: players join over UDP, move a step at a
# time, and are told where everything near them is 20 times a second: each other, and
# the creatures that move on their own (the world itself is Zone, in zone.phi). Where
# each player is goes into a save log once a second, so after a restart (of the
# machine, or of this program after a crash) everyone comes back where they left off.
#
# Every 10 seconds it says how the tick kept up, which phi load checks:
#
#   tick: 200 ticks in 10000 ms, 0 late, longest 41 ms, 300 players
#
# (a tick is late when it starts more than half a tick after its time; longest is the
# most one took.)
#
# The server (server.phi, a kernel) starts the network and keeps this running with
# proc.supervisor, beside the lobby (lobby.phi).

use net.sockets;
use user.savelog;
use zone;

# one record of the save log
struct.SavedPlayer
{
	u32 id;
	i32 x;
	i32 y;
}

phi.World:Program
{
	const int TICK: Game.TICK;
	const int SAVE_EVERY: 20;             # ticks: the players who moved are saved once a second
	const int REPORT_EVERY: 200;          # ticks: how the tick kept up, every 10 seconds
	const int CHATTY: 8;                  # with more players than this, joins and saves aren't logged one by one
	const u32 NOBODY: 0xFFFFFFFF;

	ptr<MapData> saved: (Map.New);        # player id -> where they were: x << 16 | y
	u8 message[Game.STATE_SIZE];
	UdpDatagram d;
	SavedPlayer records[Game.MAX_PLAYERS];

	# which zone this is: 0, unless the command line says (server.phi starts one world for
	# each zone, on ports from Game.PORT up); each saves its players in a log of its own
	int zone: (ZoneNumber);
	str saves: 'PLAYERS.LOG';
	str prefix: '';
	if zone > 0
		saves is 'PLAYERS' zone '.LOG';
		prefix is 'zone ' zone ' ';
	;;

	int s: (Udp.Open: Game.PORT + zone 256);
	if s < 0
		log prefix 'world: no network, or the port is taken\n';
		exit 1;
	;;

	# where everyone was; then the log is written again with just that, to keep it small
	call SaveLog.Read: saves sizeof SavedPlayer addr Restore;
	log prefix 'world started: ' saved:0.count ' saved players\n';
	call Compact;

	int ticks: 0;
	int late: 0;                          # since the last report
	int longest: 0;
	int next_tick: (OS.GetTicks);
	int reported: next_tick;
	while true
		while (Udp.Receive: s addr d)
			call Handle;
		;;
		int now: (OS.GetTicks);
		if now - next_tick >= 0
			if now - next_tick > TICK / 2
				late++;
			;;
			call Zone.Tick;
			ticks++;
			if ticks % SAVE_EVERY is 0 call Save;
			call SendState;
			int took: (OS.GetTicks) - now;
			if took > longest
				longest is took;
			;;
			next_tick++ TICK;
			if ticks % REPORT_EVERY is 0
				int clock: (OS.GetTicks);
				log prefix 'tick: ' REPORT_EVERY ' ticks in ' clock - reported ' ms, ' late ' late, longest ' longest ' ms, ' Zone.players.len ' players\n';
				reported is clock;
				late is 0;
				longest is 0;
			;;
		;;
		call OS.Sleep: 1;
	;;

	# the zone number on the command line (a whole number), or 0
	[ZoneNumber]
		ptr<u8> line: (OS.Arguments);
		int n: 0;
		if line is 0 return 0;
		while int i: 0; line:i >= '0' and line:i <= '9'; i++;
			n is n * 10 + line:i - '0';
		;;
	[end: n]

	# ---- messages

	[Handle]
		if d.length < 5 return;
		u32 id: (Net.Get32: addr d.data + 1);
		when d.data:0
			is Game.JOIN
				call Join: id;
			;;
			is Game.MOVE
				if d.length >= 6
					call Move: id d.data:5;
				;;
			;;
		;;
	[end]

	# a player joins (or joins again, after a restart of theirs or ours)
	[Join: u32 id: 0;]
		int i: (Zone.Find: id);
		if i < 0
			int x: Game.START_X;
			int y: 20 + id % 4 * 40;
			u32 where: (Map.Get: saved id NOBODY);
			if where is not NOBODY
				x is where >> 16;
				y is where & 0xFFFF;
			;;
			i is (Zone.Add: id x y);
			if i < 0 return;
			if Zone.players.len <= CHATTY
				if where is not NOBODY
					log prefix 'restored player ' id ' at ' x ' ' y '\n';
				;;
				else
					log prefix 'player ' id ' joined at ' x ' ' y '\n';
				;;
			;;
		;;
		Zone.players:i.address is d.from;
		Zone.players:i.port is d.from_port;

		message:0 is Game.WELCOME;
		call Net.Put16: addr message + 1 Zone.players:i.x as u32;
		call Net.Put16: addr message + 3 Zone.players:i.y as u32;
		call Udp.SendTo: s d.from d.from_port addr message 5;
	[end]

	# a step, if it comes from where the player joined from
	[Move: u32 id: 0; u8 direction: 0;]
		int i: (Zone.Find: id);
		if i < 0 return;
		if Zone.players:i.address is not d.from or Zone.players:i.port is not d.from_port return;
		call Zone.Move: i direction;
	[end]

	# ---- every tick

	# every player that moved since the last time, into the save log in one write
	[Save]
		int n: 0;
		while int i: 0; i < Zone.players.len; i++;
			if Zone.players:i.moved
				records:n.id is Zone.players:i.id;
				records:n.x is Zone.players:i.x;
				records:n.y is Zone.players:i.y;
				n++;
			;;
		;;
		if n is 0 return;
		if (SaveLog.AddMany: saves addr records sizeof SavedPlayer n as u32) is false return;
		while int i: 0; i < Zone.players.len; i++;
			if Zone.players:i.moved
				Zone.players:i.moved is false;
				if Zone.players.len <= CHATTY
					log prefix 'saved player ' Zone.players:i.id ' at ' Zone.players:i.x ' ' Zone.players:i.y '\n';
				;;
			;;
		;;
	[end]

	# what's near each player, to each player
	[SendState]
		while int i: 0; i < Zone.players.len; i++;
			u32 size: (Zone.StateFor: i addr message);
			call Udp.SendTo: s Zone.players:i.address Zone.players:i.port addr message size;
		;;
	[end]

	# ---- the save log

	# a record from the log: the last one for each player is where they are
	[Restore: ptr<u8> bytes: 0;]
		ptr<SavedPlayer> r: bytes as ptr<SavedPlayer>;
		call Map.Set: saved r.id ((r.x << 16) | r.y) as u32;
	[end]

	# the log again, with one record for each player
	[Compact]
		call SaveLog.Clear: saves;
		int n: 0;
		int pos: (Map.Next: saved);
		while pos >= 0 and n < Game.MAX_PLAYERS
			u32 where: (Map.ValueAt: saved pos);
			records:n.id is (Map.KeyAt: saved pos);
			records:n.x is where >> 16;
			records:n.y is where & 0xFFFF;
			n++;
			pos is (Map.Next: saved pos);
		;;
		call SaveLog.AddMany: saves addr records sizeof SavedPlayer n as u32;
	[end]
}
