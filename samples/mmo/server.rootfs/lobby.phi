# The mmo sample's lobby, a user program: players log in over TLS with a name and a
# password, and can talk. The server (server.phi, a kernel) keeps it running with
# proc.supervisor, beside the world (world.phi): if the lobby crashes it's started
# again, with its accounts, and the world carries on. It takes a line at a time:
#
#   login NAME PASSWORD   ->  welcome NAME        (a name nobody has yet makes an account)
#                         ->  wrong password
#   say TEXT              ->  said TEXT           (once logged in)
#   quit                  ->  bye, and the connection closes
#
# Each connection is TLS 1.3 (net.tlslink): the lobby shows LOBBY.CRT, a certificate for
# lobby.mmo.phi.test, and signs with LOBBY.KEY (both DER, on its disk; the sample's own,
# from certs/, whose README says how to make them). A client trusts certs/root.der and
# checks the certificate, so the passwords go encrypted, to the lobby and nobody else.
#
# Each password is kept as a PBKDF2 hash with a random salt of its own (crypto.pbkdf2),
# in a save log, so accounts last across restarts. ROUNDS is low (100) for now: in
# PHI's code today a thousand rounds are about 39 million instructions, which adds up
# when hundreds of players log in at once (and a TLS handshake is about 115 million on
# the lobby's side, tests/bench_tls.bench). `phi load samples/mmo/server.phi` logs in
# hundreds of connections and keeps them talking.

use net.sockets;
use net.tlslink;
use data.map;
use memory.pool;
use user.savelog;
use crypto.pbkdf2;
use crypto.random;
use user.text;

struct.Account
{
	u8 name[16];
	u8 salt[16];
	u8 hash[32];
}

# one connection's state
struct.Session
{
	bln logged_in;
	ptr<Account> account;
	u32 length;                 # bytes in line so far
	u8 line[128];
	TlsLink link;               # its TLS
}

phi.Lobby:Program
{
	const u32 PORT: 4001;
	const u32 ROUNDS: 100;
	const int MOST: 1024;                 # Tcp.MAX_CONNECTIONS: a session for each connection number

	int listener: -1;
	ptr<Session> sessions[MOST];          # by connection number: its Session, or 0
	ptr<PoolData> session_pool: 0;
	ptr<PoolData> account_pool: 0;
	ptr<MapData> accounts: 0;             # a name's hash -> where its Account is in every, and 1
	ptr<Account> every[];                 # every account
	TlsIdentity identity;                 # what the lobby shows
	u8 certificate[2048];
	u8 key[256];
	u8 got[512];
	u8 reply[160];
	u8 hash[32];
	u32 logins: 0;

	if (Open)
		while true
			call Serve;
			call OS.Sleep: 1;
		;;
	;;

	# the identity and the accounts from their files, and the port open; false if the
	# lobby can't show who it is
	[Open]
		int certificate_length: (OS.ReadFile: 'LOBBY.CRT' addr certificate 2048);
		int key_length: (OS.ReadFile: 'LOBBY.KEY' addr key 256);
		if certificate_length <= 0 or key_length <= 0
			log 'lobby: no LOBBY.CRT and LOBBY.KEY to show\n';
			return false;
		;;
		if not (Tls13.Identity: addr identity addr certificate certificate_length addr key key_length)
			log 'lobby: LOBBY.CRT and LOBBY.KEY: ' X509.error '\n';
			return false;
		;;
		call Bytes.Zero: addr key 256;
		session_pool is (Pool.New: sizeof Session 64);
		account_pool is (Pool.New: sizeof Account 64);
		accounts is (Map.New);
		call SaveLog.Read: 'ACCOUNTS.LOG' sizeof Account addr Restore;
		listener is (Tcp.Listen: PORT 128);
		log 'lobby open on port ' PORT ' (TLS): ' accounts:0.count ' accounts\n';
	[end: true]

	# new connections, and what has arrived on each (never waits)
	[Serve]
		while true
			int c: (Tcp.Accept: listener);
			if c < 0 break;
			ptr<Session> s: (Pool.Alloc: session_pool);
			if s is 0 or not (Secure.Accept: addr s.link c addr identity)
				call Tcp.Close: c;
				if s is not 0
					call Pool.Free: session_pool s;
				;;
			;;
			else
				s.logged_in is false;
				s.length is 0;
				sessions:c is s;
			;;
		;;
		while int c: 0; c < MOST; c++;
			if sessions:c is not 0
				call Read: c;
			;;
		;;
	[end]

	# on with the connection's TLS, and what has arrived on it, a line at a time
	[Read: int c: 0;]
		ptr<Session> s: sessions:c;
		if not (Secure.Pump: addr s.link)         # closed, broken, or its TLS failed
			call Forget: c;
			return;
		;;
		ptr<u8> line: s.line;
		int n: (Secure.Read: addr s.link addr got 512);
		while n > 0
			while int i: 0; i < n; i++;
				if got:i is '\n'
					line:(s.length) is 0;
					s.length is 0;
					call Line: c;
					if sessions:c is 0 return;    # that line closed it
				;;
				elif got:i is not '\r' and s.length < 127
					line:(s.length) is got:i;
					s.length++;
				;;
			;;
			n is (Secure.Read: addr s.link addr got 512);
		;;
	[end]

	[Line: int c: 0;]
		ptr<Session> s: sessions:c;
		ptr<u8> line: s.line;
		if (Text.StartsWith: line 'login ')
			u8 name[16];
			u8 password[64];
			ptr<u8> rest: line + 6;
			call Text.CopyWord: rest addr name 15;
			call Text.CopyWord: (Text.AfterWord: rest) addr password 63;
			call Login: c addr name addr password;
			call Bytes.Zero: addr password 64;
		;;
		elif s.logged_in and (Text.StartsWith: line 'say ')
			call Text.Copy: addr reply 'said ' 160;
			call Text.Append: addr reply line + 4 160;
			call Say: c addr reply;
		;;
		elif (Text.Equal: line 'quit')
			call Say: c 'bye';
			call Forget: c;
		;;
		else
			call Say: c 'what?';
		;;
	[end]

	# a name and password: the account's, or a new account if nobody has the name yet
	[Login: int c: 0; ptr<u8> name: 0; ptr<u8> password: 0;]
		ptr<Session> s: sessions:c;
		if name:0 is 0
			call Say: c 'what?';
			return;
		;;
		ptr<Account> a: (Find: name);
		if a is 0
			a is (Pool.Alloc: account_pool);
			call Text.Copy: a.name name 16;
			call Random.Fill: a.salt 16;
			call Pbkdf2.Derive: password (Text.Length: password) a.salt 16 ROUNDS a.hash 32;
			call Remember: a;
			call SaveLog.Add: 'ACCOUNTS.LOG' a as ptr<u8> sizeof Account;
		;;
		else
			call Pbkdf2.Derive: password (Text.Length: password) a.salt 16 ROUNDS addr hash 32;
			if (Bytes.Equal: addr hash a.hash 32) is false
				call Say: c 'wrong password';
				return;
			;;
		;;
		s.logged_in is true;
		s.account is a;
		logins++;
		call Text.Copy: addr reply 'welcome ' 160;
		call Text.Append: addr reply name 160;
		call Say: c addr reply;
	[end]

	# a line back to the connection (it goes as Pump gets the chance)
	[Say: int c: 0; ptr<u8> text: 0;]
		ptr<Session> s: sessions:c;
		int taken: (Secure.Write: addr s.link text (Text.Length: text));
		taken is (Secure.Write: addr s.link '\n' 1);
	[end]

	# a connection gone: its TLS closed (close_notify, if it's still there) and its session freed
	[Forget: int c: 0;]
		ptr<Session> s: sessions:c;
		call Secure.Close: addr s.link;
		call Pool.Free: session_pool s;
		sessions:c is 0;
	[end]

	# the account with a name, or 0
	[Find: ptr<u8> name: 0;]
		u32 place: (Map.Get: accounts (Hash: name) 0);
		if place is 0 return 0;
		ptr<Account> a: every:(place - 1);
		if (Text.Equal: a.name name) is false return 0;   # another name with the same hash
	[end: a]

	# a's place, known by its name's hash
	[Remember: ptr<Account> a: 0;]
		every++ a;
		call Map.Set: accounts (Hash: a.name) every.len;
	[end]

	# FNV-1a: a 32-bit hash of the name
	[Hash: ptr<u8> text: 0;]
		u32 h: 2166136261;
		while int i: 0; text:i is not 0; i++;
			h is (h ^ text:i) * 16777619;
		;;
	[end: h]

	# an account from the log
	[Restore: ptr<u8> bytes: 0;]
		ptr<Account> a: (Pool.Alloc: account_pool);
		call Mem.Copy: a as ptr<u8> bytes sizeof Account;
		call Remember: a;
	[end]
}
