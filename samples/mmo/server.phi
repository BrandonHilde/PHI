# The mmo sample's server: a kernel that starts the network and keeps user programs
# running, from server.rootfs/: the world (world.phi), where players join over UDP and
# move, split into Game.ZONES zones (a world program for each, on ports from Game.PORT
# up), and the lobby (lobby.phi), where they log in and talk over TLS. Every core runs
# them (Cores.SharePrograms), so the zones tick at the same time. Each saves what it has
# as it goes, so if one crashes the supervisor starts it again with its players or
# accounts, and the others carry on.
#
#   phi run samples/mmo/server.phi      # the server and three clients (server.machines), each in a window
#   phi test samples/mmo/server.phi     # the same, with the moves and a restart scripted
#   phi load samples/mmo/server.phi --root samples/mmo/certs/root.der --host lobby.mmo.phi.test
#                                       # hundreds of logins in the lobby at once, over TLS
#   phi load samples/mmo/server.phi --client samples/mmo/load_players.phi --connections 300 --seconds 60
#                                       # hundreds of players in the world, checking its tick
#
# It's machine 1 on the network that phi run and phi test make (see server.machines);
# Machine.address is its address.

use net.calls;
use proc.supervisor;
use proc.cores;
use protocol;

phi.MmoServer:Kernel
{


	int worlds[Game.ZONES];
	str line: [4];

	bln ok: (Net.Start: Machine.address);
	if ok is false
		log 'no network card\n';
	;;
	# every core runs programs: the zones (and the lobby) at once, each on whichever is free
	bln shared: (Cores.SharePrograms);
	while int z: 0; z < Game.ZONES; z++;
		line is z;
		worlds:z is (Supervisor.Keep: 'WORLD.BIN' line);
	;;
	int lobby: (Supervisor.Keep: 'LOBBY.BIN');

	while true
		# K stops zone 0's world on purpose, to see it come back with everyone where they were
		if (OS.KeyAvailable)
			if (OS.ReadKey) is 'k'
				log 'stopping the world on purpose\n';
				call OS.KillTask: (Supervisor.ProcessOf: worlds:0);
			;;
		;;
		if (Supervisor.Check) > 0
			log 'started again: the world ' Supervisor.restarts:(worlds:0) ' time(s), the lobby ' Supervisor.restarts:lobby '\n';
		;;
		call OS.Idle;                     # the programs run (or the machine rests)
	;;
}
