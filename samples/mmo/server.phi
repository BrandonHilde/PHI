# The mmo sample's server: a kernel that starts the network and keeps two user programs
# running, from server.rootfs/: the world (world.phi), where players join over UDP and
# move, and the lobby (lobby.phi), where they log in and talk over TCP. Each saves what
# it has as it goes, so if one crashes the supervisor starts it again with its players
# or accounts, and the other carries on.
#
#   phi run samples/mmo/server.phi      # the server and three clients (server.machines), each in a window
#   phi test samples/mmo/server.phi     # the same, with the moves and a restart scripted
#   phi load samples/mmo/server.phi     # hundreds of logins in the lobby at once
#
# It's machine 1 on the network that phi run and phi test make (see server.machines);
# Machine.address is its address.

use net.calls;
use proc.supervisor;

phi.MmoServer:Kernel
{
	bln ok: (Net.Start: Machine.address);
	if ok is false
		log 'no network card\n';
	;;
	int world: (Supervisor.Keep: 'WORLD.BIN');
	int lobby: (Supervisor.Keep: 'LOBBY.BIN');

	while true
		# K stops the world on purpose, to see it come back with everyone where they were
		if (OS.KeyAvailable)
			if (OS.ReadKey) is 'k'
				log 'stopping the world on purpose\n';
				call OS.KillTask: (Supervisor.ProcessOf: world);
			;;
		;;
		if (Supervisor.Check) > 0
			log 'started again: the world ' Supervisor.restarts:world ' time(s), the lobby ' Supervisor.restarts:lobby '\n';
		;;
		call OS.Idle;                     # the programs run (or the machine rests)
	;;
}
