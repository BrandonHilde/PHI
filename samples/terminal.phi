# A tiny terminal for a 32-bit kernel: type commands, with a clock in the corner.
#
#   phi run samples/terminal.phi
#
# The clock is drawn by the timer event (an interrupt, 60 times a second) using
# the RTC driver; typing goes through the keyboard driver; ls and cat read the
# FAT16 disk that phi build makes from terminal.rootfs/, and run starts one of
# the programs on it (phi build compiles the .phi files there into .BIN
# programs). 'crash' divides by zero to show the panic screen.

use drivers.rtc;
use fs.fat16;
use proc.process;

phi.Terminal:Kernel
{
	const u16 CLOCK_COLOR: 0x1F00;     # white on blue
	ptr<u16> screen: 0xB8000;
	int lastSecond: -1;
	str line: [60];
	ptr<u8> file: new u8[16384];
	int size: 0;

	log '\n';
	call ShowFile: 'README.TXT';
	log '\nPHI terminal. Type help for the commands.\n';
	call OS.SetupInteruptTimer;

	while true
		log '> ';
		ask line;
		log '\n';

		if line is 'help'
			log 'help    this list\n';
			log 'ls      the files on the disk (ls docs for a folder)\n';
			log 'cat F   print the file F\n';
			log 'run P   run the program P (try run hello.bin, run count.bin)\n';
			log 'time    the date and time (UTC)\n';
			log 'uptime  seconds since the kernel started\n';
			log 'crash   divide by zero\n';
		;;
		elif line is 'time'
			log Rtc.year '-' Rtc.month '-' Rtc.day ' ' Rtc.hour ':' Rtc.minute ':' Rtc.second ' UTC\n';
		;;
		elif line is 'uptime'
			u32 ms: 0;
			call ms is OS.GetTicks;
			log ms / 1000 ' seconds\n';
		;;
		elif line is 'ls'
			call size is Fat.List: '';
		;;
		elif line:0 is 'l' and line:1 is 's' and line:2 is ' '
			ptr<u8> folder: line;
			folder++ 3;
			call size is Fat.List: folder;
		;;
		elif line:0 is 'c' and line:1 is 'a' and line:2 is 't' and line:3 is ' '
			ptr<u8> name: line;
			name++ 4;
			call ShowFile: name;
		;;
		elif line:0 is 'r' and line:1 is 'u' and line:2 is 'n' and line:3 is ' '
			ptr<u8> program: line;
			program++ 4;
			int pid: 0;
			call pid is Process.Spawn: program;
			if pid < 0
				log 'no such program: ' program '\n';
			;;
			else
				int code: 0;
				call code is Process.Wait: pid;
				log '[program ' pid ' exited with ' code ']\n';
			;;
		;;
		elif line is 'crash'
			int zero: 0;
			int boom: 1 / zero;
		;;
		elif line is not ''
			log 'unknown command: ' line '\n';
		;;
	;;

	[ShowFile: ptr<u8> path: 0;]
		call size is Fat.ReadFile: path file 16383;
		if size < 0
			log 'no such file: ' path '\n';
		;;
		else
			file:size is 0;
			log file;
		;;
	[end]

	# runs 60 times a second; redraws the clock when the second changes
	[OS.TimerEvent]
		call Rtc.Read;
		if Rtc.second is not lastSecond
			lastSecond is Rtc.second;
			call TwoDigits: 72 Rtc.hour;
			call Character: 74 ':';
			call TwoDigits: 75 Rtc.minute;
			call Character: 77 ':';
			call TwoDigits: 78 Rtc.second;
		;;
	[end]

	[TwoDigits: int column: 0; int n: 0;]
		screen:column is CLOCK_COLOR | ('0' + n / 10);
		screen:(column + 1) is CLOCK_COLOR | ('0' + n % 10);
	[end]

	[Character: int column: 0; u8 c: 0;]
		screen:column is CLOCK_COLOR | c;
	[end]
}
