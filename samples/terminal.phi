# A tiny terminal for a 32-bit kernel: type commands, with a clock in the corner.
#
#   phi run samples/terminal.phi
#
# The clock is drawn by the timer event (an interrupt, 60 times a second) using
# the RTC driver; typing goes through the keyboard driver. 'crash' divides by
# zero to show the panic screen.

use drivers.rtc;

phi.Terminal:Kernel
{
	const u16 CLOCK_COLOR: 0x1F00;     # white on blue
	ptr<u16> screen: 0xB8000;
	int lastSecond: -1;
	str line: [60];

	log '\nPHI terminal. Type help for the commands.\n';
	call OS.SetupInteruptTimer;

	while true
		log '> ';
		ask line;
		log '\n';

		if line is 'help'
			log 'help    this list\n';
			log 'time    the date and time (UTC)\n';
			log 'uptime  seconds since the kernel started\n';
			log 'crash   divide by zero\n';
		;;
		elif line is 'time'
			log Rtc.year '-' Rtc.month '-' Rtc.day ' ' Rtc.hour ':' Rtc.minute ':' Rtc.second ' UTC\n';
		;;
		elif line is 'uptime'
			u32 ms: 0;
			call ms is OS.GetTicks;
			log ms / 1000 ' seconds\n';
		;;
		elif line is 'crash'
			int zero: 0;
			int boom: 1 / zero;
		;;
		elif line is not ''
			log 'unknown command: ' line '\n';
		;;
	;;

	# runs 60 times a second; redraws the clock when the second changes
	[OS.TimerEvent]
		call Rtc.Read;
		if Rtc.second is not lastSecond
			lastSecond is Rtc.second;
			call TwoDigits: 72 Rtc.hour;
			call Character: 74 ':';
			call TwoDigits: 75 Rtc.minute;
			call Character: 77 ':';
			call TwoDigits: 78 Rtc.second;
		;;
	[end]

	[TwoDigits: int column: 0; int n: 0;]
		screen:column is CLOCK_COLOR | ('0' + n / 10);
		screen:(column + 1) is CLOCK_COLOR | ('0' + n % 10);
	[end]

	[Character: int column: 0; u8 c: 0;]
		screen:column is CLOCK_COLOR | c;
	[end]
}
