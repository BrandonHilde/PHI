# A window through SDL3: a square bouncing round it until the window is closed or Escape is
# pressed; the arrow keys push it. SDL3 comes with PHI, in the vendor folder: use vendor.sdl3;
# brings in all of it, and a build puts the library beside the program. The same source is a
# Windows program and a macOS one (and a Linux one, with the system's SDL3 installed).
#
#   phi run samples/sdl3/bounce.phi --target macos        (or windows64, windows)
use vendor.sdl3;

phi.Bounce:Program
{
	ptr<SDL_Window> window: 0;
	ptr<SDL_Renderer> renderer: 0;
	SDL_FRect square;
	SDL_Event event;
	f32 dx: 3;
	f32 dy: 2;
	bln running: true;
	int frames: 0;

	if not (SDL.Init: SDL.INIT_VIDEO)
		log 'SDL: ' (SDL.GetError) '\n';
		exit 1;
	;;
	if not (SDL.CreateWindowAndRenderer: 'PHI and SDL3' 640 400 0 addr window addr renderer)
		log 'SDL: ' (SDL.GetError) '\n';
		exit 1;
	;;
	bln ok: (SDL.SetRenderVSync: renderer 1);
	square.x is 100;
	square.y is 80;
	square.w is 48;
	square.h is 48;

	while running
		while (SDL.PollEvent: addr event)
			if event.type is SDL.EVENT_QUIT
				running is false;
			;;
			if event.type is SDL.EVENT_KEY_DOWN
				ptr<SDL_KeyboardEvent> key: addr event as ptr<SDL_KeyboardEvent>;
				call Key: key.scancode;
			;;
		;;
		call Step;
		ok is (SDL.SetRenderDrawColor: renderer 24 28 48 255);
		ok is (SDL.RenderClear: renderer);
		ok is (SDL.SetRenderDrawColor: renderer 255 170 40 255);
		ok is (SDL.RenderFillRect: renderer addr square);
		ok is (SDL.SetRenderDrawColor: renderer 255 255 255 255);
		ok is (SDL.RenderDebugText: renderer 12 12 'arrows push it, Escape ends');
		ok is (SDL.RenderPresent: renderer);
		frames++;
	;;
	log frames ' frames\n';
	call SDL.DestroyRenderer: renderer;
	call SDL.DestroyWindow: window;
	call SDL.Quit;
	exit 0;

	[Key: int scancode;]
		if scancode is SDL.SCANCODE_ESCAPE
			running is false;
		;;
		if scancode is SDL.SCANCODE_RIGHT
			dx++ 1;
		;;
		if scancode is SDL.SCANCODE_LEFT
			dx-- 1;
		;;
		if scancode is SDL.SCANCODE_DOWN
			dy++ 1;
		;;
		if scancode is SDL.SCANCODE_UP
			dy-- 1;
		;;
	[end]

	[Step]
		square.x is square.x + dx;
		square.y is square.y + dy;
		if square.x < 0 or square.x > 592
			dx is 0 - dx;
			square.x is square.x + dx;
		;;
		if square.y < 0 or square.y > 352
			dy is 0 - dy;
			square.y is square.y + dy;
		;;
	[end]
}
