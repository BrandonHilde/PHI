	const int SCANSTAT_NVISIT: 1;
	const int SCANSTAT_EST: 2;
	const int SCANSTAT_NAME: 3;
	const int SCANSTAT_EXPLAIN: 4;
	const int SCANSTAT_SELECTID: 5;
	const int SCANSTAT_PARENTID: 6;
	const int SCANSTAT_NCYCLE: 7;
	const int SCANSTAT_COMPLEX: 1;
	const int SERIALIZE_NOCOPY: 1;    # Do no memory allocations
	const int DESERIALIZE_FREEONCLOSE: 1;    # Call sqlite3_free() on close
	const int DESERIALIZE_RESIZEABLE: 2;    # Resize using sqlite3_realloc64()
	const int DESERIALIZE_READONLY: 4;    # Database is read-only
	const int CARRAY_INT32: 0;    # Data is 32-bit signed integers
	const int CARRAY_INT64: 1;    # Data is 64-bit signed integers
	const int CARRAY_DOUBLE: 2;    # Data is doubles
	const int CARRAY_TEXT: 3;    # Data is char*
	const int CARRAY_BLOB: 4;    # Data is struct iovec
	const int CARRAY_INT32_: 0;    # Data is 32-bit signed integers
	const int CARRAY_INT64_: 1;    # Data is 64-bit signed integers
	const int CARRAY_DOUBLE_: 2;    # Data is doubles
	const int CARRAY_TEXT_: 3;    # Data is char*
	const int CARRAY_BLOB_: 4;    # Data is struct iovec
	const int NOT_WITHIN: 0;    # Object completely outside of query region
	const int PARTLY_WITHIN: 1;    # Object partially overlaps query region
	const int FULLY_WITHIN: 2;    # Object fully contained within query region
	const int FTS5_TOKENIZE_QUERY: 1;
	const int FTS5_TOKENIZE_PREFIX: 2;
	const int FTS5_TOKENIZE_DOCUMENT: 4;
	const int FTS5_TOKENIZE_AUX: 8;
	const int FTS5_TOKEN_COLOCATED: 1;    # Same position as prev. token


	# what a bind_text or bind_blob is told about the bytes it's given: STATIC, that they stay
	# as they are until the statement is done with; TRANSIENT, that SQLite is to copy them now
	# (in C an address of 0 and one of -1, which is what these hold)
	ptr<u8> STATIC: 0;
	ptr<u8> TRANSIENT: 0;
	TRANSIENT is TRANSIENT - 1;
}

