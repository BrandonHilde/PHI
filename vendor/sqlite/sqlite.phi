	const int STMTSTATUS_FILTER_MISS: 7;
	const int STMTSTATUS_FILTER_HIT: 8;
	const int STMTSTATUS_MEMUSED: 99;
	const int CHECKPOINT_NOOP: -1;    # Do no work at all
	const int CHECKPOINT_PASSIVE: 0;    # Do as much as possible w/o blocking
	const int CHECKPOINT_FULL: 1;    # Wait for writers, then checkpoint
	const int CHECKPOINT_RESTART: 2;    # Like FULL but wait for readers
	const int CHECKPOINT_TRUNCATE: 3;    # Like RESTART but also truncate WAL
	const int VTAB_CONSTRAINT_SUPPORT: 1;
	const int VTAB_INNOCUOUS: 2;
	const int VTAB_DIRECTONLY: 3;
	const int VTAB_USES_ALL_SCHEMAS: 4;
	const int ROLLBACK: 1;
	const int FAIL: 3;
	const int REPLACE: 5;
