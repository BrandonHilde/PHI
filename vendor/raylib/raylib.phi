Ray.DrawLineStrip: ptr<Vector2> points int pointCount Color color;    # Draw lines sequence (using gl lines)
Ray.DrawLineBezier: Vector2 startPos Vector2 endPos f32 thick Color color;    # Draw line segment cubic-bezier in-out interpolation
Ray.DrawLineDashed: Vector2 startPos Vector2 endPos int dashSize int spaceSize Color color;    # Draw a dashed line
Ray.DrawTriangle: Vector2 v1 Vector2 v2 Vector2 v3 Color color;    # Draw a color-filled triangle, counter-clockwise vertex order
Ray.DrawTriangleGradient: Vector2 v1 Vector2 v2 Vector2 v3 Color c1 Color c2 Color c3;    # Draw triangle with interpolated colors, counter-clockwise vertex/color order
Ray.DrawTriangleLines: Vector2 v1 Vector2 v2 Vector2 v3 Color color;    # Draw triangle outline, counter-clockwise vertex order
Ray.DrawTriangleLinesEx: Vector2 v1 Vector2 v2 Vector2 v3 f32 thick Color color;    # Draw triangle outline with line thickness, counter-clockwise vertex order
Ray.DrawTriangleFan: ptr<Vector2> points int pointCount Color color;    # Draw a triangle fan defined by points (first vertex is the center)
Ray.DrawTriangleStrip: ptr<Vector2> points int pointCount Color color;    # Draw a triangle strip defined by points
Ray.DrawRectangle: int posX int posY int width int height Color color;    # Draw a color-filled rectangle
Ray.DrawRectangleV: Vector2 position Vector2 size Color color;    # Draw a color-filled rectangle (Vector version)
Ray.DrawRectangleRec: Rectangle rec Color color;    # Draw a color-filled rectangle
Ray.DrawRectanglePro: Rectangle rec Vector2 origin f32 rotation Color color;    # Draw a color-filled rectangle with pro parameters
Ray.DrawRectangleGradientV: int posX int posY int width int height Color top Color bottom;    # Draw a vertical-gradient-filled rectangle
Ray.DrawRectangleGradientH: int posX int posY int width int height Color left Color right;    # Draw a horizontal-gradient-filled rectangle
Ray.DrawRectangleGradientEx: Rectangle rec Color col1 Color col2 Color col3 Color col4;    # Draw a gradient-filled rectangle with custom vertex colors, counter-clockwise color order
Ray.DrawRectangleLines: int posX int posY int width int height Color color;    # Draw rectangle outline
Ray.DrawRectangleLinesEx: Rectangle rec f32 thick Color color;    # Draw rectangle outline with line thickness
Ray.DrawRectangleRounded: Rectangle rec f32 roundness int segments Color color;    # Draw rectangle with rounded edges
Ray.DrawRectangleRoundedLines: Rectangle rec f32 roundness int segments Color color;    # Draw rectangle lines with rounded edges
Ray.DrawRectangleRoundedLinesEx: Rectangle rec f32 roundness int segments f32 thick Color color;    # Draw rectangle lines with rounded edges outline and line thickness
Ray.DrawPoly: Vector2 center int sides f32 radius f32 rotation Color color;    # Draw a polygon of n sides
Ray.DrawPolyLines: Vector2 center int sides f32 radius f32 rotation Color color;    # Draw a polygon outline of n sides
Ray.DrawPolyLinesEx: Vector2 center int sides f32 radius f32 rotation f32 thick Color color;    # Draw a polygon outline of n sides with line thickness
Ray.DrawCircle: int centerX int centerY f32 radius Color color;    # Draw a color-filled circle
Ray.DrawCircleV: Vector2 center f32 radius Color color;    # Draw a color-filled circle (Vector version)
Ray.DrawCircleGradient: Vector2 center f32 radius Color inner Color outer;    # Draw a gradient-filled circle
Ray.DrawCircleSector: Vector2 center f32 radius f32 startAngle f32 endAngle int segments Color color;    # Draw a piece of a circle
Ray.DrawCircleSectorLines: Vector2 center f32 radius f32 startAngle f32 endAngle int segments Color color;    # Draw circle sector outline
Ray.DrawCircleSectorLinesEx: Vector2 center f32 radius f32 startAngle f32 endAngle int segments f32 thick Color color;    # Draw circle sector outline with thickness
Ray.DrawCircleLines: int centerX int centerY f32 radius Color color;    # Draw circle outline
Ray.DrawCircleLinesV: Vector2 center f32 radius Color color;    # Draw circle outline (Vector version)
Ray.DrawCircleLinesEx: Vector2 center f32 radius f32 thick Color color;    # Draw circle outline with line thickness
Ray.DrawEllipse: int centerX int centerY f32 radiusH f32 radiusV Color color;    # Draw ellipse
Ray.DrawEllipseV: Vector2 center f32 radiusH f32 radiusV Color color;    # Draw ellipse (Vector version)
Ray.DrawEllipseLines: int centerX int centerY f32 radiusH f32 radiusV Color color;    # Draw ellipse outline
Ray.DrawEllipseLinesV: Vector2 center f32 radiusH f32 radiusV Color color;    # Draw ellipse outline (Vector version)
Ray.DrawEllipseLinesEx: Vector2 center f32 radiusH f32 radiusV f32 thick Color color;    # Draw ellipse outline with line thickness
Ray.DrawRing: Vector2 center f32 innerRadius f32 outerRadius f32 startAngle f32 endAngle int segments Color color;    # Draw ring
Ray.DrawRingLines: Vector2 center f32 innerRadius f32 outerRadius f32 startAngle f32 endAngle int segments Color color;    # Draw ring outline
Ray.DrawRingLinesEx: Vector2 center f32 innerRadius f32 outerRadius f32 startAngle f32 endAngle int segments f32 thick Color color;    # Draw ring outline with line thickness
Ray.DrawSplineLinear: ptr<Vector2> points int pointCount f32 thick Color color;    # Draw spline: Linear, minimum 2 points
Ray.DrawSplineBasis: ptr<Vector2> points int pointCount f32 thick Color color;    # Draw spline: B-Spline, minimum 4 points
Ray.DrawSplineCatmullRom: ptr<Vector2> points int pointCount f32 thick Color color;    # Draw spline: Catmull-Rom, minimum 4 points
Ray.DrawSplineBezierQuadratic: ptr<Vector2> points int pointCount f32 thick Color color;    # Draw spline: Quadratic Bezier, minimum 3 points (1 control point): [p1, c2, p3, c4...]
Ray.DrawSplineBezierCubic: ptr<Vector2> points int pointCount f32 thick Color color;    # Draw spline: Cubic Bezier, minimum 4 points (2 control points): [p1, c2, c3, p4, c5, c6...]
Ray.DrawSplineSegmentLinear: Vector2 p1 Vector2 p2 f32 thick Color color;    # Draw spline segment: Linear, 2 points
Ray.DrawSplineSegmentBasis: Vector2 p1 Vector2 p2 Vector2 p3 Vector2 p4 f32 thick Color color;    # Draw spline segment: B-Spline, 4 points
Ray.DrawSplineSegmentCatmullRom: Vector2 p1 Vector2 p2 Vector2 p3 Vector2 p4 f32 thick Color color;    # Draw spline segment: Catmull-Rom, 4 points
Ray.DrawSplineSegmentBezierQuadratic: Vector2 p1 Vector2 c2 Vector2 p3 f32 thick Color color;    # Draw spline segment: Quadratic Bezier, 2 points, 1 control point
Ray.DrawSplineSegmentBezierCubic: Vector2 p1 Vector2 c2 Vector2 c3 Vector2 p4 f32 thick Color color;    # Draw spline segment: Cubic Bezier, 2 points, 2 control points
