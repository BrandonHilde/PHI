	const int CAMERA_ORBITAL: 2;    # Camera orbital, around target, zoom supported
	const int CAMERA_FIRST_PERSON: 3;    # Camera first person
	const int CAMERA_THIRD_PERSON: 4;    # Camera third person

	# CameraProjection
