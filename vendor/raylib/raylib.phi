struct.rAudioBuffer foreign    # only ever held by its address: what's in it is raylib's own
{
	int opaque;
}

struct.rAudioProcessor foreign    # only ever held by its address: what's in it is raylib's own
{
	int opaque;
}

struct.Vector2 foreign
{
	f32 x;
	f32 y;
}

struct.Vector3 foreign
{
	f32 x;
	f32 y;
	f32 z;
}

struct.Vector4 foreign
{
	f32 x;
	f32 y;
	f32 z;
	f32 w;
}

struct.Matrix foreign
{
	f32 m0;
	f32 m4;
	f32 m8;
	f32 m12;
	f32 m1;
	f32 m5;
	f32 m9;
	f32 m13;
	f32 m2;
	f32 m6;
	f32 m10;
	f32 m14;
	f32 m3;
	f32 m7;
	f32 m11;
	f32 m15;
}

struct.Color foreign
{
	u8 r;
	u8 g;
	u8 b;
	u8 a;
}

struct.Rectangle foreign
{
	f32 x;
	f32 y;
	f32 width;
	f32 height;
}

struct.Image foreign
{
	ptr<u8> data;
	int width;
	int height;
	int mipmaps;
	int format;
}

struct.Texture foreign
{
	u32 id;
	int width;
	int height;
	int mipmaps;
	int format;
}

struct.RenderTexture foreign
{
	u32 id;
	Texture texture;
	Texture depth;
}

struct.NPatchInfo foreign
{
	Rectangle source;
	int left;
	int top;
	int right;
	int bottom;
	int layout;
}

struct.GlyphInfo foreign
{
	int value;
	int offsetX;
	int offsetY;
	int advanceX;
	Image image;
}

struct.Font foreign
{
	int baseSize;
	int glyphCount;
	int glyphPadding;
	Texture texture;
	ptr<Rectangle> recs;
	ptr<GlyphInfo> glyphs;
}

struct.Camera3D foreign
{
	Vector3 position;
	Vector3 target;
	Vector3 up;
	f32 fovy;
	int projection;
}

struct.Camera2D foreign
{
	Vector2 offset;
	Vector2 target;
	f32 rotation;
	f32 zoom;
}

struct.Mesh foreign
{
	int vertexCount;
	int triangleCount;
	ptr<f32> vertices;
	ptr<f32> texcoords;
	ptr<f32> texcoords2;
	ptr<f32> normals;
	ptr<f32> tangents;
	ptr<u8> colors;
	ptr<u16> indices;
	int boneCount;
	ptr<u8> boneIndices;
	ptr<f32> boneWeights;
	ptr<f32> animVertices;
	ptr<f32> animNormals;
	u32 vaoId;
	ptr<u32> vboId;
}

struct.Shader foreign
{
	u32 id;
	ptr<int> locs;
}

struct.MaterialMap foreign
{
	Texture texture;
	Color color;
	f32 value;
}

struct.Material foreign
{
	Shader shader;
	ptr<MaterialMap> maps;
	f32 params[4];
}

struct.Transform foreign
{
	Vector3 translation;
	Vector4 rotation;
	Vector3 scale;
}

struct.BoneInfo foreign
{
	u8 name[32];
	int parent;
}

struct.ModelSkeleton foreign
{
	u32 boneCount;
	ptr<BoneInfo> bones;
	ptr<Transform> bindPose;
}

struct.Model foreign
{
	Matrix transform;
	int meshCount;
	int materialCount;
	ptr<Mesh> meshes;
	ptr<Material> materials;
	ptr<int> meshMaterial;
	ModelSkeleton skeleton;
	ptr<Transform> currentPose;
	ptr<Matrix> boneMatrices;
}

struct.ModelAnimation foreign
{
	u8 name[32];
	u32 boneCount;
	int keyframeCount;
	ptr<ptr<Transform>> keyframePoses;
}

struct.Ray foreign
{
	Vector3 position;
	Vector3 direction;
}

struct.RayCollision foreign
{
	bln hit;
	f32 distance;
	Vector3 point;
	Vector3 normal;
}

struct.BoundingBox foreign
{
	Vector3 min;
	Vector3 max;
}

struct.Wave foreign
{
	u32 frameCount;
	u32 sampleRate;
	u32 sampleSize;
	u32 channels;
	ptr<u8> data;
}

struct.AudioStream foreign
{
	ptr<rAudioBuffer> buffer;
	ptr<rAudioProcessor> processor;
	u32 sampleRate;
	u32 sampleSize;
	u32 channels;
}

struct.Sound foreign
{
	AudioStream stream;
	u32 frameCount;
}

struct.Music foreign
{
	AudioStream stream;
	u32 frameCount;
	bln looping;
	int ctxType;
	ptr<u8> ctxData;
}

struct.VrDeviceInfo foreign
{
	int hResolution;
	int vResolution;
	f32 hScreenSize;
	f32 vScreenSize;
	f32 eyeToScreenDistance;
	f32 lensSeparationDistance;
	f32 interpupillaryDistance;
	f32 lensDistortionValues[4];
	f32 chromaAbCorrection[4];
}

struct.VrStereoConfig foreign
{
	Matrix projection[2];
	Matrix viewOffset[2];
	f32 leftLensCenter[2];
	f32 rightLensCenter[2];
	f32 leftScreenCenter[2];
	f32 rightScreenCenter[2];
	f32 scale[2];
	f32 scaleIn[2];
}

struct.FilePathList foreign
{
	u32 count;
	ptr<ptr<u8>> paths;
}

struct.AutomationEvent foreign
{
	u32 frame;
	u32 type;
	int params[4];
}

struct.AutomationEventList foreign
{
	u32 capacity;
	u32 count;
	ptr<AutomationEvent> events;
}

struct.float3 foreign
{
	f32 v[3];
}

struct.float16 foreign
{
	f32 v[16];
}

struct.Quaternion is Vector4;
struct.Texture2D is Texture;
struct.TextureCubemap is Texture;
struct.RenderTexture2D is RenderTexture;
struct.Camera is Camera3D;

Ray.InitWindow: int width int height ptr<u8> title;    # Initialize window and OpenGL context
Ray.CloseWindow;    # Close window and unload OpenGL context
Ray.WindowShouldClose: : bln;    # Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
Ray.IsWindowReady: : bln;    # Check if window has been initialized successfully
Ray.IsWindowFullscreen: : bln;    # Check if window is currently fullscreen
Ray.IsWindowHidden: : bln;    # Check if window is currently hidden
Ray.IsWindowMinimized: : bln;    # Check if window is currently minimized
Ray.IsWindowMaximized: : bln;    # Check if window is currently maximized
Ray.IsWindowFocused: : bln;    # Check if window is currently focused
Ray.IsWindowResized: : bln;    # Check if window has been resized last frame
Ray.IsWindowState: u32 flag: bln;    # Check if one specific window flag is enabled
Ray.SetWindowState: u32 flags;    # Set window configuration state using flags
Ray.ClearWindowState: u32 flags;    # Clear window configuration state flags
Ray.ToggleFullscreen;    # Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
Ray.ToggleBorderlessWindowed;    # Toggle window state: borderless windowed, resizes window to match monitor resolution
Ray.MaximizeWindow;    # Set window state: maximized, if resizable
Ray.MinimizeWindow;    # Set window state: minimized, if resizable
Ray.RestoreWindow;    # Restore window from being minimized/maximized
Ray.SetWindowIcon: Image image;    # Set icon for window (single image, RGBA 32bit)
Ray.SetWindowIcons: ptr<Image> images int count;    # Set icon for window (multiple images, RGBA 32bit)
Ray.SetWindowTitle: ptr<u8> title;    # Set title for window
Ray.SetWindowPosition: int x int y;    # Set window position on screen
Ray.SetWindowMonitor: int monitor;    # Set monitor for the current window
Ray.SetWindowMinSize: int width int height;    # Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
Ray.SetWindowMaxSize: int width int height;    # Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
Ray.SetWindowSize: int width int height;    # Set window dimensions
Ray.SetWindowOpacity: f32 opacity;    # Set window opacity [0.0f..1.0f]
Ray.SetWindowFocused;    # Set window focused
Ray.GetWindowHandle: : ptr<u8>;    # Get native window handle
Ray.GetScreenWidth: : int;    # Get current screen width
Ray.GetScreenHeight: : int;    # Get current screen height
Ray.GetRenderWidth: : int;    # Get current render width (it considers HiDPI)
Ray.GetRenderHeight: : int;    # Get current render height (it considers HiDPI)
Ray.GetMonitorCount: : int;    # Get number of connected monitors
Ray.GetCurrentMonitor: : int;    # Get current monitor where window is placed
Ray.GetMonitorPosition: int monitor: Vector2;    # Get specified monitor position
Ray.GetMonitorWidth: int monitor: int;    # Get specified monitor width (current video mode used by monitor)
Ray.GetMonitorHeight: int monitor: int;    # Get specified monitor height (current video mode used by monitor)
Ray.GetMonitorPhysicalWidth: int monitor: int;    # Get specified monitor physical width in millimetres
Ray.GetMonitorPhysicalHeight: int monitor: int;    # Get specified monitor physical height in millimetres
Ray.GetMonitorRefreshRate: int monitor: int;    # Get specified monitor refresh rate
Ray.GetWindowPosition: : Vector2;    # Get window position XY on monitor
Ray.GetWindowScaleDPI: : Vector2;    # Get window scale DPI factor
Ray.GetMonitorName: int monitor: ptr<u8>;    # Get the human-readable, UTF-8 encoded name of the specified monitor
Ray.SetClipboardText: ptr<u8> text;    # Set clipboard text content
Ray.GetClipboardText: : ptr<u8>;    # Get clipboard text content
Ray.GetClipboardImage: : Image;    # Get clipboard image content
Ray.EnableEventWaiting;    # Enable waiting for events on EndDrawing(), no automatic event polling
Ray.DisableEventWaiting;    # Disable waiting for events on EndDrawing(), automatic events polling
Ray.ShowCursor;    # Show cursor
Ray.HideCursor;    # Hide cursor
Ray.IsCursorHidden: : bln;    # Check if cursor is not visible
Ray.EnableCursor;    # Enable cursor (unlock cursor)
Ray.DisableCursor;    # Disable cursor (lock cursor)
Ray.IsCursorOnScreen: : bln;    # Check if cursor is on the screen
Ray.ClearBackground: Color color;    # Clear background (framebuffer) to color
Ray.BeginDrawing;    # Begin canvas (framebuffer) drawing
Ray.EndDrawing;    # End canvas (framebuffer) drawing and swap buffers (double buffering)
Ray.BeginMode2D: Camera2D camera;    # Begin 2D mode with custom camera (2D)
Ray.EndMode2D;    # End 2D mode with custom camera
Ray.BeginMode3D: Camera3D camera;    # Begin 3D mode with custom camera (3D)
Ray.EndMode3D;    # End 3D mode and returns to default 2D orthographic mode
Ray.BeginTextureMode: RenderTexture target;    # Begin drawing to render texture
Ray.EndTextureMode;    # End drawing to render texture
Ray.BeginShaderMode: Shader shader;    # Begin custom shader drawing
Ray.EndShaderMode;    # End custom shader drawing (use default shader)
Ray.BeginBlendMode: int mode;    # Begin blending mode (alpha, additive, multiplied, subtract, custom)
Ray.EndBlendMode;    # End blending mode (reset to default: alpha blending)
Ray.BeginScissorMode: int x int y int width int height;    # Begin scissor mode (define screen area for following drawing)
Ray.EndScissorMode;    # End scissor mode
Ray.BeginVrStereoMode: VrStereoConfig config;    # Begin stereo rendering (requires VR simulator)
Ray.EndVrStereoMode;    # End stereo rendering (requires VR simulator)
Ray.LoadVrStereoConfig: VrDeviceInfo device: VrStereoConfig;    # Load VR stereo config for VR simulator device parameters
Ray.UnloadVrStereoConfig: VrStereoConfig config;    # Unload VR stereo config
Ray.LoadShader: ptr<u8> vsFileName ptr<u8> fsFileName: Shader;    # Load shader from files and bind default locations
Ray.LoadShaderFromMemory: ptr<u8> vsCode ptr<u8> fsCode: Shader;    # Load shader from code strings and bind default locations
Ray.IsShaderValid: Shader shader: bln;    # Check if shader is valid (loaded on GPU)
Ray.GetShaderLocation: Shader shader ptr<u8> uniformName: int;    # Get shader uniform location
Ray.GetShaderLocationAttrib: Shader shader ptr<u8> attribName: int;    # Get shader attribute location
Ray.SetShaderValue: Shader shader int locIndex ptr<u8> value int uniformType;    # Set shader uniform value
Ray.SetShaderValueV: Shader shader int locIndex ptr<u8> value int uniformType int count;    # Set shader uniform value vector
Ray.SetShaderValueMatrix: Shader shader int locIndex Matrix mat;    # Set shader uniform value (matrix 4x4)
Ray.SetShaderValueTexture: Shader shader int locIndex Texture texture;    # Set shader uniform value and bind the texture (sampler2d)
Ray.UnloadShader: Shader shader;    # Unload shader from GPU memory (VRAM)
Ray.GetScreenToWorldRay: Vector2 position Camera3D camera: Ray;    # Get a ray trace from screen position (i.e mouse)
Ray.GetScreenToWorldRayEx: Vector2 position Camera3D camera int width int height: Ray;    # Get a ray trace from screen position (i.e mouse) in a viewport
Ray.GetWorldToScreen: Vector3 position Camera3D camera: Vector2;    # Get screen space position for a 3d world space position
Ray.GetWorldToScreenEx: Vector3 position Camera3D camera int width int height: Vector2;    # Get sized screen space position for a 3d world space position
Ray.GetWorldToScreen2D: Vector2 position Camera2D camera: Vector2;    # Get screen space position for a 2d camera world space position
Ray.GetScreenToWorld2D: Vector2 position Camera2D camera: Vector2;    # Get world space position for a 2d camera screen space position
Ray.GetCameraMatrix: Camera3D camera: Matrix;    # Get camera transform matrix (view matrix)
Ray.GetCameraMatrix2D: Camera2D camera: Matrix;    # Get camera 2d transform matrix
Ray.SetTargetFPS: int fps;    # Set target FPS (maximum)
Ray.GetFrameTime: : f32;    # Get time in seconds for last frame drawn (delta time)
Ray.GetTime: : f64;    # Get elapsed time in seconds since InitWindow()
Ray.GetFPS: : int;    # Get current FPS
Ray.SwapScreenBuffer;    # Swap back buffer with front buffer (screen drawing)
Ray.PollInputEvents;    # Register all input events
Ray.WaitTime: f64 seconds;    # Wait for some time (halt program execution)
Ray.SetRandomSeed: u32 seed;    # Set the seed for the random number generator
Ray.GetRandomValue: int min int max: int;    # Get a random value between min and max (both included)
Ray.LoadRandomSequence: u32 count int min int max: ptr<int>;    # Load random values sequence, no values repeated
Ray.UnloadRandomSequence: ptr<int> sequence;    # Unload random values sequence
Ray.TakeScreenshot: ptr<u8> fileName;    # Takes a screenshot of current screen (filename extension defines format)
Ray.SetConfigFlags: u32 flags;    # Set init configuration flags (view FLAGS)
Ray.OpenURL: ptr<u8> url;    # Open URL with default system browser (if available)
Ray.SetTraceLogLevel: int logLevel;    # Set the current threshold (minimum) log level
Ray.TraceLog: int logLevel ptr<u8> text ...;    # Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
Ray.SetTraceLogCallback: ptr<u8> callback;    # Set custom trace log
Ray.MemAlloc: u32 size: ptr<u8>;    # Internal memory allocator
Ray.MemRealloc: ptr<u8> ptr_ u32 size: ptr<u8>;    # Internal memory reallocator
Ray.MemFree: ptr<u8> ptr_;    # Internal memory free
Ray.LoadFileData: ptr<u8> fileName ptr<int> dataSize: ptr<u8>;    # Load file data as byte array (read)
Ray.UnloadFileData: ptr<u8> data;    # Unload file data allocated by LoadFileData()
Ray.SaveFileData: ptr<u8> fileName ptr<u8> data int dataSize: bln;    # Save data to file from byte array (write), returns true on success
Ray.ExportDataAsCode: ptr<u8> data int dataSize ptr<u8> fileName: bln;    # Export data to code (.h), returns true on success
Ray.LoadFileText: ptr<u8> fileName: ptr<u8>;    # Load text data from file (read), returns a '\0' terminated string
Ray.UnloadFileText: ptr<u8> text;    # Unload file text data allocated by LoadFileText()
Ray.SaveFileText: ptr<u8> fileName ptr<u8> text: bln;    # Save text data to file (write), string must be '\0' terminated, returns true on success
Ray.SetLoadFileDataCallback: ptr<u8> callback;    # Set custom file binary data loader
Ray.SetSaveFileDataCallback: ptr<u8> callback;    # Set custom file binary data saver
Ray.SetLoadFileTextCallback: ptr<u8> callback;    # Set custom file text data loader
Ray.SetSaveFileTextCallback: ptr<u8> callback;    # Set custom file text data saver
Ray.FileRename: ptr<u8> fileName ptr<u8> fileRename: int;    # Rename file (if exists), returns 0 on success
Ray.FileRemove: ptr<u8> fileName: int;    # Remove file (if exists), returns 0 on success
Ray.FileCopy: ptr<u8> srcPath ptr<u8> dstPath: int;    # Copy file from one path to another, dstPath created if it doesn't exist, returns 0 on success
Ray.FileMove: ptr<u8> srcPath ptr<u8> dstPath: int;    # Move file from one directory to another, dstPath created if it doesn't exist, returns 0 on success
Ray.FileTextReplace: ptr<u8> fileName ptr<u8> search ptr<u8> replacement: int;    # Replace text in an existing file, returns 0 on success
Ray.FileTextFindIndex: ptr<u8> fileName ptr<u8> search: int;    # Find text in existing file, returns -1 if index not found or index otherwise
Ray.FileExists: ptr<u8> fileName: bln;    # Check if file exists
Ray.DirectoryExists: ptr<u8> dirPath: bln;    # Check if directory path exists
Ray.IsFileExtension: ptr<u8> fileName ptr<u8> ext: bln;    # Check file extension (recommended include point: .png, .wav)
Ray.IsFileHidden: ptr<u8> filePath: bln;    # Check if file path (file or directory) is hidden by OS
Ray.GetFileLength: ptr<u8> fileName: int;    # Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
Ray.GetFileModTime: ptr<u8> fileName: lng;    # Get file modification time (last write time)
Ray.GetFileExtension: ptr<u8> fileName: ptr<u8>;    # Get pointer to extension for a filename string (includes dot: '.png')
Ray.GetFileName: ptr<u8> filePath: ptr<u8>;    # Get pointer to filename for a path string
Ray.GetFileNameWithoutExt: ptr<u8> filePath: ptr<u8>;    # Get filename string without extension (uses static string)
Ray.GetDirectoryPath: ptr<u8> filePath: ptr<u8>;    # Get full path for a provided fileName with path (uses static string)
Ray.GetPrevDirectoryPath: ptr<u8> dirPath: ptr<u8>;    # Get previous directory path for a provided path (uses static string)
Ray.GetWorkingDirectory: : ptr<u8>;    # Get current working directory (uses static string)
Ray.GetApplicationDirectory: : ptr<u8>;    # Get the directory of the running application (uses static string)
Ray.MakeDirectory: ptr<u8> dirPath: int;    # Create directories (including full path requested), returns 0 on success
Ray.ChangeDirectory: ptr<u8> dirPath: int;    # Change working directory, returns 0 on success
Ray.IsPathFile: ptr<u8> path: bln;    # Check if provided path points to a file
Ray.IsPathDirectory: ptr<u8> path: bln;    # Check if provided path points to a directory
Ray.IsPathAbsolute: ptr<u8> path: bln;    # Check if provided path is an absolute path
Ray.IsFileNameValid: ptr<u8> fileName: bln;    # Check if fileName is valid for the platform/OS
Ray.LoadDirectoryFiles: ptr<u8> dirPath: FilePathList;    # Load directory filepaths, files and directories, no subdirs scan
Ray.LoadDirectoryFilesEx: ptr<u8> basePath ptr<u8> filter bln scanSubdirs: FilePathList;    # Load directory filepaths with extension filtering and subdir scan; some filters available: '*.*','FILES*','DIRS*'
Ray.UnloadDirectoryFiles: FilePathList files;    # Unload filepaths
Ray.IsFileDropped: : bln;    # Check if file has been dropped into window
Ray.LoadDroppedFiles: : FilePathList;    # Load dropped filepaths
Ray.UnloadDroppedFiles: FilePathList files;    # Unload dropped filepaths
Ray.GetDirectoryFileCount: ptr<u8> dirPath: u32;    # Get the file count in a directory
Ray.GetDirectoryFileCountEx: ptr<u8> basePath ptr<u8> filter bln scanSubdirs: u32;    # Get the file count in a directory with extension filtering and recursive directory scan. Use 'DIR' in the filter string to include directories in the result
Ray.CompressData: ptr<u8> data int dataSize ptr<int> compDataSize: ptr<u8>;    # Compress data (DEFLATE algorithm), memory must be MemFree()
Ray.DecompressData: ptr<u8> compData int compDataSize ptr<int> dataSize: ptr<u8>;    # Decompress data (DEFLATE algorithm), memory must be MemFree()
Ray.EncodeDataBase64: ptr<u8> data int dataSize ptr<int> outputSize: ptr<u8>;    # Encode data to Base64 string (includes NULL terminator), memory must be MemFree()
Ray.DecodeDataBase64: ptr<u8> text ptr<int> outputSize: ptr<u8>;    # Decode Base64 string (expected NULL terminated), memory must be MemFree()
Ray.ComputeCRC32: ptr<u8> data int dataSize: u32;    # Compute CRC32 hash code
Ray.ComputeMD5: ptr<u8> data int dataSize: ptr<u32>;    # Compute MD5 hash code, returns static int[4] (16 bytes)
Ray.ComputeSHA1: ptr<u8> data int dataSize: ptr<u32>;    # Compute SHA1 hash code, returns static int[5] (20 bytes)
Ray.ComputeSHA256: ptr<u8> data int dataSize: ptr<u32>;    # Compute SHA256 hash code, returns static int[8] (32 bytes)
Ray.LoadAutomationEventList: ptr<u8> fileName: AutomationEventList;    # Load automation events list from file, NULL for empty list, capacity = MAX_AUTOMATION_EVENTS
Ray.UnloadAutomationEventList: AutomationEventList list;    # Unload automation events list from file
Ray.ExportAutomationEventList: AutomationEventList list ptr<u8> fileName: bln;    # Export automation events list as text file
Ray.SetAutomationEventList: ptr<AutomationEventList> list;    # Set automation event list to record to
Ray.SetAutomationEventBaseFrame: int frame;    # Set automation event internal base frame to start recording
Ray.StartAutomationEventRecording;    # Start recording automation events (AutomationEventList must be set)
Ray.StopAutomationEventRecording;    # Stop recording automation events
Ray.PlayAutomationEvent: AutomationEvent event;    # Play a recorded automation event
Ray.IsKeyPressed: int key: bln;    # Check if key has been pressed once
Ray.IsKeyPressedRepeat: int key: bln;    # Check if key has been pressed again
Ray.IsKeyDown: int key: bln;    # Check if key is being pressed
Ray.IsKeyReleased: int key: bln;    # Check if key has been released once
Ray.IsKeyUp: int key: bln;    # Check if key is NOT being pressed
Ray.GetKeyPressed: : int;    # Get key pressed (keycode), call it multiple times for keys queued, returns 0 when the queue is empty
Ray.GetCharPressed: : int;    # Get char pressed (unicode), call it multiple times for chars queued, returns 0 when the queue is empty
Ray.GetKeyName: int key: ptr<u8>;    # Get name of a QWERTY key on the current keyboard layout (eg returns string 'q' for KEY_A on an AZERTY keyboard)
Ray.SetExitKey: int key;    # Set a custom key to exit program (default is ESC)
Ray.IsGamepadAvailable: int gamepad: bln;    # Check if gamepad is available
Ray.GetGamepadName: int gamepad: ptr<u8>;    # Get gamepad internal name id
Ray.IsGamepadButtonPressed: int gamepad int button: bln;    # Check if gamepad button has been pressed once
Ray.IsGamepadButtonDown: int gamepad int button: bln;    # Check if gamepad button is being pressed
Ray.IsGamepadButtonReleased: int gamepad int button: bln;    # Check if gamepad button has been released once
Ray.IsGamepadButtonUp: int gamepad int button: bln;    # Check if gamepad button is NOT being pressed
Ray.GetGamepadButtonPressed: : int;    # Get the last gamepad button pressed
Ray.GetGamepadAxisCount: int gamepad: int;    # Get axis count for a gamepad
Ray.GetGamepadAxisMovement: int gamepad int axis: f32;    # Get movement value for a gamepad axis
Ray.SetGamepadMappings: ptr<u8> mappings: int;    # Set internal gamepad mappings (SDL_GameControllerDB)
Ray.SetGamepadVibration: int gamepad f32 leftMotor f32 rightMotor f32 duration;    # Set gamepad vibration for both motors (duration in seconds)
Ray.IsMouseButtonPressed: int button: bln;    # Check if mouse button has been pressed once
Ray.IsMouseButtonDown: int button: bln;    # Check if mouse button is being pressed
Ray.IsMouseButtonReleased: int button: bln;    # Check if mouse button has been released once
Ray.IsMouseButtonUp: int button: bln;    # Check if mouse button is NOT being pressed
Ray.GetMouseX: : int;    # Get mouse position X
Ray.GetMouseY: : int;    # Get mouse position Y
Ray.GetMousePosition: : Vector2;    # Get mouse position XY
Ray.GetMouseDelta: : Vector2;    # Get mouse delta between frames
Ray.SetMousePosition: int x int y;    # Set mouse position XY
Ray.SetMouseOffset: int offsetX int offsetY;    # Set mouse offset
Ray.SetMouseScale: f32 scaleX f32 scaleY;    # Set mouse scaling
Ray.GetMouseWheelMove: : f32;    # Get mouse wheel movement for X or Y, whichever is larger
Ray.GetMouseWheelMoveV: : Vector2;    # Get mouse wheel movement for both X and Y
Ray.SetMouseCursor: int cursor;    # Set mouse cursor
Ray.GetTouchX: : int;    # Get touch position X for touch point 0 (relative to screen size)
Ray.GetTouchY: : int;    # Get touch position Y for touch point 0 (relative to screen size)
Ray.GetTouchPosition: int index: Vector2;    # Get touch position XY for a touch point index (relative to screen size)
Ray.GetTouchPointId: int index: int;    # Get touch point identifier for provided index
Ray.GetTouchPointCount: : int;    # Get number of touch points
Ray.SetGesturesEnabled: u32 flags;    # Enable a set of gestures using flags
Ray.IsGestureDetected: u32 gesture: bln;    # Check if gesture has been detected
Ray.GetGestureDetected: : int;    # Get latest detected gesture
Ray.GetGestureHoldDuration: : f32;    # Get gesture hold time in seconds
Ray.GetGestureDragVector: : Vector2;    # Get gesture drag vector
Ray.GetGestureDragAngle: : f32;    # Get gesture drag angle
Ray.GetGesturePinchVector: : Vector2;    # Get gesture pinch delta
Ray.GetGesturePinchAngle: : f32;    # Get gesture pinch angle
Ray.UpdateCamera: ptr<Camera3D> camera int mode;    # Update camera position for selected mode
Ray.UpdateCameraPro: ptr<Camera3D> camera Vector3 movement Vector3 rotation f32 zoom;    # Update camera movement/rotation
Ray.SetShapesTexture: Texture texture Rectangle rec;    # Set texture and rectangle to be used on shapes drawing
Ray.GetShapesTexture: : Texture;    # Get texture that is used for shapes drawing
Ray.GetShapesTextureRectangle: : Rectangle;    # Get texture source rectangle that is used for shapes drawing
Ray.DrawPixel: int posX int posY Color color;    # Draw a pixel using geometry [Can be slow, use with care]
Ray.DrawPixelV: Vector2 position Color color;    # Draw a pixel using geometry (Vector version) [Can be slow, use with care]
Ray.DrawLine: int startPosX int startPosY int endPosX int endPosY Color color;    # Draw a line
Ray.DrawLineV: Vector2 startPos Vector2 endPos Color color;    # Draw a line (using gl lines)
