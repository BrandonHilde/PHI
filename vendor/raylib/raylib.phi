Ray.GetSplinePointBasis: Vector2 p1 Vector2 p2 Vector2 p3 Vector2 p4 f32 t: Vector2;    # Get (evaluate) spline point: B-Spline
Ray.GetSplinePointCatmullRom: Vector2 p1 Vector2 p2 Vector2 p3 Vector2 p4 f32 t: Vector2;    # Get (evaluate) spline point: Catmull-Rom
Ray.GetSplinePointBezierQuadratic: Vector2 p1 Vector2 c2 Vector2 p3 f32 t: Vector2;    # Get (evaluate) spline point: Quadratic Bezier
Ray.GetSplinePointBezierCubic: Vector2 p1 Vector2 c2 Vector2 c3 Vector2 p4 f32 t: Vector2;    # Get (evaluate) spline point: Cubic Bezier
Ray.CheckCollisionRecs: Rectangle rec1 Rectangle rec2: bln;    # Check collision between two rectangles
Ray.CheckCollisionCircles: Vector2 center1 f32 radius1 Vector2 center2 f32 radius2: bln;    # Check collision between two circles
Ray.CheckCollisionCircleRec: Vector2 center f32 radius Rectangle rec: bln;    # Check collision between circle and rectangle
Ray.CheckCollisionCircleLine: Vector2 center f32 radius Vector2 p1 Vector2 p2: bln;    # Check if circle collides with a line created between two points [p1] and [p2]
Ray.CheckCollisionPointRec: Vector2 point Rectangle rec: bln;    # Check if point is inside rectangle
Ray.CheckCollisionPointCircle: Vector2 point Vector2 center f32 radius: bln;    # Check if point is inside circle
Ray.CheckCollisionPointTriangle: Vector2 point Vector2 p1 Vector2 p2 Vector2 p3: bln;    # Check if point is inside a triangle
Ray.CheckCollisionPointLine: Vector2 point Vector2 p1 Vector2 p2 int threshold: bln;    # Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold]
Ray.CheckCollisionPointPoly: Vector2 point ptr<Vector2> points int pointCount: bln;    # Check if point is within a polygon described by array of vertices
Ray.CheckCollisionLines: Vector2 startPos1 Vector2 endPos1 Vector2 startPos2 Vector2 endPos2 ptr<Vector2> collisionPoint: bln;    # Check the collision between two lines defined by two points each, returns collision point by reference
Ray.GetCollisionRec: Rectangle rec1 Rectangle rec2: Rectangle;    # Get collision rectangle for two rectangles collision
Ray.LoadImage: ptr<u8> fileName: Image;    # Load image from file into CPU memory (RAM)
