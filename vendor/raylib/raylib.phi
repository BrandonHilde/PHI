Ray.LoadTexture: ptr<u8> fileName: Texture;    # Load texture from file into GPU memory (VRAM)
Ray.LoadTextureFromImage: Image image: Texture;    # Load texture from image data
Ray.LoadTextureCubemap: Image image int layout: Texture;    # Load cubemap from image, multiple image cubemap layouts supported
Ray.LoadRenderTexture: int width int height: RenderTexture;    # Load texture for rendering (framebuffer)
Ray.LoadRenderTextureEx: int width int height int format: RenderTexture;    # Load texture for rendering (framebuffer), with specific format
Ray.IsTextureValid: Texture texture: bln;    # Check if texture is valid (loaded in GPU)
Ray.UnloadTexture: Texture texture;    # Unload texture from GPU memory (VRAM)
Ray.IsRenderTextureValid: RenderTexture target: bln;    # Check if render texture is valid (loaded in GPU)
Ray.UnloadRenderTexture: RenderTexture target;    # Unload render texture from GPU memory (VRAM)
Ray.UpdateTexture: Texture texture ptr<u8> pixels;    # Update GPU texture with new data (pixels should be able to fill texture)
Ray.UpdateTextureRec: Texture texture Rectangle rec ptr<u8> pixels;    # Update GPU texture rectangle with new data (pixels and rec should fit in texture)
Ray.GenTextureMipmaps: ptr<Texture> texture;    # Generate GPU mipmaps for a texture
Ray.SetTextureFilter: Texture texture int filter;    # Set texture scaling filter mode
Ray.SetTextureWrap: Texture texture int wrap;    # Set texture wrapping mode
Ray.DrawTexture: Texture texture int posX int posY Color tint;    # Draw a Texture2D
Ray.DrawTextureV: Texture texture Vector2 position Color tint;    # Draw a Texture2D with position defined as Vector2
Ray.DrawTextureEx: Texture texture Vector2 position f32 rotation f32 scale Color tint;    # Draw a Texture2D with rotation and scale
Ray.DrawTextureRec: Texture texture Rectangle rec Vector2 position Color tint;    # Draw a part of a texture defined by a rectangle
Ray.DrawTexturePro: Texture texture Rectangle srcrec Rectangle dstrec Vector2 origin f32 rotation Color tint;    # Draw a part of a texture defined by a source rectangle to destination rectangle, with scaling and rotation
Ray.DrawTextureNPatch: Texture texture NPatchInfo nPatchInfo Rectangle dstrec Vector2 origin f32 rotation Color tint;    # Draw a texture (or part of it) that stretches or shrinks nicely
Ray.ColorIsEqual: Color col1 Color col2: bln;    # Check if two colors are equal
Ray.Fade: Color color f32 alpha: Color;    # Get color with alpha applied, alpha goes from 0.0f to 1.0f
Ray.ColorToInt: Color color: int;    # Get hexadecimal value for a Color (0xRRGGBBAA)
Ray.ColorNormalize: Color color: Vector4;    # Get Color normalized as float [0..1]
Ray.ColorFromNormalized: Vector4 normalized: Color;    # Get Color from normalized values [0..1]
Ray.ColorToHSV: Color color: Vector3;    # Get HSV values for a Color, hue [0..360], saturation/value [0..1]
Ray.ColorFromHSV: f32 hue f32 saturation f32 value: Color;    # Get a Color from HSV values, hue [0..360], saturation/value [0..1]
Ray.ColorTint: Color color Color tint: Color;    # Get color multiplied with another color
Ray.ColorBrightness: Color color f32 factor: Color;    # Get color with brightness correction, brightness factor goes from -1.0f to 1.0f
Ray.ColorContrast: Color color f32 contrast: Color;    # Get color with contrast correction, contrast values between -1.0f and 1.0f
Ray.ColorAlpha: Color color f32 alpha: Color;    # Get color with alpha applied, alpha goes from 0.0f to 1.0f
Ray.ColorAlphaBlend: Color dst Color src Color tint: Color;    # Get src alpha-blended into dst color with tint
Ray.ColorLerp: Color color1 Color color2 f32 factor: Color;    # Get color lerp interpolation between two colors, factor [0.0f..1.0f]
Ray.GetColor: u32 hexValue: Color;    # Get Color structure from hexadecimal value
