Ray.LoadImageAnim: ptr<u8> fileName ptr<int> frames: Image;    # Load image sequence from file (frames appended to image.data)
Ray.LoadImageAnimFromMemory: ptr<u8> fileType ptr<u8> fileData int dataSize ptr<int> frames: Image;    # Load image sequence from memory buffer
Ray.LoadImageFromMemory: ptr<u8> fileType ptr<u8> fileData int dataSize: Image;    # Load image from memory buffer, fileType refers to extension: i.e. '.png'
Ray.LoadImageFromTexture: Texture texture: Image;    # Load image from GPU texture data
Ray.LoadImageFromScreen: : Image;    # Load image from screen buffer (screenshot)
Ray.IsImageValid: Image image: bln;    # Check if an image is valid (data and parameters)
Ray.UnloadImage: Image image;    # Unload image from CPU memory (RAM)
Ray.ExportImage: Image image ptr<u8> fileName: bln;    # Export image data to file, returns true on success
Ray.ExportImageToMemory: Image image ptr<u8> fileType ptr<int> fileSize: ptr<u8>;    # Export image to memory buffer, memory must be MemFree()
Ray.ExportImageAsCode: Image image ptr<u8> fileName: bln;    # Export image as code file defining an array of bytes, returns true on success
Ray.GenImageColor: int width int height Color color: Image;    # Generate image: plain color
Ray.GenImageGradientLinear: int width int height int direction Color start Color end_: Image;    # Generate image: linear gradient, direction in degrees [0..360], 0=Vertical gradient
Ray.GenImageGradientRadial: int width int height f32 density Color inner Color outer: Image;    # Generate image: radial gradient
Ray.GenImageGradientSquare: int width int height f32 density Color inner Color outer: Image;    # Generate image: square gradient
Ray.GenImageChecked: int width int height int checksX int checksY Color col1 Color col2: Image;    # Generate image: checked
Ray.GenImageWhiteNoise: int width int height f32 factor: Image;    # Generate image: white noise
Ray.GenImagePerlinNoise: int width int height int offsetX int offsetY f32 scale: Image;    # Generate image: perlin noise
Ray.GenImageCellular: int width int height int tileSize: Image;    # Generate image: cellular algorithm, bigger tileSize means bigger cells
