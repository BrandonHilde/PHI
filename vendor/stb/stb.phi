# stb 2026-11: pictures read (PNG, JPEG, BMP, GIF, TGA and more) and written, fonts drawn from TrueType files, rectangles packed, Ogg Vorbis sound decoded
# https://github.com/nothings/stb  (public domain or MIT licence: see LICENSE beside this file)
#
# Written by vendor/bindgen.py from stb_image.h, stb_image_write.h, stb_rect_pack.h, stb_truetype.h, stb_vorbis.c: change package.json
# and run it again, rather than this file. Functions, structs and constants have C's names.
# stb_image 2.30, stb_image_write 1.19, stb_truetype 1.28, stb_rect_pack 1.02 and stb_vorbis 1.25, in one library.
# Functions have C's whole names: Stb.stbi_load, Stb.stbi_write_png, Stb.stbtt_InitFont, Stb.stb_vorbis_decode_filename.
use 'stb.dll' 'libstb.dylib' 'libstb.so' as Stb;

phi.Stb:Library
{
	const int STB_RECT_PACK_VERSION: 1;
	const int STBTT_MACSTYLE_DONTCARE: 0;
	const int STBTT_MACSTYLE_BOLD: 1;
	const int STBTT_MACSTYLE_ITALIC: 2;
	const int STBTT_MACSTYLE_UNDERSCORE: 4;
	const int STBTT_MACSTYLE_NONE: 8;    # <= not same as 0, this makes us check the bitfield is 0

	# (an enum with no name)
	const int STBI_default: 0;    # only used for desired_channels
	const int STBI_grey: 1;
	const int STBI_grey_alpha: 2;
	const int STBI_rgb: 3;
	const int STBI_rgb_alpha: 4;

	# (an enum with no name)
	const int STBI_type_unsupported: 0;    # image type
	const int STBI_type_jpeg: 1;
	const int STBI_type_png: 2;
	const int STBI_type_gif: 3;
	const int STBI_type_bmp: 4;
	const int STBI_type_psd: 5;
	const int STBI_type_pnm: 6;
	const int STBI_type_hdr: 7;
	const int STBI_type_tga: 8;

	# (an enum with no name)
	const int STBRP_HEURISTIC_Skyline_default: 0;
	const int STBRP_HEURISTIC_Skyline_BL_sortHeight: 0;
	const int STBRP_HEURISTIC_Skyline_BF_sortHeight: 1;

	# (an enum with no name)
	const int STBTT_vmove: 1;
	const int STBTT_vline: 2;
	const int STBTT_vcurve: 3;
	const int STBTT_vcubic: 4;

	# (an enum with no name)
	const int STBTT_PLATFORM_ID_UNICODE: 0;
	const int STBTT_PLATFORM_ID_MAC: 1;
	const int STBTT_PLATFORM_ID_ISO: 2;
	const int STBTT_PLATFORM_ID_MICROSOFT: 3;

	# (an enum with no name)
	const int STBTT_UNICODE_EID_UNICODE_1_0: 0;
	const int STBTT_UNICODE_EID_UNICODE_1_1: 1;
	const int STBTT_UNICODE_EID_ISO_10646: 2;
	const int STBTT_UNICODE_EID_UNICODE_2_0_BMP: 3;
	const int STBTT_UNICODE_EID_UNICODE_2_0_FULL: 4;

	# (an enum with no name)
	const int STBTT_MS_EID_SYMBOL: 0;
	const int STBTT_MS_EID_UNICODE_BMP: 1;
	const int STBTT_MS_EID_SHIFTJIS: 2;
	const int STBTT_MS_EID_UNICODE_FULL: 10;

	# (an enum with no name)
	const int STBTT_MAC_EID_ROMAN: 0;
	const int STBTT_MAC_EID_ARABIC: 4;
	const int STBTT_MAC_EID_JAPANESE: 1;
	const int STBTT_MAC_EID_HEBREW: 5;
	const int STBTT_MAC_EID_CHINESE_TRAD: 2;
	const int STBTT_MAC_EID_GREEK: 6;
	const int STBTT_MAC_EID_KOREAN: 3;
	const int STBTT_MAC_EID_RUSSIAN: 7;

	# (an enum with no name)
	const int STBTT_MS_LANG_ENGLISH: 1033;
	const int STBTT_MS_LANG_ITALIAN: 1040;
	const int STBTT_MS_LANG_CHINESE: 2052;
	const int STBTT_MS_LANG_JAPANESE: 1041;
	const int STBTT_MS_LANG_DUTCH: 1043;
	const int STBTT_MS_LANG_KOREAN: 1042;
	const int STBTT_MS_LANG_FRENCH: 1036;
	const int STBTT_MS_LANG_RUSSIAN: 1049;
	const int STBTT_MS_LANG_GERMAN: 1031;
	const int STBTT_MS_LANG_SPANISH: 1033;
	const int STBTT_MS_LANG_HEBREW: 1037;
	const int STBTT_MS_LANG_SWEDISH: 1053;

	# (an enum with no name)
	const int STBTT_MAC_LANG_ENGLISH: 0;
	const int STBTT_MAC_LANG_JAPANESE: 11;
	const int STBTT_MAC_LANG_ARABIC: 12;
	const int STBTT_MAC_LANG_KOREAN: 23;
	const int STBTT_MAC_LANG_DUTCH: 4;
	const int STBTT_MAC_LANG_RUSSIAN: 32;
	const int STBTT_MAC_LANG_FRENCH: 1;
	const int STBTT_MAC_LANG_SPANISH: 6;
	const int STBTT_MAC_LANG_GERMAN: 2;
	const int STBTT_MAC_LANG_SWEDISH: 5;
	const int STBTT_MAC_LANG_HEBREW: 10;
	const int STBTT_MAC_LANG_CHINESE_SIMPLIFIED: 33;
	const int STBTT_MAC_LANG_ITALIAN: 3;
	const int STBTT_MAC_LANG_CHINESE_TRAD: 19;

	# STBVorbisError
	const int VORBIS__no_error: 0;
	const int VORBIS_need_more_data: 1;    # not a real error
	const int VORBIS_invalid_api_mixing: 2;    # can't mix API modes
	const int VORBIS_outofmem: 3;    # not enough memory
	const int VORBIS_feature_not_supported: 4;    # uses floor 0
	const int VORBIS_too_many_channels: 5;    # STB_VORBIS_MAX_CHANNELS is too small
	const int VORBIS_file_open_failure: 6;    # fopen() failed
	const int VORBIS_seek_without_length: 7;    # can't seek in unknown-length file
	const int VORBIS_unexpected_eof: 10;    # file is truncated?
	const int VORBIS_seek_invalid: 11;    # seek past EOF
	const int VORBIS_invalid_setup: 20;
	const int VORBIS_invalid_stream: 21;
	const int VORBIS_missing_capture_pattern: 30;
	const int VORBIS_invalid_stream_structure_version: 31;
	const int VORBIS_continued_packet_flag_invalid: 32;
	const int VORBIS_incorrect_stream_serial_number: 33;
	const int VORBIS_invalid_first_page: 34;
	const int VORBIS_bad_packet_type: 35;
	const int VORBIS_cant_find_last_page: 36;
	const int VORBIS_seek_failed: 37;
	const int VORBIS_ogg_skeleton_not_supported: 38;
	const int VORBIS_invalid_granule_pos: 39;
}

struct.stb_vorbis foreign    # only ever held by its address: what's in it is stb's own
{
	int opaque;
}

struct.stbi_io_callbacks foreign
{
	ptr<u8> read;
	ptr<u8> skip;
	ptr<u8> eof;
}

struct.stbi_info_res foreign
{
	int type;
	int x;
	int y;
	int comp;
	int is_16_bit;
	int is_hdr;
	int is_iphone_png;
}

struct.stbrp_rect foreign
{
	int id;
	int w;
	int h;
	int x;
	int y;
	int was_packed;
}

struct.stbrp_node foreign
{
	int x;
	int y;
	ptr<stbrp_node> next;
}

struct.stbrp_context foreign
{
	int width;
	int height;
	int align;
	int init_mode;
	int heuristic;
	int num_nodes;
	ptr<stbrp_node> active_head;
	ptr<stbrp_node> free_head;
	stbrp_node extra[2];
}

struct.stbtt__buf foreign
{
	ptr<u8> data;
	int cursor;
	int size;
}

struct.stbtt_bakedchar foreign
{
	u16 x0;
	u16 y0;
	u16 x1;
	u16 y1;
	f32 xoff;
	f32 yoff;
	f32 xadvance;
}

struct.stbtt_aligned_quad foreign
{
	f32 x0;
	f32 y0;
	f32 s0;
	f32 t0;
	f32 x1;
	f32 y1;
	f32 s1;
	f32 t1;
}

struct.stbtt_packedchar foreign
{
	u16 x0;
	u16 y0;
	u16 x1;
	u16 y1;
	f32 xoff;
	f32 yoff;
	f32 xadvance;
	f32 xoff2;
	f32 yoff2;
}

struct.stbtt_pack_range foreign
{
	f32 font_size;
	int first_unicode_codepoint_in_range;
	ptr<int> array_of_unicode_codepoints;
	int num_chars;
	ptr<stbtt_packedchar> chardata_for_range;
	u8 h_oversample;
	u8 v_oversample;
}

struct.stbtt_pack_context foreign
{
	ptr<u8> user_allocator_context;
	ptr<u8> pack_info;
	int width;
	int height;
	int stride_in_bytes;
	int padding;
	int skip_missing;
	u32 h_oversample;
	u32 v_oversample;
	ptr<u8> pixels;
	ptr<u8> nodes;
}

struct.stbtt_fontinfo foreign
{
	ptr<u8> userdata;
	ptr<u8> data;
	int fontstart;
	int numGlyphs;
	int loca;
	int head;
	int glyf;
	int hhea;
	int hmtx;
	int vhea;
	int vmtx;
	int kern;
	int gpos;
	int svg;
	int index_map;
	int indexToLocFormat;
	stbtt__buf cff;
	stbtt__buf charstrings;
	stbtt__buf gsubrs;
	stbtt__buf subrs;
	stbtt__buf fontdicts;
	stbtt__buf fdselect;
}

struct.stbtt_kerningentry foreign
{
	int glyph1;
	int glyph2;
	int advance;
}

struct.stbtt_vertex foreign
{
	i16 x;
	i16 y;
	i16 cx;
	i16 cy;
	i16 cx1;
	i16 cy1;
	u8 type;
	u8 padding;
}

struct.stbtt__bitmap foreign
{
	int w;
	int h;
	int stride;
	ptr<u8> pixels;
}

struct.stb_vorbis_alloc foreign
{
	ptr<u8> alloc_buffer;
	int alloc_buffer_length_in_bytes;
}

struct.stb_vorbis_info foreign
{
	u32 sample_rate;
	int channels;
	u32 setup_memory_required;
	u32 setup_temp_memory_required;
	u32 temp_memory_required;
	int max_frame_size;
}

struct.stb_vorbis_comment foreign
{
	ptr<u8> vendor;
	int comment_list_length;
	ptr<ptr<u8>> comment_list;
}

