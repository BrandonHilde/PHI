	const int Z_PARTIAL_FLUSH: 1;
	const int Z_SYNC_FLUSH: 2;
	const int Z_FULL_FLUSH: 3;
	const int Z_FINISH: 4;
	const int Z_BLOCK: 5;
	const int Z_TREES: 6;
	const int Z_OK: 0;
	const int Z_STREAM_END: 1;
	const int Z_NEED_DICT: 2;
	const int Z_ERRNO: -1;
	const int Z_STREAM_ERROR: -2;
	const int Z_DATA_ERROR: -3;
	const int Z_MEM_ERROR: -4;
	const int Z_BUF_ERROR: -5;
	const int Z_VERSION_ERROR: -6;
	const int Z_NO_COMPRESSION: 0;
	const int Z_BEST_SPEED: 1;
	const int Z_BEST_COMPRESSION: 9;
	const int Z_DEFAULT_COMPRESSION: -1;
	const int Z_FILTERED: 1;
	const int Z_HUFFMAN_ONLY: 2;
	const int Z_RLE: 3;
	const int Z_FIXED: 4;
	const int Z_DEFAULT_STRATEGY: 0;
	const int Z_BINARY: 0;
	const int Z_TEXT: 1;
	const int Z_ASCII: 1;    # for compatibility with 1.2.2 and earlier
	const int Z_UNKNOWN: 2;
	const int Z_DEFLATED: 8;
	const int Z_NULL: 0;    # for initializing zalloc, zfree, opaque


	# what C's header has as macros: each hands zlib the version it was written for and the
	# size of a z_stream, which zlib checks
	[deflateInit: ptr<z_stream> strm; int level;]
	[end: (Z.deflateInit_: strm level '1.4' (sizeof z_stream))]

	[inflateInit: ptr<z_stream> strm;]
	[end: (Z.inflateInit_: strm '1.4' (sizeof z_stream))]

	[deflateInit2: ptr<z_stream> strm; int level; int how; int windowBits; int memLevel; int strategy;]
	[end: (Z.deflateInit2_: strm level how windowBits memLevel strategy '1.4' (sizeof z_stream))]

	[inflateInit2: ptr<z_stream> strm; int windowBits;]
	[end: (Z.inflateInit2_: strm windowBits '1.4' (sizeof z_stream))]

	[inflateBackInit: ptr<z_stream> strm; int windowBits; ptr<u8> window;]
	[end: (Z.inflateBackInit_: strm windowBits window '1.4' (sizeof z_stream))]
}

struct.internal_state foreign    # only ever held by its address: what's in it is zlib's own
{
	int opaque;
}

struct.z_stream foreign
{
	ptr<u8> next_in;
	u32 avail_in;
	ulng total_in;
	ptr<u8> next_out;
	u32 avail_out;
	ulng total_out;
	ptr<u8> msg;
	ptr<internal_state> state;
	ptr<u8> zalloc;
	ptr<u8> zfree;
	ptr<u8> opaque;
	int data_type;
	ulng adler;
	ulng reserved;
}

struct.gz_header foreign
{
	int text;
	ulng time;
	int xflags;
	int os;
	ptr<u8> extra;
	u32 extra_len;
	u32 extra_max;
	ptr<u8> name;
	u32 name_max;
	ptr<u8> comment;
	u32 comm_max;
	int hcrc;
	int done;
}

struct.gzFile_s foreign
{
	u32 have;
	ptr<u8> next;
	i64 pos;
}

