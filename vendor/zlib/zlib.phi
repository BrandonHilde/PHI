# and run it again, rather than this file. Functions, structs and constants have C's names.
# deflateInit, inflateInit and the others C has as macros are methods here (Z.deflateInit),
# which hand zlib its version and the size of a z_stream as the macros do.
use 'zlib1.dll' 'libz.1.4.dylib' 'libz.so.1.4' as Z;

phi.Z:Library
{
	const int ZLIB_VERNUM: 5120;
	const int ZLIB_VER_MAJOR: 1;
	const int ZLIB_VER_MINOR: 4;
