	const int GPU_STENCILOP_INCREMENT_AND_CLAMP: 4;    # Increments the current value and clamps to the maximum value.
	const int GPU_STENCILOP_DECREMENT_AND_CLAMP: 5;    # Decrements the current value and clamps to 0.
	const int GPU_STENCILOP_INVERT: 6;    # Bitwise-inverts the current value.
