	# SDL_Folder
	const int FOLDER_HOME: 0;    # The folder which contains all of the current user's data, preferences, and documents. It usually contains most of the other folders. If a requested folder does not exist, the home folder can be considered a safe fallback to store a user's documents.
	const int FOLDER_DESKTOP: 1;    # The folder of files that are displayed on the desktop. Note that the existence of a desktop folder does not guarantee that the system does show icons on its desktop; certain GNU/Linux distros with a graphical environment may not have desktop icons.
	const int FOLDER_DOCUMENTS: 2;    # User document files, possibly application-specific. This is a good place to save a user's projects.
	const int FOLDER_DOWNLOADS: 3;    # Standard folder for user files downloaded from the internet.
	const int FOLDER_MUSIC: 4;    # Music files that can be played using a standard music player (mp3, ogg...).
	const int FOLDER_PICTURES: 5;    # Image files that can be displayed using a standard viewer (png, jpg...).
	const int FOLDER_PUBLICSHARE: 6;    # Files that are meant to be shared with other users on the same computer.
	const int FOLDER_SAVEDGAMES: 7;    # Save files for games.
	const int FOLDER_SCREENSHOTS: 8;    # Application screenshots.
	const int FOLDER_TEMPLATES: 9;    # Template files to be used when the user requests the desktop environment to create a new file in a certain folder, such as "New Text File.txt".  Any file in the Templates folder can be used as a starting point for a new file.
	const int FOLDER_VIDEOS: 10;    # Video files that can be played using a standard video player (mp4, webm...).
	const int FOLDER_COUNT: 11;    # Total number of types in this enum, not a folder type by itself.

