	const int HID_API_BUS_I2C: 3;
	const int HID_API_BUS_SPI: 4;

	# SDL_HintPriority
	const int HINT_DEFAULT: 0;
	const int HINT_NORMAL: 1;
	const int HINT_OVERRIDE: 2;

	# SDL_AppResult
	const int APP_CONTINUE: 0;    # Value that requests that the app continue from the main callbacks.
	const int APP_SUCCESS: 1;    # Value that requests termination with success from the main callbacks.
	const int APP_FAILURE: 2;    # Value that requests termination with error from the main callbacks.

	# SDL_LogCategory
	const int LOG_CATEGORY_APPLICATION: 0;
	const int LOG_CATEGORY_ERROR: 1;
	const int LOG_CATEGORY_ASSERT: 2;
	const int LOG_CATEGORY_SYSTEM: 3;
	const int LOG_CATEGORY_AUDIO: 4;
	const int LOG_CATEGORY_VIDEO: 5;
	const int LOG_CATEGORY_RENDER: 6;
	const int LOG_CATEGORY_INPUT: 7;
	const int LOG_CATEGORY_TEST: 8;
	const int LOG_CATEGORY_GPU: 9;
	const int LOG_CATEGORY_RESERVED2: 10;
	const int LOG_CATEGORY_RESERVED3: 11;
	const int LOG_CATEGORY_RESERVED4: 12;
	const int LOG_CATEGORY_RESERVED5: 13;
	const int LOG_CATEGORY_RESERVED6: 14;
	const int LOG_CATEGORY_RESERVED7: 15;
	const int LOG_CATEGORY_RESERVED8: 16;
	const int LOG_CATEGORY_RESERVED9: 17;
	const int LOG_CATEGORY_RESERVED10: 18;
	const int LOG_CATEGORY_CUSTOM: 19;

	# SDL_LogPriority
	const int LOG_PRIORITY_INVALID: 0;
	const int LOG_PRIORITY_TRACE: 1;
	const int LOG_PRIORITY_VERBOSE: 2;
	const int LOG_PRIORITY_DEBUG: 3;
	const int LOG_PRIORITY_INFO: 4;
	const int LOG_PRIORITY_WARN: 5;
	const int LOG_PRIORITY_ERROR: 6;
	const int LOG_PRIORITY_CRITICAL: 7;
	const int LOG_PRIORITY_COUNT: 8;

	# SDL_MessageBoxColorType
	const int MESSAGEBOX_COLOR_BACKGROUND: 0;
	const int MESSAGEBOX_COLOR_TEXT: 1;
	const int MESSAGEBOX_COLOR_BUTTON_BORDER: 2;
	const int MESSAGEBOX_COLOR_BUTTON_BACKGROUND: 3;
	const int MESSAGEBOX_COLOR_BUTTON_SELECTED: 4;
	const int MESSAGEBOX_COLOR_COUNT: 5;    # Size of the colors array of SDL_MessageBoxColorScheme.

	# SDL_ProcessIO
	const int PROCESS_STDIO_INHERITED: 0;    # The I/O stream is inherited from the application.
	const int PROCESS_STDIO_NULL: 1;    # The I/O stream is ignored.
	const int PROCESS_STDIO_APP: 2;    # The I/O stream is connected to a new SDL_IOStream that the application can read or write
	const int PROCESS_STDIO_REDIRECT: 3;    # The I/O stream is redirected to an existing SDL_IOStream.

	# SDL_TextureAccess
	const int TEXTUREACCESS_STATIC: 0;    # Changes rarely, not lockable
	const int TEXTUREACCESS_STREAMING: 1;    # Changes frequently, lockable
	const int TEXTUREACCESS_TARGET: 2;    # Texture can be used as a render target

	# SDL_TextureAddressMode
	const int TEXTURE_ADDRESS_INVALID: -1;
	const int TEXTURE_ADDRESS_AUTO: 0;    # Wrapping is enabled if texture coordinates are outside [0, 1], this is the default
	const int TEXTURE_ADDRESS_CLAMP: 1;    # Texture coordinates are clamped to the [0, 1] range
	const int TEXTURE_ADDRESS_WRAP: 2;    # The texture is repeated (tiled)

	# SDL_RendererLogicalPresentation
	const int LOGICAL_PRESENTATION_DISABLED: 0;    # There is no logical size in effect
	const int LOGICAL_PRESENTATION_STRETCH: 1;    # The rendered content is stretched to the output resolution
	const int LOGICAL_PRESENTATION_LETTERBOX: 2;    # The rendered content is fit to the largest dimension and the other dimension is letterboxed with the clear color
	const int LOGICAL_PRESENTATION_OVERSCAN: 3;    # The rendered content is fit to the smallest dimension and the other dimension extends beyond the output bounds
	const int LOGICAL_PRESENTATION_INTEGER_SCALE: 4;    # The rendered content is scaled up by integer multiples to fit the output resolution

	# SDL_Sandbox
	const int SANDBOX_NONE: 0;
	const int SANDBOX_UNKNOWN_CONTAINER: 1;
	const int SANDBOX_FLATPAK: 2;
	const int SANDBOX_SNAP: 3;
	const int SANDBOX_MACOS: 4;

	# SDL_DateFormat
	const int DATE_FORMAT_YYYYMMDD: 0;    # Year/Month/Day
	const int DATE_FORMAT_DDMMYYYY: 1;    # Day/Month/Year
	const int DATE_FORMAT_MMDDYYYY: 2;    # Month/Day/Year

	# SDL_TimeFormat
	const int TIME_FORMAT_24HR: 0;    # 24 hour time
	const int TIME_FORMAT_12HR: 1;    # 12 hour time

	call SDL.SetMainReady;    # (the program has a start of its own, which SDL is told before anything else of it is called)
}

