{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PHI",
  "scopeName": "source.phi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#assembly" },
    { "include": "#headers" },
    { "include": "#methods" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#names" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.phi",
          "begin": "^\\s*#\\s*$",
          "end": "#"
        },
        {
          "name": "comment.line.number-sign.phi",
          "match": "#.*$"
        }
      ]
    },
    "assembly": {
      "name": "meta.assembly.phi",
      "begin": "^\\s*(asm|x64|arm)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.phi" },
        "3": { "name": "entity.name.function.phi" }
      },
      "end": "^\\s*\\}",
      "patterns": [
        { "name": "comment.line.semicolon.asm", "match": ";.*$" }
      ]
    },
    "headers": {
      "patterns": [
        {
          "match": "\\b(phi)(\\.)([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.other.phi" },
            "3": { "name": "entity.name.type.class.phi" },
            "5": { "name": "entity.other.inherited-class.phi" }
          }
        },
        {
          "match": "\\b(struct|enum|interface)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.phi" },
            "3": { "name": "entity.name.type.phi" }
          }
        },
        {
          "match": "\\b(sys)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.phi" },
            "3": { "name": "entity.name.function.phi" }
          }
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "match": "\\[\\s*(end)\\b",
          "captures": { "1": { "name": "keyword.control.phi" } }
        },
        {
          "match": "^\\s*\\[\\s*(?:(isr)\\s+)?(?!end\\b)([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.other.phi" },
            "2": { "name": "entity.name.function.phi" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.phi",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        { "name": "constant.character.escape.phi", "match": "\\\\(x[0-9A-Fa-f]{2}|.)" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.phi", "match": "\\b0[xX][0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.phi", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "storage.type.phi", "match": "\\b(str|int|byt|bln|chr|dec|fin|var|u8|u16|u32|i8|i16|i32|i64|u64|f16|f32|f64|ptr|method|lock)\\b" },
        { "name": "keyword.control.phi", "match": "\\b(if|elif|else|while|each|when|break|continue|return|exit|throw|throws|call|unsafe|locked|atomic)\\b" },
        { "name": "keyword.operator.word.phi", "match": "\\b(is|not|and|or|has|as|takes|addr|sizeof|new|free|in|inw|ind|out|outw|outd|below|above|atmost|atleast|at|into)\\b" },
        { "name": "constant.language.phi", "match": "\\b(true|false|empty)\\b" },
        { "name": "keyword.other.phi", "match": "\\b(log|debug|ask|use|const|volatile|foreign)\\b" }
      ]
    },
    "names": {
      "patterns": [
        { "name": "constant.other.phi", "match": "\\b[A-Z][A-Z0-9_]{1,}\\b" },
        { "name": "entity.name.type.phi", "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s+[a-z_])" },
        { "name": "entity.name.function.phi", "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*:\\s)" }
      ]
    }
  }
}
