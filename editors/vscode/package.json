{
  "name": "phi-language",
  "displayName": "PHI",
  "description": "The PHI language: errors as you type, going to a definition, completing names, and colors.",
  "version": "0.1.0",
  "publisher": "phi-language",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "phi",
        "aliases": ["PHI", "phi"],
        "extensions": [".phi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phi",
        "scopeName": "source.phi",
        "path": "./syntaxes/phi.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "phi.restartServer",
        "title": "PHI: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "PHI",
      "properties": {
        "phi.serverPath": {
          "type": "string",
          "default": "",
          "description": "The phi program to run as the language server. Left empty, it's the one built in this workspace (Compiler/Phi.Cli/bin/...), else phi on your PATH."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "2.32.0"
  }
}
